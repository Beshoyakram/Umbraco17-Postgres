@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteInfoService SiteInfo
@inject ICareerViewService ViewCounter
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
	Layout = "Layout.cshtml";

	string? ResolveMediaUrl(object? mediaValue)
	{
		if (mediaValue == null) return null;
		try
		{
			if (mediaValue is MediaWithCrops mwc)
			{
				return SiteInfo.GetMediaUrl(mwc.Content) ?? SiteInfo.GetMediaUrl(mwc);
			}
			if (mediaValue is IPublishedContent ipc)
			{
				return SiteInfo.GetMediaUrl(ipc);
			}
			if (mediaValue is IEnumerable<MediaWithCrops> manyCrops)
			{
				var first = manyCrops.FirstOrDefault();
				return first == null ? null : SiteInfo.GetMediaUrl(first.Content) ?? SiteInfo.GetMediaUrl(first);
			}
			if (mediaValue is IEnumerable<IPublishedContent> many)
			{
				return SiteInfo.GetMediaUrl(many.FirstOrDefault());
			}
		}
		catch (Exception)
		{
			return null;
		}
		return null;
	}

	string? MediaUrl(string alias)
	{
		if (!Model.HasProperty(alias) || !Model.HasValue(alias)) return null;
		try { return ResolveMediaUrl(Model.Value(alias)); }
		catch (Exception) { return null; }
	}

	string? Text(string alias)
		=> Model.HasValue(alias) ? Model.Value<string>(alias) : null;

	// Match production detail banner label
	var bannerTitle = Text("bannerTitle");
	if (string.IsNullOrWhiteSpace(bannerTitle) || bannerTitle == "Blog")
	{
		bannerTitle = "Blog Details";
	}
	var bannerImageUrl = MediaUrl("bannerImage");
	var postTitle = Text("postTitle") ?? Model.Name;
	var category = Text("category");
	var excerptRaw = Text("excerpt");
	var excerpt = string.IsNullOrWhiteSpace(excerptRaw)
		? null
		: System.Text.RegularExpressions.Regex.Replace(excerptRaw, "<[^>]+>", " ").Replace("&nbsp;", " ").Trim();
	excerpt = string.IsNullOrWhiteSpace(excerpt) ? null : System.Text.RegularExpressions.Regex.Replace(excerpt, @"\s+", " ");
	var featuredImageUrl = MediaUrl("featuredImage");
	var blogUrl = SiteInfo.GetBlogPage()?.Url() ?? "/blog";
	var contentBlocks = Model.HasValue("contentBlocks") ? Model.Value<BlockListModel>("contentBlocks") : null;
	var hasBlocks = contentBlocks != null && contentBlocks.Any();

	var cookieName = $"blog_viewed_{Model.Key:N}";
	var http = HttpContextAccessor.HttpContext;
	var alreadyCounted = http?.Request.Cookies.ContainsKey(cookieName) == true;
	var viewCount = ViewCounter.IncrementAndGet(Model.Key, alreadyCounted);
	if (http != null && !alreadyCounted)
	{
		http.Response.Cookies.Append(cookieName, "1", new CookieOptions
		{
			Expires = DateTimeOffset.UtcNow.AddDays(1),
			HttpOnly = true,
			IsEssential = true,
			SameSite = SameSiteMode.Lax
		});
	}

	var recent = SiteInfo.GetBlogPosts().Where(x => x.Id != Model.Id).Take(5).ToList();
}

@section Head {
	<link rel="stylesheet" href="~/css/pages/blog.css" asp-append-version="true" />
}

@section Scripts {
	<script src="~/js/pages/blog-interactive.js" asp-append-version="true"></script>
}

<div class="bg4" style="@(string.IsNullOrWhiteSpace(bannerImageUrl) ? null : $"--blog-banner-bg: url('{bannerImageUrl}');")">
	<div class="breadcam_area bradcam_bg overlay2">
		<div class="bradcam_text">
			<h3>@bannerTitle</h3>
		</div>
	</div>
</div>

<section class="blog_area single-post-area section-padding blog-detail">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 posts-list">
				<div class="single-post">
					@if (!string.IsNullOrWhiteSpace(featuredImageUrl))
					{
						<div class="feature-img">
							<img class="img-fluid" src="@featuredImageUrl" alt="@postTitle" loading="eager">
						</div>
					}
					<div class="blog_details">
						@if (!string.IsNullOrWhiteSpace(postTitle))
						{
							<h2>@postTitle</h2>
						}
						<ul class="blog-info-link mt-3 mb-4">
							@if (!string.IsNullOrWhiteSpace(category))
							{
								<li><i class="fa fa-user"></i> @category</li>
							}
							<li>
								<span class="post-views">
									<i class="fa fa-solid fa-eye"></i>@viewCount.ToString("N0") Views
								</span>
							</li>
						</ul>
						@if (!string.IsNullOrWhiteSpace(excerpt))
						{
							<p class="excert">@excerpt</p>
						}

						<div class="blog-full-body">
							@if (hasBlocks)
							{
								@await Html.PartialAsync("~/Views/Partials/blog/_ContentBlocks.cshtml", contentBlocks)
							}
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-4">
				<div class="blog_right_sidebar">
					<aside class="single_sidebar_widget search_widget">
						<form method="get" action="@blogUrl">
							<div class="form-group">
								<div class="input-group mb-3">
									<input class="form-control" type="text" name="s" placeholder="Search Keyword" autocomplete="off" />
									<div class="input-group-append">
										<button class="btn" type="submit" aria-label="Search"><i class="ti-search"></i></button>
									</div>
								</div>
							</div>
							<button class="button rounded-0 primary-bg text-white w-100 btn_1 boxed-btn" type="submit">Search</button>
						</form>
					</aside>

					<aside class="single_sidebar_widget popular_post_widget">
						<h3 class="widget_title">Recent Post</h3>
						@foreach (var post in recent)
						{
							var title = post.HasValue("postTitle") ? post.Value<string>("postTitle") : post.Name;
							string? imageUrl = null;
							try
							{
								imageUrl = post.HasValue("featuredImage") ? ResolveMediaUrl(post.Value("featuredImage")) : null;
							}
							catch (Exception) { }
							DateTime? date = post.HasValue("publishDate") ? post.Value<DateTime>("publishDate") : null;
							<div class="media post_item">
								@if (!string.IsNullOrWhiteSpace(imageUrl))
								{
									<img src="@imageUrl" alt="@title" loading="lazy">
								}
								<div class="media-body">
									<a href="@post.Url()">
										<h3>@title</h3>
									</a>
									@if (date.HasValue)
									{
										<p>@date.Value.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</p>
									}
								</div>
							</div>
						}
					</aside>
				</div>
			</div>
		</div>
	</div>
</section>
