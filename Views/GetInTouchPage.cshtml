@using System.Net
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteInfoService SiteInfo
@{
	Layout = "Layout.cshtml";

	string? ResolveMediaUrl(object? mediaValue)
	{
		try
		{
			if (mediaValue is MediaWithCrops mwc)
			{
				return SiteInfo.GetMediaUrl(mwc.Content) ?? SiteInfo.GetMediaUrl(mwc);
			}

			if (mediaValue is IPublishedContent ipc)
			{
				return SiteInfo.GetMediaUrl(ipc);
			}

			if (mediaValue is IEnumerable<MediaWithCrops> manyCrops)
			{
				var first = manyCrops.FirstOrDefault();
				return first == null ? null : SiteInfo.GetMediaUrl(first.Content) ?? SiteInfo.GetMediaUrl(first);
			}

			if (mediaValue is IEnumerable<IPublishedContent> many)
			{
				return SiteInfo.GetMediaUrl(many.FirstOrDefault());
			}
		}
		catch (Exception)
		{
			return null;
		}

		return null;
	}

	string? MediaUrl(string alias)
	{
		if (!Model.HasProperty(alias) || !Model.HasValue(alias)) return null;
		return ResolveMediaUrl(Model.Value(alias));
	}

	string? Text(string alias)
		=> Model.HasProperty(alias) && Model.HasValue(alias) ? Model.Value<string>(alias) : null;

	string WithEmail(string? template, string emailAddress)
	{
		var safe = WebUtility.HtmlEncode(template ?? string.Empty);
		var mail = WebUtility.HtmlEncode(emailAddress);
		return safe.Replace("{email}", $"<a href=\"mailto:{mail}\">{mail}</a>", StringComparison.OrdinalIgnoreCase);
	}

	var bannerTitle = Text("bannerTitle") ?? "CONTACT US";
	var bannerImageUrl = MediaUrl("bannerImage");
	var formTitle = Text("formTitle") ?? "Get in Touch";
	var formKey = Text("formKey") ?? "home";
	var sourcePage = Model.UrlSegment ?? "contactus";

	var phone = Text("contactPhone") ?? "+1 (975) 432-345";
	var phoneHours = Text("contactPhoneHours") ?? "Mon to Fri 9am to 6pm";
	var email = Text("contactEmail") ?? "contact@centrocdx.com";
	var emailNote = Text("contactEmailNote") ?? "Send us your query anytime!";
	var addressLine1 = Text("addressLine1") ?? "21515 Ridgetop Circle, Suite 120";
	var addressLine2 = Text("addressLine2") ?? "Sterling, VA, 20166";
	var mapEmbedUrl = Text("mapEmbedUrl")
		?? "https://maps.google.com/maps?q=21515+Ridgetop+Circle,+Suite+120,+Sterling,+VA+20166&hl=en&z=15&output=embed";

	var consentText = Text("consentText")
		?? "By selecting this checkbox, I consent to receive text messages from Centro regarding my inquiries, requested services, appointments, and related updates. Message frequency varies. Message and data rates may apply.";
	var consentHelpText = Text("consentHelpText")
		?? "Text HELP for assistance or contact us at {email}. Reply STOP at any time to unsubscribe.";
	var privacyCtaLabel = Text("privacyCtaLabel")
		?? "View our Privacy Policy and Terms & Conditions.";
	var privacyCtaUrl = Text("privacyCtaUrl");
	if (string.IsNullOrWhiteSpace(privacyCtaUrl))
	{
		privacyCtaUrl = SiteInfo.GetPrivacyPolicyPage()?.Url() ?? "/privacy-policy/";
	}

	var consentTextHtml = WebUtility.HtmlEncode(consentText);
	var consentHelpHtml = WithEmail(consentHelpText, email);
	var telHref = "tel:" + new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
	var bannerStyle = string.IsNullOrWhiteSpace(bannerImageUrl)
		? null
		: $"--contactus-banner-bg: url('{bannerImageUrl}');";
}

@section Head {
	<link rel="stylesheet" href="~/css/pages/get-in-touch.css" asp-append-version="true" />
}

<div class="contactus-banner@(string.IsNullOrWhiteSpace(bannerImageUrl) ? "" : " has-banner-image")" style="@bannerStyle">
	<div class="breadcam_area bradcam_bg overlay2">
		<div class="bradcam_text">
			<h3>@bannerTitle</h3>
		</div>
	</div>
</div>

<section class="contact-section contactus-page">
	<div class="container">
		<div class="contactus-map-wrap">
			<iframe
				title="Centro office location map"
				src="@mapEmbedUrl"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen></iframe>
		</div>

		<div class="row align-items-start">
			<div class="col-12">
				<h2 class="contact-title">@formTitle</h2>
			</div>
			<div class="col-lg-8">
				<form class="form-contact contact_form" id="centro-get-in-touch-form" novalidate>
					@Html.AntiForgeryToken()
					<input type="hidden" name="formKey" value="@formKey" />
					<input type="hidden" name="sourcePage" value="@sourcePage" />
					<div class="row">
						<div class="col-12">
							<div class="form-group">
								<textarea class="form-control w-100" name="message" id="message" cols="30" rows="9" maxlength="2000" placeholder="Enter Message" required></textarea>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="form-group">
								<input class="form-control valid" name="name" id="name" type="text" maxlength="255" placeholder="Enter your name" required autocomplete="name" />
							</div>
						</div>
						<div class="col-sm-6">
							<div class="form-group">
								<input class="form-control valid" name="email" id="email" type="email" maxlength="255" placeholder="Enter email address" required autocomplete="email" />
							</div>
						</div>
						<div class="col-sm-6">
							<div class="form-group">
								<input class="form-control valid" name="phone" id="phone" type="tel" maxlength="50" placeholder="Enter your phone number" required autocomplete="tel" />
							</div>
						</div>
						<div class="col-sm-6">
							<div class="form-group">
								<input class="form-control valid" name="subject" id="subject" type="text" maxlength="255" placeholder="Enter Subject" required autocomplete="off" />
							</div>
						</div>
						<div class="col-12">
							<div class="form-group contactus-consent">
								<label class="contactus-consent__label" for="smsConsent">
									<input type="checkbox" name="smsConsent" id="smsConsent" value="true" required />
									<span class="contactus-consent__copy">
										@if (!string.IsNullOrWhiteSpace(consentText))
										{
											<span class="contactus-consent__text">@Html.Raw(consentTextHtml)</span>
										}
										@if (!string.IsNullOrWhiteSpace(consentHelpText))
										{
											<span class="contactus-consent__help">@Html.Raw(consentHelpHtml)</span>
										}
										@if (!string.IsNullOrWhiteSpace(privacyCtaLabel))
										{
											<a class="contactus-consent__cta" href="@privacyCtaUrl">@privacyCtaLabel</a>
										}
									</span>
								</label>
							</div>
						</div>
					</div>
					<div class="form-group mt-3">
						<button type="submit" id="get-in-touch-submit-btn" class="button button-contactForm boxed-btn">SEND</button>
					</div>
					<div id="form-response-message"></div>
				</form>
			</div>
			<div class="col-lg-3 offset-lg-1">
				@if (!string.IsNullOrWhiteSpace(addressLine1) || !string.IsNullOrWhiteSpace(addressLine2))
				{
					<div class="media contact-info">
						<span class="contact-info__icon"><i class="ti-home"></i></span>
						<div class="media-body">
							@if (!string.IsNullOrWhiteSpace(addressLine1))
							{
								<h3>@addressLine1</h3>
							}
							@if (!string.IsNullOrWhiteSpace(addressLine2))
							{
								<p>@addressLine2</p>
							}
						</div>
					</div>
				}
				@if (!string.IsNullOrWhiteSpace(phone))
				{
					<div class="media contact-info">
						<span class="contact-info__icon"><i class="ti-tablet"></i></span>
						<div class="media-body">
							<h3><a href="@telHref">@phone</a></h3>
							@if (!string.IsNullOrWhiteSpace(phoneHours))
							{
								<p>@phoneHours</p>
							}
						</div>
					</div>
				}
				@if (!string.IsNullOrWhiteSpace(email))
				{
					<div class="media contact-info">
						<span class="contact-info__icon"><i class="ti-email"></i></span>
						<div class="media-body">
							<h3><a href="mailto:@email">@email</a></h3>
							@if (!string.IsNullOrWhiteSpace(emailNote))
							{
								<p>@emailNote</p>
							}
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/pages/get-in-touch.js" asp-append-version="true"></script>
}
