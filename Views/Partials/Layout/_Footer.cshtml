@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteInfoService SiteInfo
@{
    var homeUrl = SiteInfo.GetHomePage()?.Url() ?? "/";
    var getInTouchUrl = SiteInfo.GetGetInTouchPage()?.Url() ?? "/get-in-touch";
    var footer = SiteInfo.GetFooter();
    var logoUrl = SiteInfo.GetMediaUrl(footer?.Value<IPublishedContent>("footerLogo"));
    var ctaTitle = footer?.Value<string>("ctaTitle");
    var ctaText = footer?.Value<string>("ctaText");
    var ctaButtonLabel = footer?.Value<string>("ctaButtonLabel");
    var ctaButton = SiteInfo.GetFirstLink(footer, "ctaButton");
    var ctaButtonLink = ctaButton?.Url;
    if (string.IsNullOrWhiteSpace(ctaButtonLabel))
    {
        ctaButtonLabel = ctaButton?.Name;
    }
    if (string.IsNullOrWhiteSpace(ctaButtonLink))
    {
        ctaButtonLink = getInTouchUrl;
    }
    if (string.IsNullOrWhiteSpace(ctaButtonLabel))
    {
        ctaButtonLabel = "Get Started Today";
    }

    var navigationLinks = SiteInfo.GetLinks(footer, "navigationLinks");
    var servicesLinks = SiteInfo.GetLinks(footer, "servicesLinks");
    var phone = footer?.Value<string>("phone");
    var email = footer?.Value<string>("email");
    var copyright = footer?.Value<string>("copyright");
    var socialLinks = footer?.HasValue("socialLinks") == true
        ? footer.Value<BlockListModel>("socialLinks")
        : null;

    string HardcodedIconClass(string? name, string? link)
    {
        var haystack = $"{name} {link}".ToLowerInvariant();
        if (haystack.Contains("facebook")) return "fab fa-facebook";
        if (haystack.Contains("linkedin")) return "fab fa-linkedin";
        if (haystack.Contains("instagram")) return "fab fa-instagram";
        if (haystack.Contains("twitter") || haystack.Contains("x.com")) return "fab fa-x-twitter";
        if (haystack.Contains("youtube")) return "fab fa-youtube";
        if (haystack.Contains("tiktok")) return "fab fa-tiktok";
        return "fas fa-link";
    }
}
@if (footer != null)
{
<footer class="footer footer_bg">
    <div class="footer_top">
        <div class="container-fluid p-0">
            <div class="row no-gutters">
                <div class="col-xl-3 col-12 col-md-4">
                    <div class="footer_widget">
                        @if (!string.IsNullOrWhiteSpace(logoUrl))
                        {
                            <div class="footer_logo" data-aos="fade-up" data-aos-duration="1000">
                                <a href="@homeUrl">
                                    <img src="@logoUrl" alt="Footer Logo">
                                </a>
                            </div>
                        }
                        @if (socialLinks != null && socialLinks.Any())
                        {
                            <ul class="social_links" data-aos="fade-up" data-aos-duration="2000">
                                @foreach (var item in socialLinks)
                                {
                                    var content = item.Content;
                                    var name = content.Value<string>("name") ?? "Social";
                                    var link = content.Value<string>("link");
                                    string? iconUrl = null;
                                    try
                                    {
                                        iconUrl = SiteInfo.GetMediaUrl(content.Value<IPublishedContent>("icon"));
                                    }
                                    catch (ArgumentException)
                                    {
                                        iconUrl = null;
                                    }
                                    var iconClass = HardcodedIconClass(name, link);
                                    if (string.IsNullOrWhiteSpace(link))
                                    {
                                        continue;
                                    }
                                    <li>
                                        <a href="@link" target="_blank" rel="noopener" aria-label="@name" title="@name">
                                            @if (!string.IsNullOrWhiteSpace(iconUrl))
                                            {
                                                <img src="@iconUrl" alt="" class="social_links__icon" width="18" height="18" />
                                            }
                                            else
                                            {
                                                <i class="@iconClass" aria-hidden="true"></i>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                <div class="col-xl-9 col-12 col-md-8">
                    <div class="footer_header d-flex justify-content-between">
                        <div class="footer_header_left">
                            @if (!string.IsNullOrWhiteSpace(ctaTitle))
                            {
                                <h3 data-aos="fade-up" data-aos-duration="2000">@ctaTitle</h3>
                            }
                            @if (!string.IsNullOrWhiteSpace(ctaText))
                            {
                                <p data-aos="fade-up" data-aos-duration="3000">@ctaText</p>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ctaButtonLabel) && !string.IsNullOrWhiteSpace(ctaButtonLink))
                        {
                            <div class="footer_btn" data-aos="fade-up" data-aos-duration="3000">
                                <a href="@ctaButtonLink" class="boxed-btn2" target="@(ctaButton?.Target)">@ctaButtonLabel</a>
                            </div>
                        }
                    </div>
                    <div class="row">
                        <div class="col-xl-8 col-12 col-md-12">
                            <div class="row">
                                <div class="col-xl-4 col-12 col-md-4">
                                    <div class="footer_widget">
                                        <h3 class="footer_heading" data-aos="fade-up" data-aos-duration="2000">Navigation</h3>
                                        <ul class="quick_links" data-aos="fade-up" data-aos-duration="3000">
                                            @if (navigationLinks.Any())
                                            {
                                                @foreach (var link in navigationLinks)
                                                {
                                                    <li><a href="@link.Url" target="@link.Target">@(link.Name ?? link.Url)</a></li>
                                                }
                                            }
                                            else
                                            {
                                                var aboutUrl = SiteInfo.GetAboutPage()?.Url() ?? "/aboutus";
                                                <li><a href="@homeUrl">Home</a></li>
                                                <li><a href="@aboutUrl">About</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-12 col-md-4">
                                    <div class="footer_widget">
                                        <h3 class="footer_heading" data-aos="fade-up" data-aos-duration="2000">Services</h3>
                                        <ul class="quick_links" data-aos="fade-up" data-aos-duration="3000">
                                            @if (servicesLinks.Any())
                                            {
                                                @foreach (var link in servicesLinks)
                                                {
                                                    <li><a href="@link.Url" target="@link.Target">@(link.Name ?? link.Url)</a></li>
                                                }
                                            }
                                            else
                                            {
                                                foreach (var solution in SiteInfo.GetSolutionPages())
                                                {
                                                    <li><a href="@solution.Url()">@solution.Name</a></li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-12 col-md-4">
                                    <div class="footer_widget">
                                        <h3 class="footer_heading" data-aos="fade-up" data-aos-duration="2000">How To Reach Us</h3>
                                        <ul class="quick_links" data-aos="fade-up" data-aos-duration="3000">
                                            @if (!string.IsNullOrWhiteSpace(phone))
                                            {
                                                <li><a href="tel:@phone.Replace("-", "").Replace(" ", "")">@phone</a></li>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(email))
                                            {
                                                <li><a href="mailto:@email">@email</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(copyright))
    {
        <div class="footer_copy_right">
            <p>@copyright</p>
        </div>
    }
</footer>
}
