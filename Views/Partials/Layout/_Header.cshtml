@using Umbraco.Cms.Core.Models
@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteInfoService SiteInfo
@{
    var home = SiteInfo.GetHomePage() ?? Model.Root()?.DescendantsOrSelfOfType("homePage").FirstOrDefault() ?? Model;
    var homeUrl = home?.Url() ?? "/";
    var getInTouchUrl = SiteInfo.GetGetInTouchPage()?.Url() ?? "/contactus/";
    var site = SiteInfo.GetSiteMainInformation();
    var siteTitle = site?.Value<string>("siteTitle");
    var logoUrl = SiteInfo.GetMediaUrl(site?.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("siteLogo"));

    var headerCta = SiteInfo.GetFirstLink(site, "headerCta");
    var ctaLabel = site?.Value<string>("headerCtaLabel");
    if (string.IsNullOrWhiteSpace(ctaLabel))
    {
        ctaLabel = headerCta?.Name;
    }
    var ctaLink = headerCta?.Url;
    if (string.IsNullOrWhiteSpace(ctaLink))
    {
        ctaLink = getInTouchUrl;
    }
    if (string.IsNullOrWhiteSpace(ctaLabel))
    {
        ctaLabel = "Free Consultation";
    }

    string? RoutableUrl(Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent item)
    {
        try
        {
            var url = item.Url();
            return string.IsNullOrWhiteSpace(url) || url == "#" ? null : url;
        }
        catch (InvalidOperationException)
        {
            return null;
        }
        catch (ArgumentException)
        {
            return null;
        }
    }

    string NavTitle(Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent item)
    {
        var title = item.HasProperty("navbarTitle") ? item.Value<string>("navbarTitle") : null;
        return string.IsNullOrWhiteSpace(title) ? item.Name : title.Trim();
    }

    var navigationRoot = Model
        .AncestorsOrSelf()
        .FirstOrDefault(x => x.ContentType.Alias.Equals("contentTreeRoot", StringComparison.OrdinalIgnoreCase))
        ?? home?.AncestorsOrSelf()
            .FirstOrDefault(x => x.ContentType.Alias.Equals("contentTreeRoot", StringComparison.OrdinalIgnoreCase));

    // Contact is rendered as the header CTA and privacy remains in the footer.
    var excludedAliases = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "getInTouchPage",
        "privacyPolicyPage"
    };

    var navigationItems = navigationRoot?
        .Children()
        .Where(x => x.IsPublished() && !excludedAliases.Contains(x.ContentType.Alias))
        .OrderBy(x => x.SortOrder)
        .ToList()
        ?? [];
}
<header>
    <div class="header-area">
        <div id="sticky-header" class="main-header-area">
            <div class="container-fluid p-0">
                <div class="row align-items-center justify-content-between no-gutters">
                    <div class="col-xl-2 col-lg-2">
                        <div class="logo-img">
                            <a href="@homeUrl">
                                @if (!string.IsNullOrWhiteSpace(logoUrl))
                                {
                                    <img src="@logoUrl" alt="@(siteTitle ?? "Centro")">
                                }
                                else if (!string.IsNullOrWhiteSpace(siteTitle))
                                {
                                    <span>@siteTitle</span>
                                }
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-7 col-lg-7">
                        <div class="main-menu d-none d-lg-block">
                            <nav>
                                <ul id="navigation">
                                    @foreach (var navigationItem in navigationItems)
                                    {
                                        var itemUrl = RoutableUrl(navigationItem);
                                        var dropdownItems = navigationItem
                                            .Children()
                                            .Where(x => x.IsPublished())
                                            .OrderBy(x => x.SortOrder)
                                            .Select(x => new { Content = x, Url = RoutableUrl(x) })
                                            .Where(x => x.Url != null)
                                            .ToList();
                                        var hasTemplate = navigationItem.TemplateId > 0;
                                        var showDropdown = !hasTemplate && dropdownItems.Count > 0;
                                        var isActive = Model.AncestorsOrSelf().Any(x => x.Key == navigationItem.Key);
                                        var itemTitle = NavTitle(navigationItem);

                                        if ((hasTemplate && !string.IsNullOrWhiteSpace(itemUrl)) || showDropdown)
                                        {
                                            <li>
                                                @if (showDropdown)
                                                {
                                                    <a class="@(isActive ? "active" : null)" aria-haspopup="true">
                                                        @itemTitle
                                                        <i class="ti-angle-down"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="@(isActive ? "active" : null)" href="@itemUrl">@itemTitle</a>
                                                }
                                                @if (showDropdown)
                                                {
                                                    <ul class="submenu">
                                                        @foreach (var dropdownItem in dropdownItems)
                                                        {
                                                            <li><a href="@dropdownItem.Url">@NavTitle(dropdownItem.Content)</a></li>
                                                        }
                                                    </ul>
                                                }
                                            </li>
                                        }
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 d-none d-lg-block">
                        @if (!string.IsNullOrWhiteSpace(ctaLabel) && !string.IsNullOrWhiteSpace(ctaLink))
                        {
                            <div class="get_in_tauch">
                                <a href="@ctaLink" class="boxed-btn" target="@(headerCta?.Target)">@ctaLabel</a>
                            </div>
                        }
                    </div>
                    <div class="col-12">
                        <div class="mobile_menu d-block d-lg-none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
