@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteInfoService SiteInfo
@{
    var home = SiteInfo.GetHomePage() ?? Model.Root()?.DescendantsOrSelfOfType("homePage").FirstOrDefault() ?? Model;
    var homeUrl = home?.Url() ?? "/";
    var about = SiteInfo.GetAboutPage();
    var aboutUrl = about?.Url() ?? "/aboutus";
    var site = SiteInfo.GetSiteMainInformation();
    var siteTitle = site?.Value<string>("siteTitle");
    var logoUrl = SiteInfo.GetMediaUrl(site?.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("siteLogo"));
    var ctaLabel = site?.Value<string>("headerCtaLabel");
    var ctaLink = site?.Value<string>("headerCtaLink");
    var isAbout = Model.ContentType.Alias.Equals("aboutPage", StringComparison.OrdinalIgnoreCase);
    var isHome = Model.ContentType.Alias.Equals("homePage", StringComparison.OrdinalIgnoreCase);
}
<header>
    <div class="header-area">
        <div id="sticky-header" class="main-header-area">
            <div class="container-fluid p-0">
                <div class="row align-items-center justify-content-between no-gutters">
                    <div class="col-xl-2 col-lg-2">
                        <div class="logo-img">
                            <a href="@homeUrl">
                                @if (!string.IsNullOrWhiteSpace(logoUrl))
                                {
                                    <img src="@logoUrl" alt="@(siteTitle ?? "Centro")">
                                }
                                else if (!string.IsNullOrWhiteSpace(siteTitle))
                                {
                                    <span>@siteTitle</span>
                                }
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-7 col-lg-7">
                        <div class="main-menu d-none d-lg-block">
                            <nav>
                                <ul id="navigation">
                                    <li><a class="@(isHome ? "active" : null)" href="@homeUrl">home</a></li>
                                    <li><a class="@(isAbout ? "active" : null)" href="@aboutUrl">About</a></li>
                                    <li>
                                        <a href="@(homeUrl.TrimEnd('/'))#solutions">solutions <i class="ti-angle-down"></i></a>
                                        <ul class="submenu">
                                            <li><a href="@(homeUrl.TrimEnd('/'))#solutions">Business outsourcing</a></li>
                                            <li><a href="@(homeUrl.TrimEnd('/'))#solutions">Healthcare solutions</a></li>
                                            <li><a href="@(homeUrl.TrimEnd('/'))#solutions">Digital Transformation</a></li>
                                        </ul>
                                    </li>
                                    <li><a href="@(homeUrl.TrimEnd('/'))#contact">careers</a></li>
                                    <li><a href="@(homeUrl.TrimEnd('/'))#contact">Blog</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 d-none d-lg-block">
                        @if (!string.IsNullOrWhiteSpace(ctaLabel) && !string.IsNullOrWhiteSpace(ctaLink))
                        {
                            <div class="get_in_tauch">
                                <a href="@ctaLink" class="boxed-btn">@ctaLabel</a>
                            </div>
                        }
                    </div>
                    <div class="col-12">
                        <div class="mobile_menu d-block d-lg-none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
