@using Umbraco.Cms.Core.Models.Blocks
@model BlockListItem
@{
	var data = Model.Content;
	var question = data.Value<string>("question");
	var answer = data.Value<string>("answer");
}
@if (!string.IsNullOrWhiteSpace(question))
{
	<details class="blog-faq-item">
		<summary>@question</summary>
		@if (!string.IsNullOrWhiteSpace(answer))
		{
			<div class="blog-faq-answer">
				@if (answer.Contains("<p>") || answer.Contains("<br"))
				{
					@Html.Raw(answer)
				}
				else
				{
					@foreach (var paragraph in answer.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
					{
						<p>@paragraph.Trim()</p>
					}
				}
			</div>
		}
	</details>
}
