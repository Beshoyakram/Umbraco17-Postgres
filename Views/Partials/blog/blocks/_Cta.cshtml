@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Centrocdx.Services
@inject ISiteInfoService SiteInfo
@model BlockListItem
@{
	var data = Model.Content;
	var eyebrow = data.Value<string>("eyebrow");
	var title = data.Value<string>("title");
	var text = data.Value<string>("text");
	var buttonLabel = data.Value<string>("buttonLabel");
	var link = SiteInfo.GetFirstLink(data, "buttonLink");
	var buttonUrl = link?.Url ?? (data.HasValue("buttonUrl") ? data.Value<string>("buttonUrl") : null);
	if (string.IsNullOrWhiteSpace(buttonUrl) || buttonUrl == "#")
	{
		buttonUrl = "https://centrocdx.com/get-in-touch/";
	}
	var hasHtml = !string.IsNullOrWhiteSpace(text) && (text.Contains("<div") || text.Contains("<p>") || text.Contains("<span"));
}
<aside class="blog-cta-block">
	@if (!string.IsNullOrWhiteSpace(eyebrow))
	{
		<span class="blog-cta-eyebrow">@eyebrow</span>
	}
	@if (!string.IsNullOrWhiteSpace(title))
	{
		<h2>@title</h2>
	}
	@if (!string.IsNullOrWhiteSpace(text))
	{
		@if (hasHtml)
		{
			@Html.Raw(text)
		}
		else
		{
			@foreach (var para in text.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
			{
				<p>@para.Trim()</p>
			}
		}
	}
	@if (!string.IsNullOrWhiteSpace(buttonLabel) && !string.IsNullOrWhiteSpace(buttonUrl))
	{
		<a class="blog-cta-btn" href="@buttonUrl">@buttonLabel</a>
	}
</aside>
