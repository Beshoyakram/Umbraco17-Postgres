@using Umbraco.Cms.Core.Models.Blocks
@using Centrocdx.Services
@model BlockListItem
@{
	var data = Model.Content;
	var caption = data.Value<string>("caption");
	var tableHtml = BlogRichTextHelper.Render(data, "tableHtml");
}
@if (!string.IsNullOrWhiteSpace(tableHtml.ToString()))
{
	<div class="blog-table-block">
		@if (!string.IsNullOrWhiteSpace(caption))
		{
			<h4 class="blog-table-caption">@caption</h4>
		}
		<div class="blog-table-scroll">
			@tableHtml
		</div>
	</div>
}
