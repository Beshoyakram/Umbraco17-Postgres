@using Umbraco.Cms.Core.Models.Blocks
@model BlockListItem
@{
	var data = Model.Content;
	var heading = data.Value<string>("heading");
	if (string.IsNullOrWhiteSpace(heading)) heading = "Contact Center Staffing Calculator: Build Your First Staffing Range.";
	var subheading = data.Value<string>("subheading");
	if (string.IsNullOrWhiteSpace(subheading)) subheading = "Adjust the inputs to reflect a typical month. The calculator converts your workload and coverage assumptions into an estimated staffing range instantly.";
	var consultationUrl = data.Value<string>("consultationUrl");
	if (string.IsNullOrWhiteSpace(consultationUrl)) consultationUrl = "https://centrocdx.com/get-in-touch/";
}
<section class="blog-calculator-block csp-calculator-section" id="seat-calculator">
	<p class="csp-kicker">Interactive staffing tool</p>
	<h2 class="csp-heading">@heading</h2>
	<p class="csp-lede">@subheading</p>

	<div class="csp-calculator" id="centro-seat-planner">
		<form class="csp-controls" aria-label="Contact center staffing calculator" onsubmit="return false;">
			<div class="csp-control">
				<div class="csp-label-row">
					<label for="csp-contacts">Monthly customer interactions</label>
					<output class="csp-live-value" id="csp-contacts-value" for="csp-contacts">25,000</output>
				</div>
				<input id="csp-contacts" type="range" min="1000" max="250000" step="1000" value="25000" aria-describedby="csp-contacts-scale" />
				<div class="csp-range-scale" id="csp-contacts-scale"><span>1,000</span><span>250,000</span></div>
			</div>

			<div class="csp-control">
				<div class="csp-label-row">
					<label for="csp-aht">Average handling time</label>
					<output class="csp-live-value" id="csp-aht-value" for="csp-aht">8 minutes</output>
				</div>
				<input id="csp-aht" type="range" min="3" max="20" step="1" value="8" aria-describedby="csp-aht-scale" />
				<div class="csp-range-scale" id="csp-aht-scale"><span>3 min</span><span>20 min</span></div>
			</div>

			<div class="csp-control csp-fields-row">
				<div class="csp-field">
					<label for="csp-hours">Coverage hours per day</label>
					<select id="csp-hours">
						<option value="8">8 hours</option>
						<option value="12">12 hours</option>
						<option value="16" selected>16 hours</option>
						<option value="24">24 hours</option>
					</select>
				</div>
				<div class="csp-field">
					<label for="csp-days">Coverage days per week</label>
					<select id="csp-days">
						<option value="5">5 days</option>
						<option value="6">6 days</option>
						<option value="7" selected>7 days</option>
					</select>
				</div>
			</div>

			<fieldset class="csp-control" style="padding:0;border:0;min-width:0;">
				<legend class="csp-control-label">Demand pattern</legend>
				<div class="csp-segments">
					<label class="csp-segment"><input type="radio" name="csp-demand" value="steady" /><span>Mostly steady</span></label>
					<label class="csp-segment"><input type="radio" name="csp-demand" value="variable" checked /><span>Some peaks</span></label>
					<label class="csp-segment"><input type="radio" name="csp-demand" value="high" /><span>Sharp peaks</span></label>
				</div>
			</fieldset>

			<fieldset class="csp-control" style="padding:0;border:0;min-width:0;">
				<legend class="csp-control-label">Response expectation</legend>
				<div class="csp-segments">
					<label class="csp-segment"><input type="radio" name="csp-service" value="standard" checked /><span>Standard</span></label>
					<label class="csp-segment"><input type="radio" name="csp-service" value="responsive" /><span>Responsive</span></label>
					<label class="csp-segment"><input type="radio" name="csp-service" value="priority" /><span>Priority</span></label>
				</div>
			</fieldset>

			<div class="csp-control csp-fields-row">
				<div class="csp-field">
					<label for="csp-occupancy">Target occupancy</label>
					<select id="csp-occupancy">
						<option value="0.75">75%</option>
						<option value="0.80">80%</option>
						<option value="0.85" selected>85%</option>
						<option value="0.90">90%</option>
					</select>
				</div>
				<div class="csp-field">
					<label for="csp-shrinkage">Planned shrinkage</label>
					<select id="csp-shrinkage">
						<option value="0.20">20%</option>
						<option value="0.25">25%</option>
						<option value="0.30" selected>30%</option>
						<option value="0.35">35%</option>
					</select>
				</div>
			</div>
		</form>

		<aside class="csp-result" aria-live="polite" aria-atomic="true">
			<p class="csp-result-label">Estimated dedicated capacity</p>
			<p class="csp-result-number"><span id="csp-seat-low">37</span>–<span id="csp-seat-high">42</span></p>
			<p class="csp-result-unit">full-time-equivalent seats</p>

			<div class="csp-seat-bar" aria-hidden="true">
				<div class="csp-seat-track"><div class="csp-seat-fill" id="csp-seat-fill"></div></div>
				<div class="csp-seat-scale"><span>1</span><span id="csp-scale-quarter">13</span><span id="csp-scale-half">25</span><span id="csp-scale-max">50</span></div>
			</div>

			<div class="csp-result-stats">
				<div class="csp-result-stat"><span>Monthly workload</span><strong id="csp-workload">3,333 hours</strong></div>
				<div class="csp-result-stat"><span>Coverage model</span><strong id="csp-coverage">16h × 7 days</strong></div>
				<div class="csp-result-stat"><span>Estimate driver</span><strong id="csp-driver">Workload capacity</strong></div>
				<div class="csp-result-stat"><span>Planning band</span><strong id="csp-band">Scaled program</strong></div>
			</div>

			<p class="csp-result-note">Directional estimate only. A final staffing plan should use interval-level demand, channel mix, concurrency, service-level targets, schedule design and historical arrival patterns.</p>
		</aside>
	</div>

	<div class="csp-bridge-card mt-4">
		<div class="csp-bridge-fields">
			<div class="csp-field">
				<label for="csp-need">Primary support need</label>
				<select id="csp-need">
					<option value="Customer service">Customer service</option>
					<option value="Technical support">Technical support</option>
					<option value="Sales and lead response">Sales and lead response</option>
					<option value="Back-office support">Back-office support</option>
					<option value="Overflow or peak coverage">Overflow or peak coverage</option>
					<option value="Multilingual support">Multilingual support</option>
				</select>
			</div>
			<div class="csp-field">
				<label for="csp-launch">Preferred launch window</label>
				<select id="csp-launch">
					<option value="Exploring options">Exploring options</option>
					<option value="Within 3 months">Within 3 months</option>
					<option value="Within 1–2 months">Within 1–2 months</option>
					<option value="As soon as possible">As soon as possible</option>
				</select>
			</div>
		</div>

		<div class="csp-brief">
			<p class="csp-brief-label">Your consultation brief</p>
			<p id="csp-brief-text">We are planning for approximately 37–42 dedicated seats for customer service, based on 25,000 monthly interactions, an 8-minute average handling time and 16-hour coverage across 7 days. We are currently exploring options.</p>
			<div class="csp-brief-actions">
				<a class="csp-button csp-button--light" id="csp-consult-link" href="@consultationUrl" target="_blank" rel="noopener">Discuss this plan</a>
				<button class="csp-copy-button" id="csp-copy-brief" type="button">Copy brief</button>
			</div>
		</div>
	</div>
	<div class="csp-toast" id="csp-toast" role="status" aria-live="polite">Planning brief copied.</div>
</section>
