@using System.Globalization
@using System.Text.Json
@using Umbraco.Cms.Core.Models.PublishedContent
@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteInfoService SiteInfo
@{
    Layout = null;

    var culture = CultureInfo.CurrentCulture.Name;
    var direction = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase) ? "rtl" : "ltr";
    var langAttr = culture.Length >= 2 ? culture[..2] : "en";

    var siteMain = SiteInfo.GetSiteMainInformation();
    var siteName = siteMain?.Value<string>("siteTitle") ?? string.Empty;
    var pageName = Model.Name ?? siteName;
    var favIconUrl = SiteInfo.GetMediaUrl(siteMain?.Value<IPublishedContent>("favIcon"));

    var pageTitle = FirstNonEmpty(
        Model.Value<string>("sEOTitle"),
        Model.Value<string>("title"),
        Model.Value<string>("bannerTitle"),
        pageName);

    var seoTitle = pageTitle.Contains(siteName ?? string.Empty, StringComparison.OrdinalIgnoreCase)
        ? pageTitle
        : string.IsNullOrWhiteSpace(siteName) ? pageTitle : $"{pageTitle} | {siteName}";

    var seoDescription = FirstNonEmpty(
        Model.Value<string>("sEODescription"),
        Model.Value<string>("brief"),
        Model.Value<string>("sectionDescription"),
        string.Empty);

    var seoKeywords = FirstNonEmpty(
        Model.Value<string>("sEOKeywords"),
        Model.Value<string>("keyWords"),
        string.Empty);

    var canonicalUrl = Model.Url(mode: UrlMode.Absolute);
    if (string.IsNullOrWhiteSpace(canonicalUrl))
    {
        var request = Context.Request;
        canonicalUrl = $"{request.Scheme}://{request.Host}{request.Path}";
    }

    var ogImage = ResolveImageUrl("ogImage")
        ?? ResolveImageUrl("mainImage")
        ?? ResolveImageUrl("coverImage")
        ?? SiteInfo.GetMediaUrl(siteMain?.Value<IPublishedContent>("siteLogo"));

    var jsonLd = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = Model.ContentType.Alias.Equals("homePage", StringComparison.OrdinalIgnoreCase)
            ? "WebSite"
            : "WebPage",
        ["name"] = seoTitle,
        ["description"] = seoDescription,
        ["url"] = canonicalUrl,
        ["inLanguage"] = culture,
        ["isPartOf"] = new Dictionary<string, object?>
        {
            ["@type"] = "WebSite",
            ["name"] = siteName,
            ["url"] = $"{Context.Request.Scheme}://{Context.Request.Host}/"
        }
    });

    var theme = Url.Content("~/theme/centrotheme");
}

@functions {
    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private string? ResolveImageUrl(string alias)
    {
        if (!Model.HasProperty(alias) || !Model.HasValue(alias))
        {
            return null;
        }

        var media = Model.Value<IPublishedContent>(alias);
        if (media == null)
        {
            return null;
        }

        var url = media.Url(mode: UrlMode.Absolute);
        return string.IsNullOrWhiteSpace(url) ? null : url;
    }
}
<!DOCTYPE html>
<html lang="@langAttr" dir="@direction" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@seoTitle</title>

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="description" content="@seoDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(seoKeywords))
    {
        <meta name="keywords" content="@seoKeywords" />
    }
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:site_name" content="@(string.IsNullOrWhiteSpace(siteName) ? seoTitle : siteName)" />
    <meta property="og:title" content="@seoTitle" />
    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta property="og:description" content="@seoDescription" />
    }
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="website" />
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }
    <meta property="og:locale" content="@culture.Replace('-', '_')" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="twitter:description" content="@seoDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta name="twitter:image" content="@ogImage" />
    }

    @if (!string.IsNullOrWhiteSpace(favIconUrl))
    {
        <link rel="shortcut icon" type="image/x-icon" href="@favIconUrl" />
    }

    <link rel="stylesheet" href="@theme/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@theme/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="@theme/css/magnific-popup.css" />
    <link rel="stylesheet" href="@theme/css/font-awesome.min.css" />
    <link rel="stylesheet" href="@theme/css/themify-icons.css" />
    <link rel="stylesheet" href="@theme/css/nice-select.css" />
    <link rel="stylesheet" href="@theme/css/flaticon.css" />
    <link rel="stylesheet" href="@theme/css/animate.css" />
    <link rel="stylesheet" href="@theme/css/slicknav.css" />
    <link rel="stylesheet" href="@theme/css/style.css" asp-append-version="true" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    @RenderSection("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <partial name="~/Views/Partials/Layout/_Header.cshtml" />

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <partial name="~/Views/Partials/Layout/_Footer.cshtml" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="@theme/js/popper.min.js"></script>
    <script src="@theme/js/bootstrap.min.js"></script>
    <script src="@theme/js/owl.carousel.min.js"></script>
    <script src="@theme/js/jquery.slicknav.min.js"></script>
    <script src="@theme/js/jquery.scrollUp.min.js"></script>
    <script src="@theme/js/waypoints.min.js"></script>
    <script src="@theme/js/jquery.counterup.min.js"></script>
    <script src="@theme/js/wow.min.js"></script>
    <script src="@theme/js/main.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ once: true, duration: 800 });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
