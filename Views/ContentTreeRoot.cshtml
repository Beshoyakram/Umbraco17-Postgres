@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ContentTreeRoot>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@{
	Layout = null;

	var home = Model.Children()
		.FirstOrDefault(x => x.ContentType.Alias == HomePage.ModelTypeAlias)
		?? Model.DescendantsOrSelfOfType(HomePage.ModelTypeAlias).FirstOrDefault();

	var targetUrl = home?.Url();
	if (string.IsNullOrWhiteSpace(targetUrl) || targetUrl == "#")
	{
		targetUrl = "/home";
	}

	Context.Response.Redirect(targetUrl, permanent: false);
}
