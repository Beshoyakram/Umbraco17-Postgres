@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Web.Common.PublishedModels
@using Centrocdx.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inject ISiteInfoService SiteInfo
@{
	Layout = "Layout.cshtml";

	string? MediaUrl(string alias)
	{
		if (!Model.HasProperty(alias) || !Model.HasValue(alias)) return null;
		try
		{
			return SiteInfo.GetMediaUrl(Model.Value<IPublishedContent>(alias));
		}
		catch (Exception)
		{
			// Bad media path / HybridCache issue — don't take down the page
			return null;
		}
	}

	string? Text(string alias)
		=> Model.HasValue(alias) ? Model.Value<string>(alias) : null;

	var heroTitle = Text("heroTitle");
	var heroLead = Text("heroLead");
	var heroSubtext = Text("heroSubtext");
	var heroCtaLabel = Text("heroCtaLabel");
	var heroCtaLink = Text("heroCtaLink");
	var heroVideoUrl = MediaUrl("heroVideo");
	var heroFallbackUrl = MediaUrl("heroFallbackImage");

	var aboutTitle = Text("aboutTitle");
	var aboutText = Text("aboutText");
	var aboutImageUrl = MediaUrl("aboutImage");
	var aboutCtaLabel = Text("aboutCtaLabel");
	var aboutCtaLink = Text("aboutCtaLink");

	var stats = Model.HasValue("stats") ? Model.Value<BlockListModel>("stats") : null;
	var aiTitle = Text("aiTitle");
	var aiText = Text("aiText");
	var aiBackgroundUrl = MediaUrl("aiBackground");

	var partnersEyebrow = Text("partnersEyebrow");
	var partnersTitle = Text("partnersTitle");
	var partnerLogos = Model.HasValue("partnerLogos")
		? Model.Value<IEnumerable<IPublishedContent>>("partnerLogos")?.Where(x => x != null).ToList()
		: null;

	var solutionsEyebrow = Text("solutionsEyebrow");
	var solutionsTitle = Text("solutionsTitle");
	var solutions = Model.HasValue("solutions") ? Model.Value<BlockListModel>("solutions") : null;

	var testimonialsBackgroundUrl = MediaUrl("testimonialsBackground");
	var testimonials = Model.HasValue("testimonials") ? Model.Value<BlockListModel>("testimonials") : null;

	var contactEyebrow = Text("contactEyebrow");
	var contactTitle = Text("contactTitle");
	var contactImageUrl = MediaUrl("contactImage");
	var contactNote = Text("contactNote");

	var showHero = !string.IsNullOrWhiteSpace(heroTitle) || !string.IsNullOrWhiteSpace(heroVideoUrl) || !string.IsNullOrWhiteSpace(heroFallbackUrl);
	var showAbout = !string.IsNullOrWhiteSpace(aboutTitle) || !string.IsNullOrWhiteSpace(aboutText) || !string.IsNullOrWhiteSpace(aboutImageUrl);
	var showStats = stats != null && stats.Any();
	var showAi = !string.IsNullOrWhiteSpace(aiTitle) || !string.IsNullOrWhiteSpace(aiBackgroundUrl);
	var showPartners = (partnerLogos != null && partnerLogos.Any()) || !string.IsNullOrWhiteSpace(partnersTitle);
	var showSolutions = solutions != null && solutions.Any();
	var showTestimonials = testimonials != null && testimonials.Any();
	var showContact = !string.IsNullOrWhiteSpace(contactTitle) || !string.IsNullOrWhiteSpace(contactImageUrl);
}

@section Head {
	<link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

@if (showHero)
{
	<div class="slider_area">
		@if (!string.IsNullOrWhiteSpace(heroFallbackUrl))
		{
			<div class="fallbackImage d-block d-lg-none" style="--hero-fallback-bg: url('@heroFallbackUrl');"></div>
		}
		@if (!string.IsNullOrWhiteSpace(heroVideoUrl))
		{
			<video autoplay muted loop id="myVideo" class="d-none d-lg-block" playsinline poster="@(heroFallbackUrl ?? "")">
				<source src="@heroVideoUrl" type="video/mp4">
			</video>
		}
		<div class="content" data-aos="fade-up" data-aos-delay="100">
			<div class="container-fluid">
				@if (!string.IsNullOrWhiteSpace(heroTitle))
				{
					<h2 data-aos="fade-up" data-aos-duration="1000">@Html.Raw(heroTitle.Replace("\r\n", "<br>").Replace("\n", "<br>"))</h2>
				}
				@if (!string.IsNullOrWhiteSpace(heroLead) || !string.IsNullOrWhiteSpace(heroSubtext))
				{
					<p data-aos="fade-up" data-aos-duration="2000">
						@if (!string.IsNullOrWhiteSpace(heroLead))
						{
							<span class="hero-lead">@heroLead</span>
							<br>
						}
						@if (!string.IsNullOrWhiteSpace(heroSubtext))
						{
							@Html.Raw(heroSubtext.Replace("\r\n", "<br>").Replace("\n", "<br>"))
						}
					</p>
				}
				@if (!string.IsNullOrWhiteSpace(heroCtaLabel) && !string.IsNullOrWhiteSpace(heroCtaLink))
				{
					<a data-aos="fade-up" data-aos-duration="3000" href="@heroCtaLink" class="boxed-btn mt-4">@heroCtaLabel</a>
				}
			</div>
		</div>
	</div>
}

@if (showAbout)
{
	<div id="about" class="about_area">
		<div class="container">
			<div class="row align-items-center">
				@if (!string.IsNullOrWhiteSpace(aboutImageUrl))
				{
					<div class="col-xl-6 col-md-6">
						<div data-aos="fade-up" data-aos-duration="2000" class="about_thumb">
							<img src="@aboutImageUrl" alt="@(aboutTitle ?? "About")">
						</div>
					</div>
				}
				<div class="col-xl-5 offset-xl-1 col-md-6 bottom-left">
					<div class="about_info">
						<div class="section_title">
							@if (!string.IsNullOrWhiteSpace(aboutTitle))
							{
								<h3 data-aos="fade-up" data-aos-duration="800">@aboutTitle</h3>
								<div data-aos="fade-up" data-aos-duration="800" class="seperator"></div>
							}
						</div>
						@if (!string.IsNullOrWhiteSpace(aboutText))
						{
							<p data-aos="fade-up" data-aos-duration="1200">@aboutText</p>
						}
						@if (!string.IsNullOrWhiteSpace(aboutCtaLabel) && !string.IsNullOrWhiteSpace(aboutCtaLink))
						{
							<a data-aos="fade-up" data-aos-duration="2000" href="@aboutCtaLink" class="boxed-btn mt-30">@aboutCtaLabel</a>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

@if (showStats)
{
	<section data-aos="fade-up" data-aos-duration="2000" class="counters">
		<div class="container">
			<div class="row">
				@foreach (var item in stats!)
				{
					var content = item.Content;
					<div class="col-lg-3 text-center">
						<h1>@(content.Value<string>("value"))</h1>
						<h3>@(content.Value<string>("label"))</h3>
					</div>
				}
			</div>
		</div>
	</section>
}

@if (showAi)
{
	<div class="Ai" style="@(string.IsNullOrWhiteSpace(aiBackgroundUrl) ? null : $"--ai-section-bg: url('{aiBackgroundUrl}');")">
		<div class="container-fluid">
			<div class="row">
				<div class="col-xl-12">
					<div class="cont text-center">
						@if (!string.IsNullOrWhiteSpace(aiTitle))
						{
							<h3 data-aos="fade-up" data-aos-duration="2000" class="mb-4">@aiTitle</h3>
						}
						@if (!string.IsNullOrWhiteSpace(aiText))
						{
							<p data-aos="fade-up" data-aos-duration="2000">@aiText</p>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

@if (showPartners)
{
	<div class="logo-slid">
		<div class="container">
			<div class="row">
				<div class="col-xl-12">
					<div class="section_title mb-60">
						@if (!string.IsNullOrWhiteSpace(partnersEyebrow))
						{
							<span data-aos="fade-up" data-aos-duration="1000" class="sub_heading">@partnersEyebrow</span>
						}
						@if (!string.IsNullOrWhiteSpace(partnersTitle))
						{
							<h3 data-aos="fade-up" data-aos-duration="2000">@partnersTitle</h3>
							<div data-aos="fade-up" data-aos-duration="2000" class="seperator"></div>
						}
					</div>
				</div>
			</div>
			@if (partnerLogos != null && partnerLogos.Any())
			{
				<div data-aos="fade-up" data-aos-duration="2000" class="slider">
					<div class="slide-track">
						@for (var loop = 0; loop < 2; loop++)
						{
							foreach (var logo in partnerLogos)
							{
								var url = SiteInfo.GetMediaUrl(logo);
								if (string.IsNullOrWhiteSpace(url)) { continue; }
								<div class="slide"><img src="@url" alt="@(logo.Name)"></div>
							}
						}
					</div>
				</div>
			}
		</div>
	</div>
}

@if (showSolutions)
{
	<div id="solutions" class="lastest_project">
		<div class="container">
			<div class="row">
				<div class="col-xl-12">
					<div class="section_title mb-60">
						@if (!string.IsNullOrWhiteSpace(solutionsEyebrow))
						{
							<span data-aos="fade-up" data-aos-duration="1000" class="sub_heading">@solutionsEyebrow</span>
						}
						@if (!string.IsNullOrWhiteSpace(solutionsTitle))
						{
							<h3 data-aos="fade-up" data-aos-duration="2000">@solutionsTitle</h3>
							<div data-aos="fade-up" data-aos-duration="2000" class="seperator"></div>
						}
					</div>
				</div>
			</div>

			@{
				var i = 0;
			}
			@foreach (var item in solutions!)
			{
				var content = item.Content;
				var image = SiteInfo.GetMediaUrl(content.Value<IPublishedContent>("image"));
				var reverse = i % 2 == 1;
				var title = content.Value<string>("title");
				var text = content.Value<string>("text");
				var index = content.Value<string>("index");
				var link = content.Value<string>("linkUrl");
				var linkLabel = content.Value<string>("linkLabel");
				<div class="row align-items-center mb-80">
					@if (reverse)
					{
						@if (!string.IsNullOrWhiteSpace(image))
						{
							<div class="col-xl-6 col-md-6">
								<div data-aos="fade-up" data-aos-duration="3000" class="single_project_thumb">
									<img src="@image" alt="@(title ?? "")">
								</div>
							</div>
						}
						<div class="col-xl-5 offset-xl-1 col-md-6">
							<div class="section_title">
								@if (!string.IsNullOrWhiteSpace(index))
								{
									<span data-aos="fade-up" data-aos-duration="1000" class="sub_heading2">@index</span>
								}
								@if (!string.IsNullOrWhiteSpace(title))
								{
									<h4 data-aos="fade-up" data-aos-duration="2000">@title</h4>
								}
								@if (!string.IsNullOrWhiteSpace(text))
								{
									<p data-aos="fade-up" data-aos-duration="3000">@text</p>
								}
								@if (!string.IsNullOrWhiteSpace(linkLabel) && !string.IsNullOrWhiteSpace(link))
								{
									<a data-aos="fade-up" data-aos-duration="3000" href="@link" class="boxed-btn">@linkLabel</a>
								}
							</div>
						</div>
					}
					else
					{
						<div class="col-xl-6 col-md-6">
							<div class="section_title">
								@if (!string.IsNullOrWhiteSpace(index))
								{
									<span data-aos="fade-up" data-aos-duration="1000" class="sub_heading2">@index</span>
								}
								@if (!string.IsNullOrWhiteSpace(title))
								{
									<h4 data-aos="fade-up" data-aos-duration="2000">@title</h4>
								}
								@if (!string.IsNullOrWhiteSpace(text))
								{
									<p data-aos="fade-up" data-aos-duration="3000">@text</p>
								}
								@if (!string.IsNullOrWhiteSpace(linkLabel) && !string.IsNullOrWhiteSpace(link))
								{
									<a data-aos="fade-up" data-aos-duration="3000" href="@link" class="boxed-btn">@linkLabel</a>
								}
							</div>
						</div>
						@if (!string.IsNullOrWhiteSpace(image))
						{
							<div class="col-xl-5 offset-xl-1 col-md-6">
								<div data-aos="fade-up" data-aos-duration="3000" class="single_project_thumb">
									<img src="@image" alt="@(title ?? "")">
								</div>
							</div>
						}
					}
				</div>
				i++;
			}
		</div>
	</div>
}

@if (showTestimonials)
{
	<div class="testmonial_area testimonial_bg overlay2" style="@(string.IsNullOrWhiteSpace(testimonialsBackgroundUrl) ? null : $"--testimonials-bg: url('{testimonialsBackgroundUrl}');")">
		<div class="container-fluid">
			<div class="row">
				<div class="col-xl-12">
					<div class="testmonial_active owl-carousel">
						@foreach (var item in testimonials!)
						{
							var content = item.Content;
							var imageUrl = SiteInfo.GetMediaUrl(content.Value<IPublishedContent>("image"));
							var quote = content.Value<string>("quote");
							var authorName = content.Value<string>("authorName");
							var authorTitle = content.Value<string>("authorTitle");
							var authorRole = content.Value<string>("authorRole");
							<div class="single_testmonial">
								<div class="testmonial_info text-center">
									@if (!string.IsNullOrWhiteSpace(imageUrl))
									{
										<div class="author">
											<img src="@imageUrl" alt="@(authorName ?? "Testimonial")" />
										</div>
									}
									@if (!string.IsNullOrWhiteSpace(quote))
									{
										<p>“@quote”</p>
									}
									<div class="author_name">
										@if (!string.IsNullOrWhiteSpace(authorName))
										{
											<h4>@authorName</h4>
										}
										@if (!string.IsNullOrWhiteSpace(authorTitle))
										{
											<h5>@authorTitle</h5>
										}
										@if (!string.IsNullOrWhiteSpace(authorRole))
										{
											<span>@authorRole</span>
										}
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

@if (showContact)
{
	<div id="contact" class="messege_area">
		<div class="container">
			<div class="row align-items-center">
				@if (!string.IsNullOrWhiteSpace(contactImageUrl))
				{
					<div class="col-xl-6 col-md-6">
						<div class="messege_thumb">
							<img src="@contactImageUrl" alt="@(contactTitle ?? "Contact")">
						</div>
					</div>
				}
				<div class="col-xl-5 offset-xl-1 col-md-6">
					<div class="section_title mb-20">
						@if (!string.IsNullOrWhiteSpace(contactEyebrow))
						{
							<span class="sub_heading">@contactEyebrow</span>
						}
						@if (!string.IsNullOrWhiteSpace(contactTitle))
						{
							<h3>@contactTitle</h3>
							<div class="seperator"></div>
						}
					</div>

					<form class="messege" id="centro-contact-form" novalidate>
						@Html.AntiForgeryToken()
						<input type="hidden" name="formKey" value="home" />
						<input type="text" maxlength="255" name="name" id="contact-name" placeholder="Your Name" required autocomplete="name" />
						<input type="email" maxlength="255" name="email" id="contact-email" placeholder="Your Email" required autocomplete="email" />
						<input type="tel" maxlength="50" name="phone" id="contact-phone" placeholder="Phone Number" required autocomplete="tel" />
						<textarea name="message" id="contact-message" maxlength="2000" placeholder="Your Message" required></textarea>
						<button type="submit" id="contact-submit-btn" class="boxed-btn">SEND</button>
						<div id="form-response-message"></div>
					</form>
					@if (!string.IsNullOrWhiteSpace(contactNote))
					{
						<p class="mt-3">@contactNote</p>
					}
				</div>
			</div>
		</div>
	</div>
}

@section Scripts {
	<script src="~/js/pages/home.js" asp-append-version="true"></script>
}
