      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cj-wrap\">\n<section class=\"cj-hero\">\n\n\n    <div class=\"cj-hero-content\">\n\n\n        <div class=\"cj-eyebrow\">\n\n            <span class=\"cj-eyebrow-dot\"></span>\n\n            The Centro Story\n\n        </div>\n\n\n        <h1>\n\n            From Inception to a\n\n            <span>Global Outsourcing Leader.</span>\n\n        </h1>\n\n\n        <p class=\"cj-hero-lead\">\n\n            What began with a vision in Virginia in 2009 has grown into a\n            global outsourcing organization built around talent, operational\n            excellence, technology and long-term client partnerships.\n\n        </p>\n\n\n    </div>\n\n\n\n    \n\n    <div class=\"cj-world\" aria-hidden=\"true\">\n\n\n        <div class=\"cj-world-orbit cj-world-orbit-one\"></div>\n\n        <div class=\"cj-world-orbit cj-world-orbit-two\"></div>\n\n\n        <div class=\"cj-globe\">\n\n            <div class=\"cj-globe-longitude\"></div>\n\n        </div>\n\n\n        <span class=\"cj-world-node cj-node-us\">\n            USA\n        </span>\n\n\n        <span class=\"cj-world-node cj-node-egypt\">\n            Egypt\n        </span>\n\n\n        <span class=\"cj-world-node cj-node-ph\">\n            Philippines\n        </span>\n\n\n        <span class=\"cj-world-node cj-node-gulf\">\n            UAE &amp; KSA\n        </span>\n\n\n        <div class=\"cj-world-year\">\n\n            <span class=\"cj-world-year-dot\"></span>\n\n            Growing Since 2009\n\n        </div>\n\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
      "key": "1f434080-d1ac-4f21-be7e-0b268b5c416c",
      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cj-wrap\">\n<section class=\"cj-intro\">\n\n\n    <div class=\"cj-kicker\">\n\n        <span class=\"cj-kicker-line\"></span>\n\n        <span class=\"cj-kicker-text\">\n            Where It Started\n        </span>\n\n    </div>\n\n\n    <h2>\n\n        Built on the belief that outsourcing should create strategic value.\n\n    </h2>\n\n\n    <p>\n\n        Centro was founded in 2009 by Hesham Farag in Fairfax, Virginia,\n        with a vision that went beyond traditional cost-focused outsourcing.\n\n    </p>\n\n\n    <p>\n\n        The idea was to build operations that could strengthen customer\n        experiences, create access to global talent and help businesses\n        scale with greater flexibility.\n\n    </p>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
