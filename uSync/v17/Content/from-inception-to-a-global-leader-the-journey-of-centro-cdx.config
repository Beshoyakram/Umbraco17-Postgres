          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cj-wrap\">\n<section class=\"cj-era\">\n\n\n    <div class=\"cj-era-year\">\n\n        <strong>\n            2009\n        </strong>\n\n        <span>\n            The journey begins\n        </span>\n\n    </div>\n\n\n    <div class=\"cj-era-line\"></div>\n\n\n    <div class=\"cj-era-year\">\n\n        <strong>\n            2026\n        </strong>\n\n        <span>\n            Global delivery continues\n        </span>\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
