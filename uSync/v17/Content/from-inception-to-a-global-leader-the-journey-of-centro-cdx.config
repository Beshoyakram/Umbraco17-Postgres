                        <contentBlocks>
      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "f933f343-43d0-4daf-a929-c434e21bffb0",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!-- =========================================================\nCENTRO WORDPRESS BLOG\nFROM INCEPTION TO A GLOBAL LEADER:\nTHE JOURNEY OF CENTRO\n\nNo website header or footer.\nNo stock imagery.\nAll major graphics are coded in HTML/CSS.\nAll styles scoped to this article.\n========================================================= -->\n\n<style>\n\n/* =========================================================\n   DESIGN TOKENS\n========================================================= */\n\n#centro-journey {\n    --cj-navy: #063B5C;\n    --cj-deep: #032E47;\n    --cj-blue: #015376;\n    --cj-cyan: #00A9E0;\n    --cj-light-cyan: #78DFF6;\n    --cj-pale: #F2FAFC;\n    --cj-light: #DDF5FC;\n    --cj-white: #FFFFFF;\n    --cj-text: #315568;\n    --cj-border: rgba(1,83,118,.14);\n\n    width: 100%;\n    margin: 0;\n    padding: 0;\n\n    font-family: \"Poppins\", Arial, sans-serif !important;\n    color: var(--cj-text) !important;\n    line-height: 1.75;\n}\n\n\n/* =========================================================\n   HARD WORDPRESS RESET\n========================================================= */\n\n#centro-journey *,\n#centro-journey *::before,\n#centro-journey *::after {\n    box-sizing: border-box;\n}\n\n#centro-journey h1,\n#centro-journey h2,\n#centro-journey h3,\n#centro-journey h4,\n#centro-journey p,\n#centro-journey span,\n#centro-journey strong,\n#centro-journey div,\n#centro-journey a {\n    font-family: \"Poppins\", Arial, sans-serif !important;\n}\n\n#centro-journey h1,\n#centro-journey h2,\n#centro-journey h3,\n#centro-journey h4 {\n    margin-top: 0 !important;\n    color: var(--cj-navy) !important;\n    line-height: 1.18 !important;\n}\n\n#centro-journey p {\n    margin: 0 0 20px !important;\n\n    color: var(--cj-text) !important;\n\n    font-size: 16px !important;\n    line-height: 1.8 !important;\n}\n\n#centro-journey a {\n    text-decoration: none !important;\n}\n\n\n/* =========================================================\n   WRAPPERS\n========================================================= */\n\n#centro-journey .cj-wrap {\n    width: min(100%, 1120px);\n    margin: 0 auto;\n}\n\n#centro-journey .cj-content {\n    width: min(100%, 900px);\n    margin-left: auto;\n    margin-right: auto;\n}\n\n\n/* =========================================================\n   HERO\n========================================================= */\n\n#centro-journey .cj-hero {\n    position: relative;\n\n    display: grid;\n    grid-template-columns: 1.08fr .92fr;\n\n    gap: 52px;\n\n    align-items: center;\n\n    overflow: hidden;\n\n    padding: 62px 58px;\n\n    margin-bottom: 46px;\n\n    border-radius: 30px;\n\n    background:\n        radial-gradient(\n            circle at 91% 5%,\n            rgba(0,169,224,.27),\n            transparent 32%\n        ),\n        linear-gradient(\n            135deg,\n            #032E47 0%,\n            #063B5C 60%,\n            #015376 100%\n        );\n\n    box-shadow:\n        0 24px 70px rgba(6,59,92,.14);\n}\n\n\n#centro-journey .cj-hero::before {\n    content: \"\";\n\n    position: absolute;\n\n    width: 470px;\n    height: 470px;\n\n    right: -280px;\n    bottom: -310px;\n\n    border: 1px solid rgba(255,255,255,.11);\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-journey .cj-hero-content {\n    position: relative;\n    z-index: 5;\n}\n\n\n/* =========================================================\n   HERO EYEBROW\n========================================================= */\n\n#centro-journey .cj-eyebrow {\n    display: inline-flex;\n\n    align-items: center;\n\n    gap: 8px;\n\n    margin-bottom: 22px;\n\n    padding: 8px 14px;\n\n    border: 1px solid rgba(255,255,255,.18);\n\n    border-radius: 999px;\n\n    background: rgba(255,255,255,.06);\n\n    color: #FFFFFF !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .11em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-eyebrow-dot {\n    width: 7px;\n    height: 7px;\n\n    flex: 0 0 7px;\n\n    border-radius: 50%;\n\n    background: var(--cj-cyan);\n\n    box-shadow:\n        0 0 12px rgba(0,169,224,.75);\n}\n\n\n/* =========================================================\n   HERO TEXT\n========================================================= */\n\n#centro-journey .cj-hero h1 {\n    max-width: 670px;\n\n    margin-bottom: 22px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(37px,4.7vw,61px) !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: -.045em !important;\n}\n\n\n#centro-journey .cj-hero h1 span {\n    color: var(--cj-light-cyan) !important;\n}\n\n\n#centro-journey .cj-hero-lead {\n    max-width: 610px;\n\n    margin-bottom: 0 !important;\n\n    color: rgba(255,255,255,.79) !important;\n\n    font-size: 17px !important;\n\n    line-height: 1.72 !important;\n}\n\n\n/* =========================================================\n   CODED GLOBAL JOURNEY VISUAL\n========================================================= */\n\n#centro-journey .cj-world {\n    position: relative;\n\n    z-index: 4;\n\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    min-height: 410px;\n\n    overflow: hidden;\n\n    border: 1px solid rgba(255,255,255,.13);\n\n    border-radius: 28px;\n\n    background:\n        radial-gradient(\n            circle at center,\n            rgba(0,169,224,.15),\n            transparent 57%\n        ),\n        rgba(255,255,255,.025);\n}\n\n\n/* background grid */\n\n#centro-journey .cj-world::before {\n    content: \"\";\n\n    position: absolute;\n\n    inset: 0;\n\n    opacity: .13;\n\n    background-image:\n\n        linear-gradient(\n            rgba(255,255,255,.10) 1px,\n            transparent 1px\n        ),\n\n        linear-gradient(\n            90deg,\n            rgba(255,255,255,.10) 1px,\n            transparent 1px\n        );\n\n    background-size: 34px 34px;\n\n    -webkit-mask-image:\n        radial-gradient(circle, black 5%, transparent 72%);\n\n    mask-image:\n        radial-gradient(circle, black 5%, transparent 72%);\n\n    pointer-events: none;\n}\n\n\n/* =========================================================\n   GLOBE\n========================================================= */\n\n#centro-journey .cj-globe {\n    position: relative;\n\n    z-index: 4;\n\n    width: 225px;\n    height: 225px;\n\n    overflow: hidden;\n\n    border: 2px solid rgba(120,223,246,.75);\n\n    border-radius: 50%;\n\n    background:\n        radial-gradient(\n            circle at 40% 35%,\n            rgba(0,169,224,.20),\n            rgba(0,169,224,.06) 55%,\n            transparent 76%\n        );\n\n    box-shadow:\n        0 0 65px rgba(0,169,224,.18),\n        inset 0 0 38px rgba(0,169,224,.08);\n}\n\n\n/* horizontal globe lines */\n\n#centro-journey .cj-globe::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 5%;\n    right: 5%;\n\n    top: 50%;\n\n    height: 1px;\n\n    background: rgba(120,223,246,.38);\n\n    box-shadow:\n        0 -53px 0 rgba(120,223,246,.18),\n        0 53px 0 rgba(120,223,246,.18);\n}\n\n\n/* longitude */\n\n#centro-journey .cj-globe::after {\n    content: \"\";\n\n    position: absolute;\n\n    left: 50%;\n    top: -3%;\n\n    width: 90px;\n    height: 106%;\n\n    transform: translateX(-50%);\n\n    border-left: 1px solid rgba(120,223,246,.30);\n    border-right: 1px solid rgba(120,223,246,.30);\n\n    border-radius: 50%;\n}\n\n\n/* second longitude */\n\n#centro-journey .cj-globe-longitude {\n    position: absolute;\n\n    inset: -2% 27%;\n\n    border-left: 1px solid rgba(120,223,246,.18);\n    border-right: 1px solid rgba(120,223,246,.18);\n\n    border-radius: 50%;\n\n    transform: rotate(90deg);\n}\n\n\n/* =========================================================\n   LOCATION NODES\n========================================================= */\n\n#centro-journey .cj-world-node {\n    position: absolute;\n\n    z-index: 7;\n\n    display: flex;\n\n    align-items: center;\n\n    gap: 7px;\n\n    padding: 7px 10px;\n\n    border: 1px solid rgba(255,255,255,.14);\n\n    border-radius: 999px;\n\n    background: rgba(3,46,71,.84);\n\n    backdrop-filter: blur(6px);\n    -webkit-backdrop-filter: blur(6px);\n\n    color: rgba(255,255,255,.83) !important;\n\n    font-size: 9px !important;\n\n    font-weight: 600 !important;\n\n    letter-spacing: .05em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-world-node::before {\n    content: \"\";\n\n    width: 6px;\n    height: 6px;\n\n    flex: 0 0 6px;\n\n    border-radius: 50%;\n\n    background: var(--cj-light-cyan);\n\n    box-shadow:\n        0 0 10px rgba(120,223,246,.9);\n}\n\n\n#centro-journey .cj-node-us {\n    left: 20px;\n    top: 70px;\n}\n\n\n#centro-journey .cj-node-egypt {\n    left: 22px;\n    bottom: 67px;\n}\n\n\n#centro-journey .cj-node-ph {\n    right: 18px;\n    top: 80px;\n}\n\n\n#centro-journey .cj-node-gulf {\n    right: 17px;\n    bottom: 70px;\n}\n\n\n/* =========================================================\n   ORBITS\n========================================================= */\n\n#centro-journey .cj-world-orbit {\n    position: absolute;\n\n    border: 1px solid rgba(120,223,246,.14);\n\n    border-radius: 50%;\n}\n\n\n#centro-journey .cj-world-orbit-one {\n    width: 320px;\n    height: 320px;\n\n    transform: rotate(21deg);\n}\n\n\n#centro-journey .cj-world-orbit-two {\n    width: 285px;\n    height: 145px;\n\n    transform: rotate(-25deg);\n}\n\n\n/* =========================================================\n   YEAR BADGE\n========================================================= */\n\n#centro-journey .cj-world-year {\n    position: absolute;\n\n    z-index: 8;\n\n    left: 50%;\n    bottom: 26px;\n\n    transform: translateX(-50%);\n\n    display: inline-flex;\n\n    align-items: center;\n\n    gap: 8px;\n\n    width: max-content;\n\n    padding: 8px 13px;\n\n    border: 1px solid rgba(255,255,255,.13);\n\n    border-radius: 999px;\n\n    background: rgba(3,46,71,.65);\n\n    color: rgba(255,255,255,.78) !important;\n\n    font-size: 10px !important;\n\n    font-weight: 600 !important;\n\n    letter-spacing: .08em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-world-year-dot {\n    width: 7px;\n    height: 7px;\n\n    border-radius: 50%;\n\n    background: var(--cj-light-cyan);\n\n    box-shadow:\n        0 0 11px rgba(120,223,246,.8);\n}\n\n\n/* =========================================================\n   MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: no-preference) {\n\n    #centro-journey .cj-globe {\n        animation:\n            cj-globe-float 5s ease-in-out infinite;\n    }\n\n    #centro-journey .cj-world-orbit-one {\n        animation:\n            cj-orbit-pulse 6s ease-in-out infinite;\n    }\n\n}\n\n\n@keyframes cj-globe-float {\n\n    0%,\n    100% {\n        transform: translateY(0);\n    }\n\n    50% {\n        transform: translateY(-8px);\n    }\n\n}\n\n\n@keyframes cj-orbit-pulse {\n\n    0%,\n    100% {\n        opacity: .45;\n    }\n\n    50% {\n        opacity: .9;\n    }\n\n}\n\n\n/* =========================================================\n   INTRO\n========================================================= */\n\n#centro-journey .cj-intro {\n    padding: 42px 0 18px;\n}\n\n\n#centro-journey .cj-kicker {\n    display: flex;\n\n    align-items: center;\n\n    gap: 12px;\n\n    margin-bottom: 21px;\n}\n\n\n#centro-journey .cj-kicker-line {\n    width: 42px;\n    height: 4px;\n\n    border-radius: 10px;\n\n    background: var(--cj-cyan);\n}\n\n\n#centro-journey .cj-kicker-text {\n    color: var(--cj-blue) !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .10em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-intro h2 {\n    max-width: 770px;\n\n    margin-bottom: 18px !important;\n\n    font-size: clamp(29px,3vw,40px) !important;\n\n    letter-spacing: -.03em !important;\n}\n\n\n/* =========================================================\n   2009 → 2026 STATEMENT\n========================================================= */\n\n#centro-journey .cj-era {\n    display: grid;\n\n    grid-template-columns: 1fr 90px 1fr;\n\n    align-items: center;\n\n    margin: 48px 0 70px;\n\n    padding: 40px 45px;\n\n    border: 1px solid var(--cj-border);\n\n    border-radius: 26px;\n\n    background:\n        linear-gradient(\n            135deg,\n            #F5FCFE,\n            #EAF8FC\n        );\n}\n\n\n#centro-journey .cj-era-year {\n    text-align: center;\n}\n\n\n#centro-journey .cj-era-year strong {\n    display: block;\n\n    color: var(--cj-blue) !important;\n\n    font-size: clamp(43px,5vw,66px) !important;\n\n    line-height: 1 !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-journey .cj-era-year span {\n    display: block;\n\n    margin-top: 8px;\n\n    color: var(--cj-navy) !important;\n\n    font-size: 12px !important;\n\n    font-weight: 600 !important;\n}\n\n\n#centro-journey .cj-era-line {\n    position: relative;\n\n    height: 2px;\n\n    background: var(--cj-cyan);\n}\n\n\n#centro-journey .cj-era-line::after {\n    content: \"\";\n\n    position: absolute;\n\n    right: -1px;\n    top: 50%;\n\n    width: 9px;\n    height: 9px;\n\n    border-top: 2px solid var(--cj-cyan);\n    border-right: 2px solid var(--cj-cyan);\n\n    transform:\n        translateY(-50%)\n        rotate(45deg);\n}\n\n\n/* =========================================================\n   TIMELINE INTRO\n========================================================= */\n\n#centro-journey .cj-timeline-heading {\n    margin: 72px 0 42px;\n}\n\n\n#centro-journey .cj-timeline-heading span {\n    display: block;\n\n    margin-bottom: 9px;\n\n    color: var(--cj-cyan) !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .11em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-timeline-heading h2 {\n    margin-bottom: 12px !important;\n\n    font-size: clamp(29px,3vw,40px) !important;\n}\n\n\n#centro-journey .cj-timeline-heading p {\n    max-width: 720px;\n}\n\n\n/* =========================================================\n   VERTICAL TIMELINE\n========================================================= */\n\n#centro-journey .cj-timeline {\n    position: relative;\n\n    margin: 45px 0 80px;\n\n    padding: 8px 0;\n}\n\n\n#centro-journey .cj-timeline::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 78px;\n\n    top: 5px;\n    bottom: 5px;\n\n    width: 2px;\n\n    background:\n        linear-gradient(\n            to bottom,\n            var(--cj-cyan),\n            rgba(0,169,224,.12)\n        );\n}\n\n\n/* =========================================================\n   TIMELINE ITEM\n========================================================= */\n\n#centro-journey .cj-milestone {\n    position: relative;\n\n    display: grid;\n\n    grid-template-columns: 158px 1fr;\n\n    gap: 31px;\n\n    min-height: 150px;\n\n    padding-bottom: 30px;\n}\n\n\n#centro-journey .cj-milestone:last-child {\n    padding-bottom: 0;\n}\n\n\n#centro-journey .cj-year {\n    position: relative;\n\n    z-index: 3;\n\n    display: flex;\n\n    align-items: flex-start;\n\n    justify-content: flex-start;\n\n    padding-top: 17px;\n}\n\n\n#centro-journey .cj-year strong {\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    min-width: 98px;\n\n    padding: 12px 17px;\n\n    border: 1px solid rgba(0,169,224,.20);\n\n    border-radius: 13px;\n\n    background: #FFFFFF;\n\n    color: var(--cj-blue) !important;\n\n    font-size: 18px !important;\n\n    font-weight: 700 !important;\n\n    box-shadow:\n        0 8px 24px rgba(6,59,92,.06);\n}\n\n\n#centro-journey .cj-year::after {\n    content: \"\";\n\n    position: absolute;\n\n    left: 72px;\n    top: 31px;\n\n    width: 14px;\n    height: 14px;\n\n    border: 3px solid #FFFFFF;\n\n    border-radius: 50%;\n\n    background: var(--cj-cyan);\n\n    box-shadow:\n        0 0 0 2px rgba(0,169,224,.20);\n}\n\n\n/* =========================================================\n   MILESTONE CONTENT\n========================================================= */\n\n#centro-journey .cj-milestone-content {\n    position: relative;\n\n    padding: 27px 30px;\n\n    border: 1px solid var(--cj-border);\n\n    border-radius: 21px;\n\n    background: #FFFFFF;\n\n    box-shadow:\n        0 8px 28px rgba(6,59,92,.045);\n}\n\n\n#centro-journey .cj-milestone-content::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 0;\n    top: 25px;\n\n    width: 4px;\n    height: 38px;\n\n    border-radius: 0 4px 4px 0;\n\n    background: var(--cj-cyan);\n}\n\n\n#centro-journey .cj-milestone-label {\n    display: block;\n\n    margin-bottom: 7px;\n\n    color: var(--cj-cyan) !important;\n\n    font-size: 10px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .1em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-milestone-content h3 {\n    margin-bottom: 10px !important;\n\n    font-size: 20px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-journey .cj-milestone-content p {\n    margin-bottom: 0 !important;\n\n    font-size: 14px !important;\n\n    line-height: 1.72 !important;\n}\n\n\n/* highlight latest milestone */\n\n#centro-journey .cj-milestone-latest .cj-milestone-content {\n    border-color: rgba(0,169,224,.24);\n\n    background:\n        linear-gradient(\n            135deg,\n            #F4FBFD,\n            #E7F7FB\n        );\n}\n\n\n#centro-journey .cj-milestone-latest .cj-year strong {\n    background: var(--cj-cyan);\n\n    color: #FFFFFF !important;\n\n    border-color: var(--cj-cyan);\n}\n\n\n/* =========================================================\n   EVOLUTION SECTION\n========================================================= */\n\n#centro-journey .cj-evolution {\n    position: relative;\n\n    overflow: hidden;\n\n    margin: 78px 0;\n\n    padding: 49px;\n\n    border-radius: 28px;\n\n    background:\n        radial-gradient(\n            circle at 92% 8%,\n            rgba(0,169,224,.23),\n            transparent 30%\n        ),\n        var(--cj-deep);\n}\n\n\n#centro-journey .cj-evolution-label {\n    display: block;\n\n    margin-bottom: 10px;\n\n    color: var(--cj-light-cyan) !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .11em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-evolution h2 {\n    max-width: 730px;\n\n    margin-bottom: 16px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(29px,3.5vw,42px) !important;\n}\n\n\n#centro-journey .cj-evolution > p {\n    max-width: 760px;\n\n    color: rgba(255,255,255,.78) !important;\n}\n\n\n/* evolution pillars */\n\n#centro-journey .cj-evolution-grid {\n    display: grid;\n\n    grid-template-columns: repeat(3,1fr);\n\n    gap: 14px;\n\n    margin-top: 30px;\n}\n\n\n#centro-journey .cj-evolution-card {\n    min-height: 190px;\n\n    padding: 25px;\n\n    border: 1px solid rgba(255,255,255,.12);\n\n    border-radius: 18px;\n\n    background: rgba(255,255,255,.055);\n}\n\n\n#centro-journey .cj-evolution-number {\n    display: inline-flex;\n\n    align-items: center;\n    justify-content: center;\n\n    width: 36px;\n    height: 36px;\n\n    margin-bottom: 20px;\n\n    border-radius: 10px;\n\n    background: var(--cj-cyan);\n\n    color: #FFFFFF !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-journey .cj-evolution-card h3 {\n    margin-bottom: 9px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: 17px !important;\n}\n\n\n#centro-journey .cj-evolution-card p {\n    margin-bottom: 0 !important;\n\n    color: rgba(255,255,255,.73) !important;\n\n    font-size: 13px !important;\n\n    line-height: 1.65 !important;\n}\n\n\n/* =========================================================\n   RECOGNITION\n========================================================= */\n\n#centro-journey .cj-recognition {\n    display: grid;\n\n    grid-template-columns: 200px 1fr;\n\n    overflow: hidden;\n\n    margin: 75px 0;\n\n    border-radius: 27px;\n\n    background: var(--cj-navy);\n\n    box-shadow:\n        0 18px 55px rgba(6,59,92,.11);\n}\n\n\n#centro-journey .cj-recognition-stat {\n    display: flex;\n\n    flex-direction: column;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 32px;\n\n    background: var(--cj-cyan);\n\n    text-align: center;\n}\n\n\n#centro-journey .cj-recognition-stat strong {\n    color: #FFFFFF !important;\n\n    font-size: 72px !important;\n\n    line-height: .95 !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-journey .cj-recognition-stat span {\n    margin-top: 11px;\n\n    color: #FFFFFF !important;\n\n    font-size: 10px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .10em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-recognition-copy {\n    display: flex;\n\n    flex-direction: column;\n\n    justify-content: center;\n\n    padding: 38px 42px;\n}\n\n\n#centro-journey .cj-recognition-copy > span {\n    display: block;\n\n    margin-bottom: 8px;\n\n    color: var(--cj-light-cyan) !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .1em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-recognition-copy h2 {\n    margin-bottom: 11px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(26px,3vw,36px) !important;\n}\n\n\n#centro-journey .cj-recognition-copy p {\n    margin-bottom: 0 !important;\n\n    color: rgba(255,255,255,.78) !important;\n}\n\n\n/* =========================================================\n   PURPOSE / FORWARD SECTION\n========================================================= */\n\n#centro-journey .cj-forward {\n    position: relative;\n\n    margin: 78px 0;\n\n    padding: 46px 48px 46px 55px;\n\n    border-radius: 5px 25px 25px 5px;\n\n    background: var(--cj-pale);\n}\n\n\n#centro-journey .cj-forward::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 0;\n    top: 0;\n    bottom: 0;\n\n    width: 6px;\n\n    border-radius: 6px;\n\n    background: var(--cj-cyan);\n}\n\n\n#centro-journey .cj-forward-label {\n    display: block;\n\n    margin-bottom: 10px;\n\n    color: var(--cj-blue) !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .1em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-forward h2 {\n    margin-bottom: 15px !important;\n\n    font-size: clamp(28px,3vw,38px) !important;\n}\n\n\n#centro-journey .cj-forward p:last-child {\n    margin-bottom: 0 !important;\n}\n\n\n/* =========================================================\n   CTA\n========================================================= */\n\n#centro-journey .cj-cta {\n    position: relative;\n\n    overflow: hidden;\n\n    margin-top: 70px;\n\n    padding: 58px 45px;\n\n    border-radius: 29px;\n\n    background:\n        radial-gradient(\n            circle at 90% 0%,\n            rgba(0,169,224,.24),\n            transparent 33%\n        ),\n        linear-gradient(\n            135deg,\n            #015376,\n            #063B5C\n        );\n\n    text-align: center;\n}\n\n\n#centro-journey .cj-cta::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: -160px;\n    top: -185px;\n\n    width: 300px;\n    height: 300px;\n\n    border: 1px solid rgba(255,255,255,.12);\n\n    border-radius: 50%;\n}\n\n\n#centro-journey .cj-cta-content {\n    position: relative;\n\n    z-index: 2;\n\n    max-width: 720px;\n\n    margin: auto;\n}\n\n\n#centro-journey .cj-cta-label {\n    display: block;\n\n    margin-bottom: 12px;\n\n    color: var(--cj-light-cyan) !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .1em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-journey .cj-cta h2 {\n    margin-bottom: 17px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(30px,4vw,44px) !important;\n}\n\n\n#centro-journey .cj-cta p {\n    max-width: 610px;\n\n    margin: 0 auto 28px !important;\n\n    color: rgba(255,255,255,.79) !important;\n}\n\n\n#centro-journey .cj-buttons {\n    display: flex;\n\n    flex-wrap: wrap;\n\n    justify-content: center;\n\n    gap: 12px;\n}\n\n\n#centro-journey .cj-btn {\n    display: inline-flex !important;\n\n    align-items: center;\n\n    justify-content: center;\n\n    min-height: 50px;\n\n    padding: 13px 23px !important;\n\n    border-radius: 11px !important;\n\n    font-size: 14px !important;\n\n    font-weight: 600 !important;\n\n    transition:\n        transform .2s ease;\n}\n\n\n#centro-journey .cj-btn:hover {\n    transform: translateY(-2px);\n}\n\n\n#centro-journey .cj-btn-primary {\n    background: var(--cj-cyan) !important;\n\n    color: #FFFFFF !important;\n}\n\n\n#centro-journey .cj-btn-secondary {\n    border: 1px solid rgba(255,255,255,.31) !important;\n\n    background: rgba(255,255,255,.07) !important;\n\n    color: #FFFFFF !important;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 900px) {\n\n    #centro-journey .cj-hero {\n        grid-template-columns: 1fr;\n\n        padding: 44px 32px;\n    }\n\n\n    #centro-journey .cj-world {\n        min-height: 370px;\n    }\n\n\n    #centro-journey .cj-evolution-grid {\n        grid-template-columns: 1fr;\n    }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 620px) {\n\n    #centro-journey .cj-hero {\n        gap: 31px;\n\n        padding: 36px 22px;\n\n        border-radius: 22px;\n    }\n\n\n    #centro-journey .cj-hero h1 {\n        font-size: 36px !important;\n    }\n\n\n    #centro-journey .cj-hero-lead {\n        font-size: 15px !important;\n    }\n\n\n    #centro-journey .cj-world {\n        min-height: 325px;\n\n        border-radius: 20px;\n    }\n\n\n    #centro-journey .cj-globe {\n        width: 175px;\n        height: 175px;\n    }\n\n\n    #centro-journey .cj-world-orbit-one {\n        width: 245px;\n        height: 245px;\n    }\n\n\n    #centro-journey .cj-world-orbit-two {\n        width: 220px;\n        height: 110px;\n    }\n\n\n    #centro-journey .cj-world-node {\n        padding: 6px 8px;\n\n        font-size: 7px !important;\n    }\n\n\n    #centro-journey .cj-node-us {\n        left: 8px;\n        top: 55px;\n    }\n\n\n    #centro-journey .cj-node-egypt {\n        left: 7px;\n        bottom: 61px;\n    }\n\n\n    #centro-journey .cj-node-ph {\n        right: 7px;\n        top: 62px;\n    }\n\n\n    #centro-journey .cj-node-gulf {\n        right: 7px;\n        bottom: 65px;\n    }\n\n\n    #centro-journey .cj-era {\n        grid-template-columns: 1fr;\n\n        gap: 27px;\n\n        padding: 34px 22px;\n    }\n\n\n    #centro-journey .cj-era-line {\n        width: 2px;\n        height: 45px;\n\n        margin: auto;\n    }\n\n\n    #centro-journey .cj-era-line::after {\n        right: 50%;\n        top: auto;\n        bottom: 0;\n\n        transform:\n            translateX(50%)\n            rotate(135deg);\n    }\n\n\n    #centro-journey .cj-timeline::before {\n        left: 24px;\n    }\n\n\n    #centro-journey .cj-milestone {\n        grid-template-columns: 54px 1fr;\n\n        gap: 13px;\n    }\n\n\n    #centro-journey .cj-year {\n        padding-top: 22px;\n    }\n\n\n    #centro-journey .cj-year strong {\n        min-width: 0;\n\n        width: 50px;\n\n        padding: 9px 4px;\n\n        font-size: 11px !important;\n    }\n\n\n    #centro-journey .cj-year::after {\n        left: 18px;\n        top: 63px;\n\n        width: 13px;\n        height: 13px;\n    }\n\n\n    #centro-journey .cj-milestone-content {\n        padding: 25px 21px;\n    }\n\n\n    #centro-journey .cj-evolution {\n        padding: 37px 23px;\n    }\n\n\n    #centro-journey .cj-recognition {\n        grid-template-columns: 1fr;\n    }\n\n\n    #centro-journey .cj-recognition-stat {\n        padding: 30px;\n    }\n\n\n    #centro-journey .cj-recognition-copy {\n        padding: 31px 24px;\n    }\n\n\n    #centro-journey .cj-forward {\n        padding: 36px 24px 36px 31px;\n    }\n\n\n    #centro-journey .cj-cta {\n        padding: 43px 22px;\n    }\n\n}\n\n</style>\n\n\n\n<article id=\"centro-journey\">\n\n<div class=\"cj-wrap\">\n\n\n<!-- =========================================================\n     HERO\n========================================================= -->\n\n<section class=\"cj-hero\">\n\n\n    <div class=\"cj-hero-content\">\n\n\n        <div class=\"cj-eyebrow\">\n\n            <span class=\"cj-eyebrow-dot\"></span>\n\n            The Centro Story\n\n        </div>\n\n\n        <h1>\n\n            From Inception to a\n\n            <span>Global Outsourcing Leader.</span>\n\n        </h1>\n\n\n        <p class=\"cj-hero-lead\">\n\n            What began with a vision in Virginia in 2009 has grown into a\n            global outsourcing organization built around talent, operational\n            excellence, technology and long-term client partnerships.\n\n        </p>\n\n\n    </div>\n\n\n\n    <!-- CODED GLOBAL FOOTPRINT -->\n\n    <div class=\"cj-world\" aria-hidden=\"true\">\n\n\n        <div class=\"cj-world-orbit cj-world-orbit-one\"></div>\n\n        <div class=\"cj-world-orbit cj-world-orbit-two\"></div>\n\n\n        <div class=\"cj-globe\">\n\n            <div class=\"cj-globe-longitude\"></div>\n\n        </div>\n\n\n        <span class=\"cj-world-node cj-node-us\">\n            USA\n        </span>\n\n\n        <span class=\"cj-world-node cj-node-egypt\">\n            Egypt\n        </span>\n\n\n        <span class=\"cj-world-node cj-node-ph\">\n            Philippines\n        </span>\n\n\n        <span class=\"cj-world-node cj-node-gulf\">\n            UAE &amp; KSA\n        </span>\n\n\n        <div class=\"cj-world-year\">\n\n            <span class=\"cj-world-year-dot\"></span>\n\n            Growing Since 2009\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n\n<div class=\"cj-content\">\n\n\n<!-- =========================================================\n     INTRODUCTION\n========================================================= -->\n\n<section class=\"cj-intro\">\n\n\n    <div class=\"cj-kicker\">\n\n        <span class=\"cj-kicker-line\"></span>\n\n        <span class=\"cj-kicker-text\">\n            Where It Started\n        </span>\n\n    </div>\n\n\n    <h2>\n\n        Built on the belief that outsourcing should create strategic value.\n\n    </h2>\n\n\n    <p>\n\n        Centro was founded in 2009 by Hesham Farag in Fairfax, Virginia,\n        with a vision that went beyond traditional cost-focused outsourcing.\n\n    </p>\n\n\n    <p>\n\n        The idea was to build operations that could strengthen customer\n        experiences, create access to global talent and help businesses\n        scale with greater flexibility.\n\n    </p>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     ERA\n========================================================= -->\n\n<section class=\"cj-era\">\n\n\n    <div class=\"cj-era-year\">\n\n        <strong>\n            2009\n        </strong>\n\n        <span>\n            The journey begins\n        </span>\n\n    </div>\n\n\n    <div class=\"cj-era-line\"></div>\n\n\n    <div class=\"cj-era-year\">\n\n        <strong>\n            2026\n        </strong>\n\n        <span>\n            Global delivery continues\n        </span>\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     TIMELINE HEADING\n========================================================= -->\n\n<section class=\"cj-timeline-heading\">\n\n\n    <span>\n        The Journey\n    </span>\n\n\n    <h2>\n        Growth built one milestone at a time.\n    </h2>\n\n\n    <p>\n\n        Centro&#8217;s development has combined geographic expansion with new\n        capabilities, technology and an increasingly sophisticated global\n        delivery model.\n\n    </p>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     TIMELINE\n========================================================= -->\n\n<section class=\"cj-timeline\">\n\n\n    <!-- 2009 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2009\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Foundation\n            </span>\n\n            <h3>\n                Centro is founded in Virginia.\n            </h3>\n\n            <p>\n\n                Centro begins operations in Fairfax, Virginia, establishing\n                the foundation for what would become a global outsourcing\n                delivery organization.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2010 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2010\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                International Expansion\n            </span>\n\n            <h3>\n                Cairo expands the talent model.\n            </h3>\n\n            <p>\n\n                Just one year later, Centro expands into Cairo, opening access\n                to a large multilingual talent pool and creating a new\n                international delivery capability.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2015 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2015\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Asia-Pacific Delivery\n            </span>\n\n            <h3>\n                Manila strengthens around-the-clock delivery.\n            </h3>\n\n            <p>\n\n                Centro expands into the Philippines, strengthening its ability\n                to support clients across time zones and broaden its global\n                talent base.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2016 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2016\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                U.S. Growth\n            </span>\n\n            <h3>\n                Winchester adds another U.S. delivery operation.\n            </h3>\n\n            <p>\n\n                Centro opens a facility in Winchester, Virginia, strengthening\n                its domestic capabilities while the international delivery\n                network continues to expand.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2021 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2021\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Capability Expansion\n            </span>\n\n            <h3>\n                The business evolves beyond traditional BPO.\n            </h3>\n\n            <p>\n\n                Centro broadens its capabilities into digital transformation,\n                data intelligence and end-to-end customer experience,\n                reflecting the changing needs of modern enterprises.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2022 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2022\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Experience Innovation\n            </span>\n\n            <h3>\n                El Gouna becomes a new CX delivery hub.\n            </h3>\n\n            <p>\n\n                Centro opens a Customer Experience Center in El Gouna, Egypt,\n                adding a new delivery environment designed around modern\n                customer experience operations.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2023 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2023\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Middle East Expansion\n            </span>\n\n            <h3>\n                Dubai and Riyadh extend Centro&#8217;s regional presence.\n            </h3>\n\n            <p>\n\n                Expansion into the UAE and Saudi Arabia creates new\n                opportunities to support businesses operating across some\n                of the region&#8217;s fastest-growing markets.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2025 -->\n\n    <div class=\"cj-milestone\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2025\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Industry Recognition\n            </span>\n\n            <h3>\n                Three consecutive years in the IAOP Global Outsourcing 100.\n            </h3>\n\n            <p>\n\n                Centro receives its third consecutive IAOP Global Outsourcing\n                100 recognition, marking another step in the company&#8217;s growing\n                international industry profile.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n\n    <!-- 2026 -->\n\n    <div class=\"cj-milestone cj-milestone-latest\">\n\n\n        <div class=\"cj-year\">\n\n            <strong>\n                2026\n            </strong>\n\n        </div>\n\n\n        <div class=\"cj-milestone-content\">\n\n            <span class=\"cj-milestone-label\">\n                Continuing Momentum\n            </span>\n\n            <h3>\n                Centro earns IAOP recognition for a fourth consecutive year.\n            </h3>\n\n            <p>\n\n                Centro is named to the 2026 IAOP Global Outsourcing 100 as a\n                Rising Star, extending its recognition to four consecutive\n                years and reinforcing its continued momentum in the global\n                outsourcing market.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     EVOLUTION\n========================================================= -->\n\n<section class=\"cj-evolution\">\n\n\n    <span class=\"cj-evolution-label\">\n        More Than Geographic Growth\n    </span>\n\n\n    <h2>\n        Centro&#8217;s evolution has changed what the company can deliver.\n    </h2>\n\n\n    <p>\n\n        Expansion has been accompanied by a broader operating model that\n        connects global talent, technology and execution across different\n        customer and business processes.\n\n    </p>\n\n\n\n    <div class=\"cj-evolution-grid\">\n\n\n        <div class=\"cj-evolution-card\">\n\n            <span class=\"cj-evolution-number\">\n                01\n            </span>\n\n            <h3>\n                Global Talent\n            </h3>\n\n            <p>\n\n                Access to delivery teams across multiple international\n                markets creates greater flexibility for growing operations.\n\n            </p>\n\n        </div>\n\n\n\n        <div class=\"cj-evolution-card\">\n\n            <span class=\"cj-evolution-number\">\n                02\n            </span>\n\n            <h3>\n                Technology\n            </h3>\n\n            <p>\n\n                Digital transformation and data capabilities increasingly\n                support how customer and business operations are delivered.\n\n            </p>\n\n        </div>\n\n\n\n        <div class=\"cj-evolution-card\">\n\n            <span class=\"cj-evolution-number\">\n                03\n            </span>\n\n            <h3>\n                Execution\n            </h3>\n\n            <p>\n\n                Scalable operating models help clients extend capacity,\n                improve performance and support changing business demands.\n\n            </p>\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     IAOP RECOGNITION\n========================================================= -->\n\n<section class=\"cj-recognition\">\n\n\n    <div class=\"cj-recognition-stat\">\n\n        <strong>\n            4\n        </strong>\n\n        <span>\n            Consecutive Years\n        </span>\n\n    </div>\n\n\n    <div class=\"cj-recognition-copy\">\n\n        <span>\n            IAOP Global Outsourcing 100\n        </span>\n\n\n        <h2>\n            Growth recognized by the global outsourcing industry.\n        </h2>\n\n\n        <p>\n\n            In 2026, Centro was recognized as an IAOP Rising Star for the\n            fourth consecutive year, reflecting continued growth and the\n            development of its global outsourcing capabilities.\n\n        </p>\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     FUTURE\n========================================================= -->\n\n<section class=\"cj-forward\">\n\n\n    <span class=\"cj-forward-label\">\n        What Comes Next\n    </span>\n\n\n    <h2>\n        The next chapter is still being built.\n    </h2>\n\n\n    <p>\n\n        Centro&#8217;s journey has never been defined by expansion alone. Each stage\n        has added new talent, capabilities, delivery options and expertise to\n        the organization.\n\n    </p>\n\n\n    <p>\n\n        As customer expectations and outsourcing models continue to evolve,\n        Centro&#8217;s focus remains on scalable, tech-enabled solutions,\n        operational excellence and measurable outcomes for clients across\n        industries and markets.\n\n    </p>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     CTA\n========================================================= -->\n\n<section class=\"cj-cta\">\n\n\n    <div class=\"cj-cta-content\">\n\n\n        <span class=\"cj-cta-label\">\n            The Journey Continues\n        </span>\n\n\n        <h2>\n            See what Centro can build with your business.\n        </h2>\n\n\n        <p>\n\n            Explore our outsourcing capabilities and discover how a global\n            delivery model can support your next stage of growth.\n\n        </p>\n\n\n\n        <div class=\"cj-buttons\">\n\n\n            <a\n                class=\"cj-btn cj-btn-primary\"\n                href=\"https://centrocdx.com/about/\"\n            >\n                Discover Centro\n            </a>\n\n\n            <a\n                class=\"cj-btn cj-btn-secondary\"\n                href=\"https://centrocdx.com/get-in-touch/\"\n            >\n                Get in Touch\n            </a>\n\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n</div>\n\n</div>\n\n</article>"
        }
      ]
    }
  ],
