      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "a7010006-5555-4555-8555-111100000017",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!-- =========================================================\nCENTRO WORDPRESS CASE STUDY\nBILINGUAL EXCELLENCE AT SCALE\nInsurance BPO Case Study\n\nDesigned for Centro WordPress blog body.\nNo website header or footer included.\nAll styles are scoped to avoid WordPress theme overrides.\n========================================================= -->\n\n\n<style>\n\n/* =========================================================\n   CENTRO CASE STUDY — DESIGN TOKENS\n========================================================= */\n\n#centro-insurance-case {\n    --centro-navy: #063B5C;\n    --centro-deep: #042E47;\n    --centro-blue: #015376;\n    --centro-cyan: #00A9E0;\n    --centro-cyan-light: #74DDF6;\n    --centro-light-blue: #DDF5FC;\n    --centro-pale: #F3FAFC;\n    --centro-white: #FFFFFF;\n    --centro-text: #315568;\n    --centro-border: rgba(1, 83, 118, .14);\n\n    width: 100%;\n    margin: 0 auto;\n    padding: 0;\n\n    font-family: \"Poppins\", Arial, sans-serif !important;\n\n    color: var(--centro-text) !important;\n\n    line-height: 1.75;\n}\n\n\n/* =========================================================\n   HARD WORDPRESS RESET\n========================================================= */\n\n#centro-insurance-case *,\n#centro-insurance-case *::before,\n#centro-insurance-case *::after {\n    box-sizing: border-box;\n}\n\n#centro-insurance-case h1,\n#centro-insurance-case h2,\n#centro-insurance-case h3,\n#centro-insurance-case h4,\n#centro-insurance-case p,\n#centro-insurance-case span,\n#centro-insurance-case strong,\n#centro-insurance-case div,\n#centro-insurance-case a {\n    font-family: \"Poppins\", Arial, sans-serif !important;\n}\n\n#centro-insurance-case h1,\n#centro-insurance-case h2,\n#centro-insurance-case h3,\n#centro-insurance-case h4 {\n    margin-top: 0 !important;\n\n    color: var(--centro-navy) !important;\n\n    line-height: 1.18 !important;\n}\n\n#centro-insurance-case p {\n    margin: 0 0 20px !important;\n\n    color: var(--centro-text) !important;\n\n    font-size: 16px !important;\n    line-height: 1.8 !important;\n}\n\n#centro-insurance-case a {\n    text-decoration: none !important;\n}\n\n\n/* =========================================================\n   MAIN WRAPPERS\n========================================================= */\n\n#centro-insurance-case .cc-wrap {\n    width: min(100%, 1120px);\n\n    margin: 0 auto;\n}\n\n#centro-insurance-case .cc-copy {\n    width: min(100%, 900px);\n\n    margin-left: auto;\n    margin-right: auto;\n}\n\n\n/* =========================================================\n   HERO\n========================================================= */\n\n#centro-insurance-case .cc-hero {\n    position: relative;\n\n    display: grid;\n\n    grid-template-columns: 1.08fr .92fr;\n\n    gap: 48px;\n\n    align-items: center;\n\n    overflow: hidden;\n\n    margin-bottom: 42px;\n\n    padding: 58px;\n\n    border-radius: 30px;\n\n    background:\n        radial-gradient(\n            circle at 92% 5%,\n            rgba(0, 169, 224, .23),\n            transparent 31%\n        ),\n        linear-gradient(\n            135deg,\n            #042E47 0%,\n            #063B5C 62%,\n            #015376 100%\n        );\n\n    box-shadow:\n        0 24px 70px rgba(6, 59, 92, .13);\n}\n\n\n#centro-insurance-case .cc-hero::before {\n    content: \"\";\n\n    position: absolute;\n\n    width: 460px;\n    height: 460px;\n\n    right: -250px;\n    bottom: -300px;\n\n    border: 1px solid rgba(255, 255, 255, .11);\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-insurance-case .cc-hero::after {\n    content: \"\";\n\n    position: absolute;\n\n    width: 350px;\n    height: 350px;\n\n    right: -200px;\n    bottom: -250px;\n\n    border: 1px solid rgba(255, 255, 255, .07);\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n/* =========================================================\n   HERO TEXT\n========================================================= */\n\n#centro-insurance-case .cc-hero-content {\n    position: relative;\n\n    z-index: 3;\n}\n\n\n#centro-insurance-case .cc-eyebrow {\n    display: inline-flex;\n\n    align-items: center;\n\n    gap: 8px;\n\n    margin-bottom: 22px;\n\n    padding: 8px 13px;\n\n    border: 1px solid rgba(255, 255, 255, .20);\n\n    border-radius: 999px;\n\n    background: rgba(255, 255, 255, .07);\n\n    color: #FFFFFF !important;\n\n    font-size: 11px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .12em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-insurance-case .cc-eyebrow-dot {\n    width: 7px;\n\n    height: 7px;\n\n    flex: 0 0 7px;\n\n    border-radius: 50%;\n\n    background: var(--centro-cyan);\n}\n\n\n#centro-insurance-case .cc-hero h1 {\n    max-width: 650px;\n\n    margin-bottom: 23px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(35px, 4.5vw, 58px) !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: -.04em !important;\n}\n\n\n#centro-insurance-case .cc-hero h1 span {\n    color: var(--centro-cyan-light) !important;\n}\n\n\n#centro-insurance-case .cc-hero-description {\n    max-width: 610px;\n\n    margin: 0 !important;\n\n    color: rgba(255, 255, 255, .79) !important;\n\n    font-size: 17px !important;\n\n    line-height: 1.7 !important;\n}\n\n\n/* =========================================================\n   CODED HERO VISUAL\n========================================================= */\n\n#centro-insurance-case .cc-hero-visual {\n    position: relative;\n\n    z-index: 3;\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    min-height: 390px;\n\n    overflow: hidden;\n\n    border: 1px solid rgba(255, 255, 255, .13);\n\n    border-radius: 28px;\n\n    background:\n        radial-gradient(\n            circle at 50% 45%,\n            rgba(0, 169, 224, .14),\n            transparent 56%\n        ),\n        rgba(255, 255, 255, .03);\n}\n\n\n/* =========================================================\n   HERO GRID\n========================================================= */\n\n#centro-insurance-case .cc-hero-visual::before {\n    content: \"\";\n\n    position: absolute;\n\n    inset: 0;\n\n    opacity: .14;\n\n    background-image:\n\n        linear-gradient(\n            rgba(255, 255, 255, .10) 1px,\n            transparent 1px\n        ),\n\n        linear-gradient(\n            90deg,\n            rgba(255, 255, 255, .10) 1px,\n            transparent 1px\n        );\n\n    background-size: 34px 34px;\n\n    -webkit-mask-image:\n        radial-gradient(\n            circle at center,\n            #000 8%,\n            transparent 72%\n        );\n\n    mask-image:\n        radial-gradient(\n            circle at center,\n            #000 8%,\n            transparent 72%\n        );\n\n    pointer-events: none;\n}\n\n\n/* =========================================================\n   CIRCULAR ORBITS\n========================================================= */\n\n#centro-insurance-case .cc-icon-orbit {\n    position: absolute;\n\n    border: 1px solid rgba(116, 221, 246, .18);\n\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-insurance-case .cc-icon-orbit-one {\n    width: 325px;\n\n    height: 325px;\n}\n\n\n#centro-insurance-case .cc-icon-orbit-two {\n    width: 250px;\n\n    height: 250px;\n\n    border-color: rgba(116, 221, 246, .10);\n}\n\n\n#centro-insurance-case .cc-icon-orbit-three {\n    width: 180px;\n\n    height: 180px;\n\n    border-color: rgba(116, 221, 246, .08);\n}\n\n\n/* =========================================================\n   SHIELD HOLDER\n========================================================= */\n\n#centro-insurance-case .cc-insurance-icon {\n    position: relative;\n\n    z-index: 4;\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    width: 230px;\n\n    height: 230px;\n\n    border: 1px solid rgba(116, 221, 246, .16);\n\n    border-radius: 50%;\n\n    background:\n\n        radial-gradient(\n            circle,\n            rgba(0, 169, 224, .17) 0%,\n            rgba(0, 169, 224, .06) 46%,\n            rgba(0, 169, 224, 0) 73%\n        );\n\n    box-shadow:\n\n        0 0 80px rgba(0, 169, 224, .13),\n\n        inset 0 0 45px rgba(0, 169, 224, .04);\n}\n\n\n/* =========================================================\n   CODED SHIELD\n========================================================= */\n\n#centro-insurance-case .cc-shield {\n    position: relative;\n\n    width: 145px;\n\n    height: 168px;\n\n    background:\n\n        linear-gradient(\n            160deg,\n            #91E7FA 0%,\n            #00A9E0 48%,\n            #48CDEB 100%\n        );\n\n    clip-path: polygon(\n        50% 0%,\n        91% 17%,\n        91% 53%,\n        85% 68%,\n        70% 82%,\n        50% 96%,\n        30% 82%,\n        15% 68%,\n        9% 53%,\n        9% 17%\n    );\n\n    filter:\n        drop-shadow(\n            0 15px 25px rgba(0, 169, 224, .22)\n        );\n}\n\n\n#centro-insurance-case .cc-shield-inner {\n    position: absolute;\n\n    inset: 8px;\n\n    display: flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    background:\n\n        linear-gradient(\n            145deg,\n            #084969,\n            #063B5C\n        );\n\n    clip-path: polygon(\n        50% 0%,\n        91% 17%,\n        91% 53%,\n        85% 68%,\n        70% 82%,\n        50% 96%,\n        30% 82%,\n        15% 68%,\n        9% 53%,\n        9% 17%\n    );\n}\n\n\n/* =========================================================\n   CODED CHECKMARK\n========================================================= */\n\n#centro-insurance-case .cc-checkmark {\n    position: relative;\n\n    width: 64px;\n\n    height: 35px;\n\n    margin-top: -6px;\n\n    border-left: 9px solid #FFFFFF;\n\n    border-bottom: 9px solid #FFFFFF;\n\n    border-radius: 2px;\n\n    transform: rotate(-45deg);\n\n    filter:\n        drop-shadow(\n            0 3px 8px rgba(0, 0, 0, .12)\n        );\n}\n\n\n/* =========================================================\n   HERO LABEL\n========================================================= */\n\n#centro-insurance-case .cc-security-label {\n    position: absolute;\n\n    z-index: 5;\n\n    left: 50%;\n\n    bottom: 27px;\n\n    transform: translateX(-50%);\n\n    display: inline-flex;\n\n    align-items: center;\n\n    gap: 8px;\n\n    width: max-content;\n\n    max-width: calc(100% - 30px);\n\n    padding: 8px 13px;\n\n    border: 1px solid rgba(255, 255, 255, .13);\n\n    border-radius: 999px;\n\n    background: rgba(4, 46, 71, .58);\n\n    backdrop-filter: blur(8px);\n\n    -webkit-backdrop-filter: blur(8px);\n\n    color: rgba(255, 255, 255, .78) !important;\n\n    font-size: 10px !important;\n\n    font-weight: 600 !important;\n\n    letter-spacing: .08em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-insurance-case .cc-security-dot {\n    width: 7px;\n\n    height: 7px;\n\n    flex: 0 0 7px;\n\n    border-radius: 50%;\n\n    background: #6EE0F8;\n\n    box-shadow:\n        0 0 12px rgba(110, 224, 248, .75);\n}\n\n\n/* =========================================================\n   HERO MOTION\n========================================================= */\n\n@media (prefers-reduced-motion: no-preference) {\n\n    #centro-insurance-case .cc-insurance-icon {\n        animation:\n            cc-icon-float 5s ease-in-out infinite;\n    }\n\n    #centro-insurance-case .cc-icon-orbit-one {\n        animation:\n            cc-orbit-pulse 5s ease-in-out infinite;\n    }\n\n    #centro-insurance-case .cc-icon-orbit-two {\n        animation:\n            cc-orbit-pulse 5s ease-in-out infinite 1s;\n    }\n\n}\n\n\n@keyframes cc-icon-float {\n\n    0%,\n    100% {\n        transform: translateY(0);\n    }\n\n    50% {\n        transform: translateY(-8px);\n    }\n\n}\n\n\n@keyframes cc-orbit-pulse {\n\n    0%,\n    100% {\n        opacity: .45;\n\n        transform: scale(1);\n    }\n\n    50% {\n        opacity: .8;\n\n        transform: scale(1.035);\n    }\n\n}\n\n\n/* =========================================================\n   INTRO\n========================================================= */\n\n#centro-insurance-case .cc-intro {\n    padding: 42px 0 20px;\n}\n\n\n#centro-insurance-case .cc-intro-label {\n    display: flex;\n\n    align-items: center;\n\n    gap: 12px;\n\n    margin-bottom: 22px;\n}\n\n\n#centro-insurance-case .cc-intro-label-line {\n    width: 42px;\n\n    height: 4px;\n\n    border-radius: 20px;\n\n    background: var(--centro-cyan);\n}\n\n\n#centro-insurance-case .cc-intro-label span:last-child {\n    color: var(--centro-blue) !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .10em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-insurance-case .cc-intro h2 {\n    max-width: 760px;\n\n    margin-bottom: 18px !important;\n\n    font-size: clamp(28px, 3vw, 39px) !important;\n\n    letter-spacing: -.025em !important;\n}\n\n\n/* =========================================================\n   RESULTS BAR\n========================================================= */\n\n#centro-insurance-case .cc-results {\n    display: grid;\n\n    grid-template-columns: repeat(4, 1fr);\n\n    overflow: hidden;\n\n    margin: 42px 0 65px;\n\n    border: 1px solid var(--centro-border);\n\n    border-radius: 25px;\n\n    background: #FFFFFF;\n\n    box-shadow:\n        0 15px 50px rgba(6, 59, 92, .07);\n}\n\n\n#centro-insurance-case .cc-result {\n    position: relative;\n\n    min-height: 176px;\n\n    padding: 31px 23px;\n\n    border-right: 1px solid var(--centro-border);\n}\n\n\n#centro-insurance-case .cc-result:last-child {\n    border-right: 0;\n}\n\n\n#centro-insurance-case .cc-result::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 23px;\n\n    top: 0;\n\n    width: 42px;\n\n    height: 4px;\n\n    border-radius: 0 0 5px 5px;\n\n    background: var(--centro-cyan);\n}\n\n\n#centro-insurance-case .cc-result strong {\n    display: block;\n\n    margin-bottom: 9px;\n\n    color: var(--centro-blue) !important;\n\n    font-size: 36px !important;\n\n    line-height: 1 !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-result-title {\n    display: block;\n\n    margin-bottom: 7px;\n\n    color: var(--centro-navy) !important;\n\n    font-size: 14px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-result p {\n    margin: 0 !important;\n\n    color: var(--centro-text) !important;\n\n    font-size: 12px !important;\n\n    line-height: 1.6 !important;\n}\n\n\n/* =========================================================\n   GENERAL SECTIONS\n========================================================= */\n\n#centro-insurance-case .cc-section {\n    margin: 62px 0;\n}\n\n\n#centro-insurance-case .cc-heading {\n    display: flex;\n\n    align-items: center;\n\n    gap: 15px;\n\n    margin-bottom: 25px;\n}\n\n\n#centro-insurance-case .cc-heading-number {\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    width: 42px;\n\n    height: 42px;\n\n    flex: 0 0 42px;\n\n    border-radius: 13px;\n\n    background: var(--centro-light-blue);\n\n    color: var(--centro-blue) !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-heading h2 {\n    margin: 0 !important;\n\n    font-size: clamp(27px, 3vw, 37px) !important;\n\n    letter-spacing: -.025em !important;\n}\n\n\n/* =========================================================\n   CHALLENGE\n========================================================= */\n\n#centro-insurance-case .cc-challenge {\n    position: relative;\n\n    overflow: hidden;\n\n    padding: 42px;\n\n    border: 1px solid var(--centro-border);\n\n    border-radius: 25px;\n\n    background:\n\n        linear-gradient(\n            135deg,\n            #F6FCFE,\n            #ECF9FC\n        );\n}\n\n\n#centro-insurance-case .cc-challenge::after {\n    content: \"\";\n\n    position: absolute;\n\n    right: -70px;\n\n    top: -70px;\n\n    width: 190px;\n\n    height: 190px;\n\n    border: 32px solid rgba(0, 169, 224, .06);\n\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-insurance-case .cc-challenge p:last-child {\n    margin-bottom: 0 !important;\n}\n\n\n/* =========================================================\n   STRATEGY CARDS\n========================================================= */\n\n#centro-insurance-case .cc-strategy-grid {\n    display: grid;\n\n    grid-template-columns: repeat(3, 1fr);\n\n    gap: 18px;\n\n    margin-top: 32px;\n}\n\n\n#centro-insurance-case .cc-strategy-card {\n    position: relative;\n\n    min-height: 250px;\n\n    overflow: hidden;\n\n    padding: 31px;\n\n    border-radius: 22px;\n\n    background: var(--centro-navy);\n}\n\n\n#centro-insurance-case .cc-strategy-card:nth-child(2) {\n    background: var(--centro-blue);\n}\n\n\n#centro-insurance-case .cc-strategy-card:nth-child(3) {\n    background: #08799D;\n}\n\n\n#centro-insurance-case .cc-strategy-card::after {\n    content: \"\";\n\n    position: absolute;\n\n    width: 130px;\n\n    height: 130px;\n\n    right: -72px;\n\n    bottom: -70px;\n\n    border: 1px solid rgba(255, 255, 255, .12);\n\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-insurance-case .cc-strategy-index {\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    width: 39px;\n\n    height: 39px;\n\n    margin-bottom: 28px;\n\n    border: 1px solid rgba(255, 255, 255, .20);\n\n    border-radius: 50%;\n\n    color: #FFFFFF !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-strategy-card h3 {\n    margin-bottom: 12px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: 19px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-strategy-card p {\n    margin: 0 !important;\n\n    color: rgba(255, 255, 255, .80) !important;\n\n    font-size: 14px !important;\n\n    line-height: 1.7 !important;\n}\n\n\n/* =========================================================\n   SCALE VISUAL\n========================================================= */\n\n#centro-insurance-case .cc-scale {\n    position: relative;\n\n    display: grid;\n\n    grid-template-columns: 1fr 110px 1fr;\n\n    align-items: center;\n\n    margin: 64px 0;\n\n    padding: 46px;\n\n    border: 1px solid var(--centro-border);\n\n    border-radius: 27px;\n\n    background: var(--centro-pale);\n}\n\n\n#centro-insurance-case .cc-scale-point {\n    text-align: center;\n}\n\n\n#centro-insurance-case .cc-scale-point strong {\n    display: block;\n\n    color: var(--centro-blue) !important;\n\n    font-size: clamp(45px, 6vw, 72px) !important;\n\n    line-height: 1 !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-scale-point span {\n    display: block;\n\n    margin-top: 8px;\n\n    color: var(--centro-navy) !important;\n\n    font-size: 14px !important;\n\n    font-weight: 600 !important;\n}\n\n\n#centro-insurance-case .cc-scale-arrow {\n    position: relative;\n\n    height: 2px;\n\n    background: var(--centro-cyan);\n}\n\n\n#centro-insurance-case .cc-scale-arrow::after {\n    content: \"\";\n\n    position: absolute;\n\n    right: -1px;\n\n    top: 50%;\n\n    width: 10px;\n\n    height: 10px;\n\n    border-top: 2px solid var(--centro-cyan);\n\n    border-right: 2px solid var(--centro-cyan);\n\n    transform:\n        translateY(-50%)\n        rotate(45deg);\n}\n\n\n/* =========================================================\n   BUSINESS IMPACT\n========================================================= */\n\n#centro-insurance-case .cc-impact {\n    position: relative;\n\n    overflow: hidden;\n\n    margin: 64px 0;\n\n    padding: 50px;\n\n    border-radius: 28px;\n\n    background:\n\n        radial-gradient(\n            circle at 92% 10%,\n            rgba(0, 169, 224, .23),\n            transparent 30%\n        ),\n\n        var(--centro-deep);\n}\n\n\n#centro-insurance-case .cc-impact::after {\n    content: \"\";\n\n    position: absolute;\n\n    width: 360px;\n\n    height: 360px;\n\n    right: -240px;\n\n    bottom: -250px;\n\n    border: 1px solid rgba(255, 255, 255, .12);\n\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-insurance-case .cc-impact-label {\n    display: inline-block;\n\n    margin-bottom: 13px;\n\n    color: #70DCF7 !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .10em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-insurance-case .cc-impact h2 {\n    position: relative;\n\n    z-index: 2;\n\n    max-width: 760px;\n\n    margin-bottom: 31px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(29px, 3.5vw, 43px) !important;\n}\n\n\n#centro-insurance-case .cc-impact-grid {\n    position: relative;\n\n    z-index: 2;\n\n    display: grid;\n\n    grid-template-columns: repeat(2, 1fr);\n\n    gap: 13px;\n}\n\n\n#centro-insurance-case .cc-impact-item {\n    display: flex;\n\n    gap: 14px;\n\n    align-items: flex-start;\n\n    padding: 18px 20px;\n\n    border: 1px solid rgba(255, 255, 255, .12);\n\n    border-radius: 15px;\n\n    background: rgba(255, 255, 255, .06);\n}\n\n\n#centro-insurance-case .cc-check {\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    width: 25px;\n\n    height: 25px;\n\n    flex: 0 0 25px;\n\n    border-radius: 50%;\n\n    background: var(--centro-cyan);\n\n    color: #FFFFFF !important;\n\n    font-size: 13px !important;\n\n    font-weight: 700 !important;\n}\n\n\n#centro-insurance-case .cc-impact-item span:last-child {\n    color: rgba(255, 255, 255, .91) !important;\n\n    font-size: 14px !important;\n\n    line-height: 1.55 !important;\n}\n\n\n/* =========================================================\n   TAKEAWAY\n========================================================= */\n\n#centro-insurance-case .cc-takeaway {\n    position: relative;\n\n    margin: 65px 0;\n\n    padding: 44px 46px 44px 52px;\n\n    border-radius: 4px 24px 24px 4px;\n\n    background: #F2FAFC;\n}\n\n\n#centro-insurance-case .cc-takeaway::before {\n    content: \"\";\n\n    position: absolute;\n\n    left: 0;\n\n    top: 0;\n\n    bottom: 0;\n\n    width: 6px;\n\n    border-radius: 6px;\n\n    background: var(--centro-cyan);\n}\n\n\n#centro-insurance-case .cc-takeaway-label {\n    display: block;\n\n    margin-bottom: 10px;\n\n    color: var(--centro-blue) !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .10em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-insurance-case .cc-takeaway h2 {\n    margin-bottom: 15px !important;\n\n    font-size: clamp(26px, 3vw, 36px) !important;\n}\n\n\n#centro-insurance-case .cc-takeaway p:last-child {\n    margin-bottom: 0 !important;\n}\n\n\n/* =========================================================\n   CTA\n========================================================= */\n\n#centro-insurance-case .cc-cta {\n    position: relative;\n\n    overflow: hidden;\n\n    margin-top: 65px;\n\n    padding: 55px 45px;\n\n    border-radius: 29px;\n\n    background:\n\n        radial-gradient(\n            circle at 90% 0%,\n            rgba(0, 169, 224, .22),\n            transparent 32%\n        ),\n\n        linear-gradient(\n            135deg,\n            #015376,\n            #063B5C\n        );\n\n    text-align: center;\n}\n\n\n#centro-insurance-case .cc-cta::before {\n    content: \"\";\n\n    position: absolute;\n\n    width: 270px;\n\n    height: 270px;\n\n    left: -150px;\n\n    top: -160px;\n\n    border: 1px solid rgba(255, 255, 255, .13);\n\n    border-radius: 50%;\n\n    pointer-events: none;\n}\n\n\n#centro-insurance-case .cc-cta-content {\n    position: relative;\n\n    z-index: 2;\n\n    max-width: 720px;\n\n    margin: auto;\n}\n\n\n#centro-insurance-case .cc-cta-label {\n    display: inline-block;\n\n    margin-bottom: 12px;\n\n    color: #71DDF7 !important;\n\n    font-size: 12px !important;\n\n    font-weight: 700 !important;\n\n    letter-spacing: .10em;\n\n    text-transform: uppercase;\n}\n\n\n#centro-insurance-case .cc-cta h2 {\n    margin-bottom: 17px !important;\n\n    color: #FFFFFF !important;\n\n    font-size: clamp(30px, 4vw, 44px) !important;\n}\n\n\n#centro-insurance-case .cc-cta p {\n    max-width: 610px;\n\n    margin: 0 auto 28px !important;\n\n    color: rgba(255, 255, 255, .80) !important;\n}\n\n\n#centro-insurance-case .cc-buttons {\n    display: flex;\n\n    flex-wrap: wrap;\n\n    justify-content: center;\n\n    gap: 12px;\n}\n\n\n#centro-insurance-case .cc-btn {\n    display: inline-flex !important;\n\n    align-items: center;\n\n    justify-content: center;\n\n    min-height: 50px;\n\n    padding: 13px 23px !important;\n\n    border-radius: 11px !important;\n\n    font-size: 14px !important;\n\n    font-weight: 600 !important;\n\n    transition:\n        transform .2s ease,\n        box-shadow .2s ease;\n}\n\n\n#centro-insurance-case .cc-btn:hover {\n    transform: translateY(-2px);\n}\n\n\n#centro-insurance-case .cc-btn-primary {\n    background: var(--centro-cyan) !important;\n\n    color: #FFFFFF !important;\n\n    box-shadow:\n        0 10px 28px rgba(0, 169, 224, .24);\n}\n\n\n#centro-insurance-case .cc-btn-secondary {\n    border: 1px solid rgba(255, 255, 255, .32) !important;\n\n    background: rgba(255, 255, 255, .07) !important;\n\n    color: #FFFFFF !important;\n}\n\n\n/* =========================================================\n   TABLET\n========================================================= */\n\n@media (max-width: 900px) {\n\n    #centro-insurance-case .cc-hero {\n        grid-template-columns: 1fr;\n\n        padding: 44px 32px;\n    }\n\n\n    #centro-insurance-case .cc-hero-visual {\n        min-height: 350px;\n    }\n\n\n    #centro-insurance-case .cc-results {\n        grid-template-columns: repeat(2, 1fr);\n    }\n\n\n    #centro-insurance-case .cc-result:nth-child(2) {\n        border-right: 0;\n    }\n\n\n    #centro-insurance-case .cc-result:nth-child(1),\n    #centro-insurance-case .cc-result:nth-child(2) {\n        border-bottom: 1px solid var(--centro-border);\n    }\n\n\n    #centro-insurance-case .cc-strategy-grid {\n        grid-template-columns: 1fr;\n    }\n\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 620px) {\n\n    #centro-insurance-case .cc-hero {\n        gap: 30px;\n\n        padding: 35px 22px;\n\n        border-radius: 22px;\n    }\n\n\n    #centro-insurance-case .cc-hero h1 {\n        font-size: 35px !important;\n    }\n\n\n    #centro-insurance-case .cc-hero-description {\n        font-size: 15px !important;\n    }\n\n\n    #centro-insurance-case .cc-hero-visual {\n        min-height: 310px;\n\n        border-radius: 20px;\n    }\n\n\n    #centro-insurance-case .cc-insurance-icon {\n        width: 190px;\n\n        height: 190px;\n    }\n\n\n    #centro-insurance-case .cc-shield {\n        width: 118px;\n\n        height: 138px;\n    }\n\n\n    #centro-insurance-case .cc-checkmark {\n        width: 52px;\n\n        height: 29px;\n\n        border-left-width: 8px;\n\n        border-bottom-width: 8px;\n    }\n\n\n    #centro-insurance-case .cc-icon-orbit-one {\n        width: 265px;\n\n        height: 265px;\n    }\n\n\n    #centro-insurance-case .cc-icon-orbit-two {\n        width: 210px;\n\n        height: 210px;\n    }\n\n\n    #centro-insurance-case .cc-icon-orbit-three {\n        width: 155px;\n\n        height: 155px;\n    }\n\n\n    #centro-insurance-case .cc-security-label {\n        font-size: 9px !important;\n    }\n\n\n    #centro-insurance-case .cc-results {\n        grid-template-columns: 1fr;\n    }\n\n\n    #centro-insurance-case .cc-result {\n        border-right: 0 !important;\n\n        border-bottom: 1px solid var(--centro-border);\n    }\n\n\n    #centro-insurance-case .cc-result:last-child {\n        border-bottom: 0;\n    }\n\n\n    #centro-insurance-case .cc-challenge {\n        padding: 30px 24px;\n    }\n\n\n    #centro-insurance-case .cc-strategy-card {\n        min-height: auto;\n    }\n\n\n    #centro-insurance-case .cc-scale {\n        grid-template-columns: 1fr;\n\n        gap: 28px;\n\n        padding: 35px 22px;\n    }\n\n\n    #centro-insurance-case .cc-scale-arrow {\n        width: 2px;\n\n        height: 55px;\n\n        margin: auto;\n    }\n\n\n    #centro-insurance-case .cc-scale-arrow::after {\n        right: 50%;\n\n        top: auto;\n\n        bottom: 0;\n\n        transform:\n            translateX(50%)\n            rotate(135deg);\n    }\n\n\n    #centro-insurance-case .cc-impact {\n        padding: 36px 23px;\n    }\n\n\n    #centro-insurance-case .cc-impact-grid {\n        grid-template-columns: 1fr;\n    }\n\n\n    #centro-insurance-case .cc-takeaway {\n        padding: 35px 25px 35px 32px;\n    }\n\n\n    #centro-insurance-case .cc-cta {\n        padding: 43px 22px;\n    }\n\n}\n\n</style>\n\n\n\n<!-- =========================================================\n     CASE STUDY\n========================================================= -->\n\n<article id=\"centro-insurance-case\">\n\n<div class=\"cc-wrap\">\n\n\n<!-- =========================================================\n     HERO\n========================================================= -->\n\n<section class=\"cc-hero\">\n\n\n    <div class=\"cc-hero-content\">\n\n        <div class=\"cc-eyebrow\">\n\n            <span class=\"cc-eyebrow-dot\"></span>\n\n            Insurance BPO Case Study\n\n        </div>\n\n\n        <h1>\n\n            Bilingual Excellence\n\n            <span>at Scale.</span>\n\n        </h1>\n\n\n        <p class=\"cc-hero-description\">\n\n            How Centro built a high-performing bilingual operation for a\n            leading U.S. insurance brokerage while improving cost efficiency,\n            coverage and peak-season performance.\n\n        </p>\n\n    </div>\n\n\n\n    <!-- CODED INSURANCE VISUAL -->\n\n    <div class=\"cc-hero-visual\" aria-hidden=\"true\">\n\n\n        <div class=\"cc-icon-orbit cc-icon-orbit-one\"></div>\n\n        <div class=\"cc-icon-orbit cc-icon-orbit-two\"></div>\n\n        <div class=\"cc-icon-orbit cc-icon-orbit-three\"></div>\n\n\n        <div class=\"cc-insurance-icon\">\n\n\n            <div class=\"cc-shield\">\n\n\n                <div class=\"cc-shield-inner\">\n\n\n                    <span class=\"cc-checkmark\"></span>\n\n\n                </div>\n\n\n            </div>\n\n\n        </div>\n\n\n        <div class=\"cc-security-label\">\n\n            <span class=\"cc-security-dot\"></span>\n\n            Bilingual Insurance Support\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n\n<div class=\"cc-copy\">\n\n\n<!-- =========================================================\n     INTRO\n========================================================= -->\n\n<section class=\"cc-intro\">\n\n\n    <div class=\"cc-intro-label\">\n\n        <span class=\"cc-intro-label-line\"></span>\n\n        <span>The Partnership</span>\n\n    </div>\n\n\n    <h2>\n\n        Peak-season insurance operations demand more than extra headcount.\n\n    </h2>\n\n\n    <p>\n\n        A major U.S. Medicare and Life Insurance brokerage needed a stronger\n        bilingual delivery model ahead of Annual Enrollment Period. Existing\n        vendors were creating inconsistent Spanish coverage, rising costs and\n        onboarding challenges.\n\n    </p>\n\n\n    <p>\n\n        Centro was brought in to build an operation capable of scaling quickly\n        while maintaining quality across English and Spanish customer\n        interactions.\n\n    </p>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     RESULTS SNAPSHOT\n========================================================= -->\n\n<section class=\"cc-results\">\n\n\n    <div class=\"cc-result\">\n\n        <strong>#1</strong>\n\n        <span class=\"cc-result-title\">\n            Vendor Ranking\n        </span>\n\n        <p>\n            Top-performing provider within the client&#8217;s vendor portfolio.\n        </p>\n\n    </div>\n\n\n\n    <div class=\"cc-result\">\n\n        <strong>30%</strong>\n\n        <span class=\"cc-result-title\">\n            Cost Savings\n        </span>\n\n        <p>\n            Lower costs across both English and Spanish queues.\n        </p>\n\n    </div>\n\n\n\n    <div class=\"cc-result\">\n\n        <strong>6×</strong>\n\n        <span class=\"cc-result-title\">\n            Team Scale\n        </span>\n\n        <p>\n            Expansion from 10 agents to a 60-agent bilingual operation.\n        </p>\n\n    </div>\n\n\n\n    <div class=\"cc-result\">\n\n        <strong>54</strong>\n\n        <span class=\"cc-result-title\">\n            Days of AEP\n        </span>\n\n        <p>\n            Continuous peak-season delivery throughout enrollment.\n        </p>\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     CHALLENGE\n========================================================= -->\n\n<section class=\"cc-section\">\n\n\n    <div class=\"cc-heading\">\n\n\n        <span class=\"cc-heading-number\">\n            01\n        </span>\n\n\n        <h2>\n            The Business Challenge\n        </h2>\n\n\n    </div>\n\n\n\n    <div class=\"cc-challenge\">\n\n\n        <p>\n\n            The client&#8217;s bilingual operations were distributed across several\n            vendors, creating inconsistency in Spanish-language support while\n            making native-equivalent bilingual recruitment increasingly\n            difficult.\n\n        </p>\n\n\n        <p>\n\n            With AEP approaching on a fixed calendar, the operation needed to\n            ramp quickly without sacrificing readiness, service quality or\n            coverage.\n\n        </p>\n\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     APPROACH\n========================================================= -->\n\n<section class=\"cc-section\">\n\n\n    <div class=\"cc-heading\">\n\n\n        <span class=\"cc-heading-number\">\n            02\n        </span>\n\n\n        <h2>\n            The Centro Approach\n        </h2>\n\n\n    </div>\n\n\n\n    <div class=\"cc-strategy-grid\">\n\n\n        <div class=\"cc-strategy-card\">\n\n\n            <span class=\"cc-strategy-index\">\n                01\n            </span>\n\n\n            <h3>\n                Accelerated Onboarding\n            </h3>\n\n\n            <p>\n\n                A concentrated training and nesting model helped agents move\n                into production quickly while establishing clear operational\n                expectations from the start.\n\n            </p>\n\n\n        </div>\n\n\n\n        <div class=\"cc-strategy-card\">\n\n\n            <span class=\"cc-strategy-index\">\n                02\n            </span>\n\n\n            <h3>\n                Bilingual Talent\n            </h3>\n\n\n            <p>\n\n                Recruitment focused on high-level English and Spanish fluency\n                suited to complex insurance conversations and customer needs.\n\n            </p>\n\n\n        </div>\n\n\n\n        <div class=\"cc-strategy-card\">\n\n\n            <span class=\"cc-strategy-index\">\n                03\n            </span>\n\n\n            <h3>\n                Quality Alignment\n            </h3>\n\n\n            <p>\n\n                Frequent business reviews and calibration kept Centro and\n                client leadership aligned as the operation scaled.\n\n            </p>\n\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     SCALE\n========================================================= -->\n\n<section class=\"cc-scale\">\n\n\n    <div class=\"cc-scale-point\">\n\n\n        <strong>\n            10\n        </strong>\n\n\n        <span>\n            Agents at launch\n        </span>\n\n\n    </div>\n\n\n\n    <div class=\"cc-scale-arrow\"></div>\n\n\n\n    <div class=\"cc-scale-point\">\n\n\n        <strong>\n            60\n        </strong>\n\n\n        <span>\n            Agents at peak scale\n        </span>\n\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     IMPACT\n========================================================= -->\n\n<section class=\"cc-impact\">\n\n\n    <span class=\"cc-impact-label\">\n\n        Business Impact\n\n    </span>\n\n\n    <h2>\n\n        From a new vendor to a trusted strategic operation.\n\n    </h2>\n\n\n\n    <div class=\"cc-impact-grid\">\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Ranked first against five other BPO providers and the\n                client&#8217;s internal operation.\n\n            </span>\n\n\n        </div>\n\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Delivered approximately 30% cost savings across English\n                and Spanish queues.\n\n            </span>\n\n\n        </div>\n\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Expanded from 10 agents into a 60-agent bilingual operation.\n\n            </span>\n\n\n        </div>\n\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Earned ownership of the client&#8217;s Spanish-language service\n                operation.\n\n            </span>\n\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     TAKEAWAY\n========================================================= -->\n\n<section class=\"cc-takeaway\">\n\n\n    <span class=\"cc-takeaway-label\">\n\n        The Takeaway\n\n    </span>\n\n\n    <h2>\n\n        Peak-season outsourcing works when scalability and execution move together.\n\n    </h2>\n\n\n    <p>\n\n        The engagement demonstrates how disciplined onboarding, bilingual\n        talent and consistent operational alignment can turn a demanding\n        seasonal requirement into a stronger long-term outsourcing\n        partnership.\n\n    </p>\n\n\n</section>\n\n\n\n<!-- =========================================================\n     CTA\n========================================================= -->\n\n<section class=\"cc-cta\">\n\n\n    <div class=\"cc-cta-content\">\n\n\n        <span class=\"cc-cta-label\">\n\n            Build Your Operation\n\n        </span>\n\n\n        <h2>\n\n            Need customer support that can scale when demand does?\n\n        </h2>\n\n\n        <p>\n\n            Explore Centro&#8217;s Contact Center Outsourcing capabilities and build\n            an operation designed around your customers, volumes and\n            performance requirements.\n\n        </p>\n\n\n\n        <div class=\"cc-buttons\">\n\n\n            <a\n                class=\"cc-btn cc-btn-primary\"\n                href=\"https://centrocdx.com/bpo/\"\n            >\n\n                Explore BPO Solutions\n\n            </a>\n\n\n\n            <a\n                class=\"cc-btn cc-btn-secondary\"\n                href=\"https://centrocdx.com/get-in-touch/\"\n            >\n\n                Get in Touch\n\n            </a>\n\n\n        </div>\n\n\n    </div>\n\n\n</section>\n\n\n</div>\n\n</div>\n\n</article>"
        }
      ]
    }
  ],
