                        <contentBlocks>
      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
      "key": "85f1ba19-8450-4b7e-b567-26e0e9f220c6",
      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cc-wrap\">\n<section class=\"cc-hero\">\n\n\n    <div class=\"cc-hero-content\">\n\n        <div class=\"cc-eyebrow\">\n\n            <span class=\"cc-eyebrow-dot\"></span>\n\n            Insurance BPO Case Study\n\n        </div>\n\n\n        <h1>\n\n            Bilingual Excellence\n\n            <span>at Scale.</span>\n\n        </h1>\n\n\n        <p class=\"cc-hero-description\">\n\n            How Centro built a high-performing bilingual operation for a\n            leading U.S. insurance brokerage while improving cost efficiency,\n            coverage and peak-season performance.\n\n        </p>\n\n    </div>\n\n\n\n    \n\n    <div class=\"cc-hero-visual\" aria-hidden=\"true\">\n\n\n        <div class=\"cc-icon-orbit cc-icon-orbit-one\"></div>\n\n        <div class=\"cc-icon-orbit cc-icon-orbit-two\"></div>\n\n        <div class=\"cc-icon-orbit cc-icon-orbit-three\"></div>\n\n\n        <div class=\"cc-insurance-icon\">\n\n\n            <div class=\"cc-shield\">\n\n\n                <div class=\"cc-shield-inner\">\n\n\n                    <span class=\"cc-checkmark\"></span>\n\n\n                </div>\n\n\n            </div>\n\n\n        </div>\n\n\n        <div class=\"cc-security-label\">\n\n            <span class=\"cc-security-dot\"></span>\n\n            Bilingual Insurance Support\n\n        </div>\n\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
      "key": "100c80d4-c8e6-4beb-b2b9-5dd58b2e41fa",
      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cc-wrap\">\n<section class=\"cc-results\">\n\n\n    <div class=\"cc-result\">\n\n        <strong>#1</strong>\n\n        <span class=\"cc-result-title\">\n            Vendor Ranking\n        </span>\n\n        <p>\n            Top-performing provider within the client&#8217;s vendor portfolio.\n        </p>\n\n    </div>\n\n\n\n    <div class=\"cc-result\">\n\n        <strong>30%</strong>\n\n        <span class=\"cc-result-title\">\n            Cost Savings\n        </span>\n\n        <p>\n            Lower costs across both English and Spanish queues.\n        </p>\n\n    </div>\n\n\n\n    <div class=\"cc-result\">\n\n        <strong>6×</strong>\n\n        <span class=\"cc-result-title\">\n            Team Scale\n        </span>\n\n        <p>\n            Expansion from 10 agents to a 60-agent bilingual operation.\n        </p>\n\n    </div>\n\n\n\n    <div class=\"cc-result\">\n\n        <strong>54</strong>\n\n        <span class=\"cc-result-title\">\n            Days of AEP\n        </span>\n\n        <p>\n            Continuous peak-season delivery throughout enrollment.\n        </p>\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
      "key": "b04478ab-7cdf-41aa-89b9-581cbbcddbb0",
      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cc-wrap\">\n<section class=\"cc-section\">\n\n\n    <div class=\"cc-heading\">\n\n\n        <span class=\"cc-heading-number\">\n            01\n        </span>\n\n\n        <h2>\n            The Business Challenge\n        </h2>\n\n\n    </div>\n\n\n\n    <div class=\"cc-challenge\">\n\n\n        <p>\n\n            The client&#8217;s bilingual operations were distributed across several\n            vendors, creating inconsistency in Spanish-language support while\n            making native-equivalent bilingual recruitment increasingly\n            difficult.\n\n        </p>\n\n\n        <p>\n\n            With AEP approaching on a fixed calendar, the operation needed to\n            ramp quickly without sacrificing readiness, service quality or\n            coverage.\n\n        </p>\n\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
      "key": "d2c23618-d621-48a4-a009-70fab11842ff",
      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cc-wrap\">\n<section class=\"cc-section\">\n\n\n    <div class=\"cc-heading\">\n\n\n        <span class=\"cc-heading-number\">\n            02\n        </span>\n\n\n        <h2>\n            The Centro Approach\n        </h2>\n\n\n    </div>\n\n\n\n    <div class=\"cc-strategy-grid\">\n\n\n        <div class=\"cc-strategy-card\">\n\n\n            <span class=\"cc-strategy-index\">\n                01\n            </span>\n\n\n            <h3>\n                Accelerated Onboarding\n            </h3>\n\n\n            <p>\n\n                A concentrated training and nesting model helped agents move\n                into production quickly while establishing clear operational\n                expectations from the start.\n\n            </p>\n\n\n        </div>\n\n\n\n        <div class=\"cc-strategy-card\">\n\n\n            <span class=\"cc-strategy-index\">\n                02\n            </span>\n\n\n            <h3>\n                Bilingual Talent\n            </h3>\n\n\n            <p>\n\n                Recruitment focused on high-level English and Spanish fluency\n                suited to complex insurance conversations and customer needs.\n\n            </p>\n\n\n        </div>\n\n\n\n        <div class=\"cc-strategy-card\">\n\n\n            <span class=\"cc-strategy-index\">\n                03\n            </span>\n\n\n            <h3>\n                Quality Alignment\n            </h3>\n\n\n            <p>\n\n                Frequent business reviews and calibration kept Centro and\n                client leadership aligned as the operation scaled.\n\n            </p>\n\n\n        </div>\n\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000002",
      "key": "117b7d31-f782-4a1e-90a6-2c2998ab98bd",
      "values": [
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<div class=\"cc-wrap\">\n<section class=\"cc-impact\">\n\n\n    <span class=\"cc-impact-label\">\n\n        Business Impact\n\n    </span>\n\n\n    <h2>\n\n        From a new vendor to a trusted strategic operation.\n\n    </h2>\n\n\n\n    <div class=\"cc-impact-grid\">\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Ranked first against five other BPO providers and the\n                client&#8217;s internal operation.\n\n            </span>\n\n\n        </div>\n\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Delivered approximately 30% cost savings across English\n                and Spanish queues.\n\n            </span>\n\n\n        </div>\n\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Expanded from 10 agents into a 60-agent bilingual operation.\n\n            </span>\n\n\n        </div>\n\n\n\n        <div class=\"cc-impact-item\">\n\n\n            <span class=\"cc-check\">\n                ✓\n            </span>\n\n\n            <span>\n\n                Earned ownership of the client&#8217;s Spanish-language service\n                operation.\n\n            </span>\n\n\n        </div>\n\n\n    </div>\n\n\n</section>\n</div>"
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000006",
      "key": "b599c495-007b-443b-932b-e3f3bcf148d5",
      "values": [
        {
          "alias": "label",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Key Takeaway"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Bilingual excellence is not just translation—it is cultural fluency, seamless system integration, and consistent brand representation across every touchpoint."
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000008",
      "key": "a0fa623e-1918-421f-ac0f-e6d755232352",
      "values": [
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Insurance BPO Case Study"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Scale Your Operations with High-Performing Bilingual Teams"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Partner with Centro to deliver exceptional, high-touch support across English and Spanish customer bases."
        },
        {
          "alias": "buttonLabel",
          "culture": "en-US",
