      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "78083db2-98ce-473f-818e-6815cd811151",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Prior Authorization in 2026: CMS-0057-F Guide | Centro</title>\n  <meta name=\"description\" content=\"See what CMS-0057-F changed for prior authorization in 2026, what remains manual, and how providers can use denial data and payer benchmarks.\">\n  <meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n  <link rel=\"canonical\" href=\"https://prior-authorization-2026.gehad-19.chatgpt.site/\">\n  <meta property=\"og:type\" content=\"article\">\n  <meta property=\"og:url\" content=\"https://prior-authorization-2026.gehad-19.chatgpt.site/\">\n  <meta property=\"og:title\" content=\"Prior Authorization in 2026: CMS-0057-F Guide\">\n  <meta property=\"og:description\" content=\"See what CMS-0057-F changed for prior authorization in 2026, what remains manual, and how providers can use denial data and payer benchmarks.\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:title\" content=\"Prior Authorization in 2026: CMS-0057-F Guide\">\n  <meta name=\"twitter:description\" content=\"See what CMS-0057-F changed for prior authorization in 2026, what remains manual, and how providers can use denial data and payer benchmarks.\">\n  <style>\n    .pa-wrap{\n      --navy:#014f70;\n      --deep:#06394d;\n      --teal:#009dbc;\n      --cyan:#67e2ee;\n      --aqua:#dff7f8;\n      --ice:#f2f9fa;\n      --mist:#f8fbfc;\n      --ink:#193c4a;\n      --body:#536a75;\n      --line:#cfdee3;\n      --orange:#ec9c43;\n      --green:#16856f;\n      width:100%;\n      max-width:780px;\n      margin:0 auto;\n      background:#fff;\n      color:var(--body);\n      font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Arial,sans-serif;\n      font-size:16px;\n      line-height:1.75;\n    }\n    .pa-wrap,.pa-wrap *{box-sizing:border-box}\n    .pa-wrap button{font:inherit}\n    .pa-wrap a{color:var(--navy);font-weight:720;text-decoration-color:var(--cyan);text-decoration-thickness:1.5px;text-underline-offset:4px;transition:color .2s,background-color .2s}\n    .pa-wrap a:hover{color:var(--teal);background:rgba(103,226,238,.12)}\n    .pa-wrap a:focus-visible,.pa-wrap button:focus-visible,.pa-wrap summary:focus-visible{outline:3px solid var(--cyan);outline-offset:3px}\n    .pa-progress{position:fixed;z-index:9999;top:0;left:0;width:100%;height:4px;pointer-events:none}\n    .pa-progress span{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--navy),var(--teal),var(--cyan));transform:scaleX(0);transform-origin:left}\n    .pa-page{width:100%;padding:0 0 58px;overflow-x:clip}\n    .pa-main{display:grid;grid-template-columns:180px minmax(0,1fr);column-gap:30px;align-items:start}\n    .pa-main p{margin:0 0 22px;color:var(--body);font-size:1rem;line-height:1.75}\n    .pa-main strong{color:var(--ink)}\n    .pa-intro{grid-column:2;grid-row:1;padding-bottom:28px;border-bottom:1px solid var(--line)}\n\n    /* Compact moving signal field */\n    .pa-signal-field{position:relative;isolation:isolate;min-height:176px;margin-top:30px;overflow:hidden;border:1px solid #0a6681;background:linear-gradient(135deg,var(--deep),#046b87);color:#fff}\n    .pa-signal-field::before{content:\"\";position:absolute;z-index:-2;inset:-45%;background-image:linear-gradient(rgba(103,226,238,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(103,226,238,.14) 1px,transparent 1px);background-size:34px 34px;transform:perspective(400px) rotateX(54deg) rotateZ(-12deg);animation:pa-grid-drift 15s linear infinite}\n    .pa-signal-field::after{content:\"\";position:absolute;z-index:-1;width:230px;height:230px;right:-55px;top:-110px;border:1px solid rgba(103,226,238,.36);border-radius:50%;box-shadow:0 0 0 36px rgba(103,226,238,.06),0 0 0 72px rgba(103,226,238,.04);animation:pa-orbit 9s ease-in-out infinite}\n    .pa-orb{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 7px rgba(103,226,238,.12),0 0 20px var(--cyan);animation:pa-pulse 2.6s ease-in-out infinite}\n    .pa-orb.one{left:11%;top:31%}.pa-orb.two{left:47%;top:72%;animation-delay:-1s}.pa-orb.three{right:19%;top:39%;animation-delay:-1.8s}\n    .pa-field-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px 19px 0}\n    .pa-live{display:inline-flex;align-items:center;gap:8px;color:#bdeef3;font-size:.66rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}\n    .pa-live::before{content:\"\";width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 5px rgba(103,226,238,.12)}\n    .pa-phase{color:#bdeef3;font-size:.68rem;font-weight:700}\n    .pa-field-values{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:23px 19px 19px;background:rgba(255,255,255,.2)}\n    .pa-field-value{min-width:0;padding:16px;background:rgba(4,72,94,.82);backdrop-filter:blur(5px)}\n    .pa-field-value strong{display:block;color:#fff;font-size:1.65rem;line-height:1;letter-spacing:-.04em}\n    .pa-field-value span{display:block;margin-top:7px;color:#cbeff3;font-size:.68rem;line-height:1.4}\n\n    .pa-jump{position:sticky;z-index:20;top:24px;grid-column:1;grid-row:1 / span 8;align-self:start;display:flex;flex-direction:column;gap:0;margin:0;padding:0;background:#fff;overflow:hidden}\n    .pa-toc-title{display:block;padding:0 0 12px;color:var(--ink);border-bottom:1px solid var(--line);font-size:.68rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}\n    .pa-jump button{display:grid;grid-template-columns:31px minmax(0,1fr);align-items:center;width:100%;padding:10px 7px 10px 0;border:0;border-left:1px solid var(--line);background:transparent;color:var(--body);font-size:.69rem;font-weight:760;line-height:1.35;text-align:left;cursor:pointer;transition:.2s}\n    .pa-jump button span{color:#91a4ad;font-size:.63rem;font-weight:850;text-align:center;transition:color .2s}\n    .pa-jump button:hover,.pa-jump button.active{border-left-color:var(--teal);background:linear-gradient(90deg,var(--ice),#fff);color:var(--navy);box-shadow:inset 2px 0 0 var(--teal)}\n    .pa-jump button:hover span,.pa-jump button.active span{color:var(--teal)}\n    .pa-section{grid-column:2;margin:54px 0 0;scroll-margin-top:24px}\n    .pa-section-head{display:grid;grid-template-columns:105px minmax(0,1fr);gap:18px;align-items:start;padding-top:22px;border-top:1px solid var(--line)}\n    .pa-tag{display:inline-flex;align-items:center;gap:7px;margin-top:4px;color:var(--teal);font-size:.64rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}\n    .pa-tag::before{content:\"\";width:9px;height:9px;border:2px solid var(--teal);border-radius:50%}\n    .pa-section h2,.pa-faq h2,.pa-close h2{margin:0;color:var(--navy);font-size:clamp(1.65rem,3.2vw,2.1rem);font-weight:570;line-height:1.15;letter-spacing:-.035em}\n    .pa-section h3{margin:29px 0 12px;color:var(--ink);font-size:1.12rem;line-height:1.35}\n    .pa-section-body{margin-top:23px}\n    .pa-callout{margin:26px 0;padding:20px 22px;border-left:3px solid var(--teal);background:linear-gradient(90deg,var(--ice),#fff);color:var(--ink)}\n    .pa-callout p{margin:0}\n\n    /* Deadline console */\n    .pa-deadline{margin:28px 0;border:1px solid var(--line);background:#fff}\n    .pa-deadline-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 19px;background:var(--deep);color:#fff}\n    .pa-deadline-head b{color:#fff;font-size:.91rem}\n    .pa-deadline-head span{color:var(--cyan);font-size:.66rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}\n    .pa-deadline-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}\n    .pa-deadline-tabs button{padding:12px 8px;border:0;background:var(--mist);color:var(--body);font-size:.69rem;font-weight:800;cursor:pointer}\n    .pa-deadline-tabs button:hover,.pa-deadline-tabs button.active{background:#fff;color:var(--navy);box-shadow:inset 0 -3px 0 var(--cyan)}\n    .pa-deadline-panel{display:grid;grid-template-columns:130px minmax(0,1fr);gap:23px;align-items:center;min-height:190px;padding:25px}\n    .pa-dial{--fill:72;position:relative;display:grid;place-content:center;width:112px;height:112px;border-radius:50%;background:conic-gradient(var(--teal) calc(var(--fill)*1%),var(--line) 0)}\n    .pa-dial::before{content:\"\";position:absolute;inset:8px;border-radius:50%;background:#fff}\n    .pa-dial-value{position:relative;z-index:1;color:var(--navy);font-size:1.45rem;font-weight:850;line-height:1;text-align:center}\n    .pa-dial-value small{display:block;margin-top:6px;color:#7b9099;font-size:.56rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}\n    .pa-deadline-copy h3{margin:0 0 8px;color:var(--navy);font-size:1.06rem}\n    .pa-deadline-copy p{margin:0;color:var(--body);font-size:.82rem;line-height:1.65}\n\n    /* Benchmarks */\n    .pa-benchmark{margin:28px 0;border:1px solid var(--line)}\n    .pa-benchmark-top{padding:18px 20px;background:var(--ice)}\n    .pa-benchmark-top b{display:block;color:var(--navy);font-size:.92rem}\n    .pa-benchmark-top span{color:#748b96;font-size:.68rem}\n    .pa-payer-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}\n    .pa-payer-tabs button{min-width:0;padding:15px 8px;border:0;background:#fff;color:var(--body);cursor:pointer}\n    .pa-payer-tabs button strong{display:block;color:var(--navy);font-size:1.26rem;line-height:1}\n    .pa-payer-tabs button span{display:block;margin-top:6px;font-size:.63rem;font-weight:780;line-height:1.3}\n    .pa-payer-tabs button:hover,.pa-payer-tabs button.active{background:var(--deep);color:#d7f3f5}\n    .pa-payer-tabs button:hover strong,.pa-payer-tabs button.active strong{color:var(--cyan)}\n    .pa-benchmark-panel{padding:23px;background:#fff}\n    .pa-range{position:relative;height:9px;margin:25px 0 30px;background:linear-gradient(90deg,var(--aqua),#b7e9ed)}\n    .pa-range::before,.pa-range::after{position:absolute;top:14px;color:#81949d;font-size:.61rem;font-weight:750}\n    .pa-range::before{content:\"2%\";left:0}.pa-range::after{content:\"25%\";right:0}\n    .pa-range-marker{position:absolute;left:43.5%;top:50%;width:17px;height:17px;border:4px solid #fff;border-radius:50%;background:var(--orange);box-shadow:0 0 0 2px var(--orange);transform:translate(-50%,-50%);transition:left .35s ease}\n    .pa-benchmark-panel h3{margin:0 0 7px;color:var(--navy);font-size:1.02rem}\n    .pa-benchmark-panel p{margin:0;font-size:.8rem;line-height:1.62}\n    .pa-appeal{display:inline-flex;margin-top:14px;padding:6px 9px;background:var(--ice);color:var(--teal);font-size:.64rem;font-weight:850;letter-spacing:.05em;text-transform:uppercase}\n\n    /* Unchanged map */\n    .pa-unchanged{display:grid;grid-template-columns:220px minmax(0,1fr);margin:28px 0;border:1px solid var(--line);min-height:305px}\n    .pa-unchanged-list{background:var(--mist);border-right:1px solid var(--line)}\n    .pa-unchanged-list button{display:block;width:100%;padding:13px 15px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--body);font-size:.7rem;font-weight:780;line-height:1.35;text-align:left;cursor:pointer}\n    .pa-unchanged-list button:last-child{border-bottom:0}\n    .pa-unchanged-list button:hover,.pa-unchanged-list button.active{background:#fff;color:var(--navy);box-shadow:inset 3px 0 0 var(--teal)}\n    .pa-unchanged-panel{padding:24px}\n    .pa-unchanged-icon{display:grid;place-content:center;width:44px;height:44px;margin-bottom:16px;border:1px solid var(--line);border-radius:50%;background:var(--ice);color:var(--teal);font-weight:850}\n    .pa-unchanged-panel h3{margin:0 0 9px;color:var(--navy);font-size:1.05rem}\n    .pa-unchanged-panel p{margin:0;font-size:.8rem;line-height:1.65}\n\n    /* Operational actions */\n    .pa-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:27px 0;background:var(--line);border:1px solid var(--line)}\n    .pa-stat{padding:17px 13px;background:#fff}\n    .pa-stat strong{display:block;color:var(--navy);font-size:1.45rem;line-height:1;letter-spacing:-.04em}\n    .pa-stat span{display:block;margin-top:7px;color:var(--body);font-size:.65rem;line-height:1.42}\n    .pa-action-board{margin:27px 0;border:1px solid var(--line)}\n    .pa-action-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 19px;background:var(--deep);color:#fff}\n    .pa-action-head b{color:#fff;font-size:.9rem}.pa-action-head span{color:var(--cyan);font-size:.68rem;font-weight:850}\n    .pa-action{display:grid;width:100%;grid-template-columns:34px minmax(0,1fr);gap:13px;padding:18px 20px;border:0;border-bottom:1px solid var(--line);border-radius:0;background:#fff;color:inherit;text-align:left;cursor:pointer;transition:.2s}\n    .pa-action:last-child{border-bottom:0}.pa-action:hover{background:var(--mist)}\n    .pa-check{display:grid;place-content:center;width:25px;height:25px;margin-top:2px;border:1.5px solid var(--line);color:transparent;font-size:.8rem;transition:.2s}\n    .pa-action.done .pa-check{border-color:var(--green);background:var(--green);color:#fff}\n    .pa-action b{display:block;color:var(--navy);font-size:.84rem}.pa-action p{margin:3px 0 0;font-size:.75rem;line-height:1.55}\n\n    /* API runway */\n    .pa-runway{position:relative;isolation:isolate;margin:28px 0;overflow:hidden;border:1px solid #0b6c85;background:var(--deep);color:#fff}\n    .pa-runway::before{content:\"\";position:absolute;z-index:-1;inset:0;background:radial-gradient(circle at 20% 10%,rgba(103,226,238,.16),transparent 35%),linear-gradient(90deg,transparent 49.7%,rgba(103,226,238,.08) 50%,transparent 50.3%);background-size:auto,32px 100%;animation:pa-runway-shift 8s linear infinite}\n    .pa-runway-head{display:flex;justify-content:space-between;gap:16px;padding:18px 20px;border-bottom:1px solid rgba(255,255,255,.14)}\n    .pa-runway-head b{color:#fff;font-size:.9rem}.pa-runway-head span{color:var(--cyan);font-size:.67rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}\n    .pa-api-line{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:29px 22px 27px}\n    .pa-api-line::before{content:\"\";position:absolute;left:12%;right:12%;top:49px;height:2px;background:linear-gradient(90deg,rgba(103,226,238,.3),var(--cyan),rgba(103,226,238,.3));background-size:200% 100%;animation:pa-flow 3s linear infinite}\n    .pa-api-node{position:relative;z-index:1;text-align:center}\n    .pa-api-node i{display:grid;place-content:center;width:43px;height:43px;margin:0 auto 9px;border:1px solid rgba(103,226,238,.65);border-radius:50%;background:var(--deep);color:var(--cyan);font-style:normal;font-size:.73rem;font-weight:850;box-shadow:0 0 0 6px rgba(103,226,238,.06)}\n    .pa-api-node span{display:block;max-width:105px;margin:0 auto;color:#d4f1f3;font-size:.63rem;font-weight:760;line-height:1.35}\n    .pa-runway-note{padding:0 22px 23px;color:#c9e7eb;font-size:.75rem;line-height:1.6;text-align:center}\n\n    .pa-faq{grid-column:2;margin-top:54px;scroll-margin-top:24px}.pa-faq h2{margin-bottom:22px}\n    .pa-wrap details{border-top:1px solid var(--line)}.pa-wrap details:last-child{border-bottom:1px solid var(--line)}\n    .pa-wrap summary{position:relative;padding:20px 44px 20px 0;color:var(--ink);font-weight:760;line-height:1.45;cursor:pointer;list-style:none}\n    .pa-wrap summary::-webkit-details-marker{display:none}\n    .pa-wrap summary::after{content:\"+\";position:absolute;right:8px;top:17px;color:var(--teal);font-size:1.4rem;font-weight:400;transition:transform .2s}\n    .pa-wrap details[open] summary::after{transform:rotate(45deg)}\n    .pa-wrap details p{padding:0 40px 20px 0;margin:0}\n    .pa-close{grid-column:2;margin:54px 0 0;padding:29px clamp(20px,4vw,34px);border:1px solid var(--line);background:linear-gradient(135deg,var(--aqua),#fff)}\n    .pa-close h2{margin-bottom:18px}.pa-close p:last-of-type{margin-bottom:8px}\n    .pa-wrap a.pa-cta{display:inline-flex;align-items:center;gap:12px;margin-top:4px;padding:13px 19px;background:var(--teal)!important;color:#fff!important;text-decoration:none!important;box-shadow:none!important}\n    .pa-wrap a.pa-cta::after{content:\"→\";color:#fff;font-size:1.1rem;transition:transform .2s}.pa-wrap a.pa-cta:hover{background:var(--navy)!important;color:#fff!important}.pa-wrap a.pa-cta:hover::after{transform:translateX(4px)}\n    .pa-main p.pa-entity{grid-column:2;margin:24px 0 0;padding:18px 0 0;border-top:1px solid var(--line);color:#70858f;font-size:.78rem;line-height:1.65}\n    .pa-motion .pa-reveal{opacity:0;transform:translateY(16px);transition:opacity .55s ease,transform .55s ease}.pa-motion .pa-reveal.in{opacity:1;transform:none}\n    @keyframes pa-grid-drift{to{transform:perspective(400px) rotateX(54deg) rotateZ(-12deg) translate3d(34px,34px,0)}}\n    @keyframes pa-orbit{50%{transform:translate(-22px,18px) scale(1.05)}}\n    @keyframes pa-pulse{50%{opacity:.45;transform:scale(.72)}}\n    @keyframes pa-runway-shift{to{background-position:0 0,32px 0}}\n    @keyframes pa-flow{to{background-position:-200% 0}}\n    @media(max-width:700px){\n      .pa-wrap{max-width:100%}.pa-main{display:block}.pa-jump{position:relative;top:auto;display:flex;flex-direction:row;gap:6px;margin:0 0 40px;padding:10px 0;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:thin}.pa-toc-title{display:none}.pa-jump button{display:block;flex:0 0 auto;width:auto;padding:7px 10px;border:1px solid transparent;text-align:center}.pa-jump button span{display:none}.pa-jump button:hover,.pa-jump button.active{border-color:var(--teal);box-shadow:none}.pa-section-head{grid-template-columns:1fr;gap:7px}.pa-tag{margin-top:0}\n      .pa-unchanged{grid-template-columns:1fr}.pa-unchanged-list{display:flex;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line)}.pa-unchanged-list button{flex:0 0 165px;border-right:1px solid var(--line);border-bottom:0}.pa-unchanged-list button:hover,.pa-unchanged-list button.active{box-shadow:inset 0 -3px 0 var(--teal)}\n    }\n    @media(max-width:520px){\n      .pa-field-values,.pa-stat-grid{grid-template-columns:repeat(2,1fr)}.pa-field-value:nth-child(3){grid-column:1/-1}\n      .pa-deadline-tabs{grid-template-columns:repeat(2,1fr)}.pa-deadline-panel{grid-template-columns:1fr;min-height:0}.pa-dial{margin:0 auto}.pa-deadline-copy{text-align:center}\n      .pa-payer-tabs{grid-template-columns:1fr}.pa-payer-tabs button{display:grid;grid-template-columns:55px 1fr;align-items:center;text-align:left}.pa-payer-tabs button span{margin-top:0}\n      .pa-api-line{gap:4px;padding-left:10px;padding-right:10px}.pa-api-node span{font-size:.57rem}\n    }\n    @media(prefers-reduced-motion:reduce){\n      .pa-wrap *,.pa-wrap *::before,.pa-wrap *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}\n      .pa-motion .pa-reveal{opacity:1;transform:none}\n    }\n  </style>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\":\"https://schema.org\",\n    \"@type\":\"Article\",\n    \"headline\":\"Prior Authorization in 2026: What CMS-0057-F Changed, and What It Didn't\",\n    \"description\":\"See what CMS-0057-F changed for prior authorization in 2026, what remains manual, and how providers can use denial data and payer benchmarks.\",\n    \"url\":\"https://prior-authorization-2026.gehad-19.chatgpt.site/\",\n    \"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://prior-authorization-2026.gehad-19.chatgpt.site/\"},\n    \"author\":{\"@type\":\"Organization\",\"name\":\"Centro\"},\n    \"publisher\":{\"@type\":\"Organization\",\"name\":\"Centro\",\"url\":\"https://centrocdx.com/\"},\n    \"articleSection\":[\"Prior Authorization\",\"Revenue Cycle Management\",\"CMS-0057-F\",\"Healthcare Operations\"],\n    \"keywords\":[\"prior authorization 2026\",\"CMS-0057-F\",\"Medicare Advantage prior authorization\",\"prior authorization API\",\"denial management\"],\n    \"inLanguage\":\"en-US\"\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\":\"https://schema.org\",\n    \"@type\":\"FAQPage\",\n    \"mainEntity\":[\n      {\"@type\":\"Question\",\"name\":\"What is CMS-0057-F?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A federal rule finalized in January 2024 requiring impacted payers to improve prior authorization decision timelines, provide denial reasons, report metrics publicly, and implement standardized API connections by January 2027.\"}},\n      {\"@type\":\"Question\",\"name\":\"What changed on January 1, 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Impacted payers must now decide expedited requests within 72 hours, standard requests within seven calendar days, and include a specific reason with every denial.\"}},\n      {\"@type\":\"Question\",\"name\":\"Does CMS-0057-F apply to commercial insurance or drug prior authorizations?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No to both. The rule covers Medicare Advantage, Medicaid and CHIP managed care, and Qualified Health Plan issuers on the federally facilitated exchanges. Commercial plans are excluded. The rule applies to medical items and services only, not prescription drugs.\"}},\n      {\"@type\":\"Question\",\"name\":\"Where can I find payer prior authorization metrics?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Impacted payers publish these on their public-facing websites annually. The first reports, covering 2025, were due March 31, 2026.\"}},\n      {\"@type\":\"Question\",\"name\":\"When does the Prior Authorization API go live?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"January 1, 2027. Four FHIR-based API connections will be required for all impacted payers.\"}}\n    ]\n  }\n  </script>\n</head>\n<body>\n  <div class=\"pa-wrap\" id=\"pa-top\">\n    <div class=\"pa-progress\" aria-hidden=\"true\"><span></span></div>\n    <main class=\"pa-page\">\n      <article class=\"pa-main\">\n        <div class=\"pa-intro\">\n          <p>CMS-0057-F changed how fast insurers have to respond to prior authorization requests, forced them to explain every denial, and made them publish their approval and denial rates publicly for the first time.</p>\n          <p>What it did not change is the volume of requests landing on your desk, the manual submission methods most practices still use, or the clinical criteria insurers apply when they decide to deny.</p>\n          <p>That split defines where your team stands today. Your staff is still spending 13 hours a week on a process that got faster on the payer side but no lighter on yours.</p>\n          <p>But where does the operational value actually sit, and what should your team be doing differently right now? Here’s what you need to know.</p>\n          <div class=\"pa-signal-field\" aria-label=\"Key CMS-0057-F deadlines\">\n            <span class=\"pa-orb one\" aria-hidden=\"true\"></span><span class=\"pa-orb two\" aria-hidden=\"true\"></span><span class=\"pa-orb three\" aria-hidden=\"true\"></span>\n            <div class=\"pa-field-head\"><span class=\"pa-live\">Rule in effect</span><span class=\"pa-phase\">Operations phase · 2026</span></div>\n            <div class=\"pa-field-values\">\n              <div class=\"pa-field-value\"><strong>72h</strong><span>Expedited decision window</span></div>\n              <div class=\"pa-field-value\"><strong>7 days</strong><span>Standard decision window</span></div>\n              <div class=\"pa-field-value\"><strong>2027</strong><span>FHIR API phase begins</span></div>\n            </div>\n          </div>\n        </div>\n\n        <nav class=\"pa-jump\" aria-label=\"Article sections\">\n          <span class=\"pa-toc-title\">In this article</span>\n          <button type=\"button\" data-target=\"changed\"><span>01</span>What changed</button>\n          <button type=\"button\" data-target=\"metrics\"><span>02</span>First metrics</button>\n          <button type=\"button\" data-target=\"unchanged\"><span>03</span>What did not</button>\n          <button type=\"button\" data-target=\"actions\"><span>04</span>Act now</button>\n          <button type=\"button\" data-target=\"api\"><span>05</span>2027 API</button>\n          <button type=\"button\" data-target=\"faq\"><span>FAQ</span>Questions answered</button>\n        </nav>\n\n        <section class=\"pa-section pa-reveal\" id=\"changed\">\n          <div class=\"pa-section-head\"><span class=\"pa-tag\">Phase 01</span><h2>What CMS-0057-F Changed on January 1, 2026</h2></div>\n          <div class=\"pa-section-body\">\n            <p>The CMS interoperability and prior authorization final rule, finalized in January 2024 and shortened to CMS-0057-F, split its requirements into two phases. The first phase landed on January 1, 2026, targeting operations and not technical infrastructure.</p>\n            <p>Three requirements are now in effect: expedited prior authorization requests must receive a decision within 72 hours, standard requests must receive one within seven calendar days, and every denial must include a specific, documented reason.</p>\n            <div class=\"pa-deadline\" aria-labelledby=\"pa-deadline-title\">\n              <div class=\"pa-deadline-head\"><b id=\"pa-deadline-title\">Explore the 2026 requirements</b><span>Choose a rule</span></div>\n              <div class=\"pa-deadline-tabs\" role=\"tablist\" aria-label=\"CMS-0057-F requirements\">\n                <button type=\"button\" class=\"active\" role=\"tab\" aria-selected=\"true\" data-rule=\"expedited\">Expedited</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-rule=\"standard\">Standard</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-rule=\"reasons\">Denial reasons</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-rule=\"reporting\">Reporting</button>\n              </div>\n              <div class=\"pa-deadline-panel\" aria-live=\"polite\">\n                <div class=\"pa-dial\" id=\"pa-dial\"><span class=\"pa-dial-value\" id=\"pa-rule-value\">72h<small>deadline</small></span></div>\n                <div class=\"pa-deadline-copy\"><h3 id=\"pa-rule-title\">Expedited requests</h3><p id=\"pa-rule-copy\">Impacted payers must return a decision within 72 hours.</p></div>\n              </div>\n            </div>\n            <p>These requirements apply to Medicare Advantage prior authorization plans, Medicaid and CHIP managed care entities, state Medicaid and CHIP fee-for-service programs, and Qualified Health Plan issuers on the federally facilitated exchanges. Commercial and self-funded employer plans remain outside the rule entirely.</p>\n            <p>A fourth requirement followed close behind. By March 31, 2026, every impacted payer had to publicly report prior authorization metrics for 2025, including approval rates, denial rates, and response times.</p>\n          </div>\n        </section>\n\n        <section class=\"pa-section pa-reveal\" id=\"metrics\">\n          <div class=\"pa-section-head\"><span class=\"pa-tag\">Signal 02</span><h2>What the First Metrics Reports Revealed</h2></div>\n          <div class=\"pa-section-body\">\n            <p>The transparency requirement did what it was designed to do: it made the numbers visible. And those numbers tell a story most revenue cycle management teams already suspected.</p>\n            <p>A <a href=\"https://www.kff.org/patient-consumer-protections/prior-authorization-metrics-provide-new-insights-into-insurer-practices-but-gaps-remain/\" target=\"_blank\" rel=\"noopener\">KFF analysis of the first public reports</a> found that Medicare Advantage insurers denied 12% of standard prior authorization requests in 2025, while Medicaid managed care insurers denied 14%. ACA Marketplace insurers denied 18%.</p>\n            <div class=\"pa-benchmark\" aria-labelledby=\"pa-benchmark-title\">\n              <div class=\"pa-benchmark-top\"><b id=\"pa-benchmark-title\">2025 denial benchmark</b><span>Choose a market to compare denial and appeal outcomes.</span></div>\n              <div class=\"pa-payer-tabs\" role=\"tablist\" aria-label=\"Payer markets\">\n                <button type=\"button\" class=\"active\" role=\"tab\" aria-selected=\"true\" data-payer=\"ma\"><strong>12%</strong><span>Medicare Advantage</span></button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-payer=\"medicaid\"><strong>14%</strong><span>Medicaid managed care</span></button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-payer=\"aca\"><strong>18%</strong><span>ACA Marketplace</span></button>\n              </div>\n              <div class=\"pa-benchmark-panel\" aria-live=\"polite\">\n                <div class=\"pa-range\" aria-label=\"Denial rate range from 2 to 25 percent\"><span class=\"pa-range-marker\" id=\"pa-range-marker\"></span></div>\n                <h3 id=\"pa-payer-title\">Medicare Advantage: 12% denied</h3>\n                <p id=\"pa-payer-copy\">The first public reports show a meaningful denial burden—and a strong recovery signal once those denials are appealed.</p>\n                <span class=\"pa-appeal\" id=\"pa-appeal\">66% overturned on appeal</span>\n              </div>\n            </div>\n            <p>This showcases that denial rates varied widely by insurer, ranging from 2% to 25%.</p>\n            <p>The appeal numbers expose the real cost. Two-thirds of Medicare Advantage denials were overturned on appeal, 47% in Medicaid managed care, and 43% in the ACA Marketplace.</p>\n            <div class=\"pa-callout\"><p>Most denied revenue was recoverable, but only if someone had the capacity and the clinical documentation to pursue it.</p></div>\n          </div>\n        </section>\n\n        <section class=\"pa-section pa-reveal\" id=\"unchanged\">\n          <div class=\"pa-section-head\"><span class=\"pa-tag\">Gap 03</span><h2>What CMS-0057-F Did Not Change</h2></div>\n          <div class=\"pa-section-body\">\n            <p>The 2026 provisions addressed speed and transparency, but they left the structural reasons prior authorization remains one of the most labor-intensive processes in healthcare completely intact.</p>\n            <div class=\"pa-unchanged\" aria-label=\"Areas not changed by CMS-0057-F\">\n              <div class=\"pa-unchanged-list\" role=\"tablist\" aria-label=\"Unchanged areas\">\n                <button type=\"button\" class=\"active\" role=\"tab\" aria-selected=\"true\" data-gap=\"drugs\">Drug authorizations</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-gap=\"commercial\">Commercial plans</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-gap=\"criteria\">Clinical criteria</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-gap=\"electronic\">Electronic adoption</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-gap=\"enforcement\">Provider enforcement</button>\n              </div>\n              <div class=\"pa-unchanged-panel\" aria-live=\"polite\">\n                <div class=\"pa-unchanged-icon\" id=\"pa-gap-icon\" aria-label=\"Prescription drug authorization\">Rx</div>\n                <h3 id=\"pa-gap-title\">Drug Prior Authorizations Are Excluded</h3>\n                <p id=\"pa-gap-copy\">The rule covers medical items and services only. Practices handling specialty pharmacy referrals or high-cost prescriptions will see no change. The fax machine, somehow, continues to outlive every wave of healthcare modernization. At this rate, it deserves a lifetime achievement award from CMS.</p>\n              </div>\n            </div>\n            <h3>Commercial and Employer-Sponsored Plans Are Not Covered</h3>\n            <p>Most physician practices serve a mixed payer panel. Even after every government-regulated plan complies, a significant share of authorization volume will still flow through manual channels with no federal timeline.</p>\n            <h3>The Rule Standardizes the Transaction While Clinical Criteria Stay With Payers</h3>\n            <p>Payers still write their own medical necessity policies. The 72-hour and seven-day windows guarantee a response, but they do nothing to reduce the likelihood that the response is a denial.</p>\n            <h3>Electronic Prior Authorization Adoption Is Still Low</h3>\n            <p>According to the <a href=\"https://www.caqh.org/core/priority-topics\" target=\"_blank\" rel=\"noopener\">2024 CAQH Index</a>, only 35% of prior authorization transactions were conducted fully electronically. The <a href=\"https://www.caqh.org/blog/2025-caqh-index-shows-u.s.-healthcare-avoided-258-billion-and-accelerated-automation-interoperability-and-ai-adoption\" target=\"_blank\" rel=\"noopener\">2025 CAQH Index</a> identified more than $20 billion in potential savings from broader automation across all administrative transactions, including prior authorization.</p>\n            <p>The rule created deadlines for decisions, but portal logins, phone calls, and fax cover sheets remain in play.</p>\n            <h3>Enforcement Mechanisms Are Undefined for Providers</h3>\n            <p>The rule places legal obligations on payers. If a payer misses the 72-hour window or omits a denial reason, compliance enforcement runs through CMS oversight of plan participation, and not through any channel a billing manager can access.</p>\n          </div>\n        </section>\n\n        <section class=\"pa-section pa-reveal\" id=\"actions\">\n          <div class=\"pa-section-head\"><span class=\"pa-tag\">Action 04</span><h2>What Your Team Can Actually Do With This Right Now</h2></div>\n          <div class=\"pa-section-body\">\n            <p>The <a href=\"https://www.ama-assn.org/practice-management/prior-authorization/ama-prior-authorization-physician-survey\" target=\"_blank\" rel=\"noopener\">2025 AMA Prior Authorization Physician Survey</a> found that practices complete an average of 40 prior authorization requests per physician per week, spending approximately 13 hours on the process.</p>\n            <div class=\"pa-stat-grid\" aria-label=\"Prior authorization workload statistics\">\n              <div class=\"pa-stat\"><strong>40</strong><span>requests per physician each week</span></div>\n              <div class=\"pa-stat\"><strong>13h</strong><span>spent on the process weekly</span></div>\n              <div class=\"pa-stat\"><strong>40%</strong><span>employ a dedicated team member</span></div>\n              <div class=\"pa-stat\"><strong>1 in 3</strong><span>expect reform pledges to matter</span></div>\n            </div>\n            <p>Forty percent of practices employ someone dedicated entirely to prior authorization. And only one in three physicians believe recent insurer reform pledges will produce meaningful change.</p>\n            <p>Those numbers have not moved because the 2026 provisions changed the rules around decisions. However, there are two elements that did change that your operation should be acting on today.</p>\n            <div class=\"pa-action-board\" aria-labelledby=\"pa-action-title\">\n              <div class=\"pa-action-head\"><b id=\"pa-action-title\">2026 operating checklist</b><span id=\"pa-action-progress\">0 of 2 applied</span></div>\n              <button type=\"button\" class=\"pa-action\"><span class=\"pa-check\" aria-hidden=\"true\">✓</span><span><b>Capture every denial reason</b><p>Categorize the required reason data and feed it back into submission quality.</p></span></button>\n              <button type=\"button\" class=\"pa-action\"><span class=\"pa-check\" aria-hidden=\"true\">✓</span><span><b>Benchmark payer behavior</b><p>Use public metrics to inform contracting, appeal priority, and staffing plans.</p></span></button>\n            </div>\n            <p>Denial reason data is now required on every decision: If your denial management process does not capture, categorize, and feed this data back into submission quality, you are leaving recoverable revenue on the table.</p>\n            <div class=\"pa-callout\"><p>Structured denial tracking turns individual losses into pattern-level corrections across your payer mix.</p></div>\n            <p>Public payer metrics are now available for benchmarking: Your eligibility verification and authorization teams can compare insurer behavior at the plan level, informing payer contracting decisions, appeal prioritization, and workforce management planning.</p>\n          </div>\n        </section>\n\n        <section class=\"pa-section pa-reveal\" id=\"api\">\n          <div class=\"pa-section-head\"><span class=\"pa-tag\">Phase 05</span><h2>The 2027 API Deadline Moves Work</h2></div>\n          <div class=\"pa-section-body\">\n            <p>The API deadline on January 1, 2027, will bring four FHIR-based connections between payer and provider systems. Those connections will shift submission work from manual to automated, but the exception handling, appeals, and denial management workload will grow rather than shrink.</p>\n            <div class=\"pa-runway\" aria-label=\"Four FHIR-based API connections arriving in 2027\">\n              <div class=\"pa-runway-head\"><b>2027 integration runway</b><span>Four required connections</span></div>\n              <div class=\"pa-api-line\">\n                <div class=\"pa-api-node\"><i>01</i><span>Patient access</span></div><div class=\"pa-api-node\"><i>02</i><span>Provider access</span></div><div class=\"pa-api-node\"><i>03</i><span>Payer-to-payer</span></div><div class=\"pa-api-node\"><i>04</i><span>Prior authorization</span></div>\n              </div>\n              <div class=\"pa-runway-note\">Automation accelerates the standard path. People still resolve the exceptions.</div>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"pa-faq pa-reveal\" id=\"faq\">\n          <h2>Frequently Asked Questions</h2>\n          <details><summary>What is CMS-0057-F?</summary><p>A federal rule finalized in January 2024 requiring impacted payers to improve prior authorization decision timelines, provide denial reasons, report metrics publicly, and implement standardized API connections by January 2027.</p></details>\n          <details><summary>What changed on January 1, 2026?</summary><p>Impacted payers must now decide expedited requests within 72 hours, standard requests within seven calendar days, and include a specific reason with every denial.</p></details>\n          <details><summary>Does CMS-0057-F apply to commercial insurance or drug prior authorizations?</summary><p>No to both. The rule covers Medicare Advantage, Medicaid and CHIP managed care, and Qualified Health Plan issuers on the federally facilitated exchanges. Commercial plans are excluded. The rule applies to medical items and services only, not prescription drugs.</p></details>\n          <details><summary>Where can I find payer prior authorization metrics?</summary><p>Impacted payers publish these on their public-facing websites annually. The first reports, covering 2025, were due March 31, 2026.</p></details>\n          <details><summary>When does the Prior Authorization API go live?</summary><p>January 1, 2027. Four FHIR-based API connections will be required for all impacted payers.</p></details>\n        </section>\n\n        <section class=\"pa-close pa-reveal\">\n          <h2>Your Prior Authorization Workflow Changed on Paper. Centro Can Change It in Practice</h2>\n          <p>The 2026 provisions gave your team faster answers and better denial data. They did not reduce the volume, simplify the submissions, or staff the appeals queue.</p>\n          <p>Centro runs prior authorization operations for physician practices, clinics, and hospitals across the country.</p>\n          <p>With 15+ years in healthcare, five delivery countries, and a team model built on continuity, our staff works inside your EHR, maintains direct contact with insurers, and stays on your account for the long term.</p>\n          <p>We bring HIPAA compliance, structured denial management, and service level agreements built around the metrics that drive your revenue cycle.</p>\n          <p>Ready to turn faster payer decisions into recovered revenue?</p>\n          <a class=\"pa-cta\" href=\"https://centrocdx.com/get-in-touch/\" target=\"_blank\" rel=\"noopener\">Reach out to us</a>\n        </section>\n        <p class=\"pa-entity\">Centro is a healthcare BPO and revenue cycle management partner founded in 2009 in Virginia. With 15+ years in healthcare and five delivery countries, Centro supports physician practices, clinics, and hospitals across prior authorization, eligibility verification, claims, and denial management.</p>\n      </article>\n    </main>\n  </div>\n  <script>\n    (()=>{\n      const wrap=document.querySelector('.pa-wrap');\n      if(!wrap)return;\n      wrap.classList.add('pa-motion');\n      const progress=wrap.querySelector('.pa-progress span');\n      const updateProgress=()=>{const h=document.documentElement.scrollHeight-innerHeight;progress.style.transform=`scaleX(${h>0?Math.min(1,scrollY/h):0})`};\n      updateProgress();addEventListener('scroll',updateProgress,{passive:true});addEventListener('resize',updateProgress);\n\n      const jump=[...wrap.querySelectorAll('.pa-jump button')];\n      jump.forEach(btn=>btn.addEventListener('click',()=>document.getElementById(btn.dataset.target)?.scrollIntoView({behavior:'smooth',block:'start'})));\n      const sections=jump.map(btn=>document.getElementById(btn.dataset.target)).filter(Boolean);\n      const rail=wrap.querySelector('.pa-jump');\n      const centreInRail=btn=>{\n        if(!rail||rail.scrollWidth<=rail.clientWidth)return;\n        const left=btn.offsetLeft-(rail.clientWidth-btn.offsetWidth)/2;\n        rail.scrollTo({left:Math.max(0,left),behavior:'smooth'});\n      };\n      const navObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){jump.forEach(btn=>{const active=btn.dataset.target===entry.target.id;btn.classList.toggle('active',active);if(active)centreInRail(btn)})}}),{rootMargin:'-22% 0px -62% 0px'});\n      sections.forEach(section=>navObserver.observe(section));\n      const revealObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('in');revealObserver.unobserve(entry.target)}}),{threshold:.08});\n      wrap.querySelectorAll('.pa-reveal').forEach(el=>revealObserver.observe(el));\n\n      const rules={\n        expedited:{value:'72h',small:'deadline',fill:72,title:'Expedited requests',copy:'Impacted payers must return a decision within 72 hours.'},\n        standard:{value:'7',small:'calendar days',fill:100,title:'Standard requests',copy:'Impacted payers must return a decision within seven calendar days.'},\n        reasons:{value:'100%',small:'of denials',fill:100,title:'Specific denial reasons',copy:'Every denial must include a specific, documented reason.'},\n        reporting:{value:'Mar 31',small:'2026',fill:88,title:'Public payer reporting',copy:'Impacted payers had to publish approval, denial, and response-time metrics for 2025.'}\n      };\n      wrap.querySelectorAll('.pa-deadline-tabs button').forEach(btn=>btn.addEventListener('click',()=>{\n        const d=rules[btn.dataset.rule];wrap.querySelectorAll('.pa-deadline-tabs button').forEach(b=>{const on=b===btn;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on))});\n        document.getElementById('pa-rule-value').innerHTML=`${d.value}<small>${d.small}</small>`;document.getElementById('pa-rule-title').textContent=d.title;document.getElementById('pa-rule-copy').textContent=d.copy;document.getElementById('pa-dial').style.setProperty('--fill',d.fill);\n      }));\n\n      const payers={\n        ma:{rate:12,title:'Medicare Advantage: 12% denied',copy:'The first public reports show a meaningful denial burden—and a strong recovery signal once those denials are appealed.',appeal:'66% overturned on appeal'},\n        medicaid:{rate:14,title:'Medicaid managed care: 14% denied',copy:'Medicaid managed care denial rates ran higher, with nearly half of appealed denials ultimately overturned.',appeal:'47% overturned on appeal'},\n        aca:{rate:18,title:'ACA Marketplace: 18% denied',copy:'ACA Marketplace plans posted the highest average denial rate of the three markets in the first public reports.',appeal:'43% overturned on appeal'}\n      };\n      wrap.querySelectorAll('.pa-payer-tabs button').forEach(btn=>btn.addEventListener('click',()=>{\n        const d=payers[btn.dataset.payer];wrap.querySelectorAll('.pa-payer-tabs button').forEach(b=>{const on=b===btn;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on))});\n        document.getElementById('pa-range-marker').style.left=`${((d.rate-2)/23)*100}%`;document.getElementById('pa-payer-title').textContent=d.title;document.getElementById('pa-payer-copy').textContent=d.copy;document.getElementById('pa-appeal').textContent=d.appeal;\n      }));\n\n      const gaps={\n        drugs:{icon:'Rx',label:'Prescription drug authorization',title:'Drug Prior Authorizations Are Excluded',copy:'The rule covers medical items and services only. Practices handling specialty pharmacy referrals or high-cost prescriptions will see no change. The fax machine, somehow, continues to outlive every wave of healthcare modernization. At this rate, it deserves a lifetime achievement award from CMS.'},\n        commercial:{icon:'$',label:'Commercial plans',title:'Commercial and Employer-Sponsored Plans Are Not Covered',copy:'A mixed payer panel means a significant share of authorization volume can still move through manual channels without a federal response timeline.'},\n        criteria:{icon:'Dx',label:'Clinical diagnosis criteria',title:'Clinical Criteria Stay With Payers',copy:'Payers still write their own medical necessity policies. Faster deadlines guarantee a response, not an approval.'},\n        electronic:{icon:'35%',label:'Electronic adoption rate',title:'Electronic Adoption Is Still Low',copy:'Only 35% of prior authorization transactions were fully electronic in the 2024 CAQH Index. Portals, phone calls, and fax cover sheets remain in play.'},\n        enforcement:{icon:'CMS',label:'CMS enforcement',title:'Provider Enforcement Is Undefined',copy:'Compliance runs through CMS oversight of plan participation, not through a direct channel a billing manager can use when a payer misses a deadline.'}\n      };\n      wrap.querySelectorAll('.pa-unchanged-list button').forEach(btn=>btn.addEventListener('click',()=>{\n        const d=gaps[btn.dataset.gap];wrap.querySelectorAll('.pa-unchanged-list button').forEach(b=>{const on=b===btn;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on))});\n        document.getElementById('pa-gap-icon').textContent=d.icon;document.getElementById('pa-gap-icon').setAttribute('aria-label',d.label);document.getElementById('pa-gap-title').textContent=d.title;document.getElementById('pa-gap-copy').textContent=d.copy;\n      }));\n\n      const actions=[...wrap.querySelectorAll('.pa-action')];\n      actions.forEach(btn=>btn.addEventListener('click',()=>{btn.classList.toggle('done');btn.setAttribute('aria-pressed',String(btn.classList.contains('done')));const done=actions.filter(x=>x.classList.contains('done')).length;document.getElementById('pa-action-progress').textContent=`${done} of ${actions.length} applied`}));\n    })();\n  </script>\n</body>\n</html>"
        }
      ]
    }
  ],
