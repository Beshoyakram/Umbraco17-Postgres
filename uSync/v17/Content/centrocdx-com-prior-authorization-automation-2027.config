      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "34caa937-e71a-47a1-8984-170eabb5f7f9",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Prior Authorization Automation: January 2027 API Deadline | Centro</title>\n  <meta name=\"description\" content=\"Learn five steps providers should take before the January 2027 prior authorization API deadline, from payer readiness to exception handling.\">\n  <meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n  <meta property=\"og:type\" content=\"article\">\n  <meta property=\"og:title\" content=\"Prior Authorization Automation: January 2027 API Deadline\">\n  <meta property=\"og:description\" content=\"Learn five steps providers should take before the January 2027 prior authorization API deadline, from payer readiness to exception handling.\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"Prior Authorization Automation: January 2027 API Deadline\">\n  <meta name=\"twitter:description\" content=\"Learn five steps providers should take before the January 2027 prior authorization API deadline, from payer readiness to exception handling.\">\n  <style>\n    .pad-wrap{\n      --navy:#064c68;\n      --deep:#07394c;\n      --ink:#173c4b;\n      --body:#536b76;\n      --teal:#00a4bd;\n      --cyan:#63deea;\n      --mint:#def6f3;\n      --ice:#f4fafb;\n      --steel:#587b8a;\n      --steel-soft:#edf3f6;\n      --green:#1b8a72;\n      --line:#cfdee3;\n      width:100%;\n      max-width:780px;\n      margin:0 auto;\n      background:#fff;\n      color:var(--body);\n      font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Arial,sans-serif;\n      font-size:16px;\n      line-height:1.75;\n    }\n    .pad-wrap,.pad-wrap *{box-sizing:border-box}\n    .pad-wrap button{font:inherit}\n    .pad-wrap a{color:var(--navy);font-weight:720;text-decoration-color:var(--cyan);text-decoration-thickness:1.5px;text-underline-offset:4px;transition:color .2s,background-color .2s}\n    .pad-wrap a:hover{color:var(--teal);background:rgba(99,222,234,.12)}\n    .pad-wrap a:focus-visible,.pad-wrap button:focus-visible,.pad-wrap summary:focus-visible{outline:3px solid var(--cyan);outline-offset:3px}\n    .pad-progress{position:fixed;z-index:9999;top:0;left:0;width:100%;height:4px;pointer-events:none}\n    .pad-progress span{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--navy),var(--steel),var(--cyan));transform:scaleX(0);transform-origin:left}\n    .pad-page{width:100%;padding:0 0 58px;overflow-x:clip}\n    .pad-layout{display:grid;grid-template-columns:180px minmax(0,1fr);column-gap:30px;align-items:start}\n    .pad-copy{grid-column:2;min-width:0}\n    .pad-copy p{margin:0 0 22px;color:var(--body);font-size:1rem;line-height:1.75}\n    .pad-intro{padding-bottom:30px;border-bottom:1px solid var(--line)}\n\n    /* Compact animated transition map */\n    .pad-transition{position:relative;isolation:isolate;min-height:188px;margin:29px 0 0;overflow:hidden;border:1px solid #0e6a81;background:linear-gradient(125deg,var(--deep),#086f86);color:#fff}\n    .pad-transition::before{content:\"\";position:absolute;z-index:-2;inset:0;background-image:radial-gradient(circle,rgba(99,222,234,.27) 1px,transparent 1.6px);background-size:22px 22px;mask-image:linear-gradient(90deg,#000,transparent 86%);animation:pad-drift 14s linear infinite}\n    .pad-transition::after{content:\"\";position:absolute;z-index:-1;width:240px;height:240px;right:-90px;top:-116px;border:1px solid rgba(99,222,234,.32);border-radius:50%;box-shadow:0 0 0 32px rgba(99,222,234,.06),0 0 0 67px rgba(99,222,234,.04);animation:pad-float 8s ease-in-out infinite}\n    .pad-transition-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 19px;border-bottom:1px solid rgba(255,255,255,.14)}\n    .pad-transition-label{color:#fff;font-size:.82rem;font-weight:800}\n    .pad-transition-date{color:var(--cyan);font-size:.64rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}\n    .pad-flow{position:relative;display:grid;grid-template-columns:1fr 74px 1fr;align-items:center;gap:10px;padding:29px 21px 18px}\n    .pad-system{padding:13px 12px;border:1px solid rgba(255,255,255,.2);background:rgba(2,55,75,.7);backdrop-filter:blur(5px)}\n    .pad-system small{display:block;color:#9cdae2;font-size:.59rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}\n    .pad-system span{display:block;margin-top:3px;color:#fff;font-size:.79rem;font-weight:760}\n    .pad-pipe{position:relative;height:2px;background:rgba(99,222,234,.35)}\n    .pad-pipe::after{content:\"\";position:absolute;top:50%;left:0;width:9px;height:9px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 5px rgba(99,222,234,.13),0 0 14px var(--cyan);transform:translate(-50%,-50%);animation:pad-packet 2.6s ease-in-out infinite}\n    .pad-transition-note{padding:0 21px 22px;color:#cbecef;font-size:.7rem;line-height:1.55}\n\n    .pad-snapshot{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:24px 0 0;border:1px solid var(--line);background:var(--line)}\n    .pad-snapshot-item{padding:16px 14px;background:#fff}\n    .pad-snapshot-value{display:block;color:var(--navy);font-size:1.42rem;font-weight:850;line-height:1}\n    .pad-snapshot-label{display:block;margin-top:7px;color:var(--body);font-size:.64rem;line-height:1.4}\n\n    /* Vertical contents */\n    .pad-toc{position:sticky;z-index:20;top:24px;grid-column:1;grid-row:1 / span 9;align-self:start;display:flex;flex-direction:column;margin:0;background:#fff;overflow:hidden}\n    .pad-toc-title{display:block;padding:0 0 12px;border-bottom:1px solid var(--line);color:var(--ink);font-size:.68rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}\n    .pad-toc button{display:grid;grid-template-columns:31px minmax(0,1fr);align-items:center;width:100%;padding:10px 7px 10px 0;border:0;border-left:1px solid var(--line);background:transparent;color:var(--body);font-size:.69rem;font-weight:760;line-height:1.35;text-align:left;cursor:pointer;transition:.2s}\n    .pad-toc button span{color:#92a6ae;font-size:.63rem;font-weight:850;text-align:center;transition:color .2s}\n    .pad-toc button:hover,.pad-toc button.active{border-left-color:var(--teal);background:linear-gradient(90deg,var(--ice),#fff);color:var(--navy);box-shadow:inset 2px 0 0 var(--teal)}\n    .pad-toc button:hover span,.pad-toc button.active span{color:var(--teal)}\n\n    .pad-section{margin:54px 0 0;scroll-margin-top:24px}\n    .pad-section-head{display:grid;grid-template-columns:92px minmax(0,1fr);gap:18px;align-items:start;padding-top:22px;border-top:1px solid var(--line)}\n    .pad-kicker{display:inline-flex;align-items:center;gap:7px;margin-top:4px;color:var(--teal);font-size:.63rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}\n    .pad-kicker::before{content:\"\";width:9px;height:9px;border:2px solid var(--teal);transform:rotate(45deg)}\n    .pad-section h2,.pad-faq h2,.pad-close h2{margin:0;color:var(--navy);font-size:clamp(1.58rem,3.1vw,2rem);font-weight:600;line-height:1.17;letter-spacing:-.034em}\n    .pad-section h3{margin:29px 0 12px;color:var(--ink);font-size:1.1rem;line-height:1.35}\n    .pad-section-body{margin-top:23px}\n    .pad-note{margin:25px 0;padding:18px 20px;border-left:3px solid var(--steel);background:var(--steel-soft);color:var(--ink)}\n    .pad-note p{margin:0}\n\n    /* Rule scope */\n    .pad-scope{margin:27px 0;border:1px solid var(--line);background:#fff}\n    .pad-scope-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 18px;background:var(--ice)}\n    .pad-scope-head span:first-child{color:var(--navy);font-size:.84rem;font-weight:820}\n    .pad-scope-head span:last-child{color:var(--teal);font-size:.62rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}\n    .pad-scope-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line)}\n    .pad-scope-item{min-height:92px;padding:15px 16px;background:#fff}\n    .pad-scope-item i{display:grid;place-content:center;width:25px;height:25px;margin-bottom:8px;border-radius:50%;background:var(--mint);color:var(--green);font-style:normal;font-size:.69rem;font-weight:900}\n    .pad-scope-item span{display:block;color:var(--ink);font-size:.72rem;font-weight:750;line-height:1.4}\n    .pad-excluded{display:flex;gap:10px;align-items:flex-start;padding:15px 17px;border-top:1px solid var(--line);background:var(--steel-soft);color:var(--ink);font-size:.71rem;line-height:1.55}\n    .pad-excluded i{display:grid;place-content:center;flex:0 0 22px;height:22px;border:1px solid var(--steel);border-radius:50%;color:var(--steel);font-style:normal;font-weight:900}\n\n    /* API switchboard */\n    .pad-switchboard{margin:27px 0;border:1px solid var(--line)}\n    .pad-api-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}\n    .pad-api-tabs button{min-width:0;padding:13px 7px;border:0;background:var(--ice);color:var(--body);font-size:.64rem;font-weight:800;line-height:1.35;cursor:pointer;transition:.2s}\n    .pad-api-tabs button::before{content:attr(data-number);display:grid;place-content:center;width:25px;height:25px;margin:0 auto 7px;border:1px solid var(--line);border-radius:50%;background:#fff;color:var(--teal);font-size:.61rem}\n    .pad-api-tabs button:hover,.pad-api-tabs button.active{background:var(--deep);color:#fff}\n    .pad-api-tabs button:hover::before,.pad-api-tabs button.active::before{border-color:var(--cyan);background:var(--cyan);color:var(--deep)}\n    .pad-api-panel{position:relative;min-height:206px;padding:24px 24px 22px;overflow:hidden;background:#fff}\n    .pad-api-panel::after{content:\"\";position:absolute;width:130px;height:130px;right:-74px;bottom:-80px;border:19px solid var(--mint);border-radius:50%}\n    .pad-api-route{display:inline-flex;align-items:center;gap:9px;margin-bottom:13px;color:var(--teal);font-size:.62rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}\n    .pad-api-route::after{content:\"\";width:48px;height:1px;background:var(--cyan)}\n    .pad-api-panel h3{position:relative;z-index:1;margin:0 0 9px;color:var(--navy);font-size:1.08rem}\n    .pad-api-panel p{position:relative;z-index:1;margin:0;font-size:.8rem;line-height:1.65}\n\n    /* Automation handoff */\n    .pad-handoff{margin:27px 0;border:1px solid var(--line)}\n    .pad-handoff-controls{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}\n    .pad-handoff-controls button{padding:15px 12px;border:0;background:var(--ice);color:var(--body);font-size:.72rem;font-weight:820;cursor:pointer}\n    .pad-handoff-controls button:hover,.pad-handoff-controls button.active{background:#fff;color:var(--navy);box-shadow:inset 0 -3px 0 var(--teal)}\n    .pad-handoff-panel{display:grid;grid-template-columns:72px minmax(0,1fr);gap:18px;align-items:center;padding:23px}\n    .pad-handoff-icon{display:grid;place-content:center;width:64px;height:64px;border-radius:18px;background:var(--mint);color:var(--teal);font-size:1.65rem}\n    .pad-handoff-copy h3{margin:0 0 7px;color:var(--navy);font-size:1rem}\n    .pad-handoff-copy p{margin:0;font-size:.77rem;line-height:1.6}\n\n    /* Partner challenge navigator */\n    .pad-partner{margin:27px 0;border:1px solid var(--line)}\n    .pad-partner-top{padding:16px 18px;background:var(--deep);color:#fff}\n    .pad-partner-top span{display:block;color:#fff;font-size:.84rem;font-weight:820}\n    .pad-partner-top small{display:block;margin-top:3px;color:#b9e6eb;font-size:.64rem}\n    .pad-partner-body{display:grid;grid-template-columns:165px minmax(0,1fr);min-height:244px}\n    .pad-challenges{border-right:1px solid var(--line);background:var(--ice)}\n    .pad-challenges button{display:block;width:100%;padding:11px 12px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--body);font-size:.65rem;font-weight:770;line-height:1.35;text-align:left;cursor:pointer}\n    .pad-challenges button:last-child{border-bottom:0}\n    .pad-challenges button:hover,.pad-challenges button.active{background:#fff;color:var(--navy);box-shadow:inset 3px 0 0 var(--teal)}\n    .pad-partner-panel{padding:23px}\n    .pad-partner-mark{display:grid;place-content:center;width:38px;height:38px;margin-bottom:14px;border:1px solid var(--cyan);border-radius:50%;background:var(--mint);color:var(--navy);font-size:.72rem;font-weight:900}\n    .pad-partner-panel h3{margin:0 0 8px;color:var(--navy);font-size:1rem}\n    .pad-partner-panel p{margin:0;font-size:.76rem;line-height:1.6}\n\n    /* Questions */\n    .pad-questions{margin:26px 0;border-top:1px solid var(--line)}\n    .pad-question{border-bottom:1px solid var(--line)}\n    .pad-question summary{position:relative;display:grid;grid-template-columns:33px minmax(0,1fr);gap:11px;padding:16px 40px 16px 0;color:var(--ink);font-size:.78rem;font-weight:760;line-height:1.5;cursor:pointer;list-style:none}\n    .pad-question summary::-webkit-details-marker{display:none}\n    .pad-question summary::after{content:\"+\";position:absolute;right:7px;top:14px;color:var(--teal);font-size:1.35rem;font-weight:400;transition:transform .2s}\n    .pad-question[open] summary::after{transform:rotate(45deg)}\n    .pad-question summary span{display:grid;place-content:center;width:29px;height:29px;border:1px solid var(--line);border-radius:50%;color:var(--teal);font-size:.61rem;font-weight:850}\n    .pad-question p{margin:0;padding:0 34px 17px 44px;font-size:.75rem;line-height:1.6}\n\n    /* Readiness tracker */\n    .pad-readiness{margin:27px 0;border:1px solid var(--line)}\n    .pad-readiness-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px 19px;background:var(--deep);color:#fff}\n    .pad-readiness-title{color:#fff;font-size:.84rem;font-weight:820}\n    .pad-readiness-count{color:var(--cyan);font-size:.66rem;font-weight:850}\n    .pad-readiness-meter{height:5px;background:#cbdde2}\n    .pad-readiness-meter span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--teal),var(--cyan));transition:width .3s ease}\n    .pad-task{display:grid;grid-template-columns:31px minmax(0,1fr);gap:13px;width:100%;padding:16px 18px;border:0;border-bottom:1px solid var(--line);background:#fff;color:inherit;text-align:left;cursor:pointer;transition:background .2s}\n    .pad-task:last-child{border-bottom:0}\n    .pad-task:hover{background:var(--ice)}\n    .pad-task-check{display:grid;place-content:center;width:26px;height:26px;margin-top:2px;border:1.5px solid var(--line);border-radius:50%;color:transparent;font-size:.74rem;transition:.2s}\n    .pad-task.done .pad-task-check{border-color:var(--green);background:var(--green);color:#fff}\n    .pad-task-title{display:block;color:var(--navy);font-size:.78rem;font-weight:810;line-height:1.4}\n    .pad-task-copy{display:block;margin-top:3px;color:var(--body);font-size:.7rem;line-height:1.5}\n\n    .pad-faq{margin-top:54px;scroll-margin-top:24px}\n    .pad-faq h2{margin-bottom:22px}\n    .pad-faq details{border-top:1px solid var(--line)}\n    .pad-faq details:last-child{border-bottom:1px solid var(--line)}\n    .pad-faq summary{position:relative;padding:19px 42px 19px 0;color:var(--ink);font-weight:760;line-height:1.45;cursor:pointer;list-style:none}\n    .pad-faq summary::-webkit-details-marker{display:none}\n    .pad-faq summary::after{content:\"+\";position:absolute;right:8px;top:16px;color:var(--teal);font-size:1.4rem;font-weight:400;transition:transform .2s}\n    .pad-faq details[open] summary::after{transform:rotate(45deg)}\n    .pad-faq details p{padding:0 38px 20px 0;margin:0}\n    .pad-close{margin:54px 0 0;padding:29px clamp(20px,4vw,34px);border:1px solid #c3d7df;background:linear-gradient(135deg,var(--mint),#fff 64%,var(--steel-soft))}\n    .pad-close h2{margin-bottom:18px}\n    .pad-close p:last-of-type{margin-bottom:8px}\n    .pad-wrap a.pad-cta{display:inline-flex;align-items:center;gap:12px;margin-top:4px;padding:13px 19px;background:var(--teal)!important;color:#fff!important;text-decoration:none!important;box-shadow:none!important}\n    .pad-wrap a.pad-cta::after{content:\"→\";color:#fff;font-size:1.1rem;transition:transform .2s}\n    .pad-wrap a.pad-cta:hover{background:var(--navy)!important;color:#fff!important}\n    .pad-wrap a.pad-cta:hover::after{transform:translateX(4px)}\n    .pad-entity{margin:24px 0 0!important;padding:18px 0 0;border-top:1px solid var(--line);color:#70858f!important;font-size:.78rem!important;line-height:1.65!important}\n    .pad-motion .pad-reveal{opacity:0;transform:translateY(15px);transition:opacity .55s ease,transform .55s ease}\n    .pad-motion .pad-reveal.in{opacity:1;transform:none}\n    @keyframes pad-drift{to{background-position:44px 22px}}\n    @keyframes pad-float{50%{transform:translate(-18px,15px) scale(1.04)}}\n    @keyframes pad-packet{0%{left:0}50%,100%{left:100%}}\n    @media(max-width:700px){\n      .pad-wrap{max-width:100%}.pad-layout{display:block}.pad-toc{position:relative;top:auto;display:flex;flex-direction:row;gap:6px;margin:0 0 40px;padding:10px 0;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:thin}.pad-toc-title{display:none}.pad-toc button{display:block;flex:0 0 auto;width:auto;padding:7px 10px;border:1px solid transparent;text-align:center}.pad-toc button span{display:none}.pad-toc button:hover,.pad-toc button.active{border-color:var(--teal);box-shadow:none}.pad-section-head{grid-template-columns:1fr;gap:7px}.pad-kicker{margin-top:0}\n    }\n    @media(max-width:520px){\n      .pad-flow{grid-template-columns:1fr 42px 1fr;padding-left:13px;padding-right:13px}.pad-system{padding:10px 8px}.pad-system span{font-size:.68rem}.pad-snapshot{grid-template-columns:1fr}.pad-scope-grid{grid-template-columns:1fr}.pad-api-tabs{grid-template-columns:repeat(2,1fr)}.pad-partner-body{grid-template-columns:1fr}.pad-challenges{display:flex;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line)}.pad-challenges button{flex:0 0 138px;border-right:1px solid var(--line);border-bottom:0}.pad-challenges button:hover,.pad-challenges button.active{box-shadow:inset 0 -3px 0 var(--teal)}\n    }\n    @media(prefers-reduced-motion:reduce){\n      .pad-wrap *,.pad-wrap *::before,.pad-wrap *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.pad-motion .pad-reveal{opacity:1;transform:none}\n    }\n  </style>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\":\"https://schema.org\",\n    \"@type\":\"Article\",\n    \"headline\":\"Prior Authorization Automation: What Providers Need to Do Before the January 2027 API Deadline\",\n    \"description\":\"Learn five steps providers should take before the January 2027 prior authorization API deadline, from payer readiness to exception handling.\",\n    \"author\":{\"@type\":\"Organization\",\"name\":\"Centro\"},\n    \"publisher\":{\"@type\":\"Organization\",\"name\":\"Centro\",\"url\":\"https://centrocdx.com/\"},\n    \"articleSection\":[\"Prior Authorization\",\"Revenue Cycle Management\",\"Healthcare Automation\",\"CMS-0057-F\"],\n    \"keywords\":[\"prior authorization automation\",\"January 2027 API deadline\",\"CMS-0057-F\",\"FHIR API\",\"prior authorization services\"],\n    \"inLanguage\":\"en-US\"\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\":\"https://schema.org\",\n    \"@type\":\"FAQPage\",\n    \"mainEntity\":[\n      {\"@type\":\"Question\",\"name\":\"What will happen on January 1, 2027?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Four FHIR-based API connections will have to be live at impacted payers, enabling automated prior authorization submission, patient history access, patient-facing status visibility, and coverage portability.\"}},\n      {\"@type\":\"Question\",\"name\":\"Does CMS-0057-F apply to providers or payers?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Payers carry the legal obligation. Providers absorb the operational impact and need to adapt workflows to use what payers build.\"}},\n      {\"@type\":\"Question\",\"name\":\"Will all payers have working connections on day one?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Unlikely. Compliance timelines vary by payer type and readiness. Your team should confirm individual payer timelines and plan for a mixed manual-and-automated environment through at least mid-2027.\"}},\n      {\"@type\":\"Question\",\"name\":\"What happens if my EHR vendor is not ready by January 2027?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your practice reverts to manual submission for any payer whose connection your system cannot support. Contact your vendor now for a confirmed go-live date.\"}},\n      {\"@type\":\"Question\",\"name\":\"How should we start preparing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Measure current performance, confirm vendor and payer timelines, clean provider directory data, and restructure staffing around exception handling.\"}}\n    ]\n  }\n  </script>\n</head>\n<body>\n  <div class=\"pad-wrap\">\n    <div class=\"pad-progress\" aria-hidden=\"true\"><span></span></div>\n    <main class=\"pad-page\">\n      <div class=\"pad-layout\">\n        <aside class=\"pad-toc\" aria-label=\"In this article\">\n          <span class=\"pad-toc-title\">In this article</span>\n          <button type=\"button\" class=\"active\" data-target=\"requirements\"><span>01</span>Deadline requirements</button>\n          <button type=\"button\" data-target=\"apis\"><span>02</span>The four APIs</button>\n          <button type=\"button\" data-target=\"handoff\"><span>03</span>Automation handoff</button>\n          <button type=\"button\" data-target=\"partner\"><span>04</span>RCM partner role</button>\n          <button type=\"button\" data-target=\"questions\"><span>05</span>Partner questions</button>\n          <button type=\"button\" data-target=\"prepare\"><span>06</span>Pre-deadline plan</button>\n          <button type=\"button\" data-target=\"faq\"><span>FAQ</span>Questions answered</button>\n        </aside>\n\n        <article class=\"pad-copy\">\n          <div class=\"pad-intro\">\n            <p>Providers need to do five things before the January 2027 prior authorization API deadline: measure current turnaround times and denial rates by payer, confirm go-live dates from EHR and practice management vendors, get readiness timelines from their top payers, clean provider directory data, and assign a named owner for exception handling and appeals.</p>\n            <p>Every one of these steps has to happen before January 1, 2027, when direct digital connections between insurer systems and yours replace the portals, fax cover sheets, and phone queues that define the prior authorization process today.</p>\n            <p>A federal rule called CMS-0057-F is what makes that happen. Every requirement in the rule lands on the insurance companies. But if your workflows, data, and staffing are not ready to match, you keep every hour of manual cost while the efficiency gains pass you by.</p>\n            <p>We have already covered <a href=\"https://centrocdx.com/cms-0057-f-prior-authorization-2026/\" target=\"_blank\" rel=\"noopener noreferrer\">what the 2026 provisions changed and where the gaps remain</a>. Now we are going to break down how the January 2027 deadline reshapes your operation and what your team should be doing right now to prepare.</p>\n\n            <div class=\"pad-transition pad-reveal\" aria-label=\"Digital connection transition arriving January 1, 2027\">\n              <div class=\"pad-transition-head\"><span class=\"pad-transition-label\">Prior authorization data route</span><span class=\"pad-transition-date\">January 1, 2027</span></div>\n              <div class=\"pad-flow\">\n                <div class=\"pad-system\"><small>Provider side</small><span>EHR + practice system</span></div>\n                <div class=\"pad-pipe\" aria-hidden=\"true\"></div>\n                <div class=\"pad-system\"><small>Payer side</small><span>Standard FHIR connection</span></div>\n              </div>\n              <div class=\"pad-transition-note\">The connection becomes digital. Exception ownership, data quality, and appeals still belong in the operating plan.</div>\n            </div>\n            <div class=\"pad-snapshot pad-reveal\" aria-label=\"Deadline snapshot\">\n              <div class=\"pad-snapshot-item\"><span class=\"pad-snapshot-value\">4</span><span class=\"pad-snapshot-label\">standardized digital connections required</span></div>\n              <div class=\"pad-snapshot-item\"><span class=\"pad-snapshot-value\">35%</span><span class=\"pad-snapshot-label\">of prior authorization transactions fully electronic in the 2024 CAQH Index</span></div>\n              <div class=\"pad-snapshot-item\"><span class=\"pad-snapshot-value\">5</span><span class=\"pad-snapshot-label\">provider readiness actions to complete now</span></div>\n            </div>\n          </div>\n\n          <section class=\"pad-section pad-reveal\" id=\"requirements\">\n            <div class=\"pad-section-head\"><span class=\"pad-kicker\">Rule 01</span><h2>What CMS-0057-F Requires on January 1, 2027</h2></div>\n            <div class=\"pad-section-body\">\n              <p>The CMS interoperability and prior authorization final rule requires impacted payers to build four standardized digital connections by January 1, 2027.</p>\n              <p>These connections all run on a shared technical standard called FHIR (Fast Healthcare Interoperability Resources), created by <a href=\"https://www.hl7.org/fhir/\" target=\"_blank\" rel=\"noopener noreferrer\">HL7</a>. Every impacted insurer will have to build them the same way instead of inventing its own version.</p>\n              <p>The rule applies to Medicare Advantage plans, Medicaid and CHIP managed care entities, state Medicaid and CHIP fee-for-service programs, and Qualified Health Plan issuers on the federally facilitated exchanges.</p>\n              <div class=\"pad-scope\" aria-label=\"Payer scope of CMS-0057-F\">\n                <div class=\"pad-scope-head\"><span>Who is inside the rule</span><span>Payer scope</span></div>\n                <div class=\"pad-scope-grid\">\n                  <div class=\"pad-scope-item\"><i>✓</i><span>Medicare Advantage plans</span></div>\n                  <div class=\"pad-scope-item\"><i>✓</i><span>Medicaid and CHIP managed care</span></div>\n                  <div class=\"pad-scope-item\"><i>✓</i><span>State Medicaid and CHIP fee-for-service</span></div>\n                  <div class=\"pad-scope-item\"><i>✓</i><span>Federal exchange QHP issuers</span></div>\n                </div>\n                <div class=\"pad-excluded\"><i>!</i><span>Commercial and self-funded employer plans remain outside the rule and may still require manual authorization after January 2027.</span></div>\n              </div>\n              <p>Commercial and self-funded employer plans still remain outside that rule, meaning your team will still handle those authorizations manually even after January 2027. CMS estimates the rule will produce <a href=\"https://www.cms.gov/newsroom/press-releases/cms-finalizes-rule-expand-access-health-information-improve-prior-authorization-process\" target=\"_blank\" rel=\"noopener noreferrer\">roughly $15 billion in savings over ten years</a>, with most of that landing on the provider side.</p>\n            </div>\n          </section>\n\n          <section class=\"pad-section pad-reveal\" id=\"apis\">\n            <div class=\"pad-section-head\"><span class=\"pad-kicker\">Map 02</span><h2>The Four APIs That Will Reshape Your Workflow</h2></div>\n            <div class=\"pad-section-body\">\n              <p>Each connection changes a different part of your operation. Your team needs a plan for each one.</p>\n              <div class=\"pad-switchboard\" aria-label=\"Explore the four required APIs\">\n                <div class=\"pad-api-tabs\" role=\"tablist\" aria-label=\"Required API connections\">\n                  <button type=\"button\" class=\"active\" role=\"tab\" aria-selected=\"true\" data-api=\"prior\" data-number=\"01\">Prior authorization</button>\n                  <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-api=\"provider\" data-number=\"02\">Provider access</button>\n                  <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-api=\"patient\" data-number=\"03\">Patient access</button>\n                  <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-api=\"payer\" data-number=\"04\">Payer-to-payer</button>\n                </div>\n                <div class=\"pad-api-panel\" aria-live=\"polite\">\n                  <span class=\"pad-api-route\" id=\"pad-api-route\">EHR → payer</span>\n                  <h3 id=\"pad-api-title\">Prior Authorization API</h3>\n                  <p id=\"pad-api-copy\">Your system asks what documentation is needed, sends the request, and receives the decision. Daily work shifts from submission to exceptions that automation cannot resolve.</p>\n                </div>\n              </div>\n              <h3>Prior Authorization API</h3>\n              <p>This is the connection your billing team will use most. Your system will ask the insurer what documentation it needs, send the request, and receive the decision back automatically.</p>\n              <p>Prior authorization automation will replace the hours spent logging into portals, faxing forms, and calling for status updates. Your team’s daily work shifts from submission to handling the exceptions that automation cannot resolve.</p>\n              <h3>Provider Access API</h3>\n              <p>This connection lets you pull a patient’s history directly from their insurer, including care delivered elsewhere. That visibility only works if the insurer’s records correctly link the patient to your practice, so provider directory accuracy becomes a prerequisite.</p>\n              <h3>Patient Access API</h3>\n              <p>Patients will see their own claims and authorization status inside a phone app, sometimes before your front desk does. Your team will need to handle questions about decisions they have not yet seen themselves.</p>\n              <h3>Payer-to-Payer API</h3>\n              <p>This connection moves a patient’s existing approvals to their new insurer automatically when coverage changes. Your staff stops redoing authorizations the patient already has, cutting duplicate work every time someone switches plans.</p>\n            </div>\n          </section>\n\n          <section class=\"pad-section pad-reveal\" id=\"handoff\">\n            <div class=\"pad-section-head\"><span class=\"pad-kicker\">Shift 03</span><h2>What Automation Will and Will Not Replace</h2></div>\n            <div class=\"pad-section-body\">\n              <p>Electronic prior authorization will strip out most of the typing, portal logins, and status calls. What remains is the work that requires judgment: pended requests, missing clinical notes, and appeals.</p>\n              <div class=\"pad-handoff\" aria-label=\"Compare automated work and work that still needs people\">\n                <div class=\"pad-handoff-controls\" role=\"tablist\" aria-label=\"Automation handoff\">\n                  <button type=\"button\" class=\"active\" role=\"tab\" aria-selected=\"true\" data-handoff=\"automated\">Moves to automation</button>\n                  <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-handoff=\"human\">Stays with people</button>\n                </div>\n                <div class=\"pad-handoff-panel\" aria-live=\"polite\">\n                  <div class=\"pad-handoff-icon\" id=\"pad-handoff-icon\" aria-hidden=\"true\">↻</div>\n                  <div class=\"pad-handoff-copy\"><h3 id=\"pad-handoff-title\">The repeatable path</h3><p id=\"pad-handoff-copy\">Typing, portal logins, routine submissions, and status checks can move through the standardized connection.</p></div>\n                </div>\n              </div>\n              <p>That means fewer people keying in requests and more people who can pick apart a denial and correct what triggered it. But adoption still has a long way to go. According to the <a href=\"https://www.caqh.org/core/priority-topics\" target=\"_blank\" rel=\"noopener noreferrer\">2024 CAQH Index</a>, only 35% of prior authorization transactions were conducted fully electronically.</p>\n              <p>Prior authorization automation will not happen through a software purchase alone. Someone has to map the current workflow, track which insurers are ready, rebuild the exception queues, and retrain staff who have spent years working inside payer portals, all while daily authorization volume keeps arriving.</p>\n              <div class=\"pad-note\"><p>The technical connection automates the standard path. Your operating model determines what happens to everything outside it.</p></div>\n              <p>That gap is where an experienced RCM partner and <a href=\"https://centrocdx.com/healthcare/\" target=\"_blank\" rel=\"noopener noreferrer\">prior authorization services</a> team makes the difference.</p>\n            </div>\n          </section>\n\n          <section class=\"pad-section pad-reveal\" id=\"partner\">\n            <div class=\"pad-section-head\"><span class=\"pad-kicker\">Support 04</span><h2>How the Right RCM Partner Solves Your Biggest Problems</h2></div>\n            <div class=\"pad-section-body\">\n              <div class=\"pad-partner\" aria-label=\"Common prior authorization challenges and partner capabilities\">\n                <div class=\"pad-partner-top\"><span>Choose an operating challenge</span><small>See what experienced support should bring.</small></div>\n                <div class=\"pad-partner-body\">\n                  <div class=\"pad-challenges\" role=\"tablist\" aria-label=\"Operating challenges\">\n                    <button type=\"button\" class=\"active\" role=\"tab\" aria-selected=\"true\" data-challenge=\"capacity\">Staff capacity</button>\n                    <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-challenge=\"payers\">Payer variation</button>\n                    <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-challenge=\"denials\">Recurring denials</button>\n                    <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-challenge=\"tracking\">Request status</button>\n                    <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-challenge=\"transition\">API transition</button>\n                    <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-challenge=\"documents\">Late documentation</button>\n                  </div>\n                  <div class=\"pad-partner-panel\" aria-live=\"polite\">\n                    <div class=\"pad-partner-mark\" id=\"pad-partner-mark\">01</div>\n                    <h3 id=\"pad-partner-title\">Scale without permanent headcount</h3>\n                    <p id=\"pad-partner-copy\">Trained teams can expand during the transition when authorization volume outpaces staff capacity.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          <section class=\"pad-section pad-reveal\" id=\"questions\">\n            <div class=\"pad-section-head\"><span class=\"pad-kicker\">Screen 05</span><h2>Questions to Ask Before Choosing an RCM Partner for This Transition</h2></div>\n            <div class=\"pad-section-body\">\n              <p>The right questions separate partners who understand this rule from those who have read a headline about it.</p>\n              <div class=\"pad-questions\">\n                <details class=\"pad-question\"><summary><span>01</span>How many payer connections have you taken through go-live, and what went wrong?</summary><p>Look for direct transition experience and a clear account of how the partner corrected problems.</p></details>\n                <details class=\"pad-question\"><summary><span>02</span>How will you run manual and automated authorizations side by side while payers catch up?</summary><p>The operating model needs to support both routes without losing visibility or ownership.</p></details>\n                <details class=\"pad-question\"><summary><span>03</span>What does your exception handling workflow look like, step by step?</summary><p>Ask who receives an exception, how it is prioritized, and when it escalates.</p></details>\n                <details class=\"pad-question\"><summary><span>04</span>Who owns appeals once submission is automated, and what is your overturn rate?</summary><p>Automation does not remove denial recovery, so appeal ownership must be explicit.</p></details>\n                <details class=\"pad-question\"><summary><span>05</span>How will you measure our baseline before the transition starts?</summary><p>Baseline turnaround time, denial rate, and rework hours are essential for proving improvement.</p></details>\n                <details class=\"pad-question\"><summary><span>06</span>What reporting will we receive, and how often?</summary><p>Confirm the cadence, payer-level detail, and metrics available to your team.</p></details>\n                <details class=\"pad-question\"><summary><span>07</span>How do you handle data security and compliance across new payer connections?</summary><p>New connections should come with defined access, privacy, and compliance controls.</p></details>\n                <details class=\"pad-question\"><summary><span>08</span>What happens to our staffing model, and what will you help us plan for?</summary><p>The answer should cover retraining, capacity shifts, exception ownership, and appeals.</p></details>\n              </div>\n              <p>Press hardest on the baseline question. A partner who can’t tell you how they will measure your current turnaround time and denial rate has no way to prove improvement later.</p>\n            </div>\n          </section>\n\n          <section class=\"pad-section pad-reveal\" id=\"prepare\">\n            <div class=\"pad-section-head\"><span class=\"pad-kicker\">Plan 06</span><h2>What to Do in the Months Before January</h2></div>\n            <div class=\"pad-section-body\">\n              <p>What you do now determines what your operation looks like on day one of 2027. Here’s how to make sure you&#8217;re ready.</p>\n              <div class=\"pad-readiness\" aria-labelledby=\"pad-readiness-title\">\n                <div class=\"pad-readiness-head\"><span class=\"pad-readiness-title\" id=\"pad-readiness-title\">January readiness tracker</span><span class=\"pad-readiness-count\" id=\"pad-readiness-count\">0 of 5 complete</span></div>\n                <div class=\"pad-readiness-meter\" aria-hidden=\"true\"><span id=\"pad-readiness-meter\"></span></div>\n                <button type=\"button\" class=\"pad-task\"><span class=\"pad-task-check\" aria-hidden=\"true\">✓</span><span><span class=\"pad-task-title\">Measure your baseline now</span><span class=\"pad-task-copy\">Pull turnaround time, approval rate, and rework hours by payer.</span></span></button>\n                <button type=\"button\" class=\"pad-task\"><span class=\"pad-task-check\" aria-hidden=\"true\">✓</span><span><span class=\"pad-task-title\">Get dates from software vendors</span><span class=\"pad-task-copy\">Confirm when your EHR and practice management system will support live connections.</span></span></button>\n                <button type=\"button\" class=\"pad-task\"><span class=\"pad-task-check\" aria-hidden=\"true\">✓</span><span><span class=\"pad-task-title\">Ask your ten largest payers individually</span><span class=\"pad-task-copy\">Identify which payers will still require manual submission.</span></span></button>\n                <button type=\"button\" class=\"pad-task\"><span class=\"pad-task-check\" aria-hidden=\"true\">✓</span><span><span class=\"pad-task-title\">Clean provider directory data</span><span class=\"pad-task-copy\">Correct outdated records before they surface as failed connections.</span></span></button>\n                <button type=\"button\" class=\"pad-task\"><span class=\"pad-task-check\" aria-hidden=\"true\">✓</span><span><span class=\"pad-task-title\">Name an owner for exceptions</span><span class=\"pad-task-copy\">Assign accountability before the submission queue shrinks and the appeals queue expands.</span></span></button>\n              </div>\n              <p>Measure your baseline now: Pull authorization turnaround time, approval rate, and rework hours by payer. After the switch, you will have no way to reconstruct what performance looked like before.</p>\n              <p>Get dates from your software vendors: Ask when your EHR and practice management system will support the new connections in a live environment.</p>\n              <p>Ask your ten largest payers individually: Some insurers will have working connections on January 1. Others will not. Your team needs to know which payers still require manual submission.</p>\n              <p>Clean your provider directory data: Outdated records will surface as failed connections rather than helpful error messages. Fixing them under deadline pressure costs more.</p>\n              <p>Name an owner for exceptions: Automation will shrink the submission queue and expand the appeals queue. Assigning ownership after the volume shifts is like hiring a lifeguard after the pool is full. That work needs a named owner now.</p>\n            </div>\n          </section>\n\n          <section class=\"pad-faq pad-reveal\" id=\"faq\">\n            <h2>Frequently Asked Questions</h2>\n            <details><summary>What will happen on January 1, 2027?</summary><p>Four FHIR-based API connections will have to be live at impacted payers, enabling automated prior authorization submission, patient history access, patient-facing status visibility, and coverage portability.</p></details>\n            <details><summary>Does CMS-0057-F apply to providers or payers?</summary><p>Payers carry the legal obligation. Providers absorb the operational impact and need to adapt workflows to use what payers build.</p></details>\n            <details><summary>Will all payers have working connections on day one?</summary><p>Unlikely. Compliance timelines vary by payer type and readiness. Your team should confirm individual payer timelines and plan for a mixed manual-and-automated environment through at least mid-2027.</p></details>\n            <details><summary>What happens if my EHR vendor is not ready by January 2027?</summary><p>Your practice reverts to manual submission for any payer whose connection your system cannot support. Contact your vendor now for a confirmed go-live date.</p></details>\n            <details><summary>How should we start preparing?</summary><p>Measure current performance, confirm vendor and payer timelines, clean provider directory data, and restructure staffing around exception handling.</p></details>\n          </section>\n\n          <section class=\"pad-close pad-reveal\">\n            <h2>Get Ahead of January 2027 with Centro</h2>\n            <p>The practices that enter 2027 with a measured baseline, working exception workflows, and staff trained on both manual and automated authorization will spend the year improving performance.</p>\n            <p>Centro runs prior authorization services for physician practices, clinics, and hospitals across the country. With 15+ years in healthcare, five delivery countries, and a team model built on continuity, our staff works inside your EHR, maintains direct contact with insurers, and stays on your account for the long term. We bring HIPAA compliance, structured denial management, and service level agreements built around the metrics that drive your revenue cycle.</p>\n            <p>Ready to get your prior authorization operation in shape for January 2027?</p>\n            <a class=\"pad-cta\" href=\"https://centrocdx.com/get-in-touch/\" target=\"_blank\" rel=\"noopener noreferrer\">Reach out to the Centro team</a>\n          </section>\n          <p class=\"pad-entity\">Centro is a healthcare BPO and revenue cycle management partner founded in 2009 in Virginia. With 15+ years in healthcare and five delivery countries, Centro supports physician practices, clinics, and hospitals across prior authorization, eligibility verification, claims, and denial management.</p>\n        </article>\n      </div>\n    </main>\n  </div>\n\n  <script>\n    (()=>{\n      const wrap=document.querySelector('.pad-wrap');\n      if(!wrap)return;\n      wrap.classList.add('pad-motion');\n\n      const progress=wrap.querySelector('.pad-progress span');\n      const updateProgress=()=>{\n        const max=document.documentElement.scrollHeight-innerHeight;\n        progress.style.transform=`scaleX(${max>0?Math.min(1,scrollY/max):0})`;\n      };\n      updateProgress();\n      addEventListener('scroll',updateProgress,{passive:true});\n      addEventListener('resize',updateProgress);\n\n      const toc=[...wrap.querySelectorAll('.pad-toc button')];\n      toc.forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.target)?.scrollIntoView({behavior:'smooth',block:'start'})));\n      const sections=toc.map(button=>document.getElementById(button.dataset.target)).filter(Boolean);\n      const rail=wrap.querySelector('.pad-toc');\n      const centreInRail=button=>{\n        if(!rail||rail.scrollWidth<=rail.clientWidth)return;\n        const left=button.offsetLeft-(rail.clientWidth-button.offsetWidth)/2;\n        rail.scrollTo({left:Math.max(0,left),behavior:'smooth'});\n      };\n      const tocObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{\n        if(entry.isIntersecting){\n          toc.forEach(button=>{\n            const active=button.dataset.target===entry.target.id;\n            button.classList.toggle('active',active);\n            if(active)centreInRail(button);\n          });\n        }\n      }),{rootMargin:'-22% 0px -62% 0px'});\n      sections.forEach(section=>tocObserver.observe(section));\n\n      const revealObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{\n        if(entry.isIntersecting){entry.target.classList.add('in');revealObserver.unobserve(entry.target);}\n      }),{threshold:.07});\n      wrap.querySelectorAll('.pad-reveal').forEach(element=>revealObserver.observe(element));\n\n      const apiData={\n        prior:{route:'EHR → payer',title:'Prior Authorization API',copy:'Your system asks what documentation is needed, sends the request, and receives the decision. Daily work shifts from submission to exceptions that automation cannot resolve.'},\n        provider:{route:'Payer → provider',title:'Provider Access API',copy:'Your team can retrieve a patient’s payer-held history, including care delivered elsewhere. Accurate provider directory data becomes a prerequisite.'},\n        patient:{route:'Payer → patient app',title:'Patient Access API',copy:'Patients can see claims and authorization status in an app, sometimes before the front desk. Your team needs a process for those questions.'},\n        payer:{route:'Previous payer → new payer',title:'Payer-to-Payer API',copy:'Existing approvals can move when coverage changes, reducing duplicate authorization work when a patient switches plans.'}\n      };\n      wrap.querySelectorAll('.pad-api-tabs button').forEach(button=>button.addEventListener('click',()=>{\n        const data=apiData[button.dataset.api];\n        wrap.querySelectorAll('.pad-api-tabs button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-selected',String(active));});\n        document.getElementById('pad-api-route').textContent=data.route;\n        document.getElementById('pad-api-title').textContent=data.title;\n        document.getElementById('pad-api-copy').textContent=data.copy;\n      }));\n\n      const handoffData={\n        automated:{icon:'↻',title:'The repeatable path',copy:'Typing, portal logins, routine submissions, and status checks can move through the standardized connection.'},\n        human:{icon:'◇',title:'The judgment path',copy:'Pended requests, missing clinical notes, payer-specific exceptions, denials, and appeals still need named owners and experienced review.'}\n      };\n      wrap.querySelectorAll('.pad-handoff-controls button').forEach(button=>button.addEventListener('click',()=>{\n        const data=handoffData[button.dataset.handoff];\n        wrap.querySelectorAll('.pad-handoff-controls button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-selected',String(active));});\n        document.getElementById('pad-handoff-icon').textContent=data.icon;\n        document.getElementById('pad-handoff-title').textContent=data.title;\n        document.getElementById('pad-handoff-copy').textContent=data.copy;\n      }));\n\n      const partnerData={\n        capacity:{mark:'01',title:'Scale without permanent headcount',copy:'Trained teams can expand during the transition when authorization volume outpaces staff capacity.'},\n        payers:{mark:'02',title:'Maintain payer requirements',copy:'A current requirements library prevents every payer variation from becoming a new research task for staff.'},\n        denials:{mark:'03',title:'Correct recurring causes',copy:'Root-cause tagging and pattern analysis feed corrections back to intake and scheduling before the next submission.'},\n        tracking:{mark:'04',title:'Centralize status visibility',copy:'Shared tracking and reporting replace staff checking separate payer portals one request at a time.'},\n        transition:{mark:'05',title:'Run a hybrid operation',copy:'Experienced teams can keep manual and automated routes working together through uneven payer go-lives.'},\n        documents:{mark:'06',title:'Move checks upstream',copy:'Documentation checks at scheduling help requests go out complete the first time instead of stalling later.'}\n      };\n      wrap.querySelectorAll('.pad-challenges button').forEach(button=>button.addEventListener('click',()=>{\n        const data=partnerData[button.dataset.challenge];\n        wrap.querySelectorAll('.pad-challenges button').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-selected',String(active));});\n        document.getElementById('pad-partner-mark').textContent=data.mark;\n        document.getElementById('pad-partner-title').textContent=data.title;\n        document.getElementById('pad-partner-copy').textContent=data.copy;\n      }));\n\n      const tasks=[...wrap.querySelectorAll('.pad-task')];\n      const updateReadiness=()=>{\n        const complete=tasks.filter(task=>task.classList.contains('done')).length;\n        document.getElementById('pad-readiness-count').textContent=`${complete} of ${tasks.length} complete`;\n        document.getElementById('pad-readiness-meter').style.width=`${complete/tasks.length*100}%`;\n      };\n      tasks.forEach(task=>task.addEventListener('click',()=>{task.classList.toggle('done');task.setAttribute('aria-pressed',String(task.classList.contains('done')));updateReadiness();}));\n      tasks.forEach(task=>task.setAttribute('aria-pressed','false'));\n      updateReadiness();\n    })();\n  </script>\n</body>\n</html>"
        }
      ]
    }
  ],
