    <NodeName Default="What We Heard at CCW Las Vegas 2026: From AI Ambition to Operational Reality">
      <Name Culture="en-US">What We Heard at CCW Las Vegas 2026: From AI Ambition to Operational Reality</Name>
    </NodeName>
