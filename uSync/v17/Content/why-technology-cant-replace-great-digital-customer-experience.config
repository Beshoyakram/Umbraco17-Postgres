    <NodeName Default="Why Technology Can’t Replace Great Digital Customer Experience">
      <Name Culture="en-US">Why Technology Can’t Replace Great Digital Customer Experience</Name>
    </NodeName>
    <SortOrder>4</SortOrder>
    <Published Default="true">
      <Published Culture="en-US">true</Published>
    </Published>
    <Schedule />
    <Template Key="01a04332-960a-789a-bc7b-1032733babdc">BlogDetailPage</Template>
  </Info>
  <Properties>
    <bannerImage>
      <Value Culture="en-US"><![CDATA[[
  {
