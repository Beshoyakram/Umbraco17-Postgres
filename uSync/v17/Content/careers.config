    <whyHeading>
      <Value Culture="en-US"><![CDATA[Why Work With Us ?]]></Value>
    </whyHeading>
    <whyItems>
      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010005-aaaa-4bbb-8ccc-000000000001",
      "key": "a7010005-3333-4333-8333-000000000001",
      "values": [
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Grow Your Career in a Dynamic Industry"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "At Centro, we invest in our people. We offer professional development, training, and career growth opportunities in the ever-evolving BPO and digital transformation space."
        }
      ]
    },
    {
      "contentTypeKey": "a7010005-aaaa-4bbb-8ccc-000000000001",
      "key": "a7010005-3333-4333-8333-000000000002",
      "values": [
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Be Part of an Innovative and Supportive Team"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "We foster a culture of collaboration, innovation, and inclusivity. Our teams work together to solve challenges, embrace new technologies, and make a real impact in the industries we serve."
        }
      ]
    },
    {
      "contentTypeKey": "a7010005-aaaa-4bbb-8ccc-000000000001",
      "key": "a7010005-3333-4333-8333-000000000003",
      "values": [
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Work in an Environment That Values You"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "We believe that a great workplace is built on respect, support, and opportunities for success. At Centro, we recognize hard work, encourage growth, and provide a positive environment."
        }
      ]
    }
  ],
