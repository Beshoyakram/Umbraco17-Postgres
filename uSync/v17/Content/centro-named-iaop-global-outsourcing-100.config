                        <contentBlocks>
      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "a7010006-5555-4555-8555-111100000015",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!-- =========================================================\n     CENTRO WORDPRESS BLOG\n     IAOP GLOBAL OUTSOURCING 100 — 2026\n     Paste into a WordPress Custom HTML block / code editor.\n     No website header or footer included.\n========================================================= -->\n\n<style>\n/* =========================================================\n   CENTRO BLOG — HARD SCOPED RESET\n========================================================= */\n\n#centro-iaop-blog,\n#centro-iaop-blog * {\n  box-sizing: border-box;\n}\n\n#centro-iaop-blog {\n  --centro-navy: #063B5C;\n  --centro-blue: #015376;\n  --centro-bright-blue: #00A9E0;\n  --centro-sky: #DDF5FC;\n  --centro-soft-blue: #F1FAFD;\n  --centro-white: #FFFFFF;\n  --centro-text: #24485D;\n  --centro-border: rgba(1, 83, 118, 0.14);\n\n  width: 100%;\n  margin: 0 auto;\n  padding: 0;\n  font-family: \"Poppins\", Arial, sans-serif !important;\n  color: var(--centro-text) !important;\n  line-height: 1.75;\n  background: transparent;\n}\n\n#centro-iaop-blog h1,\n#centro-iaop-blog h2,\n#centro-iaop-blog h3,\n#centro-iaop-blog h4,\n#centro-iaop-blog p,\n#centro-iaop-blog span,\n#centro-iaop-blog strong,\n#centro-iaop-blog div,\n#centro-iaop-blog summary {\n  font-family: \"Poppins\", Arial, sans-serif !important;\n}\n\n#centro-iaop-blog h1,\n#centro-iaop-blog h2,\n#centro-iaop-blog h3,\n#centro-iaop-blog h4 {\n  margin-top: 0 !important;\n  color: var(--centro-navy) !important;\n  line-height: 1.18 !important;\n}\n\n#centro-iaop-blog p {\n  color: var(--centro-text) !important;\n  margin: 0 0 20px !important;\n  font-size: 16px !important;\n  line-height: 1.8 !important;\n}\n\n#centro-iaop-blog a {\n  text-decoration: none;\n}\n\n#centro-iaop-blog img {\n  display: block;\n  height: auto !important;\n}\n\n\n/* =========================================================\n   LAYOUT\n========================================================= */\n\n#centro-iaop-blog .centro-blog-wrap {\n  width: min(100%, 1120px);\n  margin: 0 auto;\n}\n\n#centro-iaop-blog .centro-content-width {\n  width: min(100%, 880px);\n  margin-left: auto;\n  margin-right: auto;\n}\n\n\n/* =========================================================\n   HERO / INTRO\n========================================================= */\n\n#centro-iaop-blog .centro-hero {\n  position: relative;\n  overflow: hidden;\n  padding: 54px 50px;\n  margin-bottom: 38px;\n  border-radius: 28px;\n  background:\n    radial-gradient(\n      circle at 90% 15%,\n      rgba(0,169,224,0.18),\n      transparent 35%\n    ),\n    linear-gradient(\n      135deg,\n      #F5FCFE 0%,\n      #E8F8FC 100%\n    );\n  border: 1px solid rgba(0,169,224,0.15);\n}\n\n#centro-iaop-blog .centro-hero::before {\n  content: \"\";\n  position: absolute;\n  width: 280px;\n  height: 280px;\n  right: -100px;\n  bottom: -150px;\n  border-radius: 50%;\n  border: 55px solid rgba(0,169,224,0.08);\n  pointer-events: none;\n}\n\n#centro-iaop-blog .centro-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  padding: 8px 14px;\n  margin-bottom: 22px;\n  border-radius: 999px;\n  background: var(--centro-white);\n  border: 1px solid rgba(1,83,118,0.12);\n  color: var(--centro-blue) !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n#centro-iaop-blog .centro-eyebrow-dot {\n  width: 8px;\n  height: 8px;\n  flex: 0 0 8px;\n  border-radius: 50%;\n  background: var(--centro-bright-blue);\n}\n\n#centro-iaop-blog .centro-hero h1 {\n  max-width: 900px;\n  margin-bottom: 20px !important;\n  font-size: clamp(34px, 5vw, 60px) !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.04em !important;\n}\n\n#centro-iaop-blog .centro-hero .centro-lead {\n  max-width: 780px;\n  margin-bottom: 0 !important;\n  color: var(--centro-blue) !important;\n  font-size: 18px !important;\n  line-height: 1.65 !important;\n}\n\n\n/* =========================================================\n   ORIGINAL IAOP IMAGE\n========================================================= */\n\n#centro-iaop-blog .centro-main-image {\n  margin: 0 auto 50px;\n  text-align: center;\n}\n\n#centro-iaop-blog .centro-main-image img {\n  width: 100% !important;\n  max-width: 800px !important;\n  height: auto !important;\n  margin: 0 auto !important;\n  border-radius: 24px;\n  box-shadow: 0 18px 50px rgba(6,59,92,0.10);\n}\n\n/*\n  IMPORTANT:\n  The source image is approximately 800px wide.\n  max-width:800px prevents WordPress from artificially\n  enlarging it and making it look pixelated.\n*/\n\n\n/* =========================================================\n   FOURTH CONSECUTIVE YEAR STAT\n========================================================= */\n\n#centro-iaop-blog .centro-recognition {\n  display: grid;\n  grid-template-columns: 190px 1fr;\n  overflow: hidden;\n  margin: 46px 0;\n  border-radius: 24px;\n  background: var(--centro-navy);\n  box-shadow: 0 18px 50px rgba(6,59,92,0.12);\n}\n\n#centro-iaop-blog .centro-recognition-number {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  min-height: 190px;\n  padding: 28px;\n  background: var(--centro-bright-blue);\n  text-align: center;\n}\n\n#centro-iaop-blog .centro-recognition-number strong {\n  display: block;\n  color: #FFFFFF !important;\n  font-size: 76px !important;\n  line-height: 0.9 !important;\n  font-weight: 700 !important;\n}\n\n#centro-iaop-blog .centro-recognition-number span {\n  margin-top: 12px;\n  color: #FFFFFF !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n}\n\n#centro-iaop-blog .centro-recognition-copy {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: 34px 40px;\n}\n\n#centro-iaop-blog .centro-recognition-copy span {\n  display: block;\n  margin-bottom: 8px;\n  color: #7DDDF5 !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.09em;\n  text-transform: uppercase;\n}\n\n#centro-iaop-blog .centro-recognition-copy h2 {\n  margin-bottom: 10px !important;\n  color: #FFFFFF !important;\n  font-size: clamp(25px, 3vw, 36px) !important;\n}\n\n#centro-iaop-blog .centro-recognition-copy p {\n  margin-bottom: 0 !important;\n  color: rgba(255,255,255,0.82) !important;\n}\n\n\n/* =========================================================\n   ARTICLE SECTIONS\n========================================================= */\n\n#centro-iaop-blog .centro-section {\n  margin: 50px 0;\n}\n\n#centro-iaop-blog .centro-section-heading {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 22px;\n}\n\n#centro-iaop-blog .centro-section-marker {\n  width: 42px;\n  height: 4px;\n  flex: 0 0 42px;\n  border-radius: 10px;\n  background: var(--centro-bright-blue);\n}\n\n#centro-iaop-blog .centro-section-heading h2 {\n  margin: 0 !important;\n  font-size: clamp(26px, 3vw, 36px) !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.025em !important;\n}\n\n\n/* =========================================================\n   QUOTE\n========================================================= */\n\n#centro-iaop-blog .centro-quote {\n  position: relative;\n  overflow: hidden;\n  margin: 52px 0;\n  padding: 42px 46px;\n  border-radius: 26px;\n  background: var(--centro-blue);\n}\n\n#centro-iaop-blog .centro-quote::after {\n  content: \"“\";\n  position: absolute;\n  top: -45px;\n  right: 22px;\n  color: rgba(255,255,255,0.08) !important;\n  font-family: Georgia, serif !important;\n  font-size: 210px;\n  line-height: 1;\n  pointer-events: none;\n}\n\n#centro-iaop-blog .centro-quote-label {\n  position: relative;\n  z-index: 1;\n  display: block;\n  margin-bottom: 17px;\n  color: #70DCF7 !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.11em;\n  text-transform: uppercase;\n}\n\n#centro-iaop-blog .centro-quote blockquote {\n  position: relative;\n  z-index: 1;\n  padding: 0 !important;\n  margin: 0 !important;\n  border: 0 !important;\n}\n\n#centro-iaop-blog .centro-quote blockquote p {\n  margin: 0 0 23px !important;\n  color: #FFFFFF !important;\n  font-size: clamp(20px, 2.4vw, 27px) !important;\n  line-height: 1.55 !important;\n  font-weight: 500 !important;\n}\n\n#centro-iaop-blog .centro-quote-author strong {\n  display: block;\n  color: #FFFFFF !important;\n  font-size: 15px !important;\n}\n\n#centro-iaop-blog .centro-quote-author span {\n  color: rgba(255,255,255,0.69) !important;\n  font-size: 13px !important;\n}\n\n\n/* =========================================================\n   WHY IT MATTERS CARDS\n========================================================= */\n\n#centro-iaop-blog .centro-impact-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n  margin-top: 28px;\n}\n\n#centro-iaop-blog .centro-impact-card {\n  position: relative;\n  overflow: hidden;\n  min-height: 190px;\n  padding: 28px;\n  border: 1px solid var(--centro-border);\n  border-radius: 22px;\n  background: #FFFFFF;\n  box-shadow: 0 8px 28px rgba(6,59,92,0.05);\n}\n\n#centro-iaop-blog .centro-impact-card::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 4px;\n  background: var(--centro-bright-blue);\n}\n\n#centro-iaop-blog .centro-impact-index {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 38px;\n  height: 38px;\n  margin-bottom: 22px;\n  border-radius: 12px;\n  background: var(--centro-soft-blue);\n  color: var(--centro-blue) !important;\n  font-size: 13px !important;\n  font-weight: 700 !important;\n}\n\n#centro-iaop-blog .centro-impact-card h3 {\n  margin-bottom: 10px !important;\n  font-size: 18px !important;\n  font-weight: 700 !important;\n}\n\n#centro-iaop-blog .centro-impact-card p {\n  margin: 0 !important;\n  font-size: 14px !important;\n  line-height: 1.65 !important;\n}\n\n\n/* =========================================================\n   ABOUT IAOP\n========================================================= */\n\n#centro-iaop-blog .centro-about-box {\n  display: grid;\n  grid-template-columns: 1fr 180px;\n  gap: 40px;\n  align-items: center;\n  margin: 54px 0;\n  padding: 38px 42px;\n  border-radius: 26px;\n  background: linear-gradient(135deg, #F4FBFD, #E7F7FB);\n  border: 1px solid rgba(0,169,224,0.14);\n}\n\n#centro-iaop-blog .centro-about-box h2 {\n  margin-bottom: 14px !important;\n  font-size: 29px !important;\n}\n\n#centro-iaop-blog .centro-about-box p {\n  margin-bottom: 0 !important;\n}\n\n#centro-iaop-blog .centro-about-mark {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: var(--centro-navy);\n  color: #FFFFFF !important;\n  text-align: center;\n}\n\n#centro-iaop-blog .centro-about-mark span {\n  color: #FFFFFF !important;\n  font-size: 23px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.03em;\n}\n\n\n/* =========================================================\n   FAQ\n========================================================= */\n\n#centro-iaop-blog .centro-faq {\n  margin-top: 58px;\n}\n\n#centro-iaop-blog .centro-faq-title {\n  margin-bottom: 25px !important;\n  font-size: clamp(28px, 3vw, 38px) !important;\n}\n\n#centro-iaop-blog .centro-faq details {\n  overflow: hidden;\n  margin-bottom: 12px;\n  border: 1px solid var(--centro-border);\n  border-radius: 17px;\n  background: #FFFFFF;\n}\n\n#centro-iaop-blog .centro-faq summary {\n  position: relative;\n  padding: 21px 56px 21px 24px;\n  color: var(--centro-navy) !important;\n  cursor: pointer;\n  list-style: none;\n  font-size: 16px !important;\n  font-weight: 600 !important;\n}\n\n#centro-iaop-blog .centro-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n#centro-iaop-blog .centro-faq summary::after {\n  content: \"+\";\n  position: absolute;\n  right: 23px;\n  top: 50%;\n  transform: translateY(-50%);\n  color: var(--centro-bright-blue) !important;\n  font-size: 27px;\n  font-weight: 400;\n}\n\n#centro-iaop-blog .centro-faq details[open] summary::after {\n  content: \"−\";\n}\n\n#centro-iaop-blog .centro-faq-answer {\n  padding: 0 24px 22px;\n}\n\n#centro-iaop-blog .centro-faq-answer p {\n  margin: 0 !important;\n  font-size: 15px !important;\n}\n\n\n/* =========================================================\n   CTA\n========================================================= */\n\n#centro-iaop-blog .centro-cta {\n  position: relative;\n  overflow: hidden;\n  margin-top: 60px;\n  padding: 52px 44px;\n  border-radius: 28px;\n  background: var(--centro-navy);\n  text-align: center;\n}\n\n#centro-iaop-blog .centro-cta::before,\n#centro-iaop-blog .centro-cta::after {\n  content: \"\";\n  position: absolute;\n  border-radius: 50%;\n  border: 1px solid rgba(255,255,255,0.12);\n}\n\n#centro-iaop-blog .centro-cta::before {\n  width: 280px;\n  height: 280px;\n  left: -130px;\n  top: -160px;\n}\n\n#centro-iaop-blog .centro-cta::after {\n  width: 330px;\n  height: 330px;\n  right: -170px;\n  bottom: -210px;\n}\n\n#centro-iaop-blog .centro-cta-content {\n  position: relative;\n  z-index: 2;\n  max-width: 700px;\n  margin: auto;\n}\n\n#centro-iaop-blog .centro-cta-label {\n  display: inline-block;\n  margin-bottom: 14px;\n  color: #70DCF7 !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n}\n\n#centro-iaop-blog .centro-cta h2 {\n  margin-bottom: 15px !important;\n  color: #FFFFFF !important;\n  font-size: clamp(29px, 4vw, 43px) !important;\n}\n\n#centro-iaop-blog .centro-cta p {\n  max-width: 610px;\n  margin: 0 auto 28px !important;\n  color: rgba(255,255,255,0.78) !important;\n}\n\n#centro-iaop-blog .centro-cta-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n}\n\n#centro-iaop-blog .centro-btn {\n  display: inline-flex !important;\n  align-items: center;\n  justify-content: center;\n  min-height: 50px;\n  padding: 13px 23px !important;\n  border-radius: 11px !important;\n  font-size: 14px !important;\n  font-weight: 600 !important;\n  transition:\n    transform .2s ease,\n    box-shadow .2s ease;\n}\n\n#centro-iaop-blog .centro-btn:hover {\n  transform: translateY(-2px);\n}\n\n#centro-iaop-blog .centro-btn-primary {\n  background: var(--centro-bright-blue) !important;\n  color: #FFFFFF !important;\n  box-shadow: 0 10px 25px rgba(0,169,224,0.20);\n}\n\n#centro-iaop-blog .centro-btn-secondary {\n  border: 1px solid rgba(255,255,255,0.35) !important;\n  background: rgba(255,255,255,0.08) !important;\n  color: #FFFFFF !important;\n}\n\n\n/* =========================================================\n   MOBILE\n========================================================= */\n\n@media (max-width: 800px) {\n\n  #centro-iaop-blog .centro-hero {\n    padding: 36px 24px;\n    border-radius: 21px;\n  }\n\n  #centro-iaop-blog .centro-hero h1 {\n    font-size: 36px !important;\n  }\n\n  #centro-iaop-blog .centro-recognition {\n    grid-template-columns: 1fr;\n  }\n\n  #centro-iaop-blog .centro-recognition-number {\n    min-height: auto;\n    padding: 30px;\n  }\n\n  #centro-iaop-blog .centro-recognition-number strong {\n    font-size: 64px !important;\n  }\n\n  #centro-iaop-blog .centro-recognition-copy {\n    padding: 30px 25px;\n  }\n\n  #centro-iaop-blog .centro-impact-grid {\n    grid-template-columns: 1fr;\n  }\n\n  #centro-iaop-blog .centro-about-box {\n    grid-template-columns: 1fr;\n    padding: 30px 25px;\n  }\n\n  #centro-iaop-blog .centro-about-mark {\n    width: 130px;\n    justify-self: start;\n  }\n\n  #centro-iaop-blog .centro-quote {\n    padding: 32px 25px;\n  }\n\n  #centro-iaop-blog .centro-cta {\n    padding: 40px 24px;\n  }\n}\n\n</style>\n\n\n<article id=\"centro-iaop-blog\">\n\n  <div class=\"centro-blog-wrap\">\n\n    <!-- HERO -->\n    <section class=\"centro-hero\">\n\n      <div class=\"centro-eyebrow\">\n        <span class=\"centro-eyebrow-dot\"></span>\n        Awards &amp; Recognition\n      </div>\n\n      <h1>\n        Centro Named to the IAOP Global 100 for the Fourth Consecutive Year\n      </h1>\n\n      <p class=\"centro-lead\">\n        Centro has once again been recognized among the global outsourcing\n        industry&#8217;s distinguished providers, earning a place in the 2026\n        IAOP Global Outsourcing 100 as a Rising Star.\n      </p>\n\n    </section>\n\n\n    <!-- ORIGINAL ARTICLE IMAGE -->\n    <div class=\"centro-main-image\">\n\n      <img\n        src=\"https://centrocdx.com/wp-content/uploads/2026/04/Blog-IAOP.png\"\n        alt=\"Centro recognized in the 2026 IAOP Global Outsourcing 100\"\n        width=\"800\"\n        height=\"420\"\n        loading=\"eager\"\n        decoding=\"async\"\n      >\n\n    </div>\n\n\n    <div class=\"centro-content-width\">\n\n      <!-- INTRO -->\n      <section class=\"centro-section\">\n\n        <p>\n          The 2026 recognition represents Centro&#8217;s fourth consecutive year\n          receiving recognition from the International Association of\n          Outsourcing Professionals (IAOP), reinforcing the company&#8217;s\n          sustained momentum within the global outsourcing industry.\n        </p>\n\n        <p>\n          The Global Outsourcing 100 brings visibility to outsourcing service\n          providers from around the world, spanning established industry\n          leaders and emerging organizations demonstrating strong growth,\n          innovation and market impact.\n        </p>\n\n      </section>\n\n\n      <!-- RECOGNITION STAT -->\n      <section class=\"centro-recognition\">\n\n        <div class=\"centro-recognition-number\">\n\n          <strong>4</strong>\n\n          <span>Consecutive Years</span>\n\n        </div>\n\n        <div class=\"centro-recognition-copy\">\n\n          <span>IAOP Global Outsourcing 100</span>\n\n          <h2>\n            Consistent recognition. Continued momentum.\n          </h2>\n\n          <p>\n            Centro&#8217;s fourth consecutive recognition reflects the continued\n            development of its global delivery capabilities and commitment\n            to high-value outsourcing outcomes.\n          </p>\n\n        </div>\n\n      </section>\n\n\n      <!-- ABOUT RECOGNITION -->\n      <section class=\"centro-section\">\n\n        <div class=\"centro-section-heading\">\n          <span class=\"centro-section-marker\"></span>\n          <h2>Recognition Built on Outsourcing Excellence</h2>\n        </div>\n\n        <p>\n          IAOP&#8217;s Global Outsourcing 100 is designed to recognize outsourcing\n          providers demonstrating the capabilities, vision and performance\n          required in an evolving global services market.\n        </p>\n\n        <p>\n          For Centro, repeated recognition reflects a broader commitment to\n          building scalable operations, developing world-class talent and\n          delivering measurable value for clients across international\n          markets.\n        </p>\n\n      </section>\n\n\n      <!-- HESHAM QUOTE -->\n      <section class=\"centro-quote\">\n\n        <span class=\"centro-quote-label\">\n          Leadership Perspective\n        </span>\n\n        <blockquote>\n\n          <p>\n            “Being recognized as a Rising Star by the IAOP Global 100 for the\n            fourth year running is a powerful validation of our team&#8217;s\n            relentless drive and our passion for outsourcing excellence.\n            This honor pushes us to keep raising the bar for what a modern\n            outsourcing company can achieve for our clients.”\n          </p>\n\n        </blockquote>\n\n        <div class=\"centro-quote-author\">\n\n          <strong>Hesham Farag</strong>\n\n          <span>Executive Chairman &amp; Founder, Centro</span>\n\n        </div>\n\n      </section>\n\n\n      <!-- GLOBAL MODEL -->\n      <section class=\"centro-section\">\n\n        <div class=\"centro-section-heading\">\n          <span class=\"centro-section-marker\"></span>\n          <h2>What This Recognition Represents</h2>\n        </div>\n\n        <p>\n          Centro continues to strengthen a global delivery model designed to\n          support organizations with scalable outsourcing capabilities across\n          customer experience, technical support and back-office operations.\n        </p>\n\n        <div class=\"centro-impact-grid\">\n\n          <div class=\"centro-impact-card\">\n\n            <span class=\"centro-impact-index\">01</span>\n\n            <h3>Global Delivery</h3>\n\n            <p>\n              A delivery model built to support international operations and\n              changing business requirements.\n            </p>\n\n          </div>\n\n\n          <div class=\"centro-impact-card\">\n\n            <span class=\"centro-impact-index\">02</span>\n\n            <h3>Scalable Operations</h3>\n\n            <p>\n              Outsourcing capabilities designed to grow alongside client\n              demand and operational complexity.\n            </p>\n\n          </div>\n\n\n          <div class=\"centro-impact-card\">\n\n            <span class=\"centro-impact-index\">03</span>\n\n            <h3>Client Outcomes</h3>\n\n            <p>\n              A continued focus on execution, performance and meaningful\n              business impact.\n            </p>\n\n          </div>\n\n        </div>\n\n      </section>\n\n\n      <!-- TEAM -->\n      <section class=\"centro-section\">\n\n        <div class=\"centro-section-heading\">\n          <span class=\"centro-section-marker\"></span>\n          <h2>A Shared Achievement</h2>\n        </div>\n\n        <p>\n          This recognition belongs to the teams behind Centro&#8217;s operations\n          and to the clients who continue to place their trust in the\n          organization.\n        </p>\n\n        <p>\n          As Centro continues to expand its capabilities, the focus remains on\n          developing people, strengthening operations and raising the standard\n          of what businesses can expect from a modern outsourcing partner.\n        </p>\n\n      </section>\n\n\n      <!-- ABOUT IAOP -->\n      <section class=\"centro-about-box\">\n\n        <div>\n\n          <h2>About IAOP</h2>\n\n          <p>\n            IAOP is a global association for outsourcing and business services\n            professionals, bringing together customers, providers and advisors\n            through professional development, industry collaboration,\n            recognition and shared expertise.\n          </p>\n\n        </div>\n\n        <a class=\"centro-about-mark\" href=\"https://www.iaop.org/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Visit the IAOP website\">\n          <span>IAOP</span>\n        </a>\n\n      </section>\n\n\n      <!-- FAQ -->\n      <section class=\"centro-faq\">\n\n        <h2 class=\"centro-faq-title\">\n          Frequently Asked Questions\n        </h2>\n\n\n        <details>\n\n          <summary>\n            Has Centro won BPO industry awards?\n          </summary>\n\n          <div class=\"centro-faq-answer\">\n\n            <p>\n              Yes. Centro has received recognition from major organizations\n              within the outsourcing industry, including repeated recognition\n              in the IAOP Global Outsourcing 100.\n            </p>\n\n          </div>\n\n        </details>\n\n\n        <details>\n\n          <summary>\n            What is the IAOP Global Outsourcing 100?\n          </summary>\n\n          <div class=\"centro-faq-answer\">\n\n            <p>\n              The Global Outsourcing 100 is an annual IAOP program recognizing\n              outsourcing service providers from around the world, including\n              established leaders and Rising Stars.\n            </p>\n\n          </div>\n\n        </details>\n\n\n        <details>\n\n          <summary>\n            What does IAOP Rising Star recognition mean?\n          </summary>\n\n          <div class=\"centro-faq-answer\">\n\n            <p>\n              Rising Star is a category within the Global Outsourcing 100 that\n              recognizes outsourcing providers demonstrating notable growth,\n              momentum and developing market leadership.\n            </p>\n\n          </div>\n\n        </details>\n\n      </section>\n\n\n      <!-- CTA -->\n      <section class=\"centro-cta\">\n\n        <div class=\"centro-cta-content\">\n\n          <span class=\"centro-cta-label\">\n            Build With Centro\n          </span>\n\n          <h2>\n            Looking for an outsourcing partner built for what comes next?\n          </h2>\n\n          <p>\n            Explore Centro&#8217;s Business Process Outsourcing capabilities and\n            discover how our teams support scalable, high-performing\n            operations.\n          </p>\n\n          <div class=\"centro-cta-buttons\">\n\n            <a class=\"centro-btn centro-btn-primary\" href=\"https://centrocdx.com/bpo/\">\n              Explore BPO Solutions\n            </a>\n\n            <a class=\"centro-btn centro-btn-secondary\" href=\"https://centrocdx.com/get-in-touch/\">\n              Get in Touch\n            </a>\n\n          </div>\n\n        </div>\n\n      </section>\n\n    </div>\n\n  </div>\n\n</article>"
        }
      ]
    }
  ],
