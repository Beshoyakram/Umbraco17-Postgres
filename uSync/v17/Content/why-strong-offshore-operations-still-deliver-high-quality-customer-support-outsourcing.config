    <NodeName Default="Why Strong Offshore Operations Still Deliver High-Quality Customer Support Outsourcing">
      <Name Culture="en-US">Why Strong Offshore Operations Still Deliver High-Quality Customer Support Outsourcing</Name>
    </NodeName>
    <SortOrder>6</SortOrder>
    <Published Default="true">
      <Published Culture="en-US">true</Published>
    </Published>
    <Schedule />
    <Template Key="01a04332-960a-789a-bc7b-1032733babdc">BlogDetailPage</Template>
  </Info>
  <Properties>
    <bannerImage>
      <Value Culture="en-US"><![CDATA[[
  {
    "key": "a7010006-3333-4333-8333-200000000007",
