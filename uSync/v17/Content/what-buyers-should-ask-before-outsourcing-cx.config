      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "ea5ba873-9a1e-4ca9-a8d5-71a46bef1e84",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!--\n  Centro | Dynamic WordPress Custom HTML Article Body\n  Article: What Buyers Should Ask Before Outsourcing CX\n  Installation: Paste this entire file into one WordPress Custom HTML block.\n  Keep the WordPress page title, featured image, category, views and sidebar outside this block.\n-->\n\n<style>\n  .centro-cx-lab,\n  .centro-cx-lab * {\n    box-sizing: border-box;\n  }\n\n  .centro-cx-lab {\n    --cx-navy: #062f4b;\n    --cx-deep: #001f33;\n    --cx-blue: #015376;\n    --cx-bright: #29b8e6;\n    --cx-sky: #a9e4f5;\n    --cx-ice: #eef9fd;\n    --cx-white: #ffffff;\n    --cx-ink: #173245;\n    --cx-muted: #5d7280;\n    --cx-line: #d8e8ef;\n    --cx-green: #1c9c76;\n    --cx-green-bg: #eaf8f3;\n    --cx-red: #d35f62;\n    --cx-red-bg: #fff1f1;\n    --cx-amber: #f3aa3d;\n    --cx-shadow: 0 24px 70px rgba(1, 83, 118, 0.12);\n    width: 100%;\n    overflow: hidden;\n    color: var(--cx-ink);\n    font-family: \"Poppins\", Arial, sans-serif;\n    font-size: 16px;\n    line-height: 1.75;\n  }\n\n  .centro-cx-lab a {\n    color: inherit;\n  }\n\n  .centro-cx-lab button,\n  .centro-cx-lab input,\n  .centro-cx-lab label,\n  .centro-cx-lab summary {\n    font-family: inherit;\n  }\n\n  .centro-cx-lab h2,\n  .centro-cx-lab h3,\n  .centro-cx-lab h4,\n  .centro-cx-lab p {\n    margin-top: 0;\n  }\n\n  .centro-cx-lab h2,\n  .centro-cx-lab h3,\n  .centro-cx-lab h4 {\n    color: var(--cx-navy);\n    line-height: 1.18;\n    letter-spacing: -0.03em;\n  }\n\n  .cx-shell {\n    width: min(1120px, calc(100% - 36px));\n    margin: 0 auto;\n  }\n\n  .cx-section {\n    padding: 88px 0;\n    position: relative;\n  }\n\n  .cx-section--soft {\n    background:\n      radial-gradient(circle at 8% 0%, rgba(41, 184, 230, 0.13), transparent 27%),\n      linear-gradient(180deg, #f8fcfe 0%, #eef8fc 100%);\n  }\n\n  .cx-section--dark {\n    color: rgba(255, 255, 255, 0.82);\n    background:\n      radial-gradient(circle at 90% 10%, rgba(41, 184, 230, 0.18), transparent 28%),\n      linear-gradient(135deg, #001f33 0%, #062f4b 62%, #015376 100%);\n  }\n\n  .cx-section--dark h2,\n  .cx-section--dark h3,\n  .cx-section--dark h4 {\n    color: var(--cx-white);\n  }\n\n  .cx-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin-bottom: 16px;\n    color: var(--cx-blue);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .cx-eyebrow::before {\n    content: \"\";\n    width: 24px;\n    height: 3px;\n    border-radius: 99px;\n    background: var(--cx-bright);\n  }\n\n  .cx-section--dark .cx-eyebrow {\n    color: var(--cx-sky);\n  }\n\n  .cx-title {\n    max-width: 780px;\n    margin-bottom: 18px;\n    font-size: clamp(32px, 4.5vw, 56px);\n  }\n\n  .cx-lead {\n    max-width: 760px;\n    margin-bottom: 0;\n    color: var(--cx-muted);\n    font-size: clamp(17px, 2vw, 20px);\n  }\n\n  .cx-section--dark .cx-lead {\n    color: rgba(255, 255, 255, 0.72);\n  }\n\n  /* Hero */\n  .cx-hero {\n    position: relative;\n    isolation: isolate;\n    min-height: 620px;\n    padding: 58px 0 50px;\n    color: var(--cx-white);\n    background:\n      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),\n      radial-gradient(circle at 72% 46%, rgba(41, 184, 230, 0.24), transparent 26%),\n      linear-gradient(135deg, #001a2c 0%, #063953 58%, #015376 100%);\n    background-size: 42px 42px, 42px 42px, auto, auto;\n  }\n\n  .cx-hero::before,\n  .cx-hero::after {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    border-radius: 50%;\n    filter: blur(1px);\n    opacity: 0.5;\n  }\n\n  .cx-hero::before {\n    top: -170px;\n    right: -110px;\n    width: 420px;\n    height: 420px;\n    border: 1px solid rgba(169, 228, 245, 0.23);\n    box-shadow: inset 0 0 0 70px rgba(41, 184, 230, 0.025);\n  }\n\n  .cx-hero::after {\n    bottom: -210px;\n    left: -160px;\n    width: 460px;\n    height: 460px;\n    background: rgba(41, 184, 230, 0.08);\n  }\n\n  .cx-hero__topline {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    padding-bottom: 28px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.13);\n    color: rgba(255, 255, 255, 0.68);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n  }\n\n  .cx-live {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .cx-live::before {\n    content: \"\";\n    width: 9px;\n    height: 9px;\n    border-radius: 50%;\n    background: var(--cx-bright);\n    box-shadow: 0 0 0 7px rgba(41, 184, 230, 0.12);\n    animation: cxPulse 2s infinite;\n  }\n\n  .cx-hero__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);\n    gap: 54px;\n    align-items: center;\n    padding-top: 48px;\n  }\n\n  .cx-hero__kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 18px;\n    color: var(--cx-sky);\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n\n  .cx-hero__kicker span {\n    width: 32px;\n    height: 2px;\n    background: var(--cx-bright);\n  }\n\n  .cx-hero h2 {\n    max-width: 710px;\n    margin-bottom: 20px;\n    color: var(--cx-white);\n    font-size: clamp(42px, 6vw, 74px);\n    line-height: 1.02;\n    letter-spacing: -0.055em;\n  }\n\n  .cx-hero h2 em {\n    color: var(--cx-sky);\n    font-style: normal;\n  }\n\n  .cx-hero__copy {\n    max-width: 650px;\n    margin-bottom: 28px;\n    color: rgba(255, 255, 255, 0.74);\n    font-size: 18px;\n  }\n\n  .cx-hero__chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .cx-hero__chips span {\n    padding: 9px 13px;\n    border: 1px solid rgba(255, 255, 255, 0.17);\n    border-radius: 99px;\n    background: rgba(255, 255, 255, 0.06);\n    color: rgba(255, 255, 255, 0.78);\n    font-size: 12px;\n    font-weight: 700;\n  }\n\n  .cx-compass {\n    position: relative;\n    width: min(430px, 100%);\n    aspect-ratio: 1;\n    margin: 0 auto;\n    border: 1px solid rgba(169, 228, 245, 0.21);\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(41, 184, 230, 0.12) 0 20%, transparent 21% 100%);\n    box-shadow: inset 0 0 0 44px rgba(255, 255, 255, 0.018), 0 25px 75px rgba(0, 0, 0, 0.18);\n    animation: cxFloat 6s ease-in-out infinite;\n  }\n\n  .cx-compass::before,\n  .cx-compass::after {\n    content: \"\";\n    position: absolute;\n    inset: 15%;\n    border: 1px dashed rgba(169, 228, 245, 0.26);\n    border-radius: 50%;\n  }\n\n  .cx-compass::after {\n    inset: 31%;\n    border-style: solid;\n    opacity: 0.7;\n  }\n\n  .cx-compass__axis-x,\n  .cx-compass__axis-y {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    background: linear-gradient(90deg, transparent, rgba(169, 228, 245, 0.32), transparent);\n    transform: translate(-50%, -50%);\n  }\n\n  .cx-compass__axis-x {\n    width: 86%;\n    height: 1px;\n  }\n\n  .cx-compass__axis-y {\n    width: 1px;\n    height: 86%;\n    background: linear-gradient(180deg, transparent, rgba(169, 228, 245, 0.32), transparent);\n  }\n\n  .cx-compass__core {\n    position: absolute;\n    z-index: 3;\n    top: 50%;\n    left: 50%;\n    display: grid;\n    place-items: center;\n    width: 124px;\n    height: 124px;\n    padding: 18px;\n    border: 1px solid rgba(255, 255, 255, 0.32);\n    border-radius: 50%;\n    background: linear-gradient(145deg, #1aa8d3, #015376);\n    box-shadow: 0 0 0 12px rgba(41, 184, 230, 0.09), 0 18px 50px rgba(0, 0, 0, 0.26);\n    color: var(--cx-white);\n    font-size: 14px;\n    font-weight: 800;\n    line-height: 1.25;\n    text-align: center;\n    text-transform: uppercase;\n    transform: translate(-50%, -50%);\n  }\n\n  .cx-compass__node {\n    position: absolute;\n    z-index: 4;\n    min-width: 104px;\n    padding: 11px 14px;\n    border: 1px solid rgba(255, 255, 255, 0.19);\n    border-radius: 14px;\n    background: rgba(0, 31, 51, 0.75);\n    backdrop-filter: blur(8px);\n    color: var(--cx-white);\n    font-size: 12px;\n    font-weight: 800;\n    text-align: center;\n    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);\n  }\n\n  .cx-compass__node small {\n    display: block;\n    margin-top: 2px;\n    color: var(--cx-sky);\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  .cx-compass__node--top { top: 3%; left: 50%; transform: translateX(-50%); }\n  .cx-compass__node--right { top: 50%; right: -2%; transform: translateY(-50%); }\n  .cx-compass__node--bottom { bottom: 3%; left: 50%; transform: translateX(-50%); }\n  .cx-compass__node--left { top: 50%; left: -2%; transform: translateY(-50%); }\n\n  /* Ticker */\n  .cx-ticker {\n    overflow: hidden;\n    border-top: 1px solid rgba(255, 255, 255, 0.12);\n    border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n    background: var(--cx-bright);\n    color: var(--cx-deep);\n  }\n\n  .cx-ticker__track {\n    display: flex;\n    width: max-content;\n    animation: cxTicker 30s linear infinite;\n  }\n\n  .cx-ticker__set {\n    display: flex;\n    align-items: center;\n    white-space: nowrap;\n  }\n\n  .cx-ticker__set span {\n    display: inline-flex;\n    align-items: center;\n    gap: 22px;\n    padding: 14px 24px;\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  .cx-ticker__set span::after {\n    content: \"✦\";\n    font-size: 10px;\n  }\n\n  /* Opening thesis */\n  .cx-thesis {\n    display: grid;\n    grid-template-columns: 0.8fr 1.2fr;\n    gap: 64px;\n    align-items: start;\n  }\n\n  .cx-thesis__marker {\n    position: sticky;\n    top: 28px;\n    padding: 28px;\n    border: 1px solid var(--cx-line);\n    border-radius: 24px;\n    background: var(--cx-white);\n    box-shadow: var(--cx-shadow);\n  }\n\n  .cx-thesis__marker strong {\n    display: block;\n    margin-bottom: 12px;\n    color: var(--cx-blue);\n    font-size: clamp(54px, 7vw, 82px);\n    line-height: 0.9;\n    letter-spacing: -0.07em;\n  }\n\n  .cx-thesis__marker span {\n    display: block;\n    color: var(--cx-navy);\n    font-size: 18px;\n    font-weight: 800;\n    line-height: 1.35;\n  }\n\n  .cx-thesis__copy h2 {\n    margin-bottom: 22px;\n    font-size: clamp(34px, 4.3vw, 54px);\n  }\n\n  .cx-thesis__copy p {\n    color: var(--cx-muted);\n    font-size: 18px;\n  }\n\n  .cx-thesis__copy p:last-child {\n    margin-bottom: 0;\n  }\n\n  .cx-highlight {\n    margin-top: 30px;\n    padding: 22px 24px;\n    border-left: 4px solid var(--cx-bright);\n    border-radius: 0 16px 16px 0;\n    background: var(--cx-ice);\n    color: var(--cx-navy);\n    font-weight: 700;\n  }\n\n  /* Priority selector */\n  .cx-priority {\n    margin-top: 42px;\n    padding: 8px;\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    border-radius: 30px;\n    background: rgba(255, 255, 255, 0.055);\n    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.18);\n  }\n\n  .cx-priority > input {\n    position: absolute;\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  .cx-priority__tabs {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n  }\n\n  .cx-priority__tabs label {\n    position: relative;\n    z-index: 2;\n    padding: 15px 10px;\n    border: 1px solid transparent;\n    border-radius: 19px;\n    color: rgba(255, 255, 255, 0.65);\n    font-size: 13px;\n    font-weight: 800;\n    text-align: center;\n    cursor: pointer;\n    transition: 0.25s ease;\n  }\n\n  .cx-priority__tabs label:hover {\n    color: var(--cx-white);\n    background: rgba(255, 255, 255, 0.07);\n  }\n\n  #cx-priority-scale:checked ~ .cx-priority__tabs label[for=\"cx-priority-scale\"],\n  #cx-priority-quality:checked ~ .cx-priority__tabs label[for=\"cx-priority-quality\"],\n  #cx-priority-tech:checked ~ .cx-priority__tabs label[for=\"cx-priority-tech\"],\n  #cx-priority-risk:checked ~ .cx-priority__tabs label[for=\"cx-priority-risk\"] {\n    border-color: rgba(255, 255, 255, 0.17);\n    background: var(--cx-white);\n    color: var(--cx-blue);\n    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);\n  }\n\n  .cx-priority__panels {\n    min-height: 290px;\n    padding: 34px;\n  }\n\n  .cx-priority__panel {\n    display: none;\n    grid-template-columns: 0.72fr 1.28fr;\n    gap: 38px;\n    align-items: start;\n    animation: cxReveal 0.35s ease both;\n  }\n\n  #cx-priority-scale:checked ~ .cx-priority__panels .cx-priority__panel--scale,\n  #cx-priority-quality:checked ~ .cx-priority__panels .cx-priority__panel--quality,\n  #cx-priority-tech:checked ~ .cx-priority__panels .cx-priority__panel--tech,\n  #cx-priority-risk:checked ~ .cx-priority__panels .cx-priority__panel--risk {\n    display: grid;\n  }\n\n  .cx-priority__panel h3 {\n    margin-bottom: 12px;\n    color: var(--cx-white);\n    font-size: 30px;\n  }\n\n  .cx-priority__panel p {\n    margin-bottom: 0;\n    color: rgba(255, 255, 255, 0.66);\n  }\n\n  .cx-priority__questions {\n    display: grid;\n    gap: 10px;\n  }\n\n  .cx-priority__question {\n    display: flex;\n    align-items: flex-start;\n    gap: 13px;\n    padding: 14px 16px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    border-radius: 14px;\n    background: rgba(255, 255, 255, 0.055);\n    color: rgba(255, 255, 255, 0.88);\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  .cx-priority__question::before {\n    content: \"?\";\n    flex: 0 0 25px;\n    display: grid;\n    place-items: center;\n    width: 25px;\n    height: 25px;\n    border-radius: 50%;\n    background: var(--cx-bright);\n    color: var(--cx-deep);\n    font-size: 12px;\n    font-weight: 900;\n  }\n\n  /* Question gates */\n  .cx-gates {\n    display: grid;\n    gap: 14px;\n    margin-top: 44px;\n  }\n\n  .cx-gate {\n    overflow: hidden;\n    border: 1px solid var(--cx-line);\n    border-radius: 20px;\n    background: var(--cx-white);\n    box-shadow: 0 10px 34px rgba(1, 83, 118, 0.05);\n    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;\n  }\n\n  .cx-gate:hover,\n  .cx-gate[open] {\n    border-color: rgba(41, 184, 230, 0.58);\n    box-shadow: 0 22px 54px rgba(1, 83, 118, 0.11);\n    transform: translateY(-2px);\n  }\n\n  .cx-gate summary {\n    display: grid;\n    grid-template-columns: 58px 1fr auto;\n    gap: 18px;\n    align-items: center;\n    padding: 22px 24px;\n    list-style: none;\n    cursor: pointer;\n  }\n\n  .cx-gate summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .cx-gate__number {\n    display: grid;\n    place-items: center;\n    width: 52px;\n    height: 52px;\n    border-radius: 15px;\n    background: var(--cx-ice);\n    color: var(--cx-blue);\n    font-size: 15px;\n    font-weight: 900;\n    transition: 0.25s ease;\n  }\n\n  .cx-gate[open] .cx-gate__number {\n    background: var(--cx-blue);\n    color: var(--cx-white);\n  }\n\n  .cx-gate__heading strong {\n    display: block;\n    margin-bottom: 3px;\n    color: var(--cx-navy);\n    font-size: 18px;\n    line-height: 1.3;\n  }\n\n  .cx-gate__heading small {\n    color: var(--cx-muted);\n    font-size: 12px;\n    font-weight: 600;\n  }\n\n  .cx-gate__plus {\n    display: grid;\n    place-items: center;\n    width: 38px;\n    height: 38px;\n    border: 1px solid var(--cx-line);\n    border-radius: 50%;\n    color: var(--cx-blue);\n    font-size: 22px;\n    font-weight: 400;\n    transition: 0.25s ease;\n  }\n\n  .cx-gate[open] .cx-gate__plus {\n    border-color: var(--cx-bright);\n    background: var(--cx-bright);\n    color: var(--cx-deep);\n    transform: rotate(45deg);\n  }\n\n  .cx-gate__body {\n    padding: 0 24px 26px 100px;\n  }\n\n  .cx-gate__body > p {\n    color: var(--cx-muted);\n  }\n\n  .cx-gate__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n    margin-top: 18px;\n  }\n\n  .cx-proof,\n  .cx-warning {\n    padding: 18px;\n    border-radius: 15px;\n  }\n\n  .cx-proof {\n    background: var(--cx-green-bg);\n  }\n\n  .cx-warning {\n    background: var(--cx-red-bg);\n  }\n\n  .cx-proof strong,\n  .cx-warning strong {\n    display: block;\n    margin-bottom: 6px;\n    font-size: 11px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  .cx-proof strong { color: var(--cx-green); }\n  .cx-warning strong { color: var(--cx-red); }\n\n  .cx-proof span,\n  .cx-warning span {\n    color: var(--cx-ink);\n    font-size: 13px;\n    font-weight: 600;\n    line-height: 1.6;\n  }\n\n  /* Ask vs prove */\n  .cx-proof-matrix {\n    display: grid;\n    grid-template-columns: 0.84fr 1.16fr;\n    gap: 54px;\n    align-items: center;\n    margin-top: 42px;\n  }\n\n  .cx-proof-matrix__statement {\n    padding: 34px;\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    border-radius: 26px;\n    background: rgba(255, 255, 255, 0.055);\n  }\n\n  .cx-proof-matrix__statement span {\n    display: block;\n    margin-bottom: 22px;\n    color: var(--cx-sky);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .cx-proof-matrix__statement blockquote {\n    margin: 0;\n    color: var(--cx-white);\n    font-size: clamp(25px, 3.3vw, 38px);\n    font-weight: 800;\n    line-height: 1.3;\n    letter-spacing: -0.035em;\n  }\n\n  .cx-proof-matrix__rows {\n    display: grid;\n    gap: 10px;\n  }\n\n  .cx-proof-row {\n    display: grid;\n    grid-template-columns: 1fr 40px 1fr;\n    gap: 12px;\n    align-items: center;\n    padding: 14px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    border-radius: 15px;\n    background: rgba(255, 255, 255, 0.045);\n  }\n\n  .cx-proof-row__claim,\n  .cx-proof-row__evidence {\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.45;\n  }\n\n  .cx-proof-row__claim {\n    color: rgba(255, 255, 255, 0.56);\n  }\n\n  .cx-proof-row__evidence {\n    color: var(--cx-white);\n  }\n\n  .cx-proof-row__arrow {\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: var(--cx-bright);\n    color: var(--cx-deep);\n    font-weight: 900;\n  }\n\n  /* Green and red flags */\n  .cx-flags {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 22px;\n    margin-top: 42px;\n  }\n\n  .cx-flag-column {\n    overflow: hidden;\n    border: 1px solid var(--cx-line);\n    border-radius: 24px;\n    background: var(--cx-white);\n    box-shadow: 0 18px 54px rgba(1, 83, 118, 0.08);\n  }\n\n  .cx-flag-column__head {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 22px 24px;\n    color: var(--cx-white);\n  }\n\n  .cx-flag-column--green .cx-flag-column__head {\n    background: var(--cx-green);\n  }\n\n  .cx-flag-column--red .cx-flag-column__head {\n    background: var(--cx-red);\n  }\n\n  .cx-flag-column__head span {\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    border: 1px solid rgba(255, 255, 255, 0.33);\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.13);\n    font-size: 16px;\n    font-weight: 900;\n  }\n\n  .cx-flag-column__head h3 {\n    margin: 0;\n    color: var(--cx-white);\n    font-size: 22px;\n  }\n\n  .cx-flag-column ul {\n    margin: 0;\n    padding: 12px 24px 22px;\n    list-style: none;\n  }\n\n  .cx-flag-column li {\n    position: relative;\n    padding: 15px 0 15px 30px;\n    border-bottom: 1px solid var(--cx-line);\n    color: var(--cx-muted);\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  .cx-flag-column li:last-child {\n    border-bottom: 0;\n  }\n\n  .cx-flag-column li::before {\n    position: absolute;\n    top: 16px;\n    left: 0;\n    display: grid;\n    place-items: center;\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    font-size: 10px;\n    font-weight: 900;\n  }\n\n  .cx-flag-column--green li::before {\n    content: \"✓\";\n    background: var(--cx-green-bg);\n    color: var(--cx-green);\n  }\n\n  .cx-flag-column--red li::before {\n    content: \"!\";\n    background: var(--cx-red-bg);\n    color: var(--cx-red);\n  }\n\n  /* Partnership roadmap */\n  .cx-roadmap {\n    position: relative;\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    margin-top: 46px;\n  }\n\n  .cx-roadmap::before {\n    content: \"\";\n    position: absolute;\n    top: 38px;\n    right: 8%;\n    left: 8%;\n    height: 2px;\n    background: linear-gradient(90deg, var(--cx-line), var(--cx-bright), var(--cx-line));\n  }\n\n  .cx-roadmap__step {\n    position: relative;\n    z-index: 1;\n    padding: 0 8px;\n    text-align: center;\n  }\n\n  .cx-roadmap__number {\n    display: grid;\n    place-items: center;\n    width: 76px;\n    height: 76px;\n    margin: 0 auto 18px;\n    border: 8px solid var(--cx-white);\n    border-radius: 50%;\n    background: var(--cx-blue);\n    color: var(--cx-white);\n    font-size: 16px;\n    font-weight: 900;\n    box-shadow: 0 10px 28px rgba(1, 83, 118, 0.2);\n    transition: 0.25s ease;\n  }\n\n  .cx-roadmap__step:hover .cx-roadmap__number {\n    background: var(--cx-bright);\n    color: var(--cx-deep);\n    transform: translateY(-5px);\n  }\n\n  .cx-roadmap__step h3 {\n    margin-bottom: 8px;\n    font-size: 19px;\n  }\n\n  .cx-roadmap__step p {\n    margin-bottom: 0;\n    color: var(--cx-muted);\n    font-size: 13px;\n    line-height: 1.65;\n  }\n\n  /* Interactive readiness list */\n  .cx-readiness {\n    display: grid;\n    grid-template-columns: 0.75fr 1.25fr;\n    gap: 54px;\n    align-items: start;\n    margin-top: 42px;\n  }\n\n  .cx-readiness__intro {\n    padding: 28px;\n    border: 1px solid var(--cx-line);\n    border-radius: 22px;\n    background: var(--cx-white);\n    box-shadow: var(--cx-shadow);\n  }\n\n  .cx-readiness__intro span {\n    display: inline-grid;\n    place-items: center;\n    width: 50px;\n    height: 50px;\n    margin-bottom: 18px;\n    border-radius: 15px;\n    background: var(--cx-blue);\n    color: var(--cx-white);\n    font-size: 22px;\n    font-weight: 900;\n  }\n\n  .cx-readiness__intro h3 {\n    margin-bottom: 12px;\n    font-size: 27px;\n  }\n\n  .cx-readiness__intro p {\n    margin-bottom: 0;\n    color: var(--cx-muted);\n  }\n\n  .cx-checklist {\n    display: grid;\n    gap: 11px;\n  }\n\n  .cx-checklist input {\n    position: absolute;\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  .cx-checklist label {\n    position: relative;\n    display: grid;\n    grid-template-columns: 38px 1fr;\n    gap: 15px;\n    align-items: center;\n    padding: 17px 19px;\n    border: 1px solid var(--cx-line);\n    border-radius: 16px;\n    background: var(--cx-white);\n    color: var(--cx-ink);\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    transition: 0.25s ease;\n  }\n\n  .cx-checklist label::before {\n    content: \"\";\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    border: 2px solid var(--cx-line);\n    border-radius: 10px;\n    color: var(--cx-white);\n    transition: 0.2s ease;\n  }\n\n  .cx-checklist label:hover {\n    border-color: var(--cx-bright);\n    transform: translateX(4px);\n  }\n\n  .cx-checklist input:focus-visible + label {\n    outline: 3px solid rgba(41, 184, 230, 0.25);\n    outline-offset: 2px;\n  }\n\n  .cx-checklist input:checked + label {\n    border-color: rgba(28, 156, 118, 0.35);\n    background: var(--cx-green-bg);\n    color: #16694f;\n    text-decoration: line-through;\n  }\n\n  .cx-checklist input:checked + label::before {\n    content: \"✓\";\n    border-color: var(--cx-green);\n    background: var(--cx-green);\n  }\n\n  /* Closing */\n  .cx-closing {\n    padding: 78px 0;\n    background:\n      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n      linear-gradient(135deg, #001f33 0%, #06405b 68%, #015376 100%);\n    background-size: 38px 38px, 38px 38px, auto;\n  }\n\n  .cx-closing__card {\n    position: relative;\n    overflow: hidden;\n    padding: 52px;\n    border: 1px solid rgba(255, 255, 255, 0.14);\n    border-radius: 30px;\n    background: rgba(255, 255, 255, 0.07);\n    color: var(--cx-white);\n    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.22);\n  }\n\n  .cx-closing__card::after {\n    content: \"?\";\n    position: absolute;\n    right: -10px;\n    bottom: -120px;\n    color: rgba(169, 228, 245, 0.09);\n    font-size: 350px;\n    font-weight: 900;\n    line-height: 1;\n  }\n\n  .cx-closing__content {\n    position: relative;\n    z-index: 1;\n    max-width: 790px;\n  }\n\n  .cx-closing h2 {\n    margin-bottom: 18px;\n    color: var(--cx-white);\n    font-size: clamp(36px, 5vw, 58px);\n  }\n\n  .cx-closing p {\n    max-width: 690px;\n    margin-bottom: 28px;\n    color: rgba(255, 255, 255, 0.72);\n    font-size: 18px;\n  }\n\n  .cx-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n\n  .cx-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    min-height: 52px;\n    padding: 13px 21px;\n    border: 1px solid rgba(255, 255, 255, 0.2);\n    border-radius: 99px;\n    color: var(--cx-white) !important;\n    font-size: 13px;\n    font-weight: 800;\n    line-height: 1.25;\n    text-decoration: none !important;\n    transition: 0.25s ease;\n  }\n\n  .cx-button span {\n    transition: transform 0.25s ease;\n  }\n\n  .cx-button:hover {\n    border-color: var(--cx-white);\n    background: rgba(255, 255, 255, 0.1);\n    transform: translateY(-2px);\n  }\n\n  .cx-button:hover span {\n    transform: translateX(4px);\n  }\n\n  .cx-button--primary {\n    border-color: var(--cx-bright);\n    background: var(--cx-bright);\n    color: var(--cx-deep) !important;\n  }\n\n  .cx-button--primary:hover {\n    border-color: var(--cx-sky);\n    background: var(--cx-sky);\n  }\n\n  .cx-footnote {\n    padding: 18px 0 4px;\n    color: #78909d;\n    font-size: 11px;\n    text-align: center;\n  }\n\n  @keyframes cxPulse {\n    0%, 100% { box-shadow: 0 0 0 6px rgba(41, 184, 230, 0.12); }\n    50% { box-shadow: 0 0 0 12px rgba(41, 184, 230, 0.02); }\n  }\n\n  @keyframes cxFloat {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-9px); }\n  }\n\n  @keyframes cxTicker {\n    to { transform: translateX(-50%); }\n  }\n\n  @keyframes cxReveal {\n    from { opacity: 0; transform: translateY(8px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @media (max-width: 920px) {\n    .cx-hero__grid,\n    .cx-thesis,\n    .cx-proof-matrix,\n    .cx-readiness {\n      grid-template-columns: 1fr;\n    }\n\n    .cx-hero__grid {\n      gap: 42px;\n    }\n\n    .cx-compass {\n      width: min(390px, 92%);\n    }\n\n    .cx-thesis__marker {\n      position: relative;\n      top: auto;\n      max-width: 420px;\n    }\n\n    .cx-priority__panel {\n      grid-template-columns: 1fr;\n    }\n\n    .cx-roadmap {\n      grid-template-columns: 1fr 1fr;\n      row-gap: 34px;\n    }\n\n    .cx-roadmap::before {\n      display: none;\n    }\n  }\n\n  @media (max-width: 680px) {\n    .cx-shell {\n      width: min(100% - 24px, 1120px);\n    }\n\n    .cx-section {\n      padding: 66px 0;\n    }\n\n    .cx-hero {\n      min-height: auto;\n      padding-top: 36px;\n    }\n\n    .cx-hero__topline {\n      align-items: flex-start;\n      flex-direction: column;\n      gap: 10px;\n    }\n\n    .cx-hero h2 {\n      font-size: 45px;\n    }\n\n    .cx-compass {\n      width: 310px;\n      max-width: 88vw;\n    }\n\n    .cx-compass__core {\n      width: 98px;\n      height: 98px;\n      font-size: 11px;\n    }\n\n    .cx-compass__node {\n      min-width: 86px;\n      padding: 8px 9px;\n      font-size: 10px;\n    }\n\n    .cx-compass__node--right { right: -5%; }\n    .cx-compass__node--left { left: -5%; }\n\n    .cx-priority__tabs {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    .cx-priority__panels {\n      min-height: 0;\n      padding: 24px 15px 20px;\n    }\n\n    .cx-gate summary {\n      grid-template-columns: 45px 1fr auto;\n      gap: 12px;\n      padding: 18px 15px;\n    }\n\n    .cx-gate__number {\n      width: 44px;\n      height: 44px;\n    }\n\n    .cx-gate__heading small {\n      display: none;\n    }\n\n    .cx-gate__plus {\n      width: 32px;\n      height: 32px;\n    }\n\n    .cx-gate__body {\n      padding: 0 16px 20px;\n    }\n\n    .cx-gate__grid,\n    .cx-flags,\n    .cx-roadmap {\n      grid-template-columns: 1fr;\n    }\n\n    .cx-proof-row {\n      grid-template-columns: 1fr;\n    }\n\n    .cx-proof-row__arrow {\n      transform: rotate(90deg);\n    }\n\n    .cx-closing__card {\n      padding: 34px 24px;\n    }\n\n    .cx-actions {\n      align-items: stretch;\n      flex-direction: column;\n    }\n\n    .cx-button {\n      width: 100%;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .centro-cx-lab *,\n    .centro-cx-lab *::before,\n    .centro-cx-lab *::after {\n      scroll-behavior: auto !important;\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: 0.01ms !important;\n    }\n  }\n</style>\n\n<article class=\"centro-cx-lab\">\n  <header class=\"cx-hero\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-hero__topline\">\n        <span>CX Outsourcing Buyer Guide</span>\n        <span class=\"cx-live\">Decision Lab Active</span>\n      </div>\n\n      <div class=\"cx-hero__grid\">\n        <div>\n          <div class=\"cx-hero__kicker\"><span></span> Ask Better. See Further.</div>\n          <h2>The questions that reveal the <em>right CX partner.</em></h2>\n          <p class=\"cx-hero__copy\">\n            The strongest outsourcing decisions are not built on polished proposals alone. They are built on questions that reveal how a partner will protect your brand, operate under pressure and improve the customer experience over time.\n          </p>\n          <div class=\"cx-hero__chips\" aria-label=\"Key evaluation areas\">\n            <span>Operating Model</span>\n            <span>Talent</span>\n            <span>Technology</span>\n            <span>Governance</span>\n          </div>\n        </div>\n\n        <div class=\"cx-compass\" aria-label=\"CX partner evaluation compass\">\n          <div class=\"cx-compass__axis-x\"></div>\n          <div class=\"cx-compass__axis-y\"></div>\n          <div class=\"cx-compass__core\">The Right CX Partner</div>\n          <div class=\"cx-compass__node cx-compass__node--top\">People<small>Capability</small></div>\n          <div class=\"cx-compass__node cx-compass__node--right\">Technology<small>Enablement</small></div>\n          <div class=\"cx-compass__node cx-compass__node--bottom\">Governance<small>Accountability</small></div>\n          <div class=\"cx-compass__node cx-compass__node--left\">Operations<small>Execution</small></div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"cx-ticker\" aria-hidden=\"true\">\n    <div class=\"cx-ticker__track\">\n      <div class=\"cx-ticker__set\">\n        <span>Ask for proof</span><span>Map ownership</span><span>Test scalability</span><span>Validate security</span><span>Define success</span>\n      </div>\n      <div class=\"cx-ticker__set\">\n        <span>Ask for proof</span><span>Map ownership</span><span>Test scalability</span><span>Validate security</span><span>Define success</span>\n      </div>\n    </div>\n  </div>\n\n  <section class=\"cx-section\">\n    <div class=\"cx-shell cx-thesis\">\n      <aside class=\"cx-thesis__marker\">\n        <strong>01</strong>\n        <span>Start with the operating truth, not the sales promise.</span>\n      </aside>\n\n      <div class=\"cx-thesis__copy\">\n        <div class=\"cx-eyebrow\">The real decision</div>\n        <h2>You are not only selecting a vendor. You are choosing who represents your brand.</h2>\n        <p>\n          Outsourcing customer experience changes more than where conversations are handled. It influences how quickly customers receive help, how consistently your brand is represented, how insight moves back into the business and how confidently you can respond when demand changes.\n        </p>\n        <p>\n          Pricing, locations and staffing numbers matter. But they do not tell you what will happen during a sudden volume spike, a complicated escalation, a system disruption or a critical moment in the customer journey. That is why the best evaluation process looks past capability statements and asks how the work will actually operate.\n        </p>\n        <div class=\"cx-highlight\">\n          A strong partner should be able to explain the model, show the evidence and clarify who owns every important outcome.\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-section cx-section--dark\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-eyebrow\">Choose your priority</div>\n      <h2 class=\"cx-title\">What matters most in your outsourcing decision?</h2>\n      <p class=\"cx-lead\">Select a priority to reveal the questions that should move to the top of your conversation.</p>\n\n      <div class=\"cx-priority\">\n        <input type=\"radio\" name=\"cx-priority\" id=\"cx-priority-scale\" checked>\n        <input type=\"radio\" name=\"cx-priority\" id=\"cx-priority-quality\">\n        <input type=\"radio\" name=\"cx-priority\" id=\"cx-priority-tech\">\n        <input type=\"radio\" name=\"cx-priority\" id=\"cx-priority-risk\">\n\n        <div class=\"cx-priority__tabs\" role=\"tablist\" aria-label=\"Buyer priorities\">\n          <label for=\"cx-priority-scale\">Scale</label>\n          <label for=\"cx-priority-quality\">Quality</label>\n          <label for=\"cx-priority-tech\">Technology</label>\n          <label for=\"cx-priority-risk\">Risk</label>\n        </div>\n\n        <div class=\"cx-priority__panels\">\n          <div class=\"cx-priority__panel cx-priority__panel--scale\">\n            <div>\n              <h3>Scale without losing control.</h3>\n              <p>Growth should expand capacity without weakening quality, visibility or customer trust.</p>\n            </div>\n            <div class=\"cx-priority__questions\">\n              <div class=\"cx-priority__question\">How do you forecast demand and convert it into a staffing plan?</div>\n              <div class=\"cx-priority__question\">What is your proven timeline for hiring, training and nesting a new team?</div>\n              <div class=\"cx-priority__question\">How do you protect service levels during peaks, launches and unexpected volume?</div>\n            </div>\n          </div>\n\n          <div class=\"cx-priority__panel cx-priority__panel--quality\">\n            <div>\n              <h3>Protect every customer moment.</h3>\n              <p>Quality should be a daily operating system, not a score reviewed after the customer has already felt the impact.</p>\n            </div>\n            <div class=\"cx-priority__questions\">\n              <div class=\"cx-priority__question\">How are quality standards calibrated between your team and ours?</div>\n              <div class=\"cx-priority__question\">How does quality insight translate into coaching and process improvement?</div>\n              <div class=\"cx-priority__question\">How do you identify recurring customer friction across channels?</div>\n            </div>\n          </div>\n\n          <div class=\"cx-priority__panel cx-priority__panel--tech\">\n            <div>\n              <h3>Connect technology to outcomes.</h3>\n              <p>The platform should make service faster, clearer and more useful for customers, agents and decision-makers.</p>\n            </div>\n            <div class=\"cx-priority__questions\">\n              <div class=\"cx-priority__question\">How will your operation connect with our existing CX and data stack?</div>\n              <div class=\"cx-priority__question\">Where can automation improve the journey without creating dead ends?</div>\n              <div class=\"cx-priority__question\">Who owns access, reporting logic, data quality and change control?</div>\n            </div>\n          </div>\n\n          <div class=\"cx-priority__panel cx-priority__panel--risk\">\n            <div>\n              <h3>Plan for pressure before it arrives.</h3>\n              <p>Resilience comes from clear controls, tested continuity and fast accountability when conditions change.</p>\n            </div>\n            <div class=\"cx-priority__questions\">\n              <div class=\"cx-priority__question\">What continuity scenarios are tested, and how often?</div>\n              <div class=\"cx-priority__question\">How are access, customer data and security incidents managed?</div>\n              <div class=\"cx-priority__question\">How do you retain knowledge when people, processes or volumes change?</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-section cx-section--soft\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-eyebrow\">Seven decision gates</div>\n      <h2 class=\"cx-title\">The questions that expose how the partnership will really work.</h2>\n      <p class=\"cx-lead\">Open each gate to see what to ask, what evidence to request and what should make you pause.</p>\n\n      <div class=\"cx-gates\">\n        <details class=\"cx-gate\" open>\n          <summary>\n            <span class=\"cx-gate__number\">01</span>\n            <span class=\"cx-gate__heading\"><strong>What business outcomes will this partnership own?</strong><small>Outcomes, baselines and accountability</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>Ask the provider to connect operational metrics to the customer and business outcomes you care about. Clarify the starting baseline, the target, the reporting cadence and who acts when performance moves off track.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A sample measurement plan showing baselines, leading indicators, outcome metrics and named owners.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>The conversation stays focused on seats, rates and generic service levels without defining business impact.</span></div>\n            </div>\n          </div>\n        </details>\n\n        <details class=\"cx-gate\">\n          <summary>\n            <span class=\"cx-gate__number\">02</span>\n            <span class=\"cx-gate__heading\"><strong>How will you find, prepare and retain the right people?</strong><small>Recruitment, training, coaching and culture</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>Look beyond headcount. Ask how profiles are matched to the work, how brand knowledge is assessed, what nesting looks like and how coaching changes after agents enter production.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A role profile, training journey, nesting criteria and example of how quality feedback becomes coaching.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>Hiring speed is presented as the full talent strategy, with little detail on readiness or retention.</span></div>\n            </div>\n          </div>\n        </details>\n\n        <details class=\"cx-gate\">\n          <summary>\n            <span class=\"cx-gate__number\">03</span>\n            <span class=\"cx-gate__heading\"><strong>What does the day-to-day operating model look like?</strong><small>Forecasting, escalation and service recovery</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>Ask how demand is forecast, schedules are adjusted, knowledge is maintained and escalations move across teams. The response should show how decisions happen during real operating conditions, not only during business reviews.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A governance map with operating roles, escalation paths, decision rights and response times.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>Ownership becomes unclear when a customer issue crosses channels, systems or internal teams.</span></div>\n            </div>\n          </div>\n        </details>\n\n        <details class=\"cx-gate\">\n          <summary>\n            <span class=\"cx-gate__number\">04</span>\n            <span class=\"cx-gate__heading\"><strong>How will technology and data improve the experience?</strong><small>Integration, automation, reporting and insight</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>Technology should support the operating model, not distract from it. Ask how platforms connect, where automation adds value, how agents receive context and how customer insight returns to the wider business.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A high-level architecture, data-access model and example of an insight that led to measurable action.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>AI and automation are presented as broad claims without a use case, owner, control or success measure.</span></div>\n            </div>\n          </div>\n        </details>\n\n        <details class=\"cx-gate\">\n          <summary>\n            <span class=\"cx-gate__number\">05</span>\n            <span class=\"cx-gate__heading\"><strong>How will transition and scale be controlled?</strong><small>Discovery, knowledge transfer, pilot and ramp</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>A transition plan should protect current service while the future operation is built. Ask how knowledge is captured, risks are tracked, readiness is tested and expansion decisions are made.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A transition plan with owners, milestones, dependencies, entry criteria, exit criteria and contingency actions.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>The timeline assumes perfect inputs and contains no pilot, readiness gate or recovery path.</span></div>\n            </div>\n          </div>\n        </details>\n\n        <details class=\"cx-gate\">\n          <summary>\n            <span class=\"cx-gate__number\">06</span>\n            <span class=\"cx-gate__heading\"><strong>How are security, compliance and continuity managed?</strong><small>Controls, response and resilience</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>Requirements will vary by industry and geography, but the provider should clearly explain access controls, training, incident response, data handling, continuity planning and the evidence available for validation.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A control summary, incident process, recovery approach and relevant audit or certification evidence.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>Security is treated as a checklist answer with no operational owner or tested response process.</span></div>\n            </div>\n          </div>\n        </details>\n\n        <details class=\"cx-gate\">\n          <summary>\n            <span class=\"cx-gate__number\">07</span>\n            <span class=\"cx-gate__heading\"><strong>How will the partnership improve after launch?</strong><small>Governance, transparency and continuous improvement</small></span>\n            <span class=\"cx-gate__plus\">+</span>\n          </summary>\n          <div class=\"cx-gate__body\">\n            <p>Performance should not become static after stabilization. Ask how improvement opportunities are identified, prioritized, funded, tested and measured, and how leadership remains connected to the program.</p>\n            <div class=\"cx-gate__grid\">\n              <div class=\"cx-proof\"><strong>Proof to request</strong><span>A sample weekly review, monthly business review and improvement register with owners and outcome tracking.</span></div>\n              <div class=\"cx-warning\"><strong>Red flag</strong><span>Governance is limited to reporting past results rather than deciding what changes next.</span></div>\n            </div>\n          </div>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-section cx-section--dark\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-eyebrow\">The proof test</div>\n      <h2 class=\"cx-title\">Turn every promise into an operating question.</h2>\n\n      <div class=\"cx-proof-matrix\">\n        <div class=\"cx-proof-matrix__statement\">\n          <span>The buyer mindset</span>\n          <blockquote>Do not stop at “Can you do it?” Ask “How does it work, who owns it and what proves it?”</blockquote>\n        </div>\n\n        <div class=\"cx-proof-matrix__rows\">\n          <div class=\"cx-proof-row\">\n            <div class=\"cx-proof-row__claim\">“We deliver high quality.”</div>\n            <div class=\"cx-proof-row__arrow\">→</div>\n            <div class=\"cx-proof-row__evidence\">Show the calibration, coaching and improvement loop.</div>\n          </div>\n          <div class=\"cx-proof-row\">\n            <div class=\"cx-proof-row__claim\">“We can scale quickly.”</div>\n            <div class=\"cx-proof-row__arrow\">→</div>\n            <div class=\"cx-proof-row__evidence\">Show the hiring plan, training capacity and readiness gates.</div>\n          </div>\n          <div class=\"cx-proof-row\">\n            <div class=\"cx-proof-row__claim\">“We use AI.”</div>\n            <div class=\"cx-proof-row__arrow\">→</div>\n            <div class=\"cx-proof-row__evidence\">Show the use case, human control and measured outcome.</div>\n          </div>\n          <div class=\"cx-proof-row\">\n            <div class=\"cx-proof-row__claim\">“We are transparent.”</div>\n            <div class=\"cx-proof-row__arrow\">→</div>\n            <div class=\"cx-proof-row__evidence\">Show the data access, reporting cadence and escalation path.</div>\n          </div>\n          <div class=\"cx-proof-row\">\n            <div class=\"cx-proof-row__claim\">“We are a strategic partner.”</div>\n            <div class=\"cx-proof-row__arrow\">→</div>\n            <div class=\"cx-proof-row__evidence\">Show how insight becomes a decision and a tracked improvement.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-section\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-eyebrow\">Read the signals</div>\n      <h2 class=\"cx-title\">What confidence sounds like, and what should make you pause.</h2>\n      <p class=\"cx-lead\">The clearest difference is often not the answer itself, but the level of ownership, detail and evidence behind it.</p>\n\n      <div class=\"cx-flags\">\n        <div class=\"cx-flag-column cx-flag-column--green\">\n          <div class=\"cx-flag-column__head\"><span>✓</span><h3>Green flags</h3></div>\n          <ul>\n            <li>Specific examples connect operating decisions to customer and business results.</li>\n            <li>Roles, dependencies and escalation paths are explained clearly.</li>\n            <li>Risks and limitations are discussed openly, with practical controls.</li>\n            <li>Data access and performance visibility are built into the model.</li>\n            <li>Improvement has a cadence, an owner and a measurement method.</li>\n          </ul>\n        </div>\n\n        <div class=\"cx-flag-column cx-flag-column--red\">\n          <div class=\"cx-flag-column__head\"><span>!</span><h3>Red flags</h3></div>\n          <ul>\n            <li>Answers rely on broad promises without showing how work is executed.</li>\n            <li>Important decisions depend on one person or an undefined future process.</li>\n            <li>Reporting is available, but access, action and ownership remain unclear.</li>\n            <li>Automation is positioned as a replacement for operating discipline.</li>\n            <li>The proposal is detailed, but the transition and governance plans are not.</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-section cx-section--soft\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-eyebrow\">Partnership architecture</div>\n      <h2 class=\"cx-title\">A strong outsourcing relationship is designed across the full lifecycle.</h2>\n      <p class=\"cx-lead\">The evaluation should show how the partnership moves from intent to execution, then keeps improving.</p>\n\n      <div class=\"cx-roadmap\">\n        <div class=\"cx-roadmap__step\">\n          <div class=\"cx-roadmap__number\">01</div>\n          <h3>Align</h3>\n          <p>Define outcomes, scope, customer journeys, constraints and decision rights.</p>\n        </div>\n        <div class=\"cx-roadmap__step\">\n          <div class=\"cx-roadmap__number\">02</div>\n          <h3>Transition</h3>\n          <p>Transfer knowledge, validate readiness, test controls and protect continuity.</p>\n        </div>\n        <div class=\"cx-roadmap__step\">\n          <div class=\"cx-roadmap__number\">03</div>\n          <h3>Operate</h3>\n          <p>Manage demand, quality, people, technology, risk and daily accountability.</p>\n        </div>\n        <div class=\"cx-roadmap__step\">\n          <div class=\"cx-roadmap__number\">04</div>\n          <h3>Improve</h3>\n          <p>Turn customer insight into prioritized action and measurable progress.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-section\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-eyebrow\">Buyer readiness check</div>\n      <h2 class=\"cx-title\">Before you compare partners, make sure your own brief is ready.</h2>\n      <p class=\"cx-lead\">Click each item as you confirm it. A clearer brief creates a more useful proposal and a more honest comparison.</p>\n\n      <div class=\"cx-readiness\">\n        <div class=\"cx-readiness__intro\">\n          <span>✓</span>\n          <h3>Ready for the conversation?</h3>\n          <p>Your provider should bring operational depth. Your team should bring clarity on the outcomes, context and constraints that shape the decision.</p>\n        </div>\n\n        <div class=\"cx-checklist\">\n          <input type=\"checkbox\" id=\"cx-check-1\">\n          <label for=\"cx-check-1\">We have defined the customer and business outcomes this decision should improve.</label>\n\n          <input type=\"checkbox\" id=\"cx-check-2\">\n          <label for=\"cx-check-2\">We understand current volumes, channels, hours, seasonality and service levels.</label>\n\n          <input type=\"checkbox\" id=\"cx-check-3\">\n          <label for=\"cx-check-3\">We have mapped the systems, integrations, data and security requirements involved.</label>\n\n          <input type=\"checkbox\" id=\"cx-check-4\">\n          <label for=\"cx-check-4\">We have identified the internal owners, dependencies and decisions required for transition.</label>\n\n          <input type=\"checkbox\" id=\"cx-check-5\">\n          <label for=\"cx-check-5\">We have agreed how partners will be evaluated beyond price.</label>\n\n          <input type=\"checkbox\" id=\"cx-check-6\">\n          <label for=\"cx-check-6\">We know what evidence we will request before making the final decision.</label>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cx-closing\">\n    <div class=\"cx-shell\">\n      <div class=\"cx-closing__card\">\n        <div class=\"cx-closing__content\">\n          <div class=\"cx-eyebrow\">The Centro perspective</div>\n          <h2>Better questions create better partnerships.</h2>\n          <p>\n            The right CX outsourcing model should give you more than capacity. It should bring operational control, experienced people, useful technology and a clear path to better performance. Centro helps businesses build contact center operations designed around their customers, goals and next stage of growth.\n          </p>\n          <div class=\"cx-actions\">\n            <a class=\"cx-button cx-button--primary\" href=\"https://centrocdx.com/get-in-touch/\">Talk to Centro <span>→</span></a>\n            <a class=\"cx-button\" href=\"https://centrocdx.com/bpo/\">Contact Center Outsourcing <span>→</span></a>\n            <a class=\"cx-button\" href=\"https://centrocdx.com/digital/\">Digital Transformation <span>→</span></a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"cx-footnote cx-shell\">Designed as a practical conversation guide. Evaluation criteria should be adapted to your business, industry and compliance requirements.</div>\n</article>"
        }
      ]
    }
  ],
