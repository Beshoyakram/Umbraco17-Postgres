    <historyEyebrow>
      <Value Culture="en-US"><![CDATA[Centro's History]]></Value>
    </historyEyebrow>
    <historyItems>
      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000001",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2009"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Hesham Farag founded Centro in Fairfax, Virginia, with a vision to enhance customer experience."
        }
      ]
    },
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000002",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2010"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Centro expanded globally, launching its first major delivery site in the heart of Cairo, Egypt."
        }
      ]
    },
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000003",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2015"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Centro\u2019s reach expanded to a new operational site in the heart of Manila, Philippines."
        }
      ]
    },
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000004",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2016"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "A state-of-the-art facility was launched in Winchester, Virginia, to strengthen operational outreach."
        }
      ]
    },
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000005",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2021"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Centro\u0027s services are diversified to include datasphere, digital experience, and customer experience solutions."
        }
      ]
    },
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000006",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2022"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Centro launched a cutting-edge, dedicated CX center in El-Gouna, Red Sea Governate, Egypt."
        }
      ]
    },
    {
      "contentTypeKey": "a7010001-cccc-4ddd-8eee-000000000002",
      "key": "a7010001-3333-4333-8333-000000000007",
      "values": [
        {
          "alias": "year",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "2023"
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Centro\u0027s footprint expands to Dubai and Riyadh, reinforcing its commitment to global excellence."
        }
      ]
    }
  ],
  "settingsData": [],
