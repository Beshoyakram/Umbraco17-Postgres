    <NodeName Default="The Hidden Risk of Inconsistent Customer Responses Across Channels">
      <Name Culture="en-US">The Hidden Risk of Inconsistent Customer Responses Across Channels</Name>
    </NodeName>
    <SortOrder>15</SortOrder>
    <Published Default="true">
      <Published Culture="en-US">true</Published>
    </Published>
