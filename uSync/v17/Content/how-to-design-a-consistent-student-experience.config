    <NodeName Default="How to Design a Consistent Student Experience">
      <Name Culture="en-US">How to Design a Consistent Student Experience</Name>
    </NodeName>
    <SortOrder>9</SortOrder>
    <Published Default="true">
      <Published Culture="en-US">true</Published>
    </Published>
    <Schedule />
