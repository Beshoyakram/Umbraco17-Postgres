  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "936cf707-c1e6-4044-b45a-752ca6c5ee2d",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<style>\n/*\n  Centro WordPress Custom HTML block\n  Scope: .centro-seat-planner only\n  Consultation bridge URL parameters:\n  source, seats, contacts, coverage, service, need, launch\n*/\n.centro-seat-planner {\n  --csp-navy: #073b53;\n  --csp-steel: #015376;\n  --csp-blue: #4fadea;\n  --csp-cyan: #13a3c7;\n  --csp-pale: #cad8ef;\n  --csp-ice: #eaf7fb;\n  --csp-soft: #f5fafc;\n  --csp-ink: #123748;\n  --csp-muted: #5b7180;\n  --csp-white: #ffffff;\n  width: 100%;\n  max-width: 100%;\n  overflow: hidden;\n  color: var(--csp-ink);\n  font-family: \"Poppins\", Arial, sans-serif;\n  font-size: 16px;\n  line-height: 1.7;\n  background: var(--csp-white);\n}\n\n.centro-seat-planner,\n.centro-seat-planner * {\n  box-sizing: border-box;\n}\n\n.centro-seat-planner button,\n.centro-seat-planner input,\n.centro-seat-planner select,\n.centro-seat-planner a {\n  font: inherit;\n}\n\n.centro-seat-planner button,\n.centro-seat-planner input,\n.centro-seat-planner select {\n  margin: 0;\n}\n\n.centro-seat-planner a {\n  color: inherit;\n}\n\n.centro-seat-planner .csp-progress {\n  position: sticky;\n  top: 0;\n  z-index: 12;\n  height: 4px;\n  background: rgba(202, 216, 239, 0.55);\n}\n\n.centro-seat-planner .csp-progress > span {\n  display: block;\n  width: 0;\n  height: 100%;\n  background: linear-gradient(90deg, var(--csp-steel), var(--csp-blue));\n  transition: width 120ms linear;\n}\n\n.centro-seat-planner .csp-section {\n  width: 100%;\n  max-width: 100%;\n  padding: 62px clamp(20px, 5vw, 54px);\n}\n\n.centro-seat-planner .csp-hero {\n  position: relative;\n  isolation: isolate;\n  min-height: 560px;\n  display: flex;\n  align-items: center;\n  color: var(--csp-white) !important;\n  background:\n    radial-gradient(circle at 87% 17%, rgba(79, 173, 234, 0.30), transparent 25%),\n    radial-gradient(circle at 70% 85%, rgba(19, 163, 199, 0.18), transparent 31%),\n    linear-gradient(135deg, #073b53 0%, #015376 62%, #086a88 100%);\n}\n\n.centro-seat-planner .csp-hero::before,\n.centro-seat-planner .csp-hero::after {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 999px;\n  pointer-events: none;\n}\n\n.centro-seat-planner .csp-hero::before {\n  width: 310px;\n  height: 310px;\n  right: -118px;\n  top: 64px;\n}\n\n.centro-seat-planner .csp-hero::after {\n  width: 150px;\n  height: 150px;\n  right: 70px;\n  bottom: -64px;\n}\n\n/* SEO-supporting visual: uses the existing Centro blog artwork while keeping the hero readable. */\n.centro-seat-planner .csp-hero-visual {\n  position: absolute;\n  right: clamp(-110px, -6vw, -36px);\n  bottom: -18px;\n  z-index: -1;\n  width: min(48%, 600px);\n  max-height: 86%;\n  object-fit: cover;\n  object-position: center;\n  border-radius: 26px 0 0 0;\n  opacity: 0.20;\n  filter: saturate(0.82) contrast(1.04);\n  mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.72) 28%, #000 100%);\n  -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.72) 28%, #000 100%);\n  pointer-events: none;\n}\n\n.centro-seat-planner .csp-hero-inner {\n  width: 100%;\n  max-width: 760px;\n}\n\n.centro-seat-planner .csp-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  margin: 0 0 20px;\n  padding: 8px 13px;\n  border: 1px solid rgba(255, 255, 255, 0.23);\n  border-radius: 999px;\n  color: var(--csp-white) !important;\n  background: rgba(255, 255, 255, 0.09);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.11em;\n  line-height: 1.3;\n  text-transform: uppercase;\n}\n\n.centro-seat-planner .csp-eyebrow::before {\n  content: \"\";\n  width: 8px;\n  height: 8px;\n  flex: 0 0 8px;\n  border-radius: 50%;\n  background: var(--csp-blue);\n  box-shadow: 0 0 0 5px rgba(79, 173, 234, 0.16);\n}\n\n.centro-seat-planner .csp-hero h1 {\n  max-width: 740px;\n  margin: 0;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  font-family: \"Poppins\", Arial, sans-serif !important;\n  font-size: clamp(36px, 6.4vw, 58px);\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1.08;\n}\n\n.centro-seat-planner .csp-hero h1 span {\n  color: #91d8ff !important;\n  -webkit-text-fill-color: #91d8ff !important;\n}\n\n.centro-seat-planner .csp-hero-copy {\n  max-width: 680px;\n  margin: 24px 0 0;\n  color: rgba(255, 255, 255, 0.86) !important;\n  -webkit-text-fill-color: rgba(255, 255, 255, 0.86) !important;\n  font-size: clamp(16px, 2.3vw, 19px);\n  line-height: 1.75;\n}\n\n.centro-seat-planner .csp-hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 30px;\n}\n\n.centro-seat-planner .csp-button {\n  min-height: 48px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  padding: 13px 20px;\n  border: 1px solid transparent;\n  border-radius: 10px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  background: var(--csp-steel);\n  box-shadow: 0 10px 24px rgba(1, 83, 118, 0.18);\n  font-weight: 700;\n  line-height: 1.3;\n  text-align: center;\n  text-decoration: none !important;\n  cursor: pointer;\n  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;\n}\n\n.centro-seat-planner .csp-button:hover,\n.centro-seat-planner .csp-button:focus-visible {\n  color: var(--csp-white) !important;\n  background: #086a88;\n  box-shadow: 0 13px 30px rgba(1, 83, 118, 0.26);\n  transform: translateY(-2px);\n}\n\n.centro-seat-planner .csp-button--light {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  background: var(--csp-white);\n  box-shadow: 0 12px 26px rgba(0, 24, 36, 0.18);\n}\n\n.centro-seat-planner .csp-button--light:hover,\n.centro-seat-planner .csp-button--light:focus-visible {\n  color: var(--csp-steel) !important;\n  background: var(--csp-ice);\n}\n\n.centro-seat-planner .csp-text-link {\n  min-height: 48px;\n  display: inline-flex;\n  align-items: center;\n  padding: 12px 4px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  font-weight: 600;\n  text-decoration: none !important;\n}\n\n.centro-seat-planner .csp-text-link:hover,\n.centro-seat-planner .csp-text-link:focus-visible {\n  text-decoration: underline !important;\n  text-underline-offset: 5px;\n}\n\n.centro-seat-planner .csp-kicker {\n  margin: 0 0 10px;\n  color: var(--csp-cyan) !important;\n  -webkit-text-fill-color: var(--csp-cyan) !important;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  line-height: 1.4;\n  text-transform: uppercase;\n}\n\n.centro-seat-planner .csp-heading {\n  max-width: 680px;\n  margin: 0;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-family: \"Poppins\", Arial, sans-serif !important;\n  font-size: clamp(30px, 4.8vw, 44px);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.15;\n}\n\n.centro-seat-planner .csp-heading span {\n  color: var(--csp-blue) !important;\n  -webkit-text-fill-color: var(--csp-blue) !important;\n}\n\n.centro-seat-planner .csp-lede {\n  max-width: 720px;\n  margin: 17px 0 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 17px;\n}\n\n.centro-seat-planner .csp-intro-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.12fr) minmax(220px, 0.88fr);\n  gap: 24px;\n  align-items: stretch;\n  margin-top: 34px;\n}\n\n.centro-seat-planner .csp-copy-card,\n.centro-seat-planner .csp-definition-card {\n  padding: clamp(24px, 4vw, 34px);\n  border: 1px solid #d9e8ef;\n  border-radius: 18px;\n}\n\n.centro-seat-planner .csp-copy-card {\n  background: var(--csp-white);\n  box-shadow: 0 18px 45px rgba(7, 59, 83, 0.08);\n}\n\n.centro-seat-planner .csp-copy-card p {\n  margin: 0 0 17px;\n  color: var(--csp-ink) !important;\n  -webkit-text-fill-color: var(--csp-ink) !important;\n}\n\n.centro-seat-planner .csp-copy-card p:last-child {\n  margin-bottom: 0;\n}\n\n.centro-seat-planner .csp-inline-link {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-weight: 700;\n  text-decoration: underline !important;\n  text-decoration-thickness: 1px;\n  text-underline-offset: 3px;\n}\n\n.centro-seat-planner .csp-inline-link:hover,\n.centro-seat-planner .csp-inline-link:focus-visible {\n  color: #086a88 !important;\n  -webkit-text-fill-color: #086a88 !important;\n}\n\n.centro-seat-planner .csp-definition-card {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  color: var(--csp-white) !important;\n  background: linear-gradient(150deg, var(--csp-steel), var(--csp-navy));\n}\n\n.centro-seat-planner .csp-definition-card span,\n.centro-seat-planner .csp-definition-card strong,\n.centro-seat-planner .csp-definition-card p {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-definition-card span {\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n\n.centro-seat-planner .csp-definition-card strong {\n  display: block;\n  margin: 12px 0;\n  font-size: clamp(25px, 4vw, 34px);\n  font-weight: 600;\n  line-height: 1.2;\n}\n\n.centro-seat-planner .csp-definition-card p {\n  margin: 0;\n  opacity: 0.8;\n  font-size: 14px;\n}\n\n.centro-seat-planner .csp-factors {\n  background: var(--csp-soft);\n}\n\n.centro-seat-planner .csp-factor-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 32px;\n}\n\n.centro-seat-planner .csp-factor {\n  position: relative;\n  min-height: 185px;\n  padding: 25px;\n  overflow: hidden;\n  border: 1px solid #dceaf0;\n  border-radius: 16px;\n  background: var(--csp-white);\n  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;\n}\n\n.centro-seat-planner .csp-factor:hover {\n  border-color: var(--csp-pale);\n  box-shadow: 0 15px 34px rgba(7, 59, 83, 0.09);\n  transform: translateY(-3px);\n}\n\n.centro-seat-planner .csp-factor-num {\n  position: absolute;\n  top: 12px;\n  right: 18px;\n  color: rgba(79, 173, 234, 0.16) !important;\n  -webkit-text-fill-color: rgba(79, 173, 234, 0.16) !important;\n  font-size: 56px;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.centro-seat-planner .csp-factor h3 {\n  position: relative;\n  max-width: 82%;\n  margin: 0 0 10px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-family: \"Poppins\", Arial, sans-serif !important;\n  font-size: 19px;\n  font-weight: 700;\n  line-height: 1.3;\n}\n\n.centro-seat-planner .csp-factor p {\n  position: relative;\n  margin: 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 14px;\n}\n\n.centro-seat-planner .csp-calculator-section {\n  background:\n    linear-gradient(rgba(7, 59, 83, 0.97), rgba(1, 83, 118, 0.98)),\n    radial-gradient(circle at 20% 20%, var(--csp-blue), transparent 45%);\n}\n\n.centro-seat-planner .csp-calculator-section .csp-kicker {\n  color: #91d8ff !important;\n  -webkit-text-fill-color: #91d8ff !important;\n}\n\n.centro-seat-planner .csp-calculator-section .csp-heading,\n.centro-seat-planner .csp-calculator-section .csp-heading span,\n.centro-seat-planner .csp-calculator-section .csp-lede {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-calculator-section .csp-lede {\n  opacity: 0.82;\n}\n\n.centro-seat-planner .csp-calculator {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.82fr);\n  gap: 20px;\n  margin-top: 34px;\n  align-items: start;\n}\n\n.centro-seat-planner .csp-controls,\n.centro-seat-planner .csp-result {\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  border-radius: 20px;\n}\n\n.centro-seat-planner .csp-controls {\n  padding: clamp(22px, 4vw, 32px);\n  background: var(--csp-white);\n  box-shadow: 0 24px 54px rgba(0, 31, 46, 0.24);\n}\n\n.centro-seat-planner .csp-control {\n  margin-bottom: 25px;\n}\n\n.centro-seat-planner .csp-control:last-child {\n  margin-bottom: 0;\n}\n\n.centro-seat-planner .csp-label-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 14px;\n  margin-bottom: 11px;\n}\n\n.centro-seat-planner .csp-label-row label,\n.centro-seat-planner .csp-control-label {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\n.centro-seat-planner .csp-live-value {\n  flex: 0 0 auto;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 14px;\n  font-weight: 800;\n}\n\n.centro-seat-planner input[type=\"range\"] {\n  width: 100%;\n  height: 8px;\n  display: block;\n  padding: 0;\n  border: 0;\n  border-radius: 999px;\n  outline: none;\n  background: linear-gradient(90deg, var(--csp-blue) var(--range-progress, 0%), #dce8ed var(--range-progress, 0%));\n  box-shadow: none;\n  accent-color: var(--csp-steel);\n  cursor: pointer;\n  -webkit-appearance: none;\n  appearance: none;\n}\n\n.centro-seat-planner input[type=\"range\"]::-webkit-slider-thumb {\n  width: 21px;\n  height: 21px;\n  border: 3px solid var(--csp-white);\n  border-radius: 50%;\n  background: var(--csp-steel);\n  box-shadow: 0 3px 10px rgba(1, 83, 118, 0.30);\n  cursor: grab;\n  -webkit-appearance: none;\n}\n\n.centro-seat-planner input[type=\"range\"]::-moz-range-thumb {\n  width: 17px;\n  height: 17px;\n  border: 3px solid var(--csp-white);\n  border-radius: 50%;\n  background: var(--csp-steel);\n  box-shadow: 0 3px 10px rgba(1, 83, 118, 0.30);\n  cursor: grab;\n}\n\n.centro-seat-planner .csp-range-scale {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 7px;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 11px;\n}\n\n.centro-seat-planner .csp-fields-row {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.centro-seat-planner .csp-field label {\n  display: block;\n  margin-bottom: 7px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.centro-seat-planner .csp-field select {\n  width: 100%;\n  min-height: 46px;\n  padding: 9px 36px 9px 12px;\n  border: 1px solid #cddfe7;\n  border-radius: 9px;\n  color: var(--csp-ink) !important;\n  -webkit-text-fill-color: var(--csp-ink) !important;\n  background-color: var(--csp-white);\n  box-shadow: none;\n}\n\n.centro-seat-planner .csp-field select:focus,\n.centro-seat-planner input[type=\"range\"]:focus-visible {\n  outline: 3px solid rgba(79, 173, 234, 0.28);\n  outline-offset: 2px;\n}\n\n.centro-seat-planner .csp-segments {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n  margin-top: 9px;\n}\n\n.centro-seat-planner .csp-segment {\n  position: relative;\n}\n\n.centro-seat-planner .csp-segment input {\n  position: absolute;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.centro-seat-planner .csp-segment span {\n  min-height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 8px;\n  border: 1px solid #d3e3ea;\n  border-radius: 9px;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  background: var(--csp-white);\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.25;\n  text-align: center;\n  cursor: pointer;\n  transition: border-color 160ms ease, color 160ms ease, background 160ms ease;\n}\n\n.centro-seat-planner .csp-segment input:checked + span {\n  border-color: var(--csp-steel);\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  background: var(--csp-ice);\n  box-shadow: inset 0 0 0 1px var(--csp-steel);\n}\n\n.centro-seat-planner .csp-segment input:focus-visible + span {\n  outline: 3px solid rgba(79, 173, 234, 0.28);\n  outline-offset: 2px;\n}\n\n.centro-seat-planner .csp-result {\n  position: sticky;\n  top: 22px;\n  padding: clamp(24px, 4vw, 34px);\n  color: var(--csp-white) !important;\n  background: rgba(255, 255, 255, 0.10);\n  backdrop-filter: blur(12px);\n  box-shadow: 0 24px 54px rgba(0, 31, 46, 0.18);\n}\n\n.centro-seat-planner .csp-result * {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-result-label {\n  margin: 0;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  opacity: 0.76;\n}\n\n.centro-seat-planner .csp-result-number {\n  margin: 7px 0 2px;\n  font-size: clamp(48px, 8vw, 72px);\n  font-weight: 600;\n  letter-spacing: -0.06em;\n  line-height: 1;\n}\n\n.centro-seat-planner .csp-result-unit {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n  opacity: 0.86;\n}\n\n.centro-seat-planner .csp-seat-bar {\n  margin-top: 26px;\n}\n\n.centro-seat-planner .csp-seat-track {\n  position: relative;\n  height: 13px;\n  overflow: hidden;\n  border: 1px solid rgba(255, 255, 255, 0.20);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.13);\n}\n\n.centro-seat-planner .csp-seat-fill {\n  width: 0;\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #91d8ff, var(--csp-blue));\n  box-shadow: 0 0 18px rgba(145, 216, 255, 0.45);\n  transition: width 450ms cubic-bezier(.2,.75,.25,1);\n}\n\n.centro-seat-planner .csp-seat-scale {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 7px;\n  font-size: 10px;\n  opacity: 0.7;\n}\n\n.centro-seat-planner .csp-result-stats {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 9px;\n  margin-top: 24px;\n}\n\n.centro-seat-planner .csp-result-stat {\n  min-height: 88px;\n  padding: 13px;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.07);\n}\n\n.centro-seat-planner .csp-result-stat span {\n  display: block;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.07em;\n  text-transform: uppercase;\n  opacity: 0.65;\n}\n\n.centro-seat-planner .csp-result-stat strong {\n  display: block;\n  margin-top: 5px;\n  font-size: 15px;\n  font-weight: 700;\n  line-height: 1.35;\n}\n\n.centro-seat-planner .csp-result-note {\n  margin: 18px 0 0;\n  font-size: 11px;\n  line-height: 1.55;\n  opacity: 0.72;\n}\n\n.centro-seat-planner .csp-bridge {\n  background: var(--csp-white);\n}\n\n.centro-seat-planner .csp-bridge-card {\n  display: grid;\n  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);\n  gap: 26px;\n  margin-top: 32px;\n  padding: clamp(24px, 5vw, 42px);\n  border: 1px solid #d7e7ee;\n  border-radius: 20px;\n  background:\n    linear-gradient(145deg, rgba(234, 247, 251, 0.92), rgba(245, 250, 252, 0.96));\n  box-shadow: 0 20px 50px rgba(7, 59, 83, 0.08);\n}\n\n.centro-seat-planner .csp-bridge-fields {\n  display: grid;\n  gap: 14px;\n}\n\n.centro-seat-planner .csp-bridge-fields .csp-field select {\n  background-color: var(--csp-white);\n}\n\n.centro-seat-planner .csp-brief {\n  display: flex;\n  flex-direction: column;\n  min-height: 100%;\n  padding: 24px;\n  border-radius: 15px;\n  color: var(--csp-white) !important;\n  background: linear-gradient(145deg, var(--csp-steel), var(--csp-navy));\n}\n\n.centro-seat-planner .csp-brief * {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-brief-label {\n  margin: 0 0 11px;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  opacity: 0.7;\n}\n\n.centro-seat-planner .csp-brief p {\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.75;\n}\n\n.centro-seat-planner .csp-brief-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: auto;\n  padding-top: 22px;\n}\n\n.centro-seat-planner .csp-brief .csp-button--light {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n}\n\n.centro-seat-planner .csp-copy-button {\n  min-height: 46px;\n  padding: 11px 16px;\n  border: 1px solid rgba(255, 255, 255, 0.34);\n  border-radius: 9px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  background: transparent;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.centro-seat-planner .csp-copy-button:hover,\n.centro-seat-planner .csp-copy-button:focus-visible {\n  background: rgba(255, 255, 255, 0.10);\n}\n\n.centro-seat-planner .csp-method {\n  background: var(--csp-soft);\n}\n\n.centro-seat-planner .csp-method-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n  margin-top: 30px;\n}\n\n.centro-seat-planner .csp-method-card {\n  padding: 22px;\n  border: 1px solid #d9e8ef;\n  border-radius: 14px;\n  background: var(--csp-white);\n}\n\n.centro-seat-planner .csp-method-card span {\n  width: 36px;\n  height: 36px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 10px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  background: var(--csp-ice);\n  font-weight: 800;\n}\n\n.centro-seat-planner .csp-method-card h3 {\n  margin: 15px 0 7px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-family: \"Poppins\", Arial, sans-serif !important;\n  font-size: 17px;\n  font-weight: 700;\n  line-height: 1.35;\n}\n\n.centro-seat-planner .csp-method-card p {\n  margin: 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 13px;\n  line-height: 1.65;\n}\n\n.centro-seat-planner .csp-method-source {\n  margin: 18px 0 0;\n  padding: 14px 16px;\n  border-left: 3px solid var(--csp-blue);\n  border-radius: 0 9px 9px 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  background: rgba(234, 247, 251, 0.72);\n  font-size: 12px;\n  line-height: 1.65;\n}\n\n.centro-seat-planner .csp-method-source a {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-weight: 700;\n  text-decoration: underline !important;\n  text-underline-offset: 3px;\n}\n\n.centro-seat-planner .csp-faq-list {\n  display: grid;\n  gap: 10px;\n  margin-top: 30px;\n}\n\n.centro-seat-planner .csp-faq {\n  border: 1px solid #d8e7ed;\n  border-radius: 12px;\n  background: var(--csp-white);\n}\n\n.centro-seat-planner .csp-faq summary {\n  position: relative;\n  padding: 18px 50px 18px 20px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 15px;\n  font-weight: 700;\n  line-height: 1.4;\n  list-style: none;\n  cursor: pointer;\n}\n\n.centro-seat-planner .csp-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n.centro-seat-planner .csp-faq summary::after {\n  content: \"+\";\n  position: absolute;\n  right: 19px;\n  top: 50%;\n  color: var(--csp-blue) !important;\n  -webkit-text-fill-color: var(--csp-blue) !important;\n  font-size: 24px;\n  font-weight: 400;\n  transform: translateY(-50%);\n}\n\n.centro-seat-planner .csp-faq[open] summary::after {\n  content: \"−\";\n}\n\n.centro-seat-planner .csp-faq p {\n  margin: 0;\n  padding: 0 20px 19px;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 14px;\n}\n\n.centro-seat-planner .csp-final {\n  position: relative;\n  overflow: hidden;\n  color: var(--csp-white) !important;\n  background: linear-gradient(135deg, var(--csp-navy), var(--csp-steel));\n}\n\n.centro-seat-planner .csp-final::after {\n  content: \"\";\n  position: absolute;\n  right: -75px;\n  top: -90px;\n  width: 240px;\n  height: 240px;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 50%;\n}\n\n.centro-seat-planner .csp-final-inner {\n  position: relative;\n  z-index: 1;\n  max-width: 660px;\n}\n\n.centro-seat-planner .csp-final h2,\n.centro-seat-planner .csp-final h2 span,\n.centro-seat-planner .csp-final p {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-final h2 {\n  margin: 0;\n  font-family: \"Poppins\", Arial, sans-serif !important;\n  font-size: clamp(30px, 4.8vw, 44px);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.15;\n}\n\n.centro-seat-planner .csp-final h2 span {\n  color: #91d8ff !important;\n  -webkit-text-fill-color: #91d8ff !important;\n}\n\n.centro-seat-planner .csp-final p {\n  margin: 16px 0 25px;\n  opacity: 0.82;\n}\n\n.centro-seat-planner .csp-toast {\n  position: fixed;\n  left: 50%;\n  bottom: 22px;\n  z-index: 9999;\n  max-width: calc(100vw - 32px);\n  padding: 11px 16px;\n  border-radius: 9px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  background: var(--csp-navy);\n  box-shadow: 0 12px 30px rgba(0, 23, 34, 0.28);\n  font-size: 13px;\n  font-weight: 700;\n  opacity: 0;\n  pointer-events: none;\n  transform: translate(-50%, 14px);\n  transition: opacity 180ms ease, transform 180ms ease;\n}\n\n.centro-seat-planner .csp-toast.is-visible {\n  opacity: 1;\n  transform: translate(-50%, 0);\n}\n\n.centro-seat-planner .csp-reveal {\n  opacity: 0;\n  transform: translateY(18px);\n  transition: opacity 520ms ease, transform 520ms ease;\n}\n\n.centro-seat-planner .csp-reveal.is-visible {\n  opacity: 1;\n  transform: none;\n}\n\n@media (max-width: 760px) {\n  .centro-seat-planner .csp-section {\n    padding: 48px 20px;\n  }\n\n  .centro-seat-planner .csp-hero {\n    min-height: 520px;\n  }\n\n  .centro-seat-planner .csp-hero h1 {\n    font-size: clamp(34px, 10vw, 44px);\n  }\n\n  .centro-seat-planner .csp-hero-visual {\n    right: -160px;\n    width: 78%;\n    opacity: 0.12;\n  }\n\n  .centro-seat-planner .csp-intro-grid,\n  .centro-seat-planner .csp-calculator,\n  .centro-seat-planner .csp-bridge-card {\n    grid-template-columns: 1fr;\n  }\n\n  .centro-seat-planner .csp-result {\n    position: static;\n  }\n\n  .centro-seat-planner .csp-method-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 560px) {\n  .centro-seat-planner .csp-factor-grid,\n  .centro-seat-planner .csp-fields-row {\n    grid-template-columns: 1fr;\n  }\n\n  .centro-seat-planner .csp-segments {\n    grid-template-columns: 1fr;\n  }\n\n  .centro-seat-planner .csp-segment span {\n    min-height: 43px;\n  }\n\n  .centro-seat-planner .csp-hero-actions,\n  .centro-seat-planner .csp-brief-actions {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .centro-seat-planner .csp-button,\n  .centro-seat-planner .csp-copy-button {\n    width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .centro-seat-planner *,\n  .centro-seat-planner *::before,\n  .centro-seat-planner *::after {\n    scroll-behavior: auto !important;\n    transition-duration: 0.01ms !important;\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n\n  .centro-seat-planner .csp-reveal {\n    opacity: 1;\n    transform: none;\n  }\n}\n</style>\n\n<article class=\"centro-seat-planner\" id=\"centro-seat-planner\">\n  <div class=\"csp-progress\" aria-hidden=\"true\"><span></span></div>\n\n  <section class=\"csp-section csp-hero\">\n    <img class=\"csp-hero-visual\" src=\"https://centrocdx.com/wp-content/uploads/2026/09/ChatGPT-Image-Sep-3-2026-01_39_56-PM-1024x512.png\" alt=\"Contact center staffing calculator\" width=\"1024\" height=\"512\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n    <div class=\"csp-hero-inner\">\n      <p class=\"csp-eyebrow\">Contact center staffing calculator</p>\n      <h1>Contact Center Staffing Calculator: <span>How Many Support Agents Do You Need?</span></h1>\n      <p class=\"csp-hero-copy\">Use this contact center staffing calculator to estimate how many customer support agents your business needs based on contact volume, average handling time, coverage requirements, occupancy, shrinkage and demand patterns.</p>\n      <div class=\"csp-hero-actions\">\n        <a class=\"csp-button csp-button--light\" href=\"#seat-calculator\">Calculate your seat range <span aria-hidden=\"true\">↓</span></a>\n        <a class=\"csp-text-link\" href=\"#how-it-works\">See what shapes the estimate</a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-reveal\" id=\"how-it-works\">\n    <p class=\"csp-kicker\">Start with the right definition</p>\n    <h2 class=\"csp-heading\">What is a <span>contact center staffing calculator?</span></h2>\n    <p class=\"csp-lede\">A contact center staffing calculator estimates the number of support agents needed by combining workload, operating coverage, productive availability and service expectations.</p>\n\n    <div class=\"csp-intro-grid\">\n      <div class=\"csp-copy-card\">\n        <p>A simple headcount calculation can miss what happens inside a real support operation. Customer demand does not arrive evenly, and promotions, billing cycles, product launches and seasonal peaks can create sharp volume changes inside the same month.</p>\n        <p>Your staffing plan also needs to account for breaks, coaching, training, leave, quality reviews and other time when an employee is scheduled but not available to handle contacts.</p>\n        <p>That is why a useful early estimate combines workload, availability and service expectations, then treats the result as a planning range to validate rather than a fixed final number.</p>\n      </div>\n      <aside class=\"csp-definition-card\">\n        <span>In this calculator</span>\n        <strong>One seat = one dedicated full-time-equivalent role.</strong>\n        <p>The result estimates staffing capacity, not physical workstations or a final commercial quote.</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-factors csp-reveal\">\n    <p class=\"csp-kicker\">What changes the answer</p>\n    <h2 class=\"csp-heading\">Four variables that can <span>move your seat requirement.</span></h2>\n\n    <div class=\"csp-factor-grid\">\n      <article class=\"csp-factor\">\n        <span class=\"csp-factor-num\" aria-hidden=\"true\">01</span>\n        <h3>Contact workload</h3>\n        <p>Monthly volume multiplied by the average time needed to resolve each interaction creates the base workload.</p>\n      </article>\n      <article class=\"csp-factor\">\n        <span class=\"csp-factor-num\" aria-hidden=\"true\">02</span>\n        <h3>Demand variability</h3>\n        <p>Evenly distributed contacts are easier to staff than bursts caused by campaigns, launches, renewals or peak seasons.</p>\n      </article>\n      <article class=\"csp-factor\">\n        <span class=\"csp-factor-num\" aria-hidden=\"true\">03</span>\n        <h3>Availability</h3>\n        <p>Occupancy and shrinkage reflect the productive time available after normal operational requirements are considered.</p>\n      </article>\n      <article class=\"csp-factor\">\n        <span class=\"csp-factor-num\" aria-hidden=\"true\">04</span>\n        <h3>Service expectation</h3>\n        <p>Faster response targets usually require more capacity than a model designed around standard turnaround times.</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-calculator-section\" id=\"seat-calculator\">\n    <p class=\"csp-kicker\">Interactive staffing tool</p>\n    <h2 class=\"csp-heading\">Contact Center Staffing Calculator: <span>Build Your First Staffing Range.</span></h2>\n    <p class=\"csp-lede\">Adjust the inputs to reflect a typical month. The calculator converts your workload and coverage assumptions into an estimated staffing range instantly.</p>\n\n    <div class=\"csp-calculator\">\n      <form class=\"csp-controls\" aria-label=\"Contact center staffing calculator\" onsubmit=\"return false;\">\n        <div class=\"csp-control\">\n          <div class=\"csp-label-row\">\n            <label for=\"csp-contacts\">Monthly customer interactions</label>\n            <output class=\"csp-live-value\" id=\"csp-contacts-value\" for=\"csp-contacts\">25,000</output>\n          </div>\n          <input id=\"csp-contacts\" type=\"range\" min=\"1000\" max=\"250000\" step=\"1000\" value=\"25000\" aria-describedby=\"csp-contacts-scale\">\n          <div class=\"csp-range-scale\" id=\"csp-contacts-scale\"><span>1,000</span><span>250,000</span></div>\n        </div>\n\n        <div class=\"csp-control\">\n          <div class=\"csp-label-row\">\n            <label for=\"csp-aht\">Average handling time</label>\n            <output class=\"csp-live-value\" id=\"csp-aht-value\" for=\"csp-aht\">8 minutes</output>\n          </div>\n          <input id=\"csp-aht\" type=\"range\" min=\"3\" max=\"20\" step=\"1\" value=\"8\" aria-describedby=\"csp-aht-scale\">\n          <div class=\"csp-range-scale\" id=\"csp-aht-scale\"><span>3 min</span><span>20 min</span></div>\n        </div>\n\n        <div class=\"csp-control csp-fields-row\">\n          <div class=\"csp-field\">\n            <label for=\"csp-hours\">Coverage hours per day</label>\n            <select id=\"csp-hours\">\n              <option value=\"8\">8 hours</option>\n              <option value=\"12\">12 hours</option>\n              <option value=\"16\" selected>16 hours</option>\n              <option value=\"24\">24 hours</option>\n            </select>\n          </div>\n          <div class=\"csp-field\">\n            <label for=\"csp-days\">Coverage days per week</label>\n            <select id=\"csp-days\">\n              <option value=\"5\">5 days</option>\n              <option value=\"6\">6 days</option>\n              <option value=\"7\" selected>7 days</option>\n            </select>\n          </div>\n        </div>\n\n        <fieldset class=\"csp-control\" style=\"padding:0;border:0;min-width:0;\">\n          <legend class=\"csp-control-label\">Demand pattern</legend>\n          <div class=\"csp-segments\">\n            <label class=\"csp-segment\"><input type=\"radio\" name=\"csp-demand\" value=\"steady\"><span>Mostly steady</span></label>\n            <label class=\"csp-segment\"><input type=\"radio\" name=\"csp-demand\" value=\"variable\" checked><span>Some peaks</span></label>\n            <label class=\"csp-segment\"><input type=\"radio\" name=\"csp-demand\" value=\"high\"><span>Sharp peaks</span></label>\n          </div>\n        </fieldset>\n\n        <fieldset class=\"csp-control\" style=\"padding:0;border:0;min-width:0;\">\n          <legend class=\"csp-control-label\">Response expectation</legend>\n          <div class=\"csp-segments\">\n            <label class=\"csp-segment\"><input type=\"radio\" name=\"csp-service\" value=\"standard\" checked><span>Standard</span></label>\n            <label class=\"csp-segment\"><input type=\"radio\" name=\"csp-service\" value=\"responsive\"><span>Responsive</span></label>\n            <label class=\"csp-segment\"><input type=\"radio\" name=\"csp-service\" value=\"priority\"><span>Priority</span></label>\n          </div>\n        </fieldset>\n\n        <div class=\"csp-control csp-fields-row\">\n          <div class=\"csp-field\">\n            <label for=\"csp-occupancy\">Target occupancy</label>\n            <select id=\"csp-occupancy\">\n              <option value=\"0.75\">75%</option>\n              <option value=\"0.80\">80%</option>\n              <option value=\"0.85\" selected>85%</option>\n              <option value=\"0.90\">90%</option>\n            </select>\n          </div>\n          <div class=\"csp-field\">\n            <label for=\"csp-shrinkage\">Planned shrinkage</label>\n            <select id=\"csp-shrinkage\">\n              <option value=\"0.20\">20%</option>\n              <option value=\"0.25\">25%</option>\n              <option value=\"0.30\" selected>30%</option>\n              <option value=\"0.35\">35%</option>\n            </select>\n          </div>\n        </div>\n      </form>\n\n      <aside class=\"csp-result\" aria-live=\"polite\" aria-atomic=\"true\">\n        <p class=\"csp-result-label\">Estimated dedicated capacity</p>\n        <p class=\"csp-result-number\"><span id=\"csp-seat-low\">37</span>–<span id=\"csp-seat-high\">42</span></p>\n        <p class=\"csp-result-unit\">full-time-equivalent seats</p>\n\n        <div class=\"csp-seat-bar\" aria-hidden=\"true\">\n          <div class=\"csp-seat-track\"><div class=\"csp-seat-fill\" id=\"csp-seat-fill\"></div></div>\n          <div class=\"csp-seat-scale\"><span>1</span><span id=\"csp-scale-quarter\">13</span><span id=\"csp-scale-half\">25</span><span id=\"csp-scale-max\">50</span></div>\n        </div>\n\n        <div class=\"csp-result-stats\">\n          <div class=\"csp-result-stat\"><span>Monthly workload</span><strong id=\"csp-workload\">3,333 hours</strong></div>\n          <div class=\"csp-result-stat\"><span>Coverage model</span><strong id=\"csp-coverage\">16h × 7 days</strong></div>\n          <div class=\"csp-result-stat\"><span>Estimate driver</span><strong id=\"csp-driver\">Workload capacity</strong></div>\n          <div class=\"csp-result-stat\"><span>Planning band</span><strong id=\"csp-band\">Scaled program</strong></div>\n        </div>\n\n        <p class=\"csp-result-note\">Directional estimate only. A final staffing plan should use interval-level demand, channel mix, concurrency, service-level targets, schedule design and historical arrival patterns.</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-reveal\" id=\"how-many-agents\">\n    <p class=\"csp-kicker\">From estimate to staffing decision</p>\n    <h2 class=\"csp-heading\">How many customer support agents <span>do you need?</span></h2>\n    <p class=\"csp-lede\">The answer depends on more than monthly volume. Workload, coverage hours, occupancy, shrinkage, response targets and demand peaks all affect the number of full-time-equivalent roles required.</p>\n\n    <div class=\"csp-intro-grid\">\n      <div class=\"csp-copy-card\">\n        <p>Start by converting monthly interactions and average handling time into total workload hours. Then adjust for the share of scheduled time agents can realistically spend handling customer contacts.</p>\n        <p>Coverage requirements and demand variability can increase the staffing range further, especially when your operation needs extended hours, seven-day support or faster response targets.</p>\n        <p>Use the result as a planning baseline. For a production-ready model, validate it against interval-level demand, channel mix, concurrency, schedules and historical arrival patterns. If you are considering an outsourced model, review Centro’s <a class=\"csp-inline-link\" href=\"https://centrocdx.com/bpo/\">contact center outsourcing services</a> to see how staffing capacity connects to delivery.</p>\n      </div>\n      <aside class=\"csp-definition-card\">\n        <span>Planning principle</span>\n        <strong>Staff for the workload and service target, not just the monthly average.</strong>\n        <p>Peak periods and non-productive scheduled time can materially change the number of agents required.</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-bridge csp-reveal\" id=\"consultation-bridge\">\n    <p class=\"csp-kicker\">From calculator to consultation</p>\n    <h2 class=\"csp-heading\">Turn the range into a <span>workable delivery plan.</span></h2>\n    <p class=\"csp-lede\">Add two practical details and the calculator will create a concise planning brief for your conversation with Centro.</p>\n\n    <div class=\"csp-bridge-card\">\n      <div class=\"csp-bridge-fields\">\n        <div class=\"csp-field\">\n          <label for=\"csp-need\">Primary support need</label>\n          <select id=\"csp-need\">\n            <option value=\"Customer service\">Customer service</option>\n            <option value=\"Technical support\">Technical support</option>\n            <option value=\"Sales and lead response\">Sales and lead response</option>\n            <option value=\"Back-office support\">Back-office support</option>\n            <option value=\"Overflow or peak coverage\">Overflow or peak coverage</option>\n            <option value=\"Multilingual support\">Multilingual support</option>\n          </select>\n        </div>\n        <div class=\"csp-field\">\n          <label for=\"csp-launch\">Preferred launch window</label>\n          <select id=\"csp-launch\">\n            <option value=\"Exploring options\">Exploring options</option>\n            <option value=\"Within 3 months\">Within 3 months</option>\n            <option value=\"Within 1–2 months\">Within 1–2 months</option>\n            <option value=\"As soon as possible\">As soon as possible</option>\n          </select>\n        </div>\n      </div>\n\n      <div class=\"csp-brief\">\n        <p class=\"csp-brief-label\">Your consultation brief</p>\n        <p id=\"csp-brief-text\">We are planning for approximately 37–42 dedicated seats for customer service, based on 25,000 monthly interactions, an 8-minute average handling time and 16-hour coverage across 7 days. We are currently exploring options.</p>\n        <div class=\"csp-brief-actions\">\n          <a class=\"csp-button csp-button--light\" id=\"csp-consult-link\" href=\"https://centrocdx.com/get-in-touch/\">Discuss this plan</a>\n          <button class=\"csp-copy-button\" id=\"csp-copy-brief\" type=\"button\">Copy brief</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-method csp-reveal\">\n    <p class=\"csp-kicker\">How the estimate works</p>\n    <h2 class=\"csp-heading\">How to calculate <span>contact center staffing requirements.</span></h2>\n\n    <div class=\"csp-method-grid\">\n      <article class=\"csp-method-card\">\n        <span>1</span>\n        <h3>Calculate base workload</h3>\n        <p>Monthly interactions are multiplied by average handling time to estimate total handling hours.</p>\n      </article>\n      <article class=\"csp-method-card\">\n        <span>2</span>\n        <h3>Adjust available capacity</h3>\n        <p>Occupancy and shrinkage reduce the productive hours available from each full-time-equivalent role.</p>\n      </article>\n      <article class=\"csp-method-card\">\n        <span>3</span>\n        <h3>Add planning protection</h3>\n        <p>Demand variability, response expectations and the selected coverage model shape the final range.</p>\n      </article>\n    </div>\n\n    <p class=\"csp-method-source\">For additional workforce-planning context, see NiCE&#8217;s <a href=\"https://www.nice.com/glossary/workforce-capacity-planning\" target=\"_blank\" rel=\"noopener noreferrer\">workforce capacity planning guidance</a>, which also highlights contact volume, average handle time and shrinkage as core staffing inputs.</p>\n\n    <div class=\"csp-faq-list\">\n      <details class=\"csp-faq\">\n        <summary>How many customer support agents do I need?</summary>\n        <p>The number of agents you need depends on contact volume, average handling time, operating coverage, occupancy, shrinkage, service expectations and demand variability. Use the calculator above for an initial staffing range, then validate it with interval-level demand and scheduling data.</p>\n      </details>\n      <details class=\"csp-faq\">\n        <summary>How do you calculate contact center staffing requirements?</summary>\n        <p>Begin with total workload by multiplying interaction volume by average handling time. Then adjust the productive capacity of each full-time-equivalent role for occupancy and shrinkage, and add protection for coverage requirements, demand peaks and response targets.</p>\n      </details>\n      <details class=\"csp-faq\">\n        <summary>Why does the calculator show a range instead of one number?</summary>\n        <p>An exact staffing requirement depends on interval-level demand, schedules and service targets. A range is more honest at the early planning stage and gives your operations team room to validate the assumptions.</p>\n      </details>\n      <details class=\"csp-faq\">\n        <summary>What should be included in average handling time?</summary>\n        <p>Use the average active work required per interaction, including talk or response time and the related after-contact work. For a blended channel model, use a workload-weighted average.</p>\n      </details>\n      <details class=\"csp-faq\">\n        <summary>What do occupancy and shrinkage mean?</summary>\n        <p>Occupancy is the share of available handling time spent actively working on contacts. Shrinkage represents scheduled time unavailable for contact handling, such as coaching, training, leave, meetings and breaks.</p>\n      </details>\n      <details class=\"csp-faq\">\n        <summary>Is this a pricing quote?</summary>\n        <p>No. The result is a capacity estimate. A commercial proposal needs the service scope, channel mix, operating location, language requirements, technology, schedule and quality requirements.</p>\n      </details>\n    </div>\n  </section>\n\n  <section class=\"csp-section csp-final\">\n    <div class=\"csp-final-inner\">\n      <h2>Capacity is only the start. <span>Execution makes it work.</span></h2>\n      <p>Centro can help validate the workload, refine the staffing model and design a scalable contact center operation around your service goals, from workforce planning through day-to-day <a href=\"https://centrocdx.com/bpo/\" style=\"color:#ffffff !important;-webkit-text-fill-color:#ffffff !important;text-decoration:underline !important;text-underline-offset:4px;font-weight:700;\">contact center outsourcing</a>.</p>\n      <a class=\"csp-button csp-button--light\" href=\"#consultation-bridge\">Build your consultation brief <span aria-hidden=\"true\">↑</span></a>\n    </div>\n  </section>\n\n  <div class=\"csp-toast\" id=\"csp-toast\" role=\"status\" aria-live=\"polite\">Planning brief copied.</div>\n</article>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var root = document.getElementById(\"centro-seat-planner\");\n  if (!root || root.dataset.initialized === \"true\") return;\n  root.dataset.initialized = \"true\";\n\n  function byId(id) { return root.querySelector(\"#\" + id); }\n  function checkedValue(name) {\n    var item = root.querySelector('input[name=\"' + name + '\"]:checked');\n    return item ? item.value : \"\";\n  }\n  function formatNumber(value) {\n    return Math.round(value).toLocaleString(\"en-US\");\n  }\n  function titleCase(value) {\n    return value.charAt(0).toUpperCase() + value.slice(1);\n  }\n\n  var inputs = root.querySelectorAll(\"input, select\");\n  var contacts = byId(\"csp-contacts\");\n  var aht = byId(\"csp-aht\");\n  var hours = byId(\"csp-hours\");\n  var days = byId(\"csp-days\");\n  var occupancy = byId(\"csp-occupancy\");\n  var shrinkage = byId(\"csp-shrinkage\");\n  var need = byId(\"csp-need\");\n  var launch = byId(\"csp-launch\");\n  var currentBrief = \"\";\n  var toastTimer;\n\n  var demandFactors = { steady: 1, variable: 1.12, high: 1.25 };\n  var serviceFactors = { standard: 1, responsive: 1.10, priority: 1.20 };\n\n  function paintRange(input) {\n    var minimum = Number(input.min);\n    var maximum = Number(input.max);\n    var progress = ((Number(input.value) - minimum) / (maximum - minimum)) * 100;\n    input.style.setProperty(\"--range-progress\", progress + \"%\");\n  }\n\n  function getBand(seats) {\n    if (seats <= 10) return \"Focused team\";\n    if (seats <= 30) return \"Growth team\";\n    if (seats <= 75) return \"Scaled program\";\n    return \"Enterprise program\";\n  }\n\n  function getScale(maxSeats) {\n    var options = [10, 25, 50, 100, 250, 500, 1000, 2000];\n    var chosen = options[options.length - 1];\n    for (var i = 0; i < options.length; i += 1) {\n      if (maxSeats <= options[i]) {\n        chosen = options[i];\n        break;\n      }\n    }\n    return chosen;\n  }\n\n  function update() {\n    var monthlyContacts = Number(contacts.value);\n    var handleMinutes = Number(aht.value);\n    var hoursPerDay = Number(hours.value);\n    var daysPerWeek = Number(days.value);\n    var occupancyRate = Number(occupancy.value);\n    var shrinkageRate = Number(shrinkage.value);\n    var demand = checkedValue(\"csp-demand\") || \"variable\";\n    var service = checkedValue(\"csp-service\") || \"standard\";\n\n    var monthlyScheduledHours = 173.2;\n    var workloadHours = monthlyContacts * handleMinutes / 60;\n    var productiveHoursPerFte = monthlyScheduledHours * occupancyRate * (1 - shrinkageRate);\n    var workloadSeats = workloadHours / productiveHoursPerFte;\n    workloadSeats = workloadSeats * demandFactors[demand] * serviceFactors[service];\n\n    var coverageHoursPerMonth = hoursPerDay * daysPerWeek * 4.33;\n    var coverageFloor = coverageHoursPerMonth / (monthlyScheduledHours * (1 - shrinkageRate));\n    var baseSeats = Math.max(workloadSeats, coverageFloor);\n    var lowSeats = Math.max(1, Math.ceil(baseSeats));\n    var highSeats = Math.max(lowSeats + 1, Math.ceil(baseSeats * 1.15));\n    var scaleMax = getScale(highSeats);\n    var barWidth = Math.max(4, Math.min(100, (highSeats / scaleMax) * 100));\n    var driver = workloadSeats >= coverageFloor ? \"Workload capacity\" : \"Coverage continuity\";\n\n    byId(\"csp-contacts-value\").textContent = formatNumber(monthlyContacts);\n    byId(\"csp-aht-value\").textContent = handleMinutes + (handleMinutes === 1 ? \" minute\" : \" minutes\");\n    byId(\"csp-seat-low\").textContent = formatNumber(lowSeats);\n    byId(\"csp-seat-high\").textContent = formatNumber(highSeats);\n    byId(\"csp-seat-fill\").style.width = barWidth + \"%\";\n    byId(\"csp-scale-quarter\").textContent = formatNumber(Math.round(scaleMax / 4));\n    byId(\"csp-scale-half\").textContent = formatNumber(Math.round(scaleMax / 2));\n    byId(\"csp-scale-max\").textContent = formatNumber(scaleMax) + (highSeats > 1000 ? \"+\" : \"\");\n    byId(\"csp-workload\").textContent = formatNumber(workloadHours) + \" hours\";\n    byId(\"csp-coverage\").textContent = hoursPerDay + \"h × \" + daysPerWeek + \" days\";\n    byId(\"csp-driver\").textContent = driver;\n    byId(\"csp-band\").textContent = getBand(highSeats);\n\n    var launchSentence = launch.value === \"Exploring options\"\n      ? \"We are currently exploring options.\"\n      : \"Our preferred launch window is \" + launch.value.toLowerCase() + \".\";\n\n    currentBrief = \"We are planning for approximately \" + formatNumber(lowSeats) + \"–\" + formatNumber(highSeats) +\n      \" dedicated seats for \" + need.value.toLowerCase() + \", based on \" + formatNumber(monthlyContacts) +\n      \" monthly interactions, a \" + handleMinutes + \"-minute average handling time and \" + hoursPerDay +\n      \"-hour coverage across \" + daysPerWeek + \" days. \" + launchSentence;\n    byId(\"csp-brief-text\").textContent = currentBrief;\n\n    var params = new URLSearchParams({\n      source: \"seat-planner\",\n      seats: lowSeats + \"-\" + highSeats,\n      contacts: monthlyContacts,\n      coverage: hoursPerDay + \"h-\" + daysPerWeek + \"d\",\n      service: titleCase(service),\n      need: need.value,\n      launch: launch.value\n    });\n    byId(\"csp-consult-link\").href = \"https://centrocdx.com/get-in-touch/?\" + params.toString();\n\n    paintRange(contacts);\n    paintRange(aht);\n  }\n\n  function showToast(message) {\n    var toast = byId(\"csp-toast\");\n    toast.textContent = message;\n    toast.classList.add(\"is-visible\");\n    window.clearTimeout(toastTimer);\n    toastTimer = window.setTimeout(function () {\n      toast.classList.remove(\"is-visible\");\n    }, 2200);\n  }\n\n  function copyBrief() {\n    function fallbackCopy() {\n      var field = document.createElement(\"textarea\");\n      field.value = currentBrief;\n      field.setAttribute(\"readonly\", \"\");\n      field.style.position = \"fixed\";\n      field.style.opacity = \"0\";\n      document.body.appendChild(field);\n      field.select();\n      var copied = document.execCommand(\"copy\");\n      document.body.removeChild(field);\n      showToast(copied ? \"Planning brief copied.\" : \"Select and copy the brief above.\");\n    }\n\n    if (navigator.clipboard && window.isSecureContext) {\n      navigator.clipboard.writeText(currentBrief).then(function () {\n        showToast(\"Planning brief copied.\");\n      }).catch(fallbackCopy);\n    } else {\n      fallbackCopy();\n    }\n  }\n\n  for (var i = 0; i < inputs.length; i += 1) {\n    inputs[i].addEventListener(\"input\", update);\n    inputs[i].addEventListener(\"change\", update);\n  }\n  byId(\"csp-copy-brief\").addEventListener(\"click\", copyBrief);\n\n  var internalLinks = root.querySelectorAll('a[href^=\"#\"]');\n  for (var j = 0; j < internalLinks.length; j += 1) {\n    internalLinks[j].addEventListener(\"click\", function (event) {\n      var target = root.querySelector(this.getAttribute(\"href\"));\n      if (!target) return;\n      event.preventDefault();\n      target.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n    });\n  }\n\n  var progressBar = root.querySelector(\".csp-progress > span\");\n  function updateProgress() {\n    var rect = root.getBoundingClientRect();\n    var viewport = window.innerHeight || document.documentElement.clientHeight;\n    var total = Math.max(1, root.offsetHeight - viewport);\n    var travelled = Math.min(total, Math.max(0, -rect.top));\n    progressBar.style.width = (travelled / total * 100) + \"%\";\n  }\n  window.addEventListener(\"scroll\", updateProgress, { passive: true });\n\n  var revealItems = root.querySelectorAll(\".csp-reveal\");\n  if (\"IntersectionObserver\" in window) {\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add(\"is-visible\");\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.08 });\n    revealItems.forEach(function (item) { observer.observe(item); });\n  } else {\n    revealItems.forEach(function (item) { item.classList.add(\"is-visible\"); });\n  }\n\n  update();\n  updateProgress();\n}());\n</script>"
        }
      ]
    }
  ],
  "settingsData": [],
