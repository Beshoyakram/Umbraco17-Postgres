      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "\u003Cstyle\u003E\n/*\n  Centro WordPress Custom HTML block\n  Scope: .centro-seat-planner only\n  Consultation bridge URL parameters:\n  source, seats, contacts, coverage, service, need, launch\n*/\n.centro-seat-planner {\n  --csp-navy: #073b53;\n  --csp-steel: #015376;\n  --csp-blue: #4fadea;\n  --csp-cyan: #13a3c7;\n  --csp-pale: #cad8ef;\n  --csp-ice: #eaf7fb;\n  --csp-soft: #f5fafc;\n  --csp-ink: #123748;\n  --csp-muted: #5b7180;\n  --csp-white: #ffffff;\n  width: 100%;\n  max-width: 100%;\n  overflow: hidden;\n  color: var(--csp-ink);\n  font-family: \u0022Poppins\u0022, Arial, sans-serif;\n  font-size: 16px;\n  line-height: 1.7;\n  background: var(--csp-white);\n}\n\n.centro-seat-planner,\n.centro-seat-planner * {\n  box-sizing: border-box;\n}\n\n.centro-seat-planner button,\n.centro-seat-planner input,\n.centro-seat-planner select,\n.centro-seat-planner a {\n  font: inherit;\n}\n\n.centro-seat-planner button,\n.centro-seat-planner input,\n.centro-seat-planner select {\n  margin: 0;\n}\n\n.centro-seat-planner a {\n  color: inherit;\n}\n\n.centro-seat-planner .csp-progress {\n  position: sticky;\n  top: 0;\n  z-index: 12;\n  height: 4px;\n  background: rgba(202, 216, 239, 0.55);\n}\n\n.centro-seat-planner .csp-progress \u003E span {\n  display: block;\n  width: 0;\n  height: 100%;\n  background: linear-gradient(90deg, var(--csp-steel), var(--csp-blue));\n  transition: width 120ms linear;\n}\n\n.centro-seat-planner .csp-section {\n  width: 100%;\n  max-width: 100%;\n  padding: 62px clamp(20px, 5vw, 54px);\n}\n\n.centro-seat-planner .csp-hero {\n  position: relative;\n  isolation: isolate;\n  min-height: 560px;\n  display: flex;\n  align-items: center;\n  color: var(--csp-white) !important;\n  background:\n    radial-gradient(circle at 87% 17%, rgba(79, 173, 234, 0.30), transparent 25%),\n    radial-gradient(circle at 70% 85%, rgba(19, 163, 199, 0.18), transparent 31%),\n    linear-gradient(135deg, #073b53 0%, #015376 62%, #086a88 100%);\n}\n\n.centro-seat-planner .csp-hero::before,\n.centro-seat-planner .csp-hero::after {\n  content: \u0022\u0022;\n  position: absolute;\n  z-index: -1;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 999px;\n  pointer-events: none;\n}\n\n.centro-seat-planner .csp-hero::before {\n  width: 310px;\n  height: 310px;\n  right: -118px;\n  top: 64px;\n}\n\n.centro-seat-planner .csp-hero::after {\n  width: 150px;\n  height: 150px;\n  right: 70px;\n  bottom: -64px;\n}\n\n/* SEO-supporting visual: uses the existing Centro blog artwork while keeping the hero readable. */\n.centro-seat-planner .csp-hero-visual {\n  position: absolute;\n  right: clamp(-110px, -6vw, -36px);\n  bottom: -18px;\n  z-index: -1;\n  width: min(48%, 600px);\n  max-height: 86%;\n  object-fit: cover;\n  object-position: center;\n  border-radius: 26px 0 0 0;\n  opacity: 0.20;\n  filter: saturate(0.82) contrast(1.04);\n  mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.72) 28%, #000 100%);\n  -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.72) 28%, #000 100%);\n  pointer-events: none;\n}\n\n.centro-seat-planner .csp-hero-inner {\n  width: 100%;\n  max-width: 760px;\n}\n\n.centro-seat-planner .csp-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  margin: 0 0 20px;\n  padding: 8px 13px;\n  border: 1px solid rgba(255, 255, 255, 0.23);\n  border-radius: 999px;\n  color: var(--csp-white) !important;\n  background: rgba(255, 255, 255, 0.09);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.11em;\n  line-height: 1.3;\n  text-transform: uppercase;\n}\n\n.centro-seat-planner .csp-eyebrow::before {\n  content: \u0022\u0022;\n  width: 8px;\n  height: 8px;\n  flex: 0 0 8px;\n  border-radius: 50%;\n  background: var(--csp-blue);\n  box-shadow: 0 0 0 5px rgba(79, 173, 234, 0.16);\n}\n\n.centro-seat-planner .csp-hero h1 {\n  max-width: 740px;\n  margin: 0;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  font-family: \u0022Poppins\u0022, Arial, sans-serif !important;\n  font-size: clamp(36px, 6.4vw, 58px);\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1.08;\n}\n\n.centro-seat-planner .csp-hero h1 span {\n  color: #91d8ff !important;\n  -webkit-text-fill-color: #91d8ff !important;\n}\n\n.centro-seat-planner .csp-hero-copy {\n  max-width: 680px;\n  margin: 24px 0 0;\n  color: rgba(255, 255, 255, 0.86) !important;\n  -webkit-text-fill-color: rgba(255, 255, 255, 0.86) !important;\n  font-size: clamp(16px, 2.3vw, 19px);\n  line-height: 1.75;\n}\n\n.centro-seat-planner .csp-hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 30px;\n}\n\n.centro-seat-planner .csp-button {\n  min-height: 48px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  padding: 13px 20px;\n  border: 1px solid transparent;\n  border-radius: 10px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  background: var(--csp-steel);\n  box-shadow: 0 10px 24px rgba(1, 83, 118, 0.18);\n  font-weight: 700;\n  line-height: 1.3;\n  text-align: center;\n  text-decoration: none !important;\n  cursor: pointer;\n  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;\n}\n\n.centro-seat-planner .csp-button:hover,\n.centro-seat-planner .csp-button:focus-visible {\n  color: var(--csp-white) !important;\n  background: #086a88;\n  box-shadow: 0 13px 30px rgba(1, 83, 118, 0.26);\n  transform: translateY(-2px);\n}\n\n.centro-seat-planner .csp-button--light {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  background: var(--csp-white);\n  box-shadow: 0 12px 26px rgba(0, 24, 36, 0.18);\n}\n\n.centro-seat-planner .csp-button--light:hover,\n.centro-seat-planner .csp-button--light:focus-visible {\n  color: var(--csp-steel) !important;\n  background: var(--csp-ice);\n}\n\n.centro-seat-planner .csp-text-link {\n  min-height: 48px;\n  display: inline-flex;\n  align-items: center;\n  padding: 12px 4px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  font-weight: 600;\n  text-decoration: none !important;\n}\n\n.centro-seat-planner .csp-text-link:hover,\n.centro-seat-planner .csp-text-link:focus-visible {\n  text-decoration: underline !important;\n  text-underline-offset: 5px;\n}\n\n.centro-seat-planner .csp-kicker {\n  margin: 0 0 10px;\n  color: var(--csp-cyan) !important;\n  -webkit-text-fill-color: var(--csp-cyan) !important;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  line-height: 1.4;\n  text-transform: uppercase;\n}\n\n.centro-seat-planner .csp-heading {\n  max-width: 680px;\n  margin: 0;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-family: \u0022Poppins\u0022, Arial, sans-serif !important;\n  font-size: clamp(30px, 4.8vw, 44px);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.15;\n}\n\n.centro-seat-planner .csp-heading span {\n  color: var(--csp-blue) !important;\n  -webkit-text-fill-color: var(--csp-blue) !important;\n}\n\n.centro-seat-planner .csp-lede {\n  max-width: 720px;\n  margin: 17px 0 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 17px;\n}\n\n.centro-seat-planner .csp-intro-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.12fr) minmax(220px, 0.88fr);\n  gap: 24px;\n  align-items: stretch;\n  margin-top: 34px;\n}\n\n.centro-seat-planner .csp-copy-card,\n.centro-seat-planner .csp-definition-card {\n  padding: clamp(24px, 4vw, 34px);\n  border: 1px solid #d9e8ef;\n  border-radius: 18px;\n}\n\n.centro-seat-planner .csp-copy-card {\n  background: var(--csp-white);\n  box-shadow: 0 18px 45px rgba(7, 59, 83, 0.08);\n}\n\n.centro-seat-planner .csp-copy-card p {\n  margin: 0 0 17px;\n  color: var(--csp-ink) !important;\n  -webkit-text-fill-color: var(--csp-ink) !important;\n}\n\n.centro-seat-planner .csp-copy-card p:last-child {\n  margin-bottom: 0;\n}\n\n.centro-seat-planner .csp-inline-link {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-weight: 700;\n  text-decoration: underline !important;\n  text-decoration-thickness: 1px;\n  text-underline-offset: 3px;\n}\n\n.centro-seat-planner .csp-inline-link:hover,\n.centro-seat-planner .csp-inline-link:focus-visible {\n  color: #086a88 !important;\n  -webkit-text-fill-color: #086a88 !important;\n}\n\n.centro-seat-planner .csp-definition-card {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  color: var(--csp-white) !important;\n  background: linear-gradient(150deg, var(--csp-steel), var(--csp-navy));\n}\n\n.centro-seat-planner .csp-definition-card span,\n.centro-seat-planner .csp-definition-card strong,\n.centro-seat-planner .csp-definition-card p {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-definition-card span {\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n\n.centro-seat-planner .csp-definition-card strong {\n  display: block;\n  margin: 12px 0;\n  font-size: clamp(25px, 4vw, 34px);\n  font-weight: 600;\n  line-height: 1.2;\n}\n\n.centro-seat-planner .csp-definition-card p {\n  margin: 0;\n  opacity: 0.8;\n  font-size: 14px;\n}\n\n.centro-seat-planner .csp-factors {\n  background: var(--csp-soft);\n}\n\n.centro-seat-planner .csp-factor-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 32px;\n}\n\n.centro-seat-planner .csp-factor {\n  position: relative;\n  min-height: 185px;\n  padding: 25px;\n  overflow: hidden;\n  border: 1px solid #dceaf0;\n  border-radius: 16px;\n  background: var(--csp-white);\n  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;\n}\n\n.centro-seat-planner .csp-factor:hover {\n  border-color: var(--csp-pale);\n  box-shadow: 0 15px 34px rgba(7, 59, 83, 0.09);\n  transform: translateY(-3px);\n}\n\n.centro-seat-planner .csp-factor-num {\n  position: absolute;\n  top: 12px;\n  right: 18px;\n  color: rgba(79, 173, 234, 0.16) !important;\n  -webkit-text-fill-color: rgba(79, 173, 234, 0.16) !important;\n  font-size: 56px;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.centro-seat-planner .csp-factor h3 {\n  position: relative;\n  max-width: 82%;\n  margin: 0 0 10px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-family: \u0022Poppins\u0022, Arial, sans-serif !important;\n  font-size: 19px;\n  font-weight: 700;\n  line-height: 1.3;\n}\n\n.centro-seat-planner .csp-factor p {\n  position: relative;\n  margin: 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 14px;\n}\n\n.centro-seat-planner .csp-calculator-section {\n  background:\n    linear-gradient(rgba(7, 59, 83, 0.97), rgba(1, 83, 118, 0.98)),\n    radial-gradient(circle at 20% 20%, var(--csp-blue), transparent 45%);\n}\n\n.centro-seat-planner .csp-calculator-section .csp-kicker {\n  color: #91d8ff !important;\n  -webkit-text-fill-color: #91d8ff !important;\n}\n\n.centro-seat-planner .csp-calculator-section .csp-heading,\n.centro-seat-planner .csp-calculator-section .csp-heading span,\n.centro-seat-planner .csp-calculator-section .csp-lede {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-calculator-section .csp-lede {\n  opacity: 0.82;\n}\n\n.centro-seat-planner .csp-calculator {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.82fr);\n  gap: 20px;\n  margin-top: 34px;\n  align-items: start;\n}\n\n.centro-seat-planner .csp-controls,\n.centro-seat-planner .csp-result {\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  border-radius: 20px;\n}\n\n.centro-seat-planner .csp-controls {\n  padding: clamp(22px, 4vw, 32px);\n  background: var(--csp-white);\n  box-shadow: 0 24px 54px rgba(0, 31, 46, 0.24);\n}\n\n.centro-seat-planner .csp-control {\n  margin-bottom: 25px;\n}\n\n.centro-seat-planner .csp-control:last-child {\n  margin-bottom: 0;\n}\n\n.centro-seat-planner .csp-label-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 14px;\n  margin-bottom: 11px;\n}\n\n.centro-seat-planner .csp-label-row label,\n.centro-seat-planner .csp-control-label {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\n.centro-seat-planner .csp-live-value {\n  flex: 0 0 auto;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 14px;\n  font-weight: 800;\n}\n\n.centro-seat-planner input[type=\u0022range\u0022] {\n  width: 100%;\n  height: 8px;\n  display: block;\n  padding: 0;\n  border: 0;\n  border-radius: 999px;\n  outline: none;\n  background: linear-gradient(90deg, var(--csp-blue) var(--range-progress, 0%), #dce8ed var(--range-progress, 0%));\n  box-shadow: none;\n  accent-color: var(--csp-steel);\n  cursor: pointer;\n  -webkit-appearance: none;\n  appearance: none;\n}\n\n.centro-seat-planner input[type=\u0022range\u0022]::-webkit-slider-thumb {\n  width: 21px;\n  height: 21px;\n  border: 3px solid var(--csp-white);\n  border-radius: 50%;\n  background: var(--csp-steel);\n  box-shadow: 0 3px 10px rgba(1, 83, 118, 0.30);\n  cursor: grab;\n  -webkit-appearance: none;\n}\n\n.centro-seat-planner input[type=\u0022range\u0022]::-moz-range-thumb {\n  width: 17px;\n  height: 17px;\n  border: 3px solid var(--csp-white);\n  border-radius: 50%;\n  background: var(--csp-steel);\n  box-shadow: 0 3px 10px rgba(1, 83, 118, 0.30);\n  cursor: grab;\n}\n\n.centro-seat-planner .csp-range-scale {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 7px;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 11px;\n}\n\n.centro-seat-planner .csp-fields-row {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.centro-seat-planner .csp-field label {\n  display: block;\n  margin-bottom: 7px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.centro-seat-planner .csp-field select {\n  width: 100%;\n  min-height: 46px;\n  padding: 9px 36px 9px 12px;\n  border: 1px solid #cddfe7;\n  border-radius: 9px;\n  color: var(--csp-ink) !important;\n  -webkit-text-fill-color: var(--csp-ink) !important;\n  background-color: var(--csp-white);\n  box-shadow: none;\n}\n\n.centro-seat-planner .csp-field select:focus,\n.centro-seat-planner input[type=\u0022range\u0022]:focus-visible {\n  outline: 3px solid rgba(79, 173, 234, 0.28);\n  outline-offset: 2px;\n}\n\n.centro-seat-planner .csp-segments {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n  margin-top: 9px;\n}\n\n.centro-seat-planner .csp-segment {\n  position: relative;\n}\n\n.centro-seat-planner .csp-segment input {\n  position: absolute;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.centro-seat-planner .csp-segment span {\n  min-height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 8px;\n  border: 1px solid #d3e3ea;\n  border-radius: 9px;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  background: var(--csp-white);\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.25;\n  text-align: center;\n  cursor: pointer;\n  transition: border-color 160ms ease, color 160ms ease, background 160ms ease;\n}\n\n.centro-seat-planner .csp-segment input:checked \u002B span {\n  border-color: var(--csp-steel);\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  background: var(--csp-ice);\n  box-shadow: inset 0 0 0 1px var(--csp-steel);\n}\n\n.centro-seat-planner .csp-segment input:focus-visible \u002B span {\n  outline: 3px solid rgba(79, 173, 234, 0.28);\n  outline-offset: 2px;\n}\n\n.centro-seat-planner .csp-result {\n  position: sticky;\n  top: 22px;\n  padding: clamp(24px, 4vw, 34px);\n  color: var(--csp-white) !important;\n  background: rgba(255, 255, 255, 0.10);\n  backdrop-filter: blur(12px);\n  box-shadow: 0 24px 54px rgba(0, 31, 46, 0.18);\n}\n\n.centro-seat-planner .csp-result * {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-result-label {\n  margin: 0;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  opacity: 0.76;\n}\n\n.centro-seat-planner .csp-result-number {\n  margin: 7px 0 2px;\n  font-size: clamp(48px, 8vw, 72px);\n  font-weight: 600;\n  letter-spacing: -0.06em;\n  line-height: 1;\n}\n\n.centro-seat-planner .csp-result-unit {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n  opacity: 0.86;\n}\n\n.centro-seat-planner .csp-seat-bar {\n  margin-top: 26px;\n}\n\n.centro-seat-planner .csp-seat-track {\n  position: relative;\n  height: 13px;\n  overflow: hidden;\n  border: 1px solid rgba(255, 255, 255, 0.20);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.13);\n}\n\n.centro-seat-planner .csp-seat-fill {\n  width: 0;\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #91d8ff, var(--csp-blue));\n  box-shadow: 0 0 18px rgba(145, 216, 255, 0.45);\n  transition: width 450ms cubic-bezier(.2,.75,.25,1);\n}\n\n.centro-seat-planner .csp-seat-scale {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 7px;\n  font-size: 10px;\n  opacity: 0.7;\n}\n\n.centro-seat-planner .csp-result-stats {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 9px;\n  margin-top: 24px;\n}\n\n.centro-seat-planner .csp-result-stat {\n  min-height: 88px;\n  padding: 13px;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.07);\n}\n\n.centro-seat-planner .csp-result-stat span {\n  display: block;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.07em;\n  text-transform: uppercase;\n  opacity: 0.65;\n}\n\n.centro-seat-planner .csp-result-stat strong {\n  display: block;\n  margin-top: 5px;\n  font-size: 15px;\n  font-weight: 700;\n  line-height: 1.35;\n}\n\n.centro-seat-planner .csp-result-note {\n  margin: 18px 0 0;\n  font-size: 11px;\n  line-height: 1.55;\n  opacity: 0.72;\n}\n\n.centro-seat-planner .csp-bridge {\n  background: var(--csp-white);\n}\n\n.centro-seat-planner .csp-bridge-card {\n  display: grid;\n  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);\n  gap: 26px;\n  margin-top: 32px;\n  padding: clamp(24px, 5vw, 42px);\n  border: 1px solid #d7e7ee;\n  border-radius: 20px;\n  background:\n    linear-gradient(145deg, rgba(234, 247, 251, 0.92), rgba(245, 250, 252, 0.96));\n  box-shadow: 0 20px 50px rgba(7, 59, 83, 0.08);\n}\n\n.centro-seat-planner .csp-bridge-fields {\n  display: grid;\n  gap: 14px;\n}\n\n.centro-seat-planner .csp-bridge-fields .csp-field select {\n  background-color: var(--csp-white);\n}\n\n.centro-seat-planner .csp-brief {\n  display: flex;\n  flex-direction: column;\n  min-height: 100%;\n  padding: 24px;\n  border-radius: 15px;\n  color: var(--csp-white) !important;\n  background: linear-gradient(145deg, var(--csp-steel), var(--csp-navy));\n}\n\n.centro-seat-planner .csp-brief * {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-brief-label {\n  margin: 0 0 11px;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.10em;\n  text-transform: uppercase;\n  opacity: 0.7;\n}\n\n.centro-seat-planner .csp-brief p {\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.75;\n}\n\n.centro-seat-planner .csp-brief-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: auto;\n  padding-top: 22px;\n}\n\n.centro-seat-planner .csp-brief .csp-button--light {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n}\n\n.centro-seat-planner .csp-copy-button {\n  min-height: 46px;\n  padding: 11px 16px;\n  border: 1px solid rgba(255, 255, 255, 0.34);\n  border-radius: 9px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  background: transparent;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.centro-seat-planner .csp-copy-button:hover,\n.centro-seat-planner .csp-copy-button:focus-visible {\n  background: rgba(255, 255, 255, 0.10);\n}\n\n.centro-seat-planner .csp-method {\n  background: var(--csp-soft);\n}\n\n.centro-seat-planner .csp-method-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n  margin-top: 30px;\n}\n\n.centro-seat-planner .csp-method-card {\n  padding: 22px;\n  border: 1px solid #d9e8ef;\n  border-radius: 14px;\n  background: var(--csp-white);\n}\n\n.centro-seat-planner .csp-method-card span {\n  width: 36px;\n  height: 36px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 10px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  background: var(--csp-ice);\n  font-weight: 800;\n}\n\n.centro-seat-planner .csp-method-card h3 {\n  margin: 15px 0 7px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-family: \u0022Poppins\u0022, Arial, sans-serif !important;\n  font-size: 17px;\n  font-weight: 700;\n  line-height: 1.35;\n}\n\n.centro-seat-planner .csp-method-card p {\n  margin: 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 13px;\n  line-height: 1.65;\n}\n\n.centro-seat-planner .csp-method-source {\n  margin: 18px 0 0;\n  padding: 14px 16px;\n  border-left: 3px solid var(--csp-blue);\n  border-radius: 0 9px 9px 0;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  background: rgba(234, 247, 251, 0.72);\n  font-size: 12px;\n  line-height: 1.65;\n}\n\n.centro-seat-planner .csp-method-source a {\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-weight: 700;\n  text-decoration: underline !important;\n  text-underline-offset: 3px;\n}\n\n.centro-seat-planner .csp-faq-list {\n  display: grid;\n  gap: 10px;\n  margin-top: 30px;\n}\n\n.centro-seat-planner .csp-faq {\n  border: 1px solid #d8e7ed;\n  border-radius: 12px;\n  background: var(--csp-white);\n}\n\n.centro-seat-planner .csp-faq summary {\n  position: relative;\n  padding: 18px 50px 18px 20px;\n  color: var(--csp-steel) !important;\n  -webkit-text-fill-color: var(--csp-steel) !important;\n  font-size: 15px;\n  font-weight: 700;\n  line-height: 1.4;\n  list-style: none;\n  cursor: pointer;\n}\n\n.centro-seat-planner .csp-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n.centro-seat-planner .csp-faq summary::after {\n  content: \u0022\u002B\u0022;\n  position: absolute;\n  right: 19px;\n  top: 50%;\n  color: var(--csp-blue) !important;\n  -webkit-text-fill-color: var(--csp-blue) !important;\n  font-size: 24px;\n  font-weight: 400;\n  transform: translateY(-50%);\n}\n\n.centro-seat-planner .csp-faq[open] summary::after {\n  content: \u0022\u2212\u0022;\n}\n\n.centro-seat-planner .csp-faq p {\n  margin: 0;\n  padding: 0 20px 19px;\n  color: var(--csp-muted) !important;\n  -webkit-text-fill-color: var(--csp-muted) !important;\n  font-size: 14px;\n}\n\n.centro-seat-planner .csp-final {\n  position: relative;\n  overflow: hidden;\n  color: var(--csp-white) !important;\n  background: linear-gradient(135deg, var(--csp-navy), var(--csp-steel));\n}\n\n.centro-seat-planner .csp-final::after {\n  content: \u0022\u0022;\n  position: absolute;\n  right: -75px;\n  top: -90px;\n  width: 240px;\n  height: 240px;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 50%;\n}\n\n.centro-seat-planner .csp-final-inner {\n  position: relative;\n  z-index: 1;\n  max-width: 660px;\n}\n\n.centro-seat-planner .csp-final h2,\n.centro-seat-planner .csp-final h2 span,\n.centro-seat-planner .csp-final p {\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n}\n\n.centro-seat-planner .csp-final h2 {\n  margin: 0;\n  font-family: \u0022Poppins\u0022, Arial, sans-serif !important;\n  font-size: clamp(30px, 4.8vw, 44px);\n  font-weight: 500;\n  letter-spacing: -0.035em;\n  line-height: 1.15;\n}\n\n.centro-seat-planner .csp-final h2 span {\n  color: #91d8ff !important;\n  -webkit-text-fill-color: #91d8ff !important;\n}\n\n.centro-seat-planner .csp-final p {\n  margin: 16px 0 25px;\n  opacity: 0.82;\n}\n\n.centro-seat-planner .csp-toast {\n  position: fixed;\n  left: 50%;\n  bottom: 22px;\n  z-index: 9999;\n  max-width: calc(100vw - 32px);\n  padding: 11px 16px;\n  border-radius: 9px;\n  color: var(--csp-white) !important;\n  -webkit-text-fill-color: var(--csp-white) !important;\n  background: var(--csp-navy);\n  box-shadow: 0 12px 30px rgba(0, 23, 34, 0.28);\n  font-size: 13px;\n  font-weight: 700;\n  opacity: 0;\n  pointer-events: none;\n  transform: translate(-50%, 14px);\n  transition: opacity 180ms ease, transform 180ms ease;\n}\n\n.centro-seat-planner .csp-toast.is-visible {\n  opacity: 1;\n  transform: translate(-50%, 0);\n}\n\n.centro-seat-planner .csp-reveal {\n  opacity: 0;\n  transform: translateY(18px);\n  transition: opacity 520ms ease, transform 520ms ease;\n}\n\n.centro-seat-planner .csp-reveal.is-visible {\n  opacity: 1;\n  transform: none;\n}\n\n@media (max-width: 760px) {\n  .centro-seat-planner .csp-section {\n    padding: 48px 20px;\n  }\n\n  .centro-seat-planner .csp-hero {\n    min-height: 520px;\n  }\n\n  .centro-seat-planner .csp-hero h1 {\n    font-size: clamp(34px, 10vw, 44px);\n  }\n\n  .centro-seat-planner .csp-hero-visual {\n    right: -160px;\n    width: 78%;\n    opacity: 0.12;\n  }\n\n  .centro-seat-planner .csp-intro-grid,\n  .centro-seat-planner .csp-calculator,\n  .centro-seat-planner .csp-bridge-card {\n    grid-template-columns: 1fr;\n  }\n\n  .centro-seat-planner .csp-result {\n    position: static;\n  }\n\n  .centro-seat-planner .csp-method-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 560px) {\n  .centro-seat-planner .csp-factor-grid,\n  .centro-seat-planner .csp-fields-row {\n    grid-template-columns: 1fr;\n  }\n\n  .centro-seat-planner .csp-segments {\n    grid-template-columns: 1fr;\n  }\n\n  .centro-seat-planner .csp-segment span {\n    min-height: 43px;\n  }\n\n  .centro-seat-planner .csp-hero-actions,\n  .centro-seat-planner .csp-brief-actions {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .centro-seat-planner .csp-button,\n  .centro-seat-planner .csp-copy-button {\n    width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .centro-seat-planner *,\n  .centro-seat-planner *::before,\n  .centro-seat-planner *::after {\n    scroll-behavior: auto !important;\n    transition-duration: 0.01ms !important;\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n\n  .centro-seat-planner .csp-reveal {\n    opacity: 1;\n    transform: none;\n  }\n}\n\u003C/style\u003E\n\n\u003Carticle class=\u0022centro-seat-planner\u0022 id=\u0022centro-seat-planner\u0022\u003E\n  \u003Cdiv class=\u0022csp-progress\u0022 aria-hidden=\u0022true\u0022\u003E\u003Cspan\u003E\u003C/span\u003E\u003C/div\u003E\n\n  \u003Csection class=\u0022csp-section csp-hero\u0022\u003E\n    \u003Cimg class=\u0022csp-hero-visual\u0022 src=\u0022https://centrocdx.com/wp-content/uploads/2026/09/ChatGPT-Image-Sep-3-2026-01_39_56-PM-1024x512.png\u0022 alt=\u0022Contact center staffing calculator\u0022 width=\u00221024\u0022 height=\u0022512\u0022 loading=\u0022eager\u0022 fetchpriority=\u0022high\u0022 decoding=\u0022async\u0022\u003E\n    \u003Cdiv class=\u0022csp-hero-inner\u0022\u003E\n      \u003Cp class=\u0022csp-eyebrow\u0022\u003EContact center staffing calculator\u003C/p\u003E\n      \u003Ch1\u003EContact Center Staffing Calculator: \u003Cspan\u003EHow Many Support Agents Do You Need?\u003C/span\u003E\u003C/h1\u003E\n      \u003Cp class=\u0022csp-hero-copy\u0022\u003EUse this contact center staffing calculator to estimate how many customer support agents your business needs based on contact volume, average handling time, coverage requirements, occupancy, shrinkage and demand patterns.\u003C/p\u003E\n      \u003Cdiv class=\u0022csp-hero-actions\u0022\u003E\n        \u003Ca class=\u0022csp-button csp-button--light\u0022 href=\u0022#seat-calculator\u0022\u003ECalculate your seat range \u003Cspan aria-hidden=\u0022true\u0022\u003E\u2193\u003C/span\u003E\u003C/a\u003E\n        \u003Ca class=\u0022csp-text-link\u0022 href=\u0022#how-it-works\u0022\u003ESee what shapes the estimate\u003C/a\u003E\n      \u003C/div\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-reveal\u0022 id=\u0022how-it-works\u0022\u003E\n    \u003Cp class=\u0022csp-kicker\u0022\u003EStart with the right definition\u003C/p\u003E\n    \u003Ch2 class=\u0022csp-heading\u0022\u003EWhat is a \u003Cspan\u003Econtact center staffing calculator?\u003C/span\u003E\u003C/h2\u003E\n    \u003Cp class=\u0022csp-lede\u0022\u003EA contact center staffing calculator estimates the number of support agents needed by combining workload, operating coverage, productive availability and service expectations.\u003C/p\u003E\n\n    \u003Cdiv class=\u0022csp-intro-grid\u0022\u003E\n      \u003Cdiv class=\u0022csp-copy-card\u0022\u003E\n        \u003Cp\u003EA simple headcount calculation can miss what happens inside a real support operation. Customer demand does not arrive evenly, and promotions, billing cycles, product launches and seasonal peaks can create sharp volume changes inside the same month.\u003C/p\u003E\n        \u003Cp\u003EYour staffing plan also needs to account for breaks, coaching, training, leave, quality reviews and other time when an employee is scheduled but not available to handle contacts.\u003C/p\u003E\n        \u003Cp\u003EThat is why a useful early estimate combines workload, availability and service expectations, then treats the result as a planning range to validate rather than a fixed final number.\u003C/p\u003E\n      \u003C/div\u003E\n      \u003Caside class=\u0022csp-definition-card\u0022\u003E\n        \u003Cspan\u003EIn this calculator\u003C/span\u003E\n        \u003Cstrong\u003EOne seat = one dedicated full-time-equivalent role.\u003C/strong\u003E\n        \u003Cp\u003EThe result estimates staffing capacity, not physical workstations or a final commercial quote.\u003C/p\u003E\n      \u003C/aside\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-factors csp-reveal\u0022\u003E\n    \u003Cp class=\u0022csp-kicker\u0022\u003EWhat changes the answer\u003C/p\u003E\n    \u003Ch2 class=\u0022csp-heading\u0022\u003EFour variables that can \u003Cspan\u003Emove your seat requirement.\u003C/span\u003E\u003C/h2\u003E\n\n    \u003Cdiv class=\u0022csp-factor-grid\u0022\u003E\n      \u003Carticle class=\u0022csp-factor\u0022\u003E\n        \u003Cspan class=\u0022csp-factor-num\u0022 aria-hidden=\u0022true\u0022\u003E01\u003C/span\u003E\n        \u003Ch3\u003EContact workload\u003C/h3\u003E\n        \u003Cp\u003EMonthly volume multiplied by the average time needed to resolve each interaction creates the base workload.\u003C/p\u003E\n      \u003C/article\u003E\n      \u003Carticle class=\u0022csp-factor\u0022\u003E\n        \u003Cspan class=\u0022csp-factor-num\u0022 aria-hidden=\u0022true\u0022\u003E02\u003C/span\u003E\n        \u003Ch3\u003EDemand variability\u003C/h3\u003E\n        \u003Cp\u003EEvenly distributed contacts are easier to staff than bursts caused by campaigns, launches, renewals or peak seasons.\u003C/p\u003E\n      \u003C/article\u003E\n      \u003Carticle class=\u0022csp-factor\u0022\u003E\n        \u003Cspan class=\u0022csp-factor-num\u0022 aria-hidden=\u0022true\u0022\u003E03\u003C/span\u003E\n        \u003Ch3\u003EAvailability\u003C/h3\u003E\n        \u003Cp\u003EOccupancy and shrinkage reflect the productive time available after normal operational requirements are considered.\u003C/p\u003E\n      \u003C/article\u003E\n      \u003Carticle class=\u0022csp-factor\u0022\u003E\n        \u003Cspan class=\u0022csp-factor-num\u0022 aria-hidden=\u0022true\u0022\u003E04\u003C/span\u003E\n        \u003Ch3\u003EService expectation\u003C/h3\u003E\n        \u003Cp\u003EFaster response targets usually require more capacity than a model designed around standard turnaround times.\u003C/p\u003E\n      \u003C/article\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-calculator-section\u0022 id=\u0022seat-calculator\u0022\u003E\n    \u003Cp class=\u0022csp-kicker\u0022\u003EInteractive staffing tool\u003C/p\u003E\n    \u003Ch2 class=\u0022csp-heading\u0022\u003EContact Center Staffing Calculator: \u003Cspan\u003EBuild Your First Staffing Range.\u003C/span\u003E\u003C/h2\u003E\n    \u003Cp class=\u0022csp-lede\u0022\u003EAdjust the inputs to reflect a typical month. The calculator converts your workload and coverage assumptions into an estimated staffing range instantly.\u003C/p\u003E\n\n    \u003Cdiv class=\u0022csp-calculator\u0022\u003E\n      \u003Cform class=\u0022csp-controls\u0022 aria-label=\u0022Contact center staffing calculator\u0022 onsubmit=\u0022return false;\u0022\u003E\n        \u003Cdiv class=\u0022csp-control\u0022\u003E\n          \u003Cdiv class=\u0022csp-label-row\u0022\u003E\n            \u003Clabel for=\u0022csp-contacts\u0022\u003EMonthly customer interactions\u003C/label\u003E\n            \u003Coutput class=\u0022csp-live-value\u0022 id=\u0022csp-contacts-value\u0022 for=\u0022csp-contacts\u0022\u003E25,000\u003C/output\u003E\n          \u003C/div\u003E\n          \u003Cinput id=\u0022csp-contacts\u0022 type=\u0022range\u0022 min=\u00221000\u0022 max=\u0022250000\u0022 step=\u00221000\u0022 value=\u002225000\u0022 aria-describedby=\u0022csp-contacts-scale\u0022\u003E\n          \u003Cdiv class=\u0022csp-range-scale\u0022 id=\u0022csp-contacts-scale\u0022\u003E\u003Cspan\u003E1,000\u003C/span\u003E\u003Cspan\u003E250,000\u003C/span\u003E\u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022csp-control\u0022\u003E\n          \u003Cdiv class=\u0022csp-label-row\u0022\u003E\n            \u003Clabel for=\u0022csp-aht\u0022\u003EAverage handling time\u003C/label\u003E\n            \u003Coutput class=\u0022csp-live-value\u0022 id=\u0022csp-aht-value\u0022 for=\u0022csp-aht\u0022\u003E8 minutes\u003C/output\u003E\n          \u003C/div\u003E\n          \u003Cinput id=\u0022csp-aht\u0022 type=\u0022range\u0022 min=\u00223\u0022 max=\u002220\u0022 step=\u00221\u0022 value=\u00228\u0022 aria-describedby=\u0022csp-aht-scale\u0022\u003E\n          \u003Cdiv class=\u0022csp-range-scale\u0022 id=\u0022csp-aht-scale\u0022\u003E\u003Cspan\u003E3 min\u003C/span\u003E\u003Cspan\u003E20 min\u003C/span\u003E\u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022csp-control csp-fields-row\u0022\u003E\n          \u003Cdiv class=\u0022csp-field\u0022\u003E\n            \u003Clabel for=\u0022csp-hours\u0022\u003ECoverage hours per day\u003C/label\u003E\n            \u003Cselect id=\u0022csp-hours\u0022\u003E\n              \u003Coption value=\u00228\u0022\u003E8 hours\u003C/option\u003E\n              \u003Coption value=\u002212\u0022\u003E12 hours\u003C/option\u003E\n              \u003Coption value=\u002216\u0022 selected\u003E16 hours\u003C/option\u003E\n              \u003Coption value=\u002224\u0022\u003E24 hours\u003C/option\u003E\n            \u003C/select\u003E\n          \u003C/div\u003E\n          \u003Cdiv class=\u0022csp-field\u0022\u003E\n            \u003Clabel for=\u0022csp-days\u0022\u003ECoverage days per week\u003C/label\u003E\n            \u003Cselect id=\u0022csp-days\u0022\u003E\n              \u003Coption value=\u00225\u0022\u003E5 days\u003C/option\u003E\n              \u003Coption value=\u00226\u0022\u003E6 days\u003C/option\u003E\n              \u003Coption value=\u00227\u0022 selected\u003E7 days\u003C/option\u003E\n            \u003C/select\u003E\n          \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cfieldset class=\u0022csp-control\u0022 style=\u0022padding:0;border:0;min-width:0;\u0022\u003E\n          \u003Clegend class=\u0022csp-control-label\u0022\u003EDemand pattern\u003C/legend\u003E\n          \u003Cdiv class=\u0022csp-segments\u0022\u003E\n            \u003Clabel class=\u0022csp-segment\u0022\u003E\u003Cinput type=\u0022radio\u0022 name=\u0022csp-demand\u0022 value=\u0022steady\u0022\u003E\u003Cspan\u003EMostly steady\u003C/span\u003E\u003C/label\u003E\n            \u003Clabel class=\u0022csp-segment\u0022\u003E\u003Cinput type=\u0022radio\u0022 name=\u0022csp-demand\u0022 value=\u0022variable\u0022 checked\u003E\u003Cspan\u003ESome peaks\u003C/span\u003E\u003C/label\u003E\n            \u003Clabel class=\u0022csp-segment\u0022\u003E\u003Cinput type=\u0022radio\u0022 name=\u0022csp-demand\u0022 value=\u0022high\u0022\u003E\u003Cspan\u003ESharp peaks\u003C/span\u003E\u003C/label\u003E\n          \u003C/div\u003E\n        \u003C/fieldset\u003E\n\n        \u003Cfieldset class=\u0022csp-control\u0022 style=\u0022padding:0;border:0;min-width:0;\u0022\u003E\n          \u003Clegend class=\u0022csp-control-label\u0022\u003EResponse expectation\u003C/legend\u003E\n          \u003Cdiv class=\u0022csp-segments\u0022\u003E\n            \u003Clabel class=\u0022csp-segment\u0022\u003E\u003Cinput type=\u0022radio\u0022 name=\u0022csp-service\u0022 value=\u0022standard\u0022 checked\u003E\u003Cspan\u003EStandard\u003C/span\u003E\u003C/label\u003E\n            \u003Clabel class=\u0022csp-segment\u0022\u003E\u003Cinput type=\u0022radio\u0022 name=\u0022csp-service\u0022 value=\u0022responsive\u0022\u003E\u003Cspan\u003EResponsive\u003C/span\u003E\u003C/label\u003E\n            \u003Clabel class=\u0022csp-segment\u0022\u003E\u003Cinput type=\u0022radio\u0022 name=\u0022csp-service\u0022 value=\u0022priority\u0022\u003E\u003Cspan\u003EPriority\u003C/span\u003E\u003C/label\u003E\n          \u003C/div\u003E\n        \u003C/fieldset\u003E\n\n        \u003Cdiv class=\u0022csp-control csp-fields-row\u0022\u003E\n          \u003Cdiv class=\u0022csp-field\u0022\u003E\n            \u003Clabel for=\u0022csp-occupancy\u0022\u003ETarget occupancy\u003C/label\u003E\n            \u003Cselect id=\u0022csp-occupancy\u0022\u003E\n              \u003Coption value=\u00220.75\u0022\u003E75%\u003C/option\u003E\n              \u003Coption value=\u00220.80\u0022\u003E80%\u003C/option\u003E\n              \u003Coption value=\u00220.85\u0022 selected\u003E85%\u003C/option\u003E\n              \u003Coption value=\u00220.90\u0022\u003E90%\u003C/option\u003E\n            \u003C/select\u003E\n          \u003C/div\u003E\n          \u003Cdiv class=\u0022csp-field\u0022\u003E\n            \u003Clabel for=\u0022csp-shrinkage\u0022\u003EPlanned shrinkage\u003C/label\u003E\n            \u003Cselect id=\u0022csp-shrinkage\u0022\u003E\n              \u003Coption value=\u00220.20\u0022\u003E20%\u003C/option\u003E\n              \u003Coption value=\u00220.25\u0022\u003E25%\u003C/option\u003E\n              \u003Coption value=\u00220.30\u0022 selected\u003E30%\u003C/option\u003E\n              \u003Coption value=\u00220.35\u0022\u003E35%\u003C/option\u003E\n            \u003C/select\u003E\n          \u003C/div\u003E\n        \u003C/div\u003E\n      \u003C/form\u003E\n\n      \u003Caside class=\u0022csp-result\u0022 aria-live=\u0022polite\u0022 aria-atomic=\u0022true\u0022\u003E\n        \u003Cp class=\u0022csp-result-label\u0022\u003EEstimated dedicated capacity\u003C/p\u003E\n        \u003Cp class=\u0022csp-result-number\u0022\u003E\u003Cspan id=\u0022csp-seat-low\u0022\u003E37\u003C/span\u003E\u2013\u003Cspan id=\u0022csp-seat-high\u0022\u003E42\u003C/span\u003E\u003C/p\u003E\n        \u003Cp class=\u0022csp-result-unit\u0022\u003Efull-time-equivalent seats\u003C/p\u003E\n\n        \u003Cdiv class=\u0022csp-seat-bar\u0022 aria-hidden=\u0022true\u0022\u003E\n          \u003Cdiv class=\u0022csp-seat-track\u0022\u003E\u003Cdiv class=\u0022csp-seat-fill\u0022 id=\u0022csp-seat-fill\u0022\u003E\u003C/div\u003E\u003C/div\u003E\n          \u003Cdiv class=\u0022csp-seat-scale\u0022\u003E\u003Cspan\u003E1\u003C/span\u003E\u003Cspan id=\u0022csp-scale-quarter\u0022\u003E13\u003C/span\u003E\u003Cspan id=\u0022csp-scale-half\u0022\u003E25\u003C/span\u003E\u003Cspan id=\u0022csp-scale-max\u0022\u003E50\u003C/span\u003E\u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022csp-result-stats\u0022\u003E\n          \u003Cdiv class=\u0022csp-result-stat\u0022\u003E\u003Cspan\u003EMonthly workload\u003C/span\u003E\u003Cstrong id=\u0022csp-workload\u0022\u003E3,333 hours\u003C/strong\u003E\u003C/div\u003E\n          \u003Cdiv class=\u0022csp-result-stat\u0022\u003E\u003Cspan\u003ECoverage model\u003C/span\u003E\u003Cstrong id=\u0022csp-coverage\u0022\u003E16h \u00D7 7 days\u003C/strong\u003E\u003C/div\u003E\n          \u003Cdiv class=\u0022csp-result-stat\u0022\u003E\u003Cspan\u003EEstimate driver\u003C/span\u003E\u003Cstrong id=\u0022csp-driver\u0022\u003EWorkload capacity\u003C/strong\u003E\u003C/div\u003E\n          \u003Cdiv class=\u0022csp-result-stat\u0022\u003E\u003Cspan\u003EPlanning band\u003C/span\u003E\u003Cstrong id=\u0022csp-band\u0022\u003EScaled program\u003C/strong\u003E\u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cp class=\u0022csp-result-note\u0022\u003EDirectional estimate only. A final staffing plan should use interval-level demand, channel mix, concurrency, service-level targets, schedule design and historical arrival patterns.\u003C/p\u003E\n      \u003C/aside\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-reveal\u0022 id=\u0022how-many-agents\u0022\u003E\n    \u003Cp class=\u0022csp-kicker\u0022\u003EFrom estimate to staffing decision\u003C/p\u003E\n    \u003Ch2 class=\u0022csp-heading\u0022\u003EHow many customer support agents \u003Cspan\u003Edo you need?\u003C/span\u003E\u003C/h2\u003E\n    \u003Cp class=\u0022csp-lede\u0022\u003EThe answer depends on more than monthly volume. Workload, coverage hours, occupancy, shrinkage, response targets and demand peaks all affect the number of full-time-equivalent roles required.\u003C/p\u003E\n\n    \u003Cdiv class=\u0022csp-intro-grid\u0022\u003E\n      \u003Cdiv class=\u0022csp-copy-card\u0022\u003E\n        \u003Cp\u003EStart by converting monthly interactions and average handling time into total workload hours. Then adjust for the share of scheduled time agents can realistically spend handling customer contacts.\u003C/p\u003E\n        \u003Cp\u003ECoverage requirements and demand variability can increase the staffing range further, especially when your operation needs extended hours, seven-day support or faster response targets.\u003C/p\u003E\n        \u003Cp\u003EUse the result as a planning baseline. For a production-ready model, validate it against interval-level demand, channel mix, concurrency, schedules and historical arrival patterns. If you are considering an outsourced model, review Centro\u2019s \u003Ca class=\u0022csp-inline-link\u0022 href=\u0022https://centrocdx.com/bpo/\u0022\u003Econtact center outsourcing services\u003C/a\u003E to see how staffing capacity connects to delivery.\u003C/p\u003E\n      \u003C/div\u003E\n      \u003Caside class=\u0022csp-definition-card\u0022\u003E\n        \u003Cspan\u003EPlanning principle\u003C/span\u003E\n        \u003Cstrong\u003EStaff for the workload and service target, not just the monthly average.\u003C/strong\u003E\n        \u003Cp\u003EPeak periods and non-productive scheduled time can materially change the number of agents required.\u003C/p\u003E\n      \u003C/aside\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-bridge csp-reveal\u0022 id=\u0022consultation-bridge\u0022\u003E\n    \u003Cp class=\u0022csp-kicker\u0022\u003EFrom calculator to consultation\u003C/p\u003E\n    \u003Ch2 class=\u0022csp-heading\u0022\u003ETurn the range into a \u003Cspan\u003Eworkable delivery plan.\u003C/span\u003E\u003C/h2\u003E\n    \u003Cp class=\u0022csp-lede\u0022\u003EAdd two practical details and the calculator will create a concise planning brief for your conversation with Centro.\u003C/p\u003E\n\n    \u003Cdiv class=\u0022csp-bridge-card\u0022\u003E\n      \u003Cdiv class=\u0022csp-bridge-fields\u0022\u003E\n        \u003Cdiv class=\u0022csp-field\u0022\u003E\n          \u003Clabel for=\u0022csp-need\u0022\u003EPrimary support need\u003C/label\u003E\n          \u003Cselect id=\u0022csp-need\u0022\u003E\n            \u003Coption value=\u0022Customer service\u0022\u003ECustomer service\u003C/option\u003E\n            \u003Coption value=\u0022Technical support\u0022\u003ETechnical support\u003C/option\u003E\n            \u003Coption value=\u0022Sales and lead response\u0022\u003ESales and lead response\u003C/option\u003E\n            \u003Coption value=\u0022Back-office support\u0022\u003EBack-office support\u003C/option\u003E\n            \u003Coption value=\u0022Overflow or peak coverage\u0022\u003EOverflow or peak coverage\u003C/option\u003E\n            \u003Coption value=\u0022Multilingual support\u0022\u003EMultilingual support\u003C/option\u003E\n          \u003C/select\u003E\n        \u003C/div\u003E\n        \u003Cdiv class=\u0022csp-field\u0022\u003E\n          \u003Clabel for=\u0022csp-launch\u0022\u003EPreferred launch window\u003C/label\u003E\n          \u003Cselect id=\u0022csp-launch\u0022\u003E\n            \u003Coption value=\u0022Exploring options\u0022\u003EExploring options\u003C/option\u003E\n            \u003Coption value=\u0022Within 3 months\u0022\u003EWithin 3 months\u003C/option\u003E\n            \u003Coption value=\u0022Within 1\u20132 months\u0022\u003EWithin 1\u20132 months\u003C/option\u003E\n            \u003Coption value=\u0022As soon as possible\u0022\u003EAs soon as possible\u003C/option\u003E\n          \u003C/select\u003E\n        \u003C/div\u003E\n      \u003C/div\u003E\n\n      \u003Cdiv class=\u0022csp-brief\u0022\u003E\n        \u003Cp class=\u0022csp-brief-label\u0022\u003EYour consultation brief\u003C/p\u003E\n        \u003Cp id=\u0022csp-brief-text\u0022\u003EWe are planning for approximately 37\u201342 dedicated seats for customer service, based on 25,000 monthly interactions, an 8-minute average handling time and 16-hour coverage across 7 days. We are currently exploring options.\u003C/p\u003E\n        \u003Cdiv class=\u0022csp-brief-actions\u0022\u003E\n          \u003Ca class=\u0022csp-button csp-button--light\u0022 id=\u0022csp-consult-link\u0022 href=\u0022https://centrocdx.com/get-in-touch/\u0022\u003EDiscuss this plan\u003C/a\u003E\n          \u003Cbutton class=\u0022csp-copy-button\u0022 id=\u0022csp-copy-brief\u0022 type=\u0022button\u0022\u003ECopy brief\u003C/button\u003E\n        \u003C/div\u003E\n      \u003C/div\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-method csp-reveal\u0022\u003E\n    \u003Cp class=\u0022csp-kicker\u0022\u003EHow the estimate works\u003C/p\u003E\n    \u003Ch2 class=\u0022csp-heading\u0022\u003EHow to calculate \u003Cspan\u003Econtact center staffing requirements.\u003C/span\u003E\u003C/h2\u003E\n\n    \u003Cdiv class=\u0022csp-method-grid\u0022\u003E\n      \u003Carticle class=\u0022csp-method-card\u0022\u003E\n        \u003Cspan\u003E1\u003C/span\u003E\n        \u003Ch3\u003ECalculate base workload\u003C/h3\u003E\n        \u003Cp\u003EMonthly interactions are multiplied by average handling time to estimate total handling hours.\u003C/p\u003E\n      \u003C/article\u003E\n      \u003Carticle class=\u0022csp-method-card\u0022\u003E\n        \u003Cspan\u003E2\u003C/span\u003E\n        \u003Ch3\u003EAdjust available capacity\u003C/h3\u003E\n        \u003Cp\u003EOccupancy and shrinkage reduce the productive hours available from each full-time-equivalent role.\u003C/p\u003E\n      \u003C/article\u003E\n      \u003Carticle class=\u0022csp-method-card\u0022\u003E\n        \u003Cspan\u003E3\u003C/span\u003E\n        \u003Ch3\u003EAdd planning protection\u003C/h3\u003E\n        \u003Cp\u003EDemand variability, response expectations and the selected coverage model shape the final range.\u003C/p\u003E\n      \u003C/article\u003E\n    \u003C/div\u003E\n\n    \u003Cp class=\u0022csp-method-source\u0022\u003EFor additional workforce-planning context, see NiCE\u0026#8217;s \u003Ca href=\u0022https://www.nice.com/glossary/workforce-capacity-planning\u0022 target=\u0022_blank\u0022 rel=\u0022noopener noreferrer\u0022\u003Eworkforce capacity planning guidance\u003C/a\u003E, which also highlights contact volume, average handle time and shrinkage as core staffing inputs.\u003C/p\u003E\n\n    \u003Cdiv class=\u0022csp-faq-list\u0022\u003E\n      \u003Cdetails class=\u0022csp-faq\u0022\u003E\n        \u003Csummary\u003EHow many customer support agents do I need?\u003C/summary\u003E\n        \u003Cp\u003EThe number of agents you need depends on contact volume, average handling time, operating coverage, occupancy, shrinkage, service expectations and demand variability. Use the calculator above for an initial staffing range, then validate it with interval-level demand and scheduling data.\u003C/p\u003E\n      \u003C/details\u003E\n      \u003Cdetails class=\u0022csp-faq\u0022\u003E\n        \u003Csummary\u003EHow do you calculate contact center staffing requirements?\u003C/summary\u003E\n        \u003Cp\u003EBegin with total workload by multiplying interaction volume by average handling time. Then adjust the productive capacity of each full-time-equivalent role for occupancy and shrinkage, and add protection for coverage requirements, demand peaks and response targets.\u003C/p\u003E\n      \u003C/details\u003E\n      \u003Cdetails class=\u0022csp-faq\u0022\u003E\n        \u003Csummary\u003EWhy does the calculator show a range instead of one number?\u003C/summary\u003E\n        \u003Cp\u003EAn exact staffing requirement depends on interval-level demand, schedules and service targets. A range is more honest at the early planning stage and gives your operations team room to validate the assumptions.\u003C/p\u003E\n      \u003C/details\u003E\n      \u003Cdetails class=\u0022csp-faq\u0022\u003E\n        \u003Csummary\u003EWhat should be included in average handling time?\u003C/summary\u003E\n        \u003Cp\u003EUse the average active work required per interaction, including talk or response time and the related after-contact work. For a blended channel model, use a workload-weighted average.\u003C/p\u003E\n      \u003C/details\u003E\n      \u003Cdetails class=\u0022csp-faq\u0022\u003E\n        \u003Csummary\u003EWhat do occupancy and shrinkage mean?\u003C/summary\u003E\n        \u003Cp\u003EOccupancy is the share of available handling time spent actively working on contacts. Shrinkage represents scheduled time unavailable for contact handling, such as coaching, training, leave, meetings and breaks.\u003C/p\u003E\n      \u003C/details\u003E\n      \u003Cdetails class=\u0022csp-faq\u0022\u003E\n        \u003Csummary\u003EIs this a pricing quote?\u003C/summary\u003E\n        \u003Cp\u003ENo. The result is a capacity estimate. A commercial proposal needs the service scope, channel mix, operating location, language requirements, technology, schedule and quality requirements.\u003C/p\u003E\n      \u003C/details\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Csection class=\u0022csp-section csp-final\u0022\u003E\n    \u003Cdiv class=\u0022csp-final-inner\u0022\u003E\n      \u003Ch2\u003ECapacity is only the start. \u003Cspan\u003EExecution makes it work.\u003C/span\u003E\u003C/h2\u003E\n      \u003Cp\u003ECentro can help validate the workload, refine the staffing model and design a scalable contact center operation around your service goals, from workforce planning through day-to-day \u003Ca href=\u0022https://centrocdx.com/bpo/\u0022 style=\u0022color:#ffffff !important;-webkit-text-fill-color:#ffffff !important;text-decoration:underline !important;text-underline-offset:4px;font-weight:700;\u0022\u003Econtact center outsourcing\u003C/a\u003E.\u003C/p\u003E\n      \u003Ca class=\u0022csp-button csp-button--light\u0022 href=\u0022#consultation-bridge\u0022\u003EBuild your consultation brief \u003Cspan aria-hidden=\u0022true\u0022\u003E\u2191\u003C/span\u003E\u003C/a\u003E\n    \u003C/div\u003E\n  \u003C/section\u003E\n\n  \u003Cdiv class=\u0022csp-toast\u0022 id=\u0022csp-toast\u0022 role=\u0022status\u0022 aria-live=\u0022polite\u0022\u003EPlanning brief copied.\u003C/div\u003E\n\u003C/article\u003E\n\n\u003Cscript\u003E\n(function () {\n  \u0022use strict\u0022;\n\n  var root = document.getElementById(\u0022centro-seat-planner\u0022);\n  if (!root || root.dataset.initialized === \u0022true\u0022) return;\n  root.dataset.initialized = \u0022true\u0022;\n\n  function byId(id) { return root.querySelector(\u0022#\u0022 \u002B id); }\n  function checkedValue(name) {\n    var item = root.querySelector(\u0027input[name=\u0022\u0027 \u002B name \u002B \u0027\u0022]:checked\u0027);\n    return item ? item.value : \u0022\u0022;\n  }\n  function formatNumber(value) {\n    return Math.round(value).toLocaleString(\u0022en-US\u0022);\n  }\n  function titleCase(value) {\n    return value.charAt(0).toUpperCase() \u002B value.slice(1);\n  }\n\n  var inputs = root.querySelectorAll(\u0022input, select\u0022);\n  var contacts = byId(\u0022csp-contacts\u0022);\n  var aht = byId(\u0022csp-aht\u0022);\n  var hours = byId(\u0022csp-hours\u0022);\n  var days = byId(\u0022csp-days\u0022);\n  var occupancy = byId(\u0022csp-occupancy\u0022);\n  var shrinkage = byId(\u0022csp-shrinkage\u0022);\n  var need = byId(\u0022csp-need\u0022);\n  var launch = byId(\u0022csp-launch\u0022);\n  var currentBrief = \u0022\u0022;\n  var toastTimer;\n\n  var demandFactors = { steady: 1, variable: 1.12, high: 1.25 };\n  var serviceFactors = { standard: 1, responsive: 1.10, priority: 1.20 };\n\n  function paintRange(input) {\n    var minimum = Number(input.min);\n    var maximum = Number(input.max);\n    var progress = ((Number(input.value) - minimum) / (maximum - minimum)) * 100;\n    input.style.setProperty(\u0022--range-progress\u0022, progress \u002B \u0022%\u0022);\n  }\n\n  function getBand(seats) {\n    if (seats \u003C= 10) return \u0022Focused team\u0022;\n    if (seats \u003C= 30) return \u0022Growth team\u0022;\n    if (seats \u003C= 75) return \u0022Scaled program\u0022;\n    return \u0022Enterprise program\u0022;\n  }\n\n  function getScale(maxSeats) {\n    var options = [10, 25, 50, 100, 250, 500, 1000, 2000];\n    var chosen = options[options.length - 1];\n    for (var i = 0; i \u003C options.length; i \u002B= 1) {\n      if (maxSeats \u003C= options[i]) {\n        chosen = options[i];\n        break;\n      }\n    }\n    return chosen;\n  }\n\n  function update() {\n    var monthlyContacts = Number(contacts.value);\n    var handleMinutes = Number(aht.value);\n    var hoursPerDay = Number(hours.value);\n    var daysPerWeek = Number(days.value);\n    var occupancyRate = Number(occupancy.value);\n    var shrinkageRate = Number(shrinkage.value);\n    var demand = checkedValue(\u0022csp-demand\u0022) || \u0022variable\u0022;\n    var service = checkedValue(\u0022csp-service\u0022) || \u0022standard\u0022;\n\n    var monthlyScheduledHours = 173.2;\n    var workloadHours = monthlyContacts * handleMinutes / 60;\n    var productiveHoursPerFte = monthlyScheduledHours * occupancyRate * (1 - shrinkageRate);\n    var workloadSeats = workloadHours / productiveHoursPerFte;\n    workloadSeats = workloadSeats * demandFactors[demand] * serviceFactors[service];\n\n    var coverageHoursPerMonth = hoursPerDay * daysPerWeek * 4.33;\n    var coverageFloor = coverageHoursPerMonth / (monthlyScheduledHours * (1 - shrinkageRate));\n    var baseSeats = Math.max(workloadSeats, coverageFloor);\n    var lowSeats = Math.max(1, Math.ceil(baseSeats));\n    var highSeats = Math.max(lowSeats \u002B 1, Math.ceil(baseSeats * 1.15));\n    var scaleMax = getScale(highSeats);\n    var barWidth = Math.max(4, Math.min(100, (highSeats / scaleMax) * 100));\n    var driver = workloadSeats \u003E= coverageFloor ? \u0022Workload capacity\u0022 : \u0022Coverage continuity\u0022;\n\n    byId(\u0022csp-contacts-value\u0022).textContent = formatNumber(monthlyContacts);\n    byId(\u0022csp-aht-value\u0022).textContent = handleMinutes \u002B (handleMinutes === 1 ? \u0022 minute\u0022 : \u0022 minutes\u0022);\n    byId(\u0022csp-seat-low\u0022).textContent = formatNumber(lowSeats);\n    byId(\u0022csp-seat-high\u0022).textContent = formatNumber(highSeats);\n    byId(\u0022csp-seat-fill\u0022).style.width = barWidth \u002B \u0022%\u0022;\n    byId(\u0022csp-scale-quarter\u0022).textContent = formatNumber(Math.round(scaleMax / 4));\n    byId(\u0022csp-scale-half\u0022).textContent = formatNumber(Math.round(scaleMax / 2));\n    byId(\u0022csp-scale-max\u0022).textContent = formatNumber(scaleMax) \u002B (highSeats \u003E 1000 ? \u0022\u002B\u0022 : \u0022\u0022);\n    byId(\u0022csp-workload\u0022).textContent = formatNumber(workloadHours) \u002B \u0022 hours\u0022;\n    byId(\u0022csp-coverage\u0022).textContent = hoursPerDay \u002B \u0022h \u00D7 \u0022 \u002B daysPerWeek \u002B \u0022 days\u0022;\n    byId(\u0022csp-driver\u0022).textContent = driver;\n    byId(\u0022csp-band\u0022).textContent = getBand(highSeats);\n\n    var launchSentence = launch.value === \u0022Exploring options\u0022\n      ? \u0022We are currently exploring options.\u0022\n      : \u0022Our preferred launch window is \u0022 \u002B launch.value.toLowerCase() \u002B \u0022.\u0022;\n\n    currentBrief = \u0022We are planning for approximately \u0022 \u002B formatNumber(lowSeats) \u002B \u0022\u2013\u0022 \u002B formatNumber(highSeats) \u002B\n      \u0022 dedicated seats for \u0022 \u002B need.value.toLowerCase() \u002B \u0022, based on \u0022 \u002B formatNumber(monthlyContacts) \u002B\n      \u0022 monthly interactions, a \u0022 \u002B handleMinutes \u002B \u0022-minute average handling time and \u0022 \u002B hoursPerDay \u002B\n      \u0022-hour coverage across \u0022 \u002B daysPerWeek \u002B \u0022 days. \u0022 \u002B launchSentence;\n    byId(\u0022csp-brief-text\u0022).textContent = currentBrief;\n\n    var params = new URLSearchParams({\n      source: \u0022seat-planner\u0022,\n      seats: lowSeats \u002B \u0022-\u0022 \u002B highSeats,\n      contacts: monthlyContacts,\n      coverage: hoursPerDay \u002B \u0022h-\u0022 \u002B daysPerWeek \u002B \u0022d\u0022,\n      service: titleCase(service),\n      need: need.value,\n      launch: launch.value\n    });\n    byId(\u0022csp-consult-link\u0022).href = \u0022https://centrocdx.com/get-in-touch/?\u0022 \u002B params.toString();\n\n    paintRange(contacts);\n    paintRange(aht);\n  }\n\n  function showToast(message) {\n    var toast = byId(\u0022csp-toast\u0022);\n    toast.textContent = message;\n    toast.classList.add(\u0022is-visible\u0022);\n    window.clearTimeout(toastTimer);\n    toastTimer = window.setTimeout(function () {\n      toast.classList.remove(\u0022is-visible\u0022);\n    }, 2200);\n  }\n\n  function copyBrief() {\n    function fallbackCopy() {\n      var field = document.createElement(\u0022textarea\u0022);\n      field.value = currentBrief;\n      field.setAttribute(\u0022readonly\u0022, \u0022\u0022);\n      field.style.position = \u0022fixed\u0022;\n      field.style.opacity = \u00220\u0022;\n      document.body.appendChild(field);\n      field.select();\n      var copied = document.execCommand(\u0022copy\u0022);\n      document.body.removeChild(field);\n      showToast(copied ? \u0022Planning brief copied.\u0022 : \u0022Select and copy the brief above.\u0022);\n    }\n\n    if (navigator.clipboard \u0026\u0026 window.isSecureContext) {\n      navigator.clipboard.writeText(currentBrief).then(function () {\n        showToast(\u0022Planning brief copied.\u0022);\n      }).catch(fallbackCopy);\n    } else {\n      fallbackCopy();\n    }\n  }\n\n  for (var i = 0; i \u003C inputs.length; i \u002B= 1) {\n    inputs[i].addEventListener(\u0022input\u0022, update);\n    inputs[i].addEventListener(\u0022change\u0022, update);\n  }\n  byId(\u0022csp-copy-brief\u0022).addEventListener(\u0022click\u0022, copyBrief);\n\n  var internalLinks = root.querySelectorAll(\u0027a[href^=\u0022#\u0022]\u0027);\n  for (var j = 0; j \u003C internalLinks.length; j \u002B= 1) {\n    internalLinks[j].addEventListener(\u0022click\u0022, function (event) {\n      var target = root.querySelector(this.getAttribute(\u0022href\u0022));\n      if (!target) return;\n      event.preventDefault();\n      target.scrollIntoView({ behavior: \u0022smooth\u0022, block: \u0022start\u0022 });\n    });\n  }\n\n  var progressBar = root.querySelector(\u0022.csp-progress \u003E span\u0022);\n  function updateProgress() {\n    var rect = root.getBoundingClientRect();\n    var viewport = window.innerHeight || document.documentElement.clientHeight;\n    var total = Math.max(1, root.offsetHeight - viewport);\n    var travelled = Math.min(total, Math.max(0, -rect.top));\n    progressBar.style.width = (travelled / total * 100) \u002B \u0022%\u0022;\n  }\n  window.addEventListener(\u0022scroll\u0022, updateProgress, { passive: true });\n\n  var revealItems = root.querySelectorAll(\u0022.csp-reveal\u0022);\n  if (\u0022IntersectionObserver\u0022 in window) {\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add(\u0022is-visible\u0022);\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.08 });\n    revealItems.forEach(function (item) { observer.observe(item); });\n  } else {\n    revealItems.forEach(function (item) { item.classList.add(\u0022is-visible\u0022); });\n  }\n\n  update();\n  updateProgress();\n}());\n\u003C/script\u003E"
        }
      ]
    }
  ],
