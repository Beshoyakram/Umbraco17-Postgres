        },
        {
          "alias": "answer",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Flexible offshore staffing models that adapt to volume swings, open-enrollment spikes, and organizational growth."
        }
      ]
    },
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000007",
      "key": "d4997bc7-171e-4b9b-b1e1-925dff8b5600",
