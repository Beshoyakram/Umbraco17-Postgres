                        <contentBlocks>
      <Value Culture="en-US"><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "a7010006-aaaa-4bbb-8ccc-000000000001",
      "key": "a7010006-5555-4555-8555-111100000028",
      "values": [
        {
          "alias": "html",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "<!--\n  CENTRO RCM FULL DYNAMIC BLOG BODY\n\n  WORDPRESS PLACEMENT\n  1. Keep the existing page title, featured image, category, view count and sidebar.\n  2. Remove the current article body from the introductory paragraph through References.\n  3. Add one WordPress “Custom HTML” block and paste this entire file.\n\n  CSS and native HTML only. No JavaScript is required.\n-->\n\n<style>\n  .centro-rcm-story,\n  .centro-rcm-story * {\n    box-sizing: border-box;\n  }\n\n  .centro-rcm-story {\n    --rcm-steel: #015376;\n    --rcm-blue: #0788bd;\n    --rcm-sky: #62cbe8;\n    --rcm-aqua: #c7f0f7;\n    --rcm-ink: #102a43;\n    --rcm-text: #344f63;\n    --rcm-muted: #607989;\n    --rcm-soft: #eaf7fc;\n    --rcm-line: rgba(1, 83, 118, 0.13);\n    width: 100%;\n    color: var(--rcm-text);\n    font-family: \"Poppins\", Arial, sans-serif;\n  }\n\n  .centro-rcm-story h2,\n  .centro-rcm-story h3,\n  .centro-rcm-story p,\n  .centro-rcm-story summary {\n    font-family: \"Poppins\", Arial, sans-serif !important;\n  }\n\n  .centro-rcm-story a {\n    text-decoration: none;\n  }\n\n  .rcm-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    margin: 0 0 10px !important;\n    color: var(--rcm-steel) !important;\n    font-size: 11px !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.15em;\n    line-height: 1.3 !important;\n    text-transform: uppercase;\n  }\n\n  .rcm-kicker::before {\n    content: \"\";\n    width: 26px;\n    height: 3px;\n    border-radius: 99px;\n    background: linear-gradient(90deg, var(--rcm-steel), var(--rcm-sky));\n  }\n\n  .rcm-section-title {\n    margin: 0 !important;\n    color: var(--rcm-ink) !important;\n    font-size: clamp(25px, 4vw, 36px) !important;\n    font-weight: 700 !important;\n    letter-spacing: -0.035em;\n    line-height: 1.16 !important;\n  }\n\n  .rcm-section-copy {\n    margin: 13px 0 0 !important;\n    color: var(--rcm-muted) !important;\n    font-size: 15px !important;\n    font-weight: 400 !important;\n    line-height: 1.8 !important;\n  }\n\n  /* INTRO */\n  .rcm-intro {\n    display: grid;\n    position: relative;\n    isolation: isolate;\n    grid-template-columns: minmax(0, 1.15fr) minmax(220px, 0.85fr);\n    gap: 28px;\n    margin: 0 0 46px;\n    padding: 38px;\n    overflow: hidden;\n    border: 1px solid var(--rcm-line);\n    border-radius: 28px;\n    background:\n      radial-gradient(circle at 96% 4%, rgba(98, 203, 232, 0.30), transparent 28%),\n      linear-gradient(145deg, #ffffff 0%, #f1faff 100%);\n    box-shadow: 0 24px 60px rgba(1, 83, 118, 0.10);\n  }\n\n  .rcm-intro::before {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    right: -65px;\n    bottom: -78px;\n    width: 205px;\n    height: 205px;\n    border: 35px solid rgba(7, 136, 189, 0.07);\n    border-radius: 50%;\n  }\n\n  .rcm-intro__content {\n    align-self: center;\n  }\n\n  .rcm-intro__title {\n    margin: 0 !important;\n    color: var(--rcm-ink) !important;\n    font-size: clamp(30px, 5vw, 44px) !important;\n    font-weight: 700 !important;\n    letter-spacing: -0.045em;\n    line-height: 1.08 !important;\n  }\n\n  .rcm-intro__title span {\n    color: var(--rcm-blue);\n  }\n\n  .rcm-intro__copy {\n    margin: 18px 0 0 !important;\n    color: var(--rcm-text) !important;\n    font-size: 15px !important;\n    font-weight: 400 !important;\n    line-height: 1.8 !important;\n  }\n\n  .rcm-intro__tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 23px;\n  }\n\n  .rcm-intro__tag {\n    padding: 8px 11px;\n    border: 1px solid rgba(1, 83, 118, 0.12);\n    border-radius: 999px;\n    color: var(--rcm-steel);\n    background: rgba(255, 255, 255, 0.84);\n    box-shadow: 0 7px 18px rgba(1, 83, 118, 0.06);\n    font-size: 10.5px;\n    font-weight: 650;\n    line-height: 1.3;\n  }\n\n  .rcm-engine {\n    display: grid;\n    position: relative;\n    min-height: 285px;\n    place-items: center;\n  }\n\n  .rcm-engine__orbit,\n  .rcm-engine__orbit::before,\n  .rcm-engine__orbit::after {\n    position: absolute;\n    border-radius: 50%;\n  }\n\n  .rcm-engine__orbit {\n    width: 220px;\n    height: 220px;\n    border: 1px solid rgba(7, 136, 189, 0.25);\n  }\n\n  .rcm-engine__orbit::before,\n  .rcm-engine__orbit::after {\n    content: \"\";\n    inset: 18px;\n    border: 1px dashed rgba(7, 136, 189, 0.20);\n  }\n\n  .rcm-engine__orbit::after {\n    inset: 42px;\n    border-style: solid;\n    border-color: rgba(98, 203, 232, 0.22);\n  }\n\n  .rcm-engine__center {\n    display: grid;\n    position: relative;\n    z-index: 2;\n    width: 112px;\n    height: 112px;\n    place-items: center;\n    border-radius: 50%;\n    color: #ffffff;\n    background: linear-gradient(145deg, var(--rcm-steel), var(--rcm-blue));\n    box-shadow: 0 18px 40px rgba(1, 83, 118, 0.26);\n    text-align: center;\n  }\n\n  .rcm-engine__center strong {\n    display: block;\n    font-size: 25px;\n    font-weight: 700;\n    letter-spacing: -0.04em;\n    line-height: 1;\n  }\n\n  .rcm-engine__center small {\n    display: block;\n    margin-top: 6px;\n    color: rgba(255, 255, 255, 0.78);\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.11em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .rcm-engine__node {\n    position: absolute;\n    z-index: 3;\n    padding: 8px 10px;\n    border: 1px solid rgba(1, 83, 118, 0.12);\n    border-radius: 10px;\n    color: var(--rcm-steel);\n    background: rgba(255, 255, 255, 0.94);\n    box-shadow: 0 9px 24px rgba(1, 83, 118, 0.11);\n    font-size: 9px;\n    font-weight: 650;\n    line-height: 1.2;\n    white-space: nowrap;\n  }\n\n  .rcm-engine__node--claim {\n    top: 28px;\n    left: 50%;\n    transform: translateX(-50%);\n  }\n\n  .rcm-engine__node--payment {\n    right: 0;\n    bottom: 62px;\n  }\n\n  .rcm-engine__node--insight {\n    bottom: 62px;\n    left: 0;\n  }\n\n  /* CHALLENGES */\n  .rcm-challenges {\n    margin: 46px 0;\n  }\n\n  .rcm-benchmark-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 13px;\n    margin-top: 27px;\n  }\n\n  .rcm-benchmark {\n    position: relative;\n    min-height: 220px;\n    padding: 22px 19px;\n    overflow: hidden;\n    border: 1px solid var(--rcm-line);\n    border-radius: 18px;\n    background: #ffffff;\n    box-shadow: 0 11px 30px rgba(16, 42, 67, 0.07);\n    transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease;\n  }\n\n  .rcm-benchmark:hover,\n  .rcm-benchmark:focus-within {\n    transform: translateY(-7px);\n    border-color: rgba(7, 136, 189, 0.35);\n    box-shadow: 0 18px 38px rgba(1, 83, 118, 0.13);\n  }\n\n  .rcm-benchmark::after {\n    content: \"\";\n    position: absolute;\n    right: -34px;\n    bottom: -36px;\n    width: 95px;\n    height: 95px;\n    border-radius: 50%;\n    background: var(--rcm-soft);\n  }\n\n  .rcm-benchmark__value {\n    position: relative;\n    z-index: 1;\n    margin: 0 0 13px;\n    color: var(--rcm-blue);\n    font-size: clamp(32px, 6vw, 44px);\n    font-weight: 700;\n    letter-spacing: -0.055em;\n    line-height: 1;\n  }\n\n  .rcm-benchmark__value--icon {\n    display: grid;\n    width: 48px;\n    height: 48px;\n    place-items: center;\n    border-radius: 14px;\n    color: #ffffff;\n    background: linear-gradient(145deg, var(--rcm-steel), var(--rcm-blue));\n    box-shadow: 0 9px 20px rgba(1, 83, 118, 0.20);\n  }\n\n  .rcm-benchmark__value--icon svg {\n    width: 24px;\n    height: 24px;\n  }\n\n  .rcm-benchmark h3 {\n    position: relative;\n    z-index: 1;\n    margin: 0 0 8px !important;\n    color: var(--rcm-ink) !important;\n    font-size: 15px !important;\n    font-weight: 650 !important;\n    line-height: 1.35 !important;\n  }\n\n  .rcm-benchmark p {\n    position: relative;\n    z-index: 1;\n    margin: 0 !important;\n    color: var(--rcm-muted) !important;\n    font-size: 12px !important;\n    font-weight: 400 !important;\n    line-height: 1.65 !important;\n  }\n\n  .rcm-benchmark__source {\n    display: inline-block;\n    position: relative;\n    z-index: 1;\n    margin-top: 14px;\n    padding: 5px 8px;\n    border-radius: 99px;\n    color: var(--rcm-steel);\n    background: var(--rcm-soft);\n    font-size: 9px;\n    font-weight: 650;\n    line-height: 1.25;\n  }\n\n  /* REVENUE CYCLE MAP */\n  .rcm-map {\n    position: relative;\n    isolation: isolate;\n    margin: 48px 0;\n    padding: 34px;\n    overflow: hidden;\n    border: 1px solid var(--rcm-line);\n    border-radius: 25px;\n    background:\n      linear-gradient(145deg, #ffffff 0%, #f4fbfe 100%);\n    box-shadow: 0 20px 50px rgba(1, 83, 118, 0.08);\n  }\n\n  .rcm-map::before {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    top: -58px;\n    left: -58px;\n    width: 150px;\n    height: 150px;\n    border: 28px solid rgba(98, 203, 232, 0.08);\n    border-radius: 50%;\n  }\n\n  .rcm-map__grid {\n    display: grid;\n    position: relative;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n    margin-top: 28px;\n  }\n\n  .rcm-stage {\n    position: relative;\n    min-height: 145px;\n    padding: 18px 16px;\n    border: 1px solid rgba(1, 83, 118, 0.10);\n    border-radius: 16px;\n    background: rgba(255, 255, 255, 0.90);\n    box-shadow: 0 8px 22px rgba(16, 42, 67, 0.05);\n    transition: transform 230ms ease, background 230ms ease;\n  }\n\n  .rcm-stage:hover {\n    background: #ffffff;\n    transform: translateY(-5px);\n  }\n\n  .rcm-stage__number {\n    display: grid;\n    width: 32px;\n    height: 32px;\n    margin-bottom: 13px;\n    place-items: center;\n    border-radius: 10px;\n    color: #ffffff;\n    background: linear-gradient(145deg, var(--rcm-steel), var(--rcm-blue));\n    font-size: 10px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .rcm-stage h3 {\n    margin: 0 0 7px !important;\n    color: var(--rcm-ink) !important;\n    font-size: 14px !important;\n    font-weight: 650 !important;\n    line-height: 1.35 !important;\n  }\n\n  .rcm-stage p {\n    margin: 0 !important;\n    color: var(--rcm-muted) !important;\n    font-size: 11.5px !important;\n    font-weight: 400 !important;\n    line-height: 1.6 !important;\n  }\n\n  /* OUTCOMES */\n  .rcm-outcomes {\n    position: relative;\n    isolation: isolate;\n    margin: 48px 0;\n    padding: 36px 34px;\n    overflow: hidden;\n    border-radius: 25px;\n    color: #ffffff;\n    background:\n      radial-gradient(circle at 92% 7%, rgba(98, 203, 232, 0.28), transparent 28%),\n      linear-gradient(135deg, var(--rcm-steel), var(--rcm-ink));\n    box-shadow: 0 24px 55px rgba(16, 42, 67, 0.22);\n  }\n\n  .rcm-outcomes::after {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    right: -70px;\n    bottom: -85px;\n    width: 220px;\n    height: 220px;\n    border: 35px solid rgba(255, 255, 255, 0.05);\n    border-radius: 50%;\n  }\n\n  .rcm-outcomes .rcm-kicker {\n    color: var(--rcm-aqua) !important;\n  }\n\n  .rcm-outcomes .rcm-kicker::before {\n    background: var(--rcm-sky);\n  }\n\n  .rcm-outcomes .rcm-section-title {\n    color: #ffffff !important;\n  }\n\n  .rcm-outcomes .rcm-section-copy {\n    color: rgba(255, 255, 255, 0.76) !important;\n  }\n\n  .rcm-outcomes__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 11px;\n    margin-top: 27px;\n  }\n\n  .rcm-outcome {\n    padding: 21px 17px;\n    border: 1px solid rgba(255, 255, 255, 0.16);\n    border-radius: 17px;\n    background: rgba(255, 255, 255, 0.08);\n    backdrop-filter: blur(8px);\n    transition: transform 240ms ease, background 240ms ease;\n  }\n\n  .rcm-outcome:hover {\n    background: rgba(255, 255, 255, 0.13);\n    transform: translateY(-6px);\n  }\n\n  .rcm-outcome__value {\n    display: block;\n    margin-bottom: 10px;\n    color: var(--rcm-aqua);\n    font-size: clamp(28px, 5vw, 39px);\n    font-weight: 700;\n    letter-spacing: -0.05em;\n    line-height: 1;\n  }\n\n  .rcm-outcome h3 {\n    margin: 0 0 8px !important;\n    color: #ffffff !important;\n    font-size: 14px !important;\n    font-weight: 650 !important;\n    line-height: 1.35 !important;\n  }\n\n  .rcm-outcome p {\n    margin: 0 !important;\n    color: rgba(255, 255, 255, 0.70) !important;\n    font-size: 11.5px !important;\n    font-weight: 400 !important;\n    line-height: 1.6 !important;\n  }\n\n  .rcm-outcomes__note {\n    margin: 18px 0 0 !important;\n    color: rgba(255, 255, 255, 0.56) !important;\n    font-size: 10px !important;\n    font-weight: 400 !important;\n    line-height: 1.55 !important;\n  }\n\n  /* WHY CENTRO */\n  .rcm-why {\n    margin: 48px 0;\n  }\n\n  .rcm-accordion {\n    display: grid;\n    gap: 10px;\n    margin-top: 27px;\n  }\n\n  .rcm-accordion details {\n    overflow: hidden;\n    border: 1px solid var(--rcm-line);\n    border-radius: 16px;\n    background: #ffffff;\n    box-shadow: 0 8px 24px rgba(1, 83, 118, 0.06);\n    transition: border-color 240ms ease, box-shadow 240ms ease;\n  }\n\n  .rcm-accordion details[open] {\n    border-color: rgba(7, 136, 189, 0.30);\n    box-shadow: 0 14px 30px rgba(1, 83, 118, 0.10);\n  }\n\n  .rcm-accordion summary {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    padding: 18px 20px;\n    color: var(--rcm-ink) !important;\n    cursor: pointer;\n    list-style: none;\n    font-size: 15px !important;\n    font-weight: 650 !important;\n    line-height: 1.4 !important;\n  }\n\n  .rcm-accordion summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .rcm-accordion summary::before {\n    content: \"\";\n    flex: 0 0 auto;\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: linear-gradient(145deg, var(--rcm-blue), var(--rcm-sky));\n    box-shadow: 0 0 0 5px rgba(98, 203, 232, 0.13);\n  }\n\n  .rcm-accordion summary::after {\n    content: \"+\";\n    display: grid;\n    flex: 0 0 auto;\n    width: 28px;\n    height: 28px;\n    margin-left: auto;\n    place-items: center;\n    border-radius: 50%;\n    color: var(--rcm-steel);\n    background: var(--rcm-soft);\n    font-size: 20px;\n    font-weight: 400;\n    line-height: 1;\n    transition: transform 240ms ease, color 240ms ease, background 240ms ease;\n  }\n\n  .rcm-accordion details[open] summary::after {\n    color: #ffffff;\n    background: var(--rcm-steel);\n    transform: rotate(45deg);\n  }\n\n  .rcm-accordion__body {\n    padding: 0 58px 20px 43px;\n  }\n\n  .rcm-accordion__body p {\n    margin: 0 !important;\n    color: var(--rcm-muted) !important;\n    font-size: 13.5px !important;\n    font-weight: 400 !important;\n    line-height: 1.75 !important;\n  }\n\n  /* CTA */\n  .rcm-cta {\n    display: grid;\n    position: relative;\n    isolation: isolate;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 24px;\n    align-items: center;\n    margin: 48px 0;\n    padding: 34px;\n    overflow: hidden;\n    border-radius: 24px;\n    color: #ffffff;\n    background:\n      linear-gradient(135deg, var(--rcm-blue), var(--rcm-steel));\n    box-shadow: 0 22px 50px rgba(1, 83, 118, 0.22);\n  }\n\n  .rcm-cta::after {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    top: -78px;\n    right: -55px;\n    width: 200px;\n    height: 200px;\n    border: 32px solid rgba(255, 255, 255, 0.08);\n    border-radius: 50%;\n  }\n\n  .rcm-cta h2 {\n    margin: 0 0 9px !important;\n    color: #ffffff !important;\n    font-size: clamp(24px, 4vw, 34px) !important;\n    font-weight: 700 !important;\n    letter-spacing: -0.035em;\n    line-height: 1.18 !important;\n  }\n\n  .rcm-cta p {\n    margin: 0 !important;\n    color: rgba(255, 255, 255, 0.77) !important;\n    font-size: 13.5px !important;\n    font-weight: 400 !important;\n    line-height: 1.7 !important;\n  }\n\n  .rcm-cta__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-width: 174px;\n    padding: 14px 18px;\n    border-radius: 12px;\n    color: var(--rcm-steel) !important;\n    background: #ffffff;\n    box-shadow: 0 12px 28px rgba(16, 42, 67, 0.19);\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.3;\n    transition: transform 220ms ease, box-shadow 220ms ease;\n  }\n\n  .rcm-cta__button:hover,\n  .rcm-cta__button:focus {\n    color: var(--rcm-steel) !important;\n    transform: translateY(-4px);\n    box-shadow: 0 17px 34px rgba(16, 42, 67, 0.25);\n  }\n\n  /* ABOUT + SOURCES */\n  .rcm-about {\n    position: relative;\n    isolation: isolate;\n    margin: 48px 0 0;\n    padding: 34px;\n    overflow: hidden;\n    border: 1px solid var(--rcm-line);\n    border-radius: 24px;\n    background: linear-gradient(120deg, rgba(234, 247, 252, 0.96), rgba(255, 255, 255, 0.98));\n    box-shadow: 0 20px 50px rgba(1, 83, 118, 0.08);\n  }\n\n  .rcm-about::before {\n    content: \"CENTRO\";\n    position: absolute;\n    z-index: -1;\n    right: -14px;\n    bottom: -24px;\n    color: rgba(1, 83, 118, 0.045);\n    font-size: clamp(70px, 15vw, 126px);\n    font-weight: 800;\n    letter-spacing: -0.06em;\n    line-height: 1;\n  }\n\n  .rcm-about__tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 22px;\n  }\n\n  .rcm-about__tags a {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 9px 12px;\n    border: 1px solid rgba(1, 83, 118, 0.12);\n    border-radius: 999px;\n    color: var(--rcm-steel) !important;\n    background: rgba(255, 255, 255, 0.84);\n    box-shadow: 0 7px 18px rgba(1, 83, 118, 0.05);\n    font-size: 10.5px;\n    font-weight: 650;\n    line-height: 1.3;\n    text-decoration: none !important;\n    transition: color 220ms ease, background 220ms ease, border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;\n  }\n\n  .rcm-about__tags a::after {\n    content: \"→\";\n    opacity: 0.58;\n    font-size: 12px;\n    line-height: 1;\n    transform: translateX(0);\n    transition: opacity 220ms ease, transform 220ms ease;\n  }\n\n  .rcm-about__tags a:hover,\n  .rcm-about__tags a:focus-visible {\n    border-color: var(--rcm-steel);\n    color: #ffffff !important;\n    background: linear-gradient(135deg, var(--rcm-steel), var(--rcm-blue));\n    box-shadow: 0 11px 24px rgba(1, 83, 118, 0.20);\n    transform: translateY(-3px);\n  }\n\n  .rcm-about__tags a:hover::after,\n  .rcm-about__tags a:focus-visible::after {\n    opacity: 1;\n    transform: translateX(3px);\n  }\n\n  .rcm-about__tags a:focus-visible {\n    outline: 3px solid rgba(98, 203, 232, 0.45);\n    outline-offset: 3px;\n  }\n\n  .rcm-sources {\n    margin-top: 18px;\n    overflow: hidden;\n    border: 1px solid var(--rcm-line);\n    border-radius: 15px;\n    background: rgba(255, 255, 255, 0.88);\n  }\n\n  .rcm-sources summary {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    padding: 15px 17px;\n    color: var(--rcm-steel) !important;\n    cursor: pointer;\n    list-style: none;\n    font-size: 12px !important;\n    font-weight: 700 !important;\n    line-height: 1.4 !important;\n  }\n\n  .rcm-sources summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .rcm-sources summary::after {\n    content: \"+\";\n    margin-left: auto;\n    font-size: 18px;\n    font-weight: 400;\n    transition: transform 220ms ease;\n  }\n\n  .rcm-sources[open] summary::after {\n    transform: rotate(45deg);\n  }\n\n  .rcm-sources__body {\n    padding: 0 17px 17px;\n  }\n\n  .rcm-sources__body ol {\n    margin: 0;\n    padding-left: 19px;\n  }\n\n  .rcm-sources__body li {\n    margin: 0 0 10px;\n    color: var(--rcm-muted);\n    font-size: 10.5px;\n    font-weight: 400;\n    line-height: 1.55;\n  }\n\n  .rcm-sources__body li:last-child {\n    margin-bottom: 0;\n  }\n\n  .rcm-sources__body a {\n    color: var(--rcm-blue) !important;\n    font-weight: 600;\n    text-decoration: underline;\n    text-underline-offset: 2px;\n  }\n\n  /* MOTION */\n  @media (prefers-reduced-motion: no-preference) {\n    .rcm-intro,\n    .rcm-challenges,\n    .rcm-map,\n    .rcm-outcomes,\n    .rcm-why,\n    .rcm-cta,\n    .rcm-about {\n      animation: rcmReveal 680ms both;\n    }\n\n    .rcm-engine__orbit {\n      animation: rcmRotate 18s linear infinite;\n    }\n\n    .rcm-engine__center {\n      animation: rcmFloat 3.4s ease-in-out infinite;\n    }\n\n    .rcm-benchmark:nth-child(2),\n    .rcm-stage:nth-child(2),\n    .rcm-stage:nth-child(5),\n    .rcm-outcome:nth-child(2) {\n      animation-delay: 110ms;\n    }\n\n    .rcm-benchmark:nth-child(3),\n    .rcm-stage:nth-child(3),\n    .rcm-stage:nth-child(6),\n    .rcm-outcome:nth-child(3) {\n      animation-delay: 220ms;\n    }\n\n    .rcm-benchmark,\n    .rcm-stage,\n    .rcm-outcome {\n      animation: rcmReveal 620ms both;\n    }\n  }\n\n  @keyframes rcmReveal {\n    from {\n      opacity: 0;\n      transform: translateY(16px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  @keyframes rcmRotate {\n    to {\n      transform: rotate(360deg);\n    }\n  }\n\n  @keyframes rcmFloat {\n    0%,\n    100% {\n      transform: translateY(0);\n    }\n    50% {\n      transform: translateY(-8px);\n    }\n  }\n\n  @media (max-width: 760px) {\n    .rcm-intro,\n    .rcm-benchmark-grid,\n    .rcm-map__grid,\n    .rcm-outcomes__grid,\n    .rcm-cta {\n      grid-template-columns: 1fr;\n    }\n\n    .rcm-intro,\n    .rcm-map,\n    .rcm-outcomes,\n    .rcm-cta,\n    .rcm-about {\n      padding: 25px 20px;\n      border-radius: 21px;\n    }\n\n    .rcm-engine {\n      min-height: 255px;\n    }\n\n    .rcm-engine__orbit {\n      width: 205px;\n      height: 205px;\n    }\n\n    .rcm-benchmark,\n    .rcm-stage {\n      min-height: auto;\n    }\n\n    .rcm-cta__button {\n      width: 100%;\n    }\n\n    .rcm-accordion__body {\n      padding-right: 20px;\n      padding-left: 20px;\n    }\n  }\n</style>\n\n<div class=\"centro-rcm-story\">\n  <section class=\"rcm-intro\" aria-labelledby=\"rcm-intro-title\">\n    <div class=\"rcm-intro__content\">\n      <p class=\"rcm-kicker\">Revenue Cycle Management</p>\n      <h2 class=\"rcm-intro__title\" id=\"rcm-intro-title\">\n        Turn the Revenue Cycle Into a <span>Performance Engine</span>\n      </h2>\n      <p class=\"rcm-intro__copy\">\n        Efficient billing and collections are essential for healthcare stability and growth. Centro provides tailored RCM solutions designed to reduce errors, accelerate reimbursements, and improve cash-flow visibility.\n      </p>\n      <p class=\"rcm-intro__copy\">\n        From claim submission and payer follow-up to denial management and patient billing, our teams help providers protect revenue while keeping their focus on care delivery.\n      </p>\n      <div class=\"rcm-intro__tags\" aria-label=\"RCM priorities\">\n        <span class=\"rcm-intro__tag\">Fewer Delays</span>\n        <span class=\"rcm-intro__tag\">Stronger Accuracy</span>\n        <span class=\"rcm-intro__tag\">Better Visibility</span>\n      </div>\n    </div>\n\n    <div class=\"rcm-engine\" aria-label=\"Revenue cycle performance illustration\">\n      <span class=\"rcm-engine__orbit\" aria-hidden=\"true\"></span>\n      <span class=\"rcm-engine__center\">\n        <span>\n          <strong>RCM</strong>\n          <small>Performance</small>\n        </span>\n      </span>\n      <span class=\"rcm-engine__node rcm-engine__node--claim\">Clean Claims</span>\n      <span class=\"rcm-engine__node rcm-engine__node--payment\">Payments</span>\n      <span class=\"rcm-engine__node rcm-engine__node--insight\">Visibility</span>\n    </div>\n  </section>\n\n  <section class=\"rcm-challenges\" aria-labelledby=\"rcm-challenges-title\">\n    <p class=\"rcm-kicker\">The Revenue Challenge</p>\n    <h2 class=\"rcm-section-title\" id=\"rcm-challenges-title\">What Healthcare Providers Are Navigating</h2>\n    <p class=\"rcm-section-copy\">\n      Complex payer requirements, evolving regulations, claim denials, and coding errors can slow reimbursement and create avoidable revenue leakage. The industry benchmarks below show how widespread the challenge has become.\n    </p>\n\n    <div class=\"rcm-benchmark-grid\">\n      <article class=\"rcm-benchmark\">\n        <div class=\"rcm-benchmark__value\">~12%</div>\n        <h3>Initial Claim Denial Rate</h3>\n        <p>The average initial denial rate was reported at nearly 12% in 2023, compared with 10.15% in 2020.</p>\n        <span class=\"rcm-benchmark__source\">Simbo.ai, 2023</span>\n      </article>\n\n      <article class=\"rcm-benchmark\">\n        <div class=\"rcm-benchmark__value\">38%</div>\n        <h3>Providers Reporting Frequent Denials</h3>\n        <p>More than one-third of providers reported that at least one in every ten claims is denied.</p>\n        <span class=\"rcm-benchmark__source\">Experian, 2024</span>\n      </article>\n\n      <article class=\"rcm-benchmark\">\n        <div class=\"rcm-benchmark__value rcm-benchmark__value--icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M4 4h16v16H4zM8 9h8M8 13h5M8 17h3\" />\n            <path d=\"m15 15 4 4M19 15l-4 4\" />\n          </svg>\n        </div>\n        <h3>Coding and Requirement Gaps</h3>\n        <p>Incorrect coding and missed insurance requirements can contribute significantly to delayed or lost revenue.</p>\n        <span class=\"rcm-benchmark__source\">Advisory Board, 2021</span>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"rcm-map\" aria-labelledby=\"rcm-map-title\">\n    <p class=\"rcm-kicker\">How Centro Makes a Difference</p>\n    <h2 class=\"rcm-section-title\" id=\"rcm-map-title\">Support Across the Revenue Cycle</h2>\n    <p class=\"rcm-section-copy\">\n      Centro combines specialized healthcare talent, technology-enabled visibility, and structured workflows to support the financial cycle from the earliest payer checks through final payment resolution.\n    </p>\n\n    <div class=\"rcm-map__grid\">\n      <article class=\"rcm-stage\">\n        <span class=\"rcm-stage__number\">01</span>\n        <h3>Eligibility Verification</h3>\n        <p>Confirm coverage and payer requirements before they become downstream delays.</p>\n      </article>\n      <article class=\"rcm-stage\">\n        <span class=\"rcm-stage__number\">02</span>\n        <h3>Coding Support</h3>\n        <p>Promote accurate documentation and coding alignment before submission.</p>\n      </article>\n      <article class=\"rcm-stage\">\n        <span class=\"rcm-stage__number\">03</span>\n        <h3>Claim Submission</h3>\n        <p>Apply consistent quality checks to support cleaner, more accurate claims.</p>\n      </article>\n      <article class=\"rcm-stage\">\n        <span class=\"rcm-stage__number\">04</span>\n        <h3>Payer Follow-Up</h3>\n        <p>Track outstanding claims and maintain disciplined follow-up activity.</p>\n      </article>\n      <article class=\"rcm-stage\">\n        <span class=\"rcm-stage__number\">05</span>\n        <h3>Denial Management</h3>\n        <p>Identify denial patterns, support corrections, and strengthen prevention efforts.</p>\n      </article>\n      <article class=\"rcm-stage\">\n        <span class=\"rcm-stage__number\">06</span>\n        <h3>Patient Billing</h3>\n        <p>Support clearer communication and more consistent patient account management.</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"rcm-outcomes\" aria-labelledby=\"rcm-outcomes-title\">\n    <p class=\"rcm-kicker\">Industry-Reported Outcomes</p>\n    <h2 class=\"rcm-section-title\" id=\"rcm-outcomes-title\">What Outsourced RCM Can Help Unlock</h2>\n    <p class=\"rcm-section-copy\">\n      The right outsourcing model can strengthen cost efficiency, collections, and claim quality while giving internal teams more capacity to focus on care and operational priorities.\n    </p>\n\n    <div class=\"rcm-outcomes__grid\">\n      <article class=\"rcm-outcome\">\n        <span class=\"rcm-outcome__value\">30–40%</span>\n        <h3>Lower Billing Costs</h3>\n        <p>Reported cost reduction when outsourcing RCM compared with maintaining in-house billing teams.</p>\n      </article>\n      <article class=\"rcm-outcome\">\n        <span class=\"rcm-outcome__value\">5–15%</span>\n        <h3>Collection Improvement</h3>\n        <p>Reported improvement in revenue collections with outsourced billing and claims management.</p>\n      </article>\n      <article class=\"rcm-outcome\">\n        <span class=\"rcm-outcome__value\">30–60%</span>\n        <h3>Fewer Claim Rejections</h3>\n        <p>Reported reduction in claim rejections during the first three months of outsourcing.</p>\n      </article>\n    </div>\n    <p class=\"rcm-outcomes__note\">These figures are industry benchmarks cited in the article’s original sources. Actual results vary by provider, starting performance, scope, payer mix, and operating model.</p>\n  </section>\n\n  <section class=\"rcm-why\" aria-labelledby=\"rcm-why-title\">\n    <p class=\"rcm-kicker\">Why Choose Centro for RCM?</p>\n    <h2 class=\"rcm-section-title\" id=\"rcm-why-title\">Built for Accuracy, Visibility, and Scale</h2>\n    <p class=\"rcm-section-copy\">\n      Centro approaches revenue cycle management as a strategic business function. Our model brings together healthcare process expertise, disciplined execution, and flexible delivery to help providers build a more predictable financial operation.\n    </p>\n\n    <div class=\"rcm-accordion\">\n      <details open>\n        <summary>Specialized Healthcare RCM Expertise</summary>\n        <div class=\"rcm-accordion__body\">\n          <p>Trained teams support healthcare revenue processes with attention to payer requirements, documentation accuracy, follow-up discipline, and regulatory expectations.</p>\n        </div>\n      </details>\n      <details>\n        <summary>End-to-End Claims Management</summary>\n        <div class=\"rcm-accordion__body\">\n          <p>Centro supports the claims journey from verification and submission through payer follow-up, denial resolution, reimbursement, and patient billing.</p>\n        </div>\n      </details>\n      <details>\n        <summary>Technology-Enabled Visibility</summary>\n        <div class=\"rcm-accordion__body\">\n          <p>Structured tracking and reporting help providers monitor activity, identify recurring issues, and gain clearer visibility into revenue-cycle performance.</p>\n        </div>\n      </details>\n      <details>\n        <summary>Scalable Delivery</summary>\n        <div class=\"rcm-accordion__body\">\n          <p>Flexible support can adapt to changing patient volumes, organizational needs, new payer requirements, and evolving operational priorities.</p>\n        </div>\n      </details>\n      <details>\n        <summary>A Clearer Patient Billing Experience</summary>\n        <div class=\"rcm-accordion__body\">\n          <p>Consistent account handling and clearer billing communication can help reduce confusion and support a better financial experience for patients.</p>\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <section class=\"rcm-cta\" aria-labelledby=\"rcm-cta-title\">\n    <div>\n      <h2 id=\"rcm-cta-title\">Build a More Predictable Revenue Cycle</h2>\n      <p>Connect with Centro to explore an RCM model shaped around your organization’s priorities, workflows, and growth plans.</p>\n    </div>\n    <a class=\"rcm-cta__button\" href=\"https://centrocdx.com/get-in-touch/\">\n      Talk to Our RCM Team\n      <svg aria-hidden=\"true\" viewBox=\"0 0 20 20\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M4 10h11M11 6l4 4-4 4\" />\n      </svg>\n    </a>\n  </section>\n\n  <section class=\"rcm-about\" aria-labelledby=\"rcm-about-title\">\n    <p class=\"rcm-kicker\">About Centro</p>\n    <h2 class=\"rcm-section-title\" id=\"rcm-about-title\">A Global BPO and Technology Services Provider</h2>\n    <p class=\"rcm-section-copy\">\n      Centro supports organizations through Contact Center Outsourcing, healthcare operations, and digital transformation. Across our global delivery network, we combine specialized talent, operational discipline, and technology-enabled workflows to deliver practical business outcomes.\n    </p>\n    <div class=\"rcm-about__tags\" aria-label=\"Explore Centro services\">\n      <a href=\"https://centrocdx.com/healthcare/\">Healthcare RCM</a>\n      <a href=\"https://centrocdx.com/bpo/\">Contact Center Outsourcing</a>\n      <a href=\"https://centrocdx.com/digital/\">Digital Transformation</a>\n    </div>\n\n    <details class=\"rcm-sources\">\n      <summary>View Article References</summary>\n      <div class=\"rcm-sources__body\">\n        <ol>\n          <li><a href=\"https://www.simbo.ai/blog/analyzing-the-increase-in-average-denial-rates-for-medical-claims-and-its-implications-for-healthcare-revenue-cycle-management-3480785/\" target=\"_blank\" rel=\"noopener noreferrer\">Simbo.ai, Analyzing the Increase in Average Denial Rates for Medical Claims, 2023</a></li>\n          <li><a href=\"https://www.experian.com/blogs/healthcare/healthcare-claim-denials-statistics-state-of-claims-report/\" target=\"_blank\" rel=\"noopener noreferrer\">Experian, Healthcare Claim Denials Statistics: State of Claims Report, 2024</a></li>\n          <li>Advisory Board, Coding and Compliance in Healthcare Finance, 2021.</li>\n          <li><a href=\"https://www.adsc.com/blog/outsourcing-revenue-cycle-management\" target=\"_blank\" rel=\"noopener noreferrer\">ADSC, Outsourcing Revenue Cycle Management, 2023</a></li>\n          <li><a href=\"https://staffingly.com/tracking-claim-rejection-rates-in-revenue-cycle-management/\" target=\"_blank\" rel=\"noopener noreferrer\">Staffingly, Tracking Claim Rejection Rates in Revenue Cycle Management, 2024</a></li>\n        </ol>\n      </div>\n    </details>\n  </section>\n</div>"
        }
      ]
    }
  ],
